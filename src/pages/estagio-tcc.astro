---
// src/pages/estagio-tcc.astro — Hub Integrador Estágio & TCC (Painel Visual Unificado para a Persona Formando)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import JourneyNav from '../components/ui/JourneyNav.astro';
import { FormandoRetaFinalHub } from '../components/features/carreira/FormandoRetaFinalHub';
import { route } from '@/lib/paths';

const badges = [
  { label: 'Persona Formando (8º–10ºP)', variant: 'purple' as const, icon: 'bi-mortarboard-fill' },
  { label: 'Aproveitamento Servidor (Art. 41)', variant: 'green' as const, icon: 'bi-file-earmark-check-fill' },
  { label: 'Estágio 300h + TCC 180h', variant: 'red' as const, icon: 'bi-briefcase-fill' },
  { label: 'Progresso no Cofre Local', variant: 'gold' as const, icon: 'bi-shield-check' },
];
---

<BaseLayout
  title="Hub Integrador Estágio & TCC (Checklist Reta Final) • CAGP FAFICH/UFMG"
  description="Painel visual unificado para a persona Formando em Gestão Pública na UFMG: checklist animado de colação de grau, Estágio 300h, Aproveitamento Servidor (Art. 41) e TCC (180h)."
  mode="operate"
>
  <div class="space-y-6 max-w-6xl mx-auto font-sans">
    <PageHeader
      axisId="carreira"
      mode="operate"
      condensed={true}
      showAxisNav={false}
      title="Hub Integrador Estágio & TCC"
      subtitle="Painel unificado para a persona Formando: acompanhe os 10 marcos obrigatórios de Estágio (300h / Art. 41), TCC (180h) e Colação de Grau salvos no seu navegador."
      badges={badges}
    />

    <FormandoRetaFinalHub client:load />

    <JourneyNav
      prev={{
        title: 'Trabalho de Conclusão de Curso (180h)',
        href: '/tcc',
        desc: 'Compare Monografia vs Artigo Científico (Art. 19) e veja a linha do tempo de defesa.',
      }}
      next={{
        title: 'Hub de Carreira, Vagas & Banco de Talentos GP',
        href: '/carreira',
        desc: 'Conecte-se às Propostas 9, 11 e 12 da Chapa Semente, editais de estágio e Banco de Talentos.',
      }}
    />
  </div>
</BaseLayout>
