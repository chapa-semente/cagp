---
// src/pages/ouvidoria.astro — Canal Contínuo de Escuta Discente & Ouvidoria (Super App CAGP UFMG)
import BaseLayout from '@/layouts/BaseLayout.astro';
import { OuvidoriaInteractiveCenter } from '@/components/features/ouvidoria/OuvidoriaInteractiveCenter';
import PageHeader from '@/components/ui/PageHeader.astro';
import SementeSignature from '@/components/ui/SementeSignature.astro';
---

<BaseLayout
  title="Fala com o CA"
  description="Fala com o CA (Proposta 14 da Chapa Semente): escreva sua demanda sobre ementas, infraestrutura ou o Colegiado e guarde o texto até o canal oficial abrir."
  mode="operate"
>
  <div class="space-y-8 max-w-5xl mx-auto">
    <PageHeader
      title="Fala com o CA"
      marker="CA"
      subtitle="Reclamação de ementa, sala sem estrutura, pauta pro Colegiado: escreve aqui. O rascunho fica só no seu celular até o CAGP ter um canal oficial."
      badges={[{ label: 'Proposta 14 da Chapa', variant: 'accent' }]}
      mode="operate"
    />

    {/* Centro Interativo de Manifestações */}
    <section aria-label="Área de Protocolo e Histórico" data-tour="larissa">
      <OuvidoriaInteractiveCenter client:load />
    </section>

    <section aria-labelledby="ouvidoria-depois" class="space-y-4">
      <h2 id="ouvidoria-depois" class="font-heading font-bold text-xl text-foreground m-0">
        O que acontece com o que você escreve
      </h2>
      <ol class="list-none m-0 p-0 grid grid-cols-1 sm:grid-cols-3 gap-4 cagp-reveal-stagger">
        <li class="p-4 rounded-xl border-2 border-border bg-white shadow-md">
          <span class="font-heading font-bold text-3xl text-primary tabular-nums leading-none">1</span>
          <strong class="block font-heading font-bold text-base text-foreground mt-2">Triagem toda semana</strong>
          <span class="block text-sm text-content-secondary mt-1">A Vice-Presidência abre o canal oficial e junta as demandas, sem expor quem mandou.</span>
        </li>
        <li class="p-4 rounded-xl border-2 border-border bg-white shadow-md">
          <span class="font-heading font-bold text-3xl text-primary tabular-nums leading-none">2</span>
          <strong class="block font-heading font-bold text-base text-foreground mt-2">Vira pauta no Colegiado</strong>
          <span class="block text-sm text-content-secondary mt-1">Ementa desatualizada e cobrança irregular vão pra reunião do Colegiado.</span>
        </li>
        <li class="p-4 rounded-xl border-2 border-border bg-white shadow-md">
          <span class="font-heading font-bold text-3xl text-primary tabular-nums leading-none">3</span>
          <strong class="block font-heading font-bold text-base text-foreground mt-2">A gente cobra solução</strong>
          <span class="block text-sm text-content-secondary mt-1">Problema de estrutura vai pra Diretoria da FAFICH e pra Chefia do DCP.</span>
        </li>
      </ol>
      <p class="text-sm text-muted-foreground m-0">É o que a Chapa Semente propõe fazer se for eleita.</p>
    </section>

    <SementeSignature
      proposal="Proposta 14"
      leaderId="larissa"
      text="Fizemos este canal porque CA não pode ser panelinha: a gestão existe pra servir todas as turmas, não só quem conhece alguém da diretoria."
    />
  </div>
</BaseLayout>
