---
// mapa-do-site.astro — Arquitetura de Informação e TreeView Interativo dos 5 Eixos Canônicos e 26 Rotas
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { SitemapTreeViewExplorer } from '../components/features/sitemap/SitemapTreeViewExplorer';
import { AXIS_REGISTRY } from '@/lib/navigationRegistry';
import { route } from '@/lib/paths';

const UTILITY_ROUTES = [
  { label: 'Configurações, Acessibilidade & Cofre', href: route('/configuracoes') },
  { label: 'Mapa do Site Interativo', href: route('/mapa-do-site') },
];

const NORMATIVE_READER_ROUTES = [
  { label: 'Leitor: PPC Gestão Pública 2020', href: route('/documentos/ppc-gestao-publica-ufmg') },
  { label: 'Leitor: Regulamento N-20229', href: route('/documentos/regulamento-gestao-publica-ufmg') },
  { label: 'Leitor: Regimento Interno CAGP 2024', href: route('/documentos/regimento-interno-cagp-ufmg') },
  { label: 'Leitor: Percurso 01-01 (Núcleo Geral)', href: route('/documentos/percurso-bacharelado-nucleo-geral') },
  { label: 'Leitor: Percurso 01-02 (FCA)', href: route('/documentos/percurso-bacharelado-nucleo-complementar') },
  { label: 'Leitor: Percurso 01-03 (Avançado Pós)', href: route('/documentos/percurso-bacharelado-nucleo-avancado') },
  { label: 'Leitor: Ementário Oficial (95 Matérias)', href: route('/documentos/ementario-gestao-publica-ufmg') },
  { label: 'Leitor: Recepção de Ingressantes', href: route('/documentos/transcricao-recepcao-ingressantes-2024-2') },
];

const badges = [
  { label: '5 Eixos Canônicos', variant: 'red' as const, icon: 'bi-diagram-3-fill' },
  { label: '26 Rotas Estáticas & Micro-Apps', variant: 'dark' as const, icon: 'bi-compass-fill' },
  { label: 'Command Palette (⌘K)', variant: 'blue' as const, icon: 'bi-search' },
];
---

<BaseLayout
  title="Mapa do Site & Arquitetura de Informação (26 Rotas)"
  description="Navegação panorâmica e árvore hierárquica interativa dos 5 Eixos Canônicos e 26 rotas do Superapp CAGP UFMG."
>
  <PageHeader
    eyebrow="Eixo 4 · Arquitetura de Informação"
    title="Mapa do Site & Árvore das 26 Rotas"
    subtitle="Explore todas as 26 páginas, calculadoras, leitores normativos e ferramentas da Chapa Semente organizados nos 5 Eixos Canônicos do curso."
    badges={badges}
  />

  <!-- Barra de Busca Instantânea ⌘K -->
  <div class="my-4 p-4 sm:p-5 rounded-2xl border-3 border-[#16181d] bg-[#FFFDF9] shadow-[6px_6px_0_0_#16181d] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <span class="font-mono text-[10px] font-black uppercase tracking-widest text-[#5B2A86] block">
        ATALHO DE TECLADO GLOBAL • COMMAND PALETTE
      </span>
      <h2 class="font-heading text-base sm:text-lg font-black uppercase text-[#16181d] m-0">
        Navegação Instantânea por Qualquer uma das 26 Rotas
      </h2>
      <p class="text-xs text-muted-foreground m-0 font-medium">
        Pressione <kbd class="px-1.5 py-0.5 rounded bg-white border-2 border-[#16181d] font-mono font-bold text-[11px]">⌘K</kbd> ou <kbd class="px-1.5 py-0.5 rounded bg-white border-2 border-[#16181d] font-mono font-bold text-[11px]">Ctrl+K</kbd> a qualquer momento para saltar direto para uma ferramenta, proposta ou PDF.
      </p>
    </div>
    <button
      type="button"
      onclick="window.dispatchEvent(new CustomEvent('cagp:open-spotlight'))"
      class="min-h-[48px] px-5 py-3 rounded-xl bg-[#5B2A86] text-white font-heading font-black text-xs uppercase tracking-wider border-3 border-[#16181d] shadow-[4px_4px_0_0_#FF8811] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-all cursor-pointer inline-flex items-center gap-2.5 shrink-0"
    >
      <i class="bi bi-search" aria-hidden="true"></i>
      <span>Acionar Busca Rápida</span>
      <kbd class="px-2 py-0.5 rounded bg-[#16181d] text-[#FF8811] font-mono text-[11px] font-black border border-white/30">⌘K</kbd>
    </button>
  </div>

  <SitemapTreeViewExplorer client:load />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 my-6" data-context-type="shell">
    {AXIS_REGISTRY.map((axis) => (
      <div class="p-5 rounded-2xl border-3 border-[#16181d] bg-card shadow-[6px_6px_0_0_#16181d] hover:shadow-[8px_8px_0_0_#16181d] hover:-translate-y-0.5 transition-all space-y-3 text-foreground">
        <div class="flex items-center justify-between border-b-2 border-[#16181d] pb-2">
          <span class="font-mono text-xs font-black uppercase text-secondary">
            EIXO {axis.number}
          </span>
          <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded bg-[#f4f0ea] border border-[#16181d]">
            {axis.items.length} Rotas Principais
          </span>
        </div>
        <h3 class="font-heading text-base font-extrabold uppercase text-foreground m-0">
          {axis.name}
        </h3>
        <p class="text-xs text-muted-foreground font-medium m-0">{axis.tagline}</p>
        <ul class="space-y-2 pt-2 list-none p-0 m-0">
          {axis.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between p-2.5 min-h-[44px] rounded-xl border-3 border-[#16181d] bg-white hover:bg-[#FFFBEB] text-xs font-bold text-foreground no-underline shadow-[3px_3px_0_0_#16181d] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[5px_5px_0_0_#16181d] transition-all"
              >
                <span>{item.label}</span>
                <span class="font-mono text-xs font-black text-secondary">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Card 6: As 8 Rotas do Leitor Normativo (/documentos/[slug]) + Rotas Utilitárias = 26 Rotas -->
    <div class="p-5 rounded-2xl border-3 border-[#16181d] bg-[#FFFDF9] shadow-[6px_6px_0_0_#5B2A86] hover:shadow-[8px_8px_0_0_#5B2A86] hover:-translate-y-0.5 transition-all space-y-3 text-foreground">
      <div class="flex items-center justify-between border-b-2 border-[#16181d] pb-2">
        <span class="font-mono text-xs font-black uppercase text-[#5B2A86]">
          LEITOR NORMATIVO &amp; UTILITÁRIOS
        </span>
        <span class="font-mono text-[10px] font-bold px-2 py-0.5 rounded bg-[#5B2A86] text-white border border-[#16181d]">
          10 Rotas Complementares
        </span>
      </div>
      <h3 class="font-heading text-base font-extrabold uppercase text-foreground m-0">
        Transcrições Web &amp; Cofre Local
      </h3>
      <p class="text-xs text-muted-foreground font-medium m-0">
        8 leitores normativos (<code class="font-mono">/documentos/[slug]</code>) + Configurações e Mapa do Site, totalizando as 26 rotas estáticas.
      </p>
      <ul class="space-y-1.5 pt-2 list-none p-0 m-0 max-h-[260px] overflow-y-auto pr-1">
        {NORMATIVE_READER_ROUTES.map((docRoute) => (
          <li>
            <a
              href={docRoute.href}
              class="flex items-center justify-between p-2 min-h-[40px] rounded-xl border-2 border-[#16181d] bg-white hover:bg-[#f4f0ea] text-[11px] font-bold text-foreground no-underline shadow-[2px_2px_0_0_#16181d] transition-all"
            >
              <span class="truncate pr-2">{docRoute.label}</span>
              <span class="font-mono text-xs font-black text-[#5B2A86] shrink-0">→</span>
            </a>
          </li>
        ))}
        {UTILITY_ROUTES.map((u) => (
          <li>
            <a
              href={u.href}
              class="flex items-center justify-between p-2 min-h-[40px] rounded-xl border-2 border-[#16181d] bg-[#FEF3C7] hover:bg-[#FDE68A] text-[11px] font-bold text-[#16181d] no-underline shadow-[2px_2px_0_0_#16181d] transition-all"
            >
              <span>Utilitário: {u.label}</span>
              <span class="font-mono text-xs font-black text-[#16181d] shrink-0">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
