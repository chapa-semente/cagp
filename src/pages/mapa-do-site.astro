---
// mapa-do-site.astro — Arquitetura de Informação e TreeView Interativo dos 5 Eixos Canônicos e 26 Rotas
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { SitemapTreeViewExplorer } from '../components/features/sitemap/SitemapTreeViewExplorer';
import { AXIS_REGISTRY } from '@/lib/navigationRegistry';
import { route } from '@/lib/paths';

const UTILITY_ROUTES = [
  { label: 'Configurações, Acessibilidade & Cofre', href: route('/configuracoes') },
  { label: 'Mapa do Site Interativo', href: route('/mapa-do-site') },
];

const NORMATIVE_READER_ROUTES = [
  { label: 'Leitor: PPC Gestão Pública 2020', href: route('/documentos/ppc-gestao-publica-ufmg') },
  { label: 'Leitor: Regulamento N-20229', href: route('/documentos/regulamento-gestao-publica-ufmg') },
  { label: 'Leitor: Regimento Interno CAGP 2024', href: route('/documentos/regimento-interno-cagp-ufmg') },
  { label: 'Leitor: Percurso 01-01 (Núcleo Geral)', href: route('/documentos/percurso-bacharelado-nucleo-geral') },
  { label: 'Leitor: Percurso 01-02 (FCA)', href: route('/documentos/percurso-bacharelado-nucleo-complementar') },
  { label: 'Leitor: Percurso 01-03 (Avançado Pós)', href: route('/documentos/percurso-bacharelado-nucleo-avancado') },
  { label: 'Leitor: Ementário Oficial (95 Matérias)', href: route('/documentos/ementario-gestao-publica-ufmg') },
  { label: 'Leitor: Recepção de Ingressantes', href: route('/documentos/transcricao-recepcao-ingressantes-2024-2') },
];

const badges = [
  { label: '5 Eixos Canônicos', variant: 'red' as const, icon: 'bi-diagram-3-fill' },
  { label: '26 Rotas Estáticas & Micro-Apps', variant: 'dark' as const, icon: 'bi-compass-fill' },
  { label: 'Command Palette (⌘K)', variant: 'blue' as const, icon: 'bi-search' },
];
---

<BaseLayout
  title="Mapa do Site & Arquitetura de Informação (26 Rotas)"
  description="Navegação panorâmica e árvore hierárquica interativa dos 5 Eixos Canônicos e 26 rotas do Superapp CAGP UFMG."
  mode="operate"
>
  <PageHeader
    title="Mapa do Site & Árvore das 26 Rotas"
    subtitle="Explore todas as 26 páginas, calculadoras, leitores normativos e ferramentas da Chapa Semente organizados nos 5 Eixos Canônicos do curso."
    badges={badges}
    mode="operate"
  />

  <!-- Barra de Busca Instantânea ⌘K -->
  <div class="my-4 p-4 sm:p-5 rounded-2xl border-2 border-[#1F1F1F] bg-[#ffffff] shadow-[6px_6px_0_0_#1F1F1F] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div class="space-y-1">
      <span class="font-mono text-xs font-black uppercase tracking-widest text-[#5B2A85] block">
        ATALHO DE TECLADO GLOBAL • COMMAND PALETTE
      </span>
      <h2 class="font-heading text-base sm:text-lg font-black text-[#1F1F1F] m-0">
        Navegação Instantânea por Qualquer uma das 26 Rotas
      </h2>
      <p class="text-xs text-muted-foreground m-0 font-medium">
        Pressione <kbd class="px-1.5 py-0.5 rounded bg-white border-2 border-[#1F1F1F] font-mono font-bold text-xs">⌘K</kbd> ou <kbd class="px-1.5 py-0.5 rounded bg-white border-2 border-[#1F1F1F] font-mono font-bold text-xs">Ctrl+K</kbd> a qualquer momento para saltar direto para uma ferramenta, proposta ou PDF.
      </p>
    </div>
    <button
      type="button"
      onclick="window.dispatchEvent(new CustomEvent('cagp:open-spotlight'))"
      class="min-h-[48px] px-5 py-3 rounded-xl bg-[#5B2A85] text-white font-heading font-black text-xs uppercase tracking-wider border-3 border-[#1F1F1F] shadow-[3px_3px_0_0_#1F1F1F] hover:translate-x-[-2px] hover:translate-y-[-2px] transition-all cursor-pointer inline-flex items-center gap-2.5 shrink-0"
    >
      <i class="bi bi-search" aria-hidden="true"></i>
      <span>Acionar Busca Rápida</span>
      <kbd class="px-2 py-0.5 rounded bg-[#1F1F1F] text-[#FE8812] font-mono text-xs font-black border border-white/30">⌘K</kbd>
    </button>
  </div>

  <SitemapTreeViewExplorer client:load />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 my-6" data-context-type="shell">
    {AXIS_REGISTRY.map((axis) => (
      <div class="p-5 rounded-2xl border-2 border-[#1F1F1F] bg-card shadow-[6px_6px_0_0_#1F1F1F] hover:shadow-[8px_8px_0_0_#1F1F1F] hover:-translate-y-0.5 transition-all space-y-3 text-foreground">
        <div class="flex items-center justify-between border-b-2 border-[#1F1F1F] pb-2">
          <span class="font-mono text-xs font-black uppercase text-secondary">
            EIXO {axis.number}
          </span>
          <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-[#F4F2EC] border border-[#1F1F1F]">
            {axis.items.length} Rotas Principais
          </span>
        </div>
        <h3 class="font-heading text-base font-extrabold text-foreground m-0">
          {axis.name}
        </h3>
        <p class="text-xs text-muted-foreground font-medium m-0">{axis.tagline}</p>
        <ul class="space-y-2 pt-2 list-none p-0 m-0">
          {axis.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between p-2.5 min-h-[44px] rounded-xl border-3 border-[#1F1F1F] bg-white hover:bg-[#FFFBEB] text-xs font-bold text-foreground no-underline shadow-[3px_3px_0_0_#1F1F1F] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[5px_5px_0_0_#1F1F1F] transition-all"
              >
                <span>{item.label}</span>
                <span class="font-mono text-xs font-black text-secondary">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}

    <!-- Card 6: As 8 Rotas do Leitor Normativo (/documentos/[slug]) + Rotas Utilitárias = 26 Rotas -->
    <div class="p-5 rounded-2xl border-2 border-[#1F1F1F] bg-[#ffffff] shadow-[6px_6px_0_0_#5B2A85] hover:shadow-[8px_8px_0_0_#5B2A85] hover:-translate-y-0.5 transition-all space-y-3 text-foreground">
      <div class="flex items-center justify-between border-b-2 border-[#1F1F1F] pb-2">
        <span class="font-mono text-xs font-black uppercase text-[#5B2A85]">
          LEITOR NORMATIVO &amp; UTILITÁRIOS
        </span>
        <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-[#5B2A85] text-white border border-[#1F1F1F]">
          10 Rotas Complementares
        </span>
      </div>
      <h3 class="font-heading text-base font-extrabold text-foreground m-0">
        Transcrições Web &amp; Cofre Local
      </h3>
      <p class="text-xs text-muted-foreground font-medium m-0">
        8 leitores normativos (<code class="font-mono">/documentos/[slug]</code>) + Configurações e Mapa do Site, totalizando as 26 rotas estáticas.
      </p>
      <ul class="space-y-1.5 pt-2 list-none p-0 m-0 max-h-[260px] overflow-y-auto pr-1">
        {NORMATIVE_READER_ROUTES.map((docRoute) => (
          <li>
            <a
              href={docRoute.href}
              class="flex items-center justify-between p-2 min-h-[40px] rounded-xl border-2 border-[#1F1F1F] bg-white hover:bg-[#F4F2EC] text-xs font-bold text-foreground no-underline shadow-[2px_2px_0_0_#1F1F1F] transition-all"
            >
              <span class="truncate pr-2">{docRoute.label}</span>
              <span class="font-mono text-xs font-black text-[#5B2A85] shrink-0">→</span>
            </a>
          </li>
        ))}
        {UTILITY_ROUTES.map((u) => (
          <li>
            <a
              href={u.href}
              class="flex items-center justify-between p-2 min-h-[40px] rounded-xl border-2 border-[#1F1F1F] bg-[#FEF3C7] hover:bg-[#FDE68A] text-xs font-bold text-[#1F1F1F] no-underline shadow-[2px_2px_0_0_#1F1F1F] transition-all"
            >
              <span>Utilitário: {u.label}</span>
              <span class="font-mono text-xs font-black text-[#1F1F1F] shrink-0">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>
