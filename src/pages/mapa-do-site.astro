---
// mapa-do-site.astro - Redirecionamento canônico para FAQ e Busca Rápida
import BaseLayout from '../layouts/BaseLayout.astro';
import { route } from '../lib/paths';

const targetUrl = route('/faq');
---

<BaseLayout
  title="Redirecionando para Central de Dúvidas & FAQ..."
  description="A navegação panorâmica foi integrada ao Spotlight (⌘K) e ao Guia de Perguntas Frequentes em /faq."
>
  <div class="py-16 text-center space-y-5 max-w-lg mx-auto font-body">
    <div class="p-8 bg-white border-[3px] border-[#0A0A0A] rounded-xl shadow-[4px_4px_0_0_#0A0A0A] space-y-4">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-xl bg-[#FBF8F3] text-[#8B1E2D] border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-2xl">
        <i class="bi bi-compass-fill" aria-hidden="true"></i>
      </div>
      <h1 class="font-head text-2xl uppercase font-extrabold text-[#0A0A0A] m-0 tracking-tight">
        Navegação Panorâmica Integrada
      </h1>
      <p class="text-sm text-[#0A0A0A] leading-relaxed font-medium m-0">
        Todas as seções do portal estão indexadas na <strong>Busca Rápida</strong> (atalho <code class="font-mono bg-[#FBF8F3] px-1 py-0.5 rounded border border-[#0A0A0A]">⌘K</code>) e na <strong>Central de Dúvidas &amp; FAQ</strong> em <code class="font-mono bg-[#FBF8F3] px-1 py-0.5 rounded border border-[#0A0A0A]">/faq</code>.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-3 pt-3 border-t-2 border-[#0A0A0A]">
        <a
          href={targetUrl}
          class="min-h-[44px] px-4 py-2.5 bg-[#8B1E2D] hover:bg-[#9E2424] text-white font-head font-bold uppercase text-xs tracking-wider border-2 border-[#0A0A0A] rounded-xl shadow-[3px_3px_0_0_#0A0A0A] hover:shadow-[4px_4px_0_0_#0A0A0A] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
        >
          <span>Acessar FAQ Geral</span>
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </a>
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('cagp:open-spotlight'))"
          class="min-h-[44px] px-4 py-2.5 bg-white hover:bg-[#FBF8F3] text-[#0A0A0A] font-head font-bold uppercase text-xs tracking-wider border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A] hover:shadow-[3px_3px_0_0_#0A0A0A] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none inline-flex items-center gap-2 transition-all cursor-pointer"
        >
          <i class="bi bi-search" aria-hidden="true"></i>
          <span>Abrir Busca (⌘K)</span>
        </button>
      </div>
    </div>
  </div>

  <script is:inline define:vars={{ targetUrl }}>
    window.location.replace(targetUrl);
  </script>
</BaseLayout>
