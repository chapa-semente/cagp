---
// mapa-do-site.astro — Arquitetura de Informação e TreeView Interativo dos 5 Eixos Canônicos
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import { SitemapTreeViewExplorer } from '../components/features/sitemap/SitemapTreeViewExplorer';
import { AXIS_REGISTRY } from '../lib/navigationRegistry';

const badges = [
  { label: '5 Eixos Canônicos', variant: 'red' as const, icon: 'bi-diagram-3-fill' },
  { label: '20 Rotas & Micro-Apps', variant: 'dark' as const, icon: 'bi-compass-fill' },
  { label: 'Command Palette (⌘K)', variant: 'blue' as const, icon: 'bi-search' },
];
---

<BaseLayout
  title="Mapa do Site & Arquitetura de Informação"
  description="Navegação panorâmica e árvore hierárquica interativa dos 5 Eixos Canônicos e 20 páginas do Superapp CAGP UFMG."
>
  <PageHeader
    eyebrow="Eixo 4 · Arquitetura de Informação"
    title="Mapa do Site & Árvore de Rotas"
    subtitle="Explore todas as páginas, calculadoras, repositórios de documentos e portais oficiais da UFMG organizados nos 5 Eixos Canônicos do curso."
    badges={badges}
  />

  <SitemapTreeViewExplorer client:load />

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 my-6">
    {AXIS_REGISTRY.map((axis) => (
      <div class="p-5 rounded-xl border-3 border-[#16181d] bg-white shadow-[4px_4px_0px_#16181d] space-y-3">
        <div class="flex items-center justify-between border-b-2 border-[#16181d] pb-2">
          <span class="font-mono text-xs font-black uppercase text-[#9E2424]">
            EIXO {axis.number}
          </span>
          <span class="font-mono text-[10px] font-bold text-[#57534E]">
            {axis.items.length} Rotas
          </span>
        </div>
        <h3 class="font-heading text-base font-black uppercase text-[#16181d]">
          {axis.name}
        </h3>
        <p class="text-xs text-[#57534E] font-medium">{axis.tagline}</p>
        <ul class="space-y-1.5 pt-2 list-none p-0 m-0">
          {axis.items.map((item) => (
            <li>
              <a
                href={item.href}
                class="flex items-center justify-between p-2 rounded-lg border-2 border-[#16181d] bg-[#f4f5f7] hover:bg-[#FFFDF9] text-xs font-bold text-[#16181d] no-underline shadow-[2px_2px_0px_#16181d]"
              >
                <span>{item.label}</span>
                <span class="font-mono text-[10px] text-[#9E2424]">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</BaseLayout>
