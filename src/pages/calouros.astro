---
// calouros.astro — Central de Acolhimento & Guia de Sobrevivência do Calouro (1º Período)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import JourneyNav from '../components/ui/JourneyNav.astro';
import CalouroCentralOverview from '../components/features/calouros/CalouroCentralOverview.astro';
import { CalouroChecklistCore } from '../components/features/calouros/checklist/CalouroChecklistCore';
import CalourosVideos from '../components/features/calouros/CalourosVideos.astro';
import CalouroEspacosCore from '../components/features/calouros/espacos/CalouroEspacosCore.astro';

const tabs = [
  { id: 'v0', shortLabel: 'Geral', fullLabel: 'Visão Geral & Primeiros 30 Dias', hash: '#visao-geral' },
  { id: 'v1', shortLabel: 'Checklist', fullLabel: '1. Checklist Interativo & Vídeos', hash: '#checklist' },
  { id: 'v2', shortLabel: 'Espaços', fullLabel: '2. Salas & Espaços FAFICH', hash: '#espacos' },
];

const badges = [
  { label: 'Turno Noturno 19h–22h30', variant: 'red' as const, icon: 'bi-moon-stars-fill' },
  { label: 'Jantar RU II 17h10–19h30', variant: 'dark' as const, icon: 'bi-cup-hot-fill' },
  { label: 'Circulares até 22h45', variant: 'green' as const, icon: 'bi-bus-front' },
  { label: 'CEAG FAFICH 08h–22h', variant: 'blue' as const, icon: 'bi-building' },
];
---

<BaseLayout
  title="Guia de Sobrevivência do Calouro"
  description="Checklist interativo dos primeiros 30 dias na UFMG, rotina noturna, jantar no RU II às 18h15, circulares gratuitos, secretaria Sala F-2039 e suporte FUMP."
  mode="operate"
>
  <PageHeader
    title="Guia de Sobrevivência do Calouro"
    subtitle="Checklist interativo dos primeiros 30 dias, salas da FAFICH (F-4000 e F-2039), rotina noturna, emissão de carteirinha e acolhimento direto pelo CAGP."
    badges={badges}
    axisId="curso"
    activeId="calouros"
    mode="operate"
    showAxisNav={false}
    condensed={true}
  />

  <SegmentedControl tabs={tabs} defaultTab="v0" />

  <!-- Sub-view 0: Visão Geral do Calouro (Recepção e Primeiros 30 Dias com Foco Linear) -->
  <section id="ws-panel-v0" class="cagp-workspace-view relative overflow-hidden space-y-6" data-ws-panel="v0" data-context-type="checklist">
    <div id="visao-geral" class="cagp-anchor-target scroll-mt-24"></div>
    <CalouroCentralOverview />
  </section>

  <!-- Sub-view 1: Checklist & Tutoriais em Vídeo -->
  <section id="ws-panel-v1" class="cagp-workspace-view space-y-4" data-ws-panel="v1" data-context-type="checklist" hidden>
    <div id="checklist" class="cagp-anchor-target scroll-mt-24"></div>
    <CalouroChecklistCore client:load />
    <CalourosVideos />
  </section>

  <!-- Sub-view 2: Espaços FAFICH -->
  <section id="ws-panel-v2" class="cagp-workspace-view" data-ws-panel="v2" hidden>
    <div id="espacos" class="cagp-anchor-target scroll-mt-24"></div>
    <CalouroEspacosCore />
  </section>

  <!-- Journey Navigation Trail -->
  <JourneyNav
    prev={{
      title: 'O Bacharelado em Gestão Pública',
      href: '/curso',
      desc: 'História, colegiado, secretaria Sala F-2039 e formas de ingresso.',
    }}
    next={{
      title: 'Permanência Estudantil & Assistência FUMP',
      href: '/permanencia',
      desc: 'Regras dos Níveis I a III da FUMP, simulador mensal e apoio ao estudante noturno.',
    }}
  />
</BaseLayout>
