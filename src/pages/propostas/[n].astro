---
// /propostas/<n> — Uma proposta por endereço (decisão de 11/11/2026).
// A âncora #proposta-7 da página da chapa não tem prévia própria: rede social ignora o que vem depois
// do #. Aqui cada proposta tem o seu banner (public/og/proposta-<n>.jpg) e a sua página.
// Volume Cartaz. Título, compromisso, quem puxa e a fala vêm de src/lib/propostasTour.ts (fala literal
// do briefing); o texto integral, da carta-programa (CartaPropostaInteractive › CARTA_PROPOSTAS_DATA).
import BaseLayout from '@/layouts/BaseLayout.astro';
import BotaoCompartilhar from '@/components/ui/BotaoCompartilhar.astro';
import { CARTA_PROPOSTAS_DATA } from '@/components/features/semente/CartaPropostaInteractive';
import { CHAPA_LEADERS, CHAPA_ROTULO, getLeaderPhotoUrl } from '@/lib/chapaSementeData';
import { PROPOSTA_EIXOS, PROPOSTA_STOPS } from '@/lib/propostasTour';
import { previaDaProposta } from '@/lib/previas';
import { planoDaProposta, resumoExecucaoDaProposta } from '@/lib/planoExecucao';
import { PLANO_FUMP_40 } from '@/lib/planoResumoData';
import PlanoDaProposta from '@/components/features/semente/PlanoDaProposta.astro';
import { asset, route } from '@/lib/paths';
import '@/styles/campanha-detalhe.css';

export function getStaticPaths() {
  return PROPOSTA_STOPS.map((proposta) => ({ params: { n: String(proposta.id) }, props: { proposta } }));
}

const { proposta } = Astro.props;
const total = PROPOSTA_STOPS.length;
const carta = CARTA_PROPOSTAS_DATA.find((c) => c.id === proposta.id)!;
const eixo = PROPOSTA_EIXOS.find((e) => e.id === carta.eixoId)!;
const pessoa = CHAPA_LEADERS.find((l) => l.id === proposta.leaderId)!;
const foto = getLeaderPhotoUrl(pessoa.photoFilename, 'thumb');
const previa = previaDaProposta(proposta);
// O plano de execução da proposta (19/11/2026): datas, custo, quem responde e plano B na frente.
const plano = planoDaProposta(proposta.id);
const resumo = resumoExecucaoDaProposta(proposta.id);
const anterior = PROPOSTA_STOPS.find((p) => p.id === proposta.id - 1);
const proxima = PROPOSTA_STOPS.find((p) => p.id === proposta.id + 1);
// Tom chapado mais fundo de cada eixo, para a folha de fundo (o mesmo dos banners).
const FUNDO: Record<number, string> = { 1: '#733C20', 2: '#5CA032', 3: '#1D5052', 4: '#F5B41F' };
const tituloHero = resumo?.tituloPlano ?? proposta.titulo;
const ledeHero = resumo?.impacto ?? proposta.compromisso;
const seloHero = proposta.id === 3 ? 'Já entregue: é este site' : proposta.jaFeito?.selo ?? resumo?.selo ?? '';
const legenda = [
  `Proposta ${proposta.id} de ${total}: ${tituloHero}.`,
  '',
  ledeHero,
  '',
  `As ${total} propostas e o plano completo estão no link da bio.`,
  'Eleição do CAGP: 25 e 26/11, das 17h às 22h30, na sala do CAGP (FAFICH).',
  '',
  '#GestãoPúblicaUFMG #CAGP #ChapaSemente #Chapa2',
].join('\n');
---

<BaseLayout
  mode="persuade"
  hideFloatingPill
  title={`Proposta ${proposta.id}: ${tituloHero}`}
  description={previa.descricao}
>
  <div class="cd-page">
    <section
      class="cd-hero"
      aria-labelledby="cd-titulo"
      style={`--cd-bg:${eixo.bg};--cd-fg:${eixo.fg};--cd-fundo:${FUNDO[eixo.id]}`}
    >
      <svg class="cd-hero-folha" viewBox="-46 -110 72 118" aria-hidden="true"><use href="#sg-folha"></use></svg>
      <div class="cd-hero-topo">
        <p class="sk-chapa-num m-0" aria-hidden="true">
          <span class="sk-chapa-num-rotulo">Nº</span>
          <span class="sk-chapa-num-n">{proposta.id}</span>
        </p>
        <div class="cd-hero-selos">
          <span class="cd-etiqueta">Proposta {proposta.id} de {total} · {eixo.nome}</span>
          {seloHero && <span class="sk-adesivo">{seloHero}</span>}
          {resumo?.custo && (
            <span class="cd-etiqueta tabular-nums">Custo: {resumo.custo}</span>
          )}
        </div>
      </div>

      <div class="cd-hero-texto">
        <h1 id="cd-titulo" class="cd-titulo">{tituloHero}</h1>
        <p class="cd-lede">{ledeHero}</p>
        {resumo?.primeiraEntrega && (
          <p class="cd-hero-entrega tabular-nums">
            <strong>1ª entrega ({resumo.primeiraData}):</strong> {resumo.primeiraEntrega}
          </p>
        )}
      </div>

      <div class="cd-acoes">
        {plano && (
          <a href="#plano" class="sk-btn sk-btn-folha">
            <i class="bi bi-calendar-check" aria-hidden="true"></i>
            Cronograma e plano B
          </a>
        )}
        <BotaoCompartilhar corpo={previa.mensagem} tom="convite" titulo={previa.titulo} rotulo="Mandar essa proposta" />
        {proposta.prova && (
          <a href={route(proposta.prova.href)} class="sk-btn">
            {proposta.prova.label}
            {proposta.prova.simulado && <span class="cagp-sticker-simulado">Simulado</span>}
          </a>
        )}
      </div>
    </section>

    {/* O plano de execução vem imediatamente após o topo (modo Persuade) */}
    {plano && <PlanoDaProposta plano={plano} semCabecaDuplicada />}

    {proposta.jaFeito && (
      <section class="cd-ficha cd-feito" aria-labelledby="cd-feito">
        <h2 id="cd-feito" class="cd-feito-selo">{proposta.jaFeito.selo}</h2>
        <p class="cd-citacao">{proposta.jaFeito.texto}</p>
      </section>
    )}

    <section class="cd-ficha cd-fala" aria-label={`Quem puxa esta proposta: ${pessoa.name}`}>
      {foto && <img src={foto} alt="" width="72" height="72" class="cd-avatar" loading="lazy" decoding="async" />}
      <div class="min-w-0">
        <p class="cd-citacao">{proposta.porque}</p>
        <p class="cd-fala-quem">
          <a href={route(`/chapa-semente/${pessoa.id}`)}>{pessoa.name}</a> · {pessoa.role}
        </p>
      </div>
    </section>

    {proposta.id === 7 && (
      <section class="cagp-folha space-y-3" aria-labelledby="cd-fump-40">
        <div class="flex flex-wrap items-center gap-2">
          <span class="sk-adesivo tabular-nums">{PLANO_FUMP_40.desconto} FUMP</span>
          <h2 id="cd-fump-40" class="cd-h2">{PLANO_FUMP_40.titulo}</h2>
        </div>
        <ul class="m-0 pl-5 space-y-1.5 text-sm leading-relaxed text-foreground">
          <li>{PLANO_FUMP_40.publico}</li>
          <li class="tabular-nums">{PLANO_FUMP_40.teto}</li>
          <li>{PLANO_FUMP_40.prioridade}</li>
          <li>{PLANO_FUMP_40.conferencia}</li>
          <li>{PLANO_FUMP_40.transparencia}</li>
        </ul>
      </section>
    )}

    <section class="cagp-folha" aria-labelledby="cd-carta">
      <details class="cd-carta-recolhida">
        <summary id="cd-carta">
          <span>Ver texto original da carta-programa ({carta.title})</span>
          <i class="bi bi-chevron-down text-sm shrink-0" aria-hidden="true"></i>
        </summary>
        <div class="cd-carta-corpo">
          <p class="cd-texto">{carta.fullText}</p>
          <a href={route('/chapa-semente') + '#carta'} class="cd-link">Ver todas as {total} fichas</a>
        </div>
      </details>
    </section>

    <section class="cd-ficha cd-kit" aria-labelledby="cd-kit">
      <img
        src={asset(`/og/kit/feed-proposta-${proposta.id}.jpg`)}
        alt={`Arte da proposta ${proposta.id} para o feed: ${tituloHero}`}
        width="1080"
        height="1350"
        class="cd-kit-arte"
        loading="lazy"
        decoding="async"
      />
      <div class="cd-secao">
        <h2 id="cd-kit" class="cd-h2">Quer postar esta proposta?</h2>
        <p class="cd-texto">A arte já vem no tamanho do feed do Instagram. A legenda sai pronta, é só colar.</p>
        <div class="cd-acoes">
          <a href={asset(`/og/kit/feed-proposta-${proposta.id}.jpg`)} download={`semente-proposta-${proposta.id}.jpg`} class="sk-btn sk-btn-roxo">
            <i class="bi bi-download" aria-hidden="true"></i>
            Baixar a arte
          </a>
          <button type="button" class="sk-btn" data-copiar-mensagem data-texto={legenda}>
            <i class="bi bi-clipboard" aria-hidden="true"></i>
            Copiar a legenda
          </button>
        </div>
      </div>
    </section>

    <nav class="cd-salto" aria-label="Ir direto para outra proposta">
      <span class="cd-salto-rotulo">Ir direto:</span>
      <ul class="cd-salto-lista" role="list">
        {PROPOSTA_STOPS.map((p) => {
          const ativa = p.id === proposta.id;
          return (
            <li>
              <a
                href={route(`/propostas/${p.id}`)}
                class="cd-salto-btn"
                aria-current={ativa ? 'page' : undefined}
                aria-label={`Proposta ${p.id}: ${p.titulo}`}
              >
                {p.id}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <nav class="cd-vizinhos" aria-label="Proposta anterior e próxima">
      {anterior ? (
        <a href={route(`/propostas/${anterior.id}`)} class="cd-vizinho">
          <small>Proposta {anterior.id}</small>
          <b>{anterior.titulo}</b>
        </a>
      ) : <span></span>}
      {proxima && (
        <a href={route(`/propostas/${proxima.id}`)} class="cd-vizinho cd-vizinho-dir">
          <small>Proposta {proxima.id}</small>
          <b>{proxima.titulo}</b>
        </a>
      )}
    </nav>

  </div>
</BaseLayout>
