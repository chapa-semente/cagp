---
// [slug].astro - Leitor Editorial Apple HIG + Neo-brutalista de Transcrições Oficiais
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { asset, route } from '@/lib/paths';
import { Attachment } from '@/components/ui/attachment';
import NormativeDetails from '@/components/ui/NormativeDetails.astro';

// Metadados canônicos mapeados por slug
const DOC_METADATA: Record<string, {
  title: string;
  pdf: string;
  orgao: string;
  ano: string;
  badge: string;
  badgeVariant: 'red' | 'dark' | 'blue' | 'green' | 'gold';
  icon: string;
}> = {
  'ppc-gestao-publica-ufmg': {
    title: 'Projeto Pedagógico do Curso de Gestão Pública (PPC 2020)',
    pdf: 'ppc-gestao-publica-ufmg.pdf',
    orgao: 'Colegiado de Gestão Pública / FAFICH / UFMG',
    ano: '2020 (Aprov. Câmara 2021 / Assin. PROGRAD 2023)',
    badge: 'Documento Mestre',
    badgeVariant: 'red',
    icon: 'bi-book-half',
  },
  'regulamento-gestao-publica-ufmg': {
    title: 'Regulamento do Curso de Graduação em Gestão Pública (Versão N-20229)',
    pdf: 'regulamento-gestao-publica-ufmg.pdf',
    orgao: 'Câmara de Graduação / Colegiado FAFICH',
    ano: 'Versão N-20229 Vigente',
    badge: 'Norma Vigente',
    badgeVariant: 'dark',
    icon: 'bi-file-earmark-check-fill',
  },
  'regimento-interno-cagp-ufmg': {
    title: 'Regimento Interno do Centro Acadêmico de Gestão Pública (CAGP)',
    pdf: 'regimento-interno-cagp-ufmg.pdf',
    orgao: 'Assembleia Geral Discente do CAGP',
    ano: '14 de Outubro de 2024',
    badge: 'Entidade Discente',
    badgeVariant: 'blue',
    icon: 'bi-people-fill',
  },
  'percurso-bacharelado-nucleo-geral': {
    title: 'Relatório de Percurso Curricular — Bacharelado / Núcleo Geral (01-01)',
    pdf: 'percurso-bacharelado-nucleo-geral.pdf',
    orgao: 'Pró-reitoria de Graduação (PROGRAD / DRCA / UFMG)',
    ano: 'Identificador 01-01 • Versão N-20229',
    badge: 'Percurso 01-01 Padrão',
    badgeVariant: 'green',
    icon: 'bi-diagram-3-fill',
  },
  'percurso-bacharelado-nucleo-complementar': {
    title: 'Relatório de Percurso Curricular — Núcleo Geral + Complementar (01-02)',
    pdf: 'percurso-bacharelado-nucleo-complementar.pdf',
    orgao: 'Pró-reitoria de Graduação (PROGRAD / DRCA / UFMG)',
    ano: 'Identificador 01-02 • Formação Complementar Aberta',
    badge: 'Percurso 01-02 FCA',
    badgeVariant: 'green',
    icon: 'bi-diagram-3-fill',
  },
  'percurso-bacharelado-nucleo-avancado': {
    title: 'Relatório de Percurso Curricular — Núcleo Geral + Avançado Pós (01-03)',
    pdf: 'percurso-bacharelado-nucleo-avancado.pdf',
    orgao: 'Pró-reitoria de Graduação (PROGRAD / DRCA / UFMG)',
    ano: 'Identificador 01-03 • Pós-graduação PPGCP',
    badge: 'Percurso 01-03 Pós',
    badgeVariant: 'green',
    icon: 'bi-diagram-3-fill',
  },
  'ementario-gestao-publica-ufmg': {
    title: 'Ementário Oficial do Curso de Gestão Pública (27 Obrigatórias + 68 Optativas)',
    pdf: 'ementario-gestao-publica-ufmg.pdf',
    orgao: 'Departamento de Ciência Política (DCP / FAFICH / UFMG)',
    ano: 'Apêndice 2 do PPC 2020',
    badge: 'Catálogo de Ementas',
    badgeVariant: 'gold',
    icon: 'bi-card-text',
  },
  'transcricao-recepcao-ingressantes-2024-2': {
    title: 'Transcrição da Palestra de Recepção de Ingressantes 2024/2',
    pdf: 'recepcao-ingressantes-2024-2.pdf',
    orgao: 'Coordenação do Curso / Profª Ana Paula Karruz',
    ano: 'Semestre 2024/2 • Apresentação em 49 Slides',
    badge: 'Guia do Calouro',
    badgeVariant: 'blue',
    icon: 'bi-mortarboard-fill',
  },
};

export async function getStaticPaths() {
  const allowed = new Set([
    'ppc-gestao-publica-ufmg',
    'regulamento-gestao-publica-ufmg',
    'regimento-interno-cagp-ufmg',
    'percurso-bacharelado-nucleo-geral',
    'percurso-bacharelado-nucleo-complementar',
    'percurso-bacharelado-nucleo-avancado',
    'ementario-gestao-publica-ufmg',
    'transcricao-recepcao-ingressantes-2024-2',
  ]);
  const docs = await getCollection('documentosOficiais');
  return docs
    .filter((doc) => allowed.has(doc.id.replace(/\.md$/, '')))
    .map((doc) => ({
      params: { slug: doc.id.replace(/\.md$/, '') },
      props: { doc },
    }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);

const slugKey = doc.id.replace(/\.md$/, '');
const meta = DOC_METADATA[slugKey] || {
  title: doc.data.titulo || doc.data.title || slugKey,
  pdf: `${slugKey}.pdf`,
  orgao: 'Colegiado de Gestão Pública / FAFICH / UFMG',
  ano: 'Oficial UFMG',
  badge: 'Documento Oficial',
  badgeVariant: 'dark' as const,
  icon: 'bi-file-earmark-text',
};

// Filtrar headings relevantes para o sumário (h1, h2, h3)
const filteredHeadings = headings.filter((h) => h.depth >= 1 && h.depth <= 3 && h.text.trim().length > 0);
---

<BaseLayout
  title={`${meta.title} — Transcrição Oficial`}
  description={`Transcrição completa do documento oficial "${meta.title}" do curso de Gestão Pública UFMG com download do PDF assinado.`}
  mode="read"
>
  <!-- Barra de Progresso de Leitura Superior -->
  <div id="cagp-reading-progress" class="fixed top-0 left-0 h-[3px] bg-secondary z-50 transition-all duration-75 w-0" aria-hidden="true"></div>

  <!-- Cabeçalho de Navegação e Metadados -->
  <div class="mb-4 space-y-3">
    <!-- Breadcrumbs & Voltar -->
    <div class="flex items-center justify-between flex-wrap gap-2 text-xs">
      <nav aria-label="Trilha de navegação" class="flex items-center gap-1.5 text-gray-600 font-mono">
        <a href={route('/')} class="hover:text-secondary underline">Início</a>
        <span>/</span>
        <a href={route('/documentos')} class="hover:text-secondary underline">Acervo de Documentos</a>
        <span>/</span>
        <span class="text-foreground font-bold truncate max-w-[200px] sm:max-w-[400px]">{meta.badge}</span>
      </nav>

      <a
        href={route('/documentos')}
        class="inline-flex items-center gap-1.5 font-head font-extrabold uppercase text-xs text-secondary hover:underline"
      >
        <i class="bi bi-arrow-left" aria-hidden="true"></i> Voltar ao Acervo
      </a>
    </div>

    <!-- Card de Cabeçalho do Documento -->
    <header class="p-5 sm:p-6 bg-card border-3 border-border rounded-xl shadow-md space-y-4 text-foreground" data-context-type="doc-template">
      <div class="flex items-start justify-between gap-3 flex-wrap sm:flex-nowrap">
        <div class="space-y-1.5 min-w-0">
          <div class="flex items-center gap-2 flex-wrap">
            <span class={`cagp-badge cagp-badge-${meta.badgeVariant} font-mono text-xs uppercase font-bold inline-flex items-center gap-1`}>
              <i class={`bi ${meta.icon}`} aria-hidden="true"></i> {meta.badge}
            </span>
            <span class="text-xs font-mono text-muted-foreground font-bold">{meta.ano}</span>
          </div>

          <h1 class="font-head font-black text-xl sm:text-2xl uppercase tracking-wide text-foreground leading-tight m-0">
            {meta.title}
          </h1>

          <p class="text-xs text-gray-700 flex items-center gap-1.5 font-body font-medium m-0">
            <i class="bi bi-bank" aria-hidden="true"></i>
            <span>Órgão Emissor: <strong>{meta.orgao}</strong></span>
          </p>
        </div>

        <!-- Download do PDF Assinado com Primitiva Attachment (Borda 3px + Sombra 4px) -->
        <div class="shrink-0 self-start">
          <Attachment
            client:load
            name={meta.pdf}
            type="application/pdf"
            href={asset(`/documentos/${meta.pdf}`)}
            className="w-full sm:w-[270px] bg-white border-3 border-[#16181d] shadow-[4px_4px_0_0_#16181d] text-foreground"
          />
        </div>
      </div>

      <!-- Alerta Institucional de Fé Pública com Primitiva NormativeDetails -->
      <NormativeDetails
        title="Fé Pública e Validade Jurídica do Documento Oficial"
        badge="Regimental"
        icon="bi-shield-check"
        open={false}
      >
        <p class="leading-relaxed m-0 font-body text-xs text-foreground font-medium">
          <strong>Fé Pública e Validade Jurídica:</strong> Esta transcrição digital em Markdown destina-se à consulta rápida, acessibilidade e busca textual. Em processos administrativos no SEI/UFMG e comprovação regimental, <strong>o PDF oficial assinado prevalece integralmente</strong>.
        </p>
      </NormativeDetails>
    </header>
  </div>

  <!-- Layout Principal de Leitura: Conteúdo + Sumário Sticky -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    <!-- Sumário Recolhível em Gaveta no Mobile (visível em telas pequenas e tablets) -->
    {filteredHeadings.length > 0 && (
      <div class="lg:hidden sticky top-16 z-30 cagp-card bg-[#FFFDF9] border-3 border-[#16181d] rounded-xl shadow-[4px_4px_0_0_#16181d] overflow-hidden">
        <details class="group">
          <summary class="cursor-pointer font-head font-black uppercase text-xs text-[#16181d] flex items-center justify-between min-h-[48px] py-3.5 px-4 tracking-wide list-none bg-[#FFFDF9] hover:bg-[#f4f0ea]">
            <span class="flex items-center gap-2">
              <i class="bi bi-layout-sidebar-inset text-secondary text-sm" aria-hidden="true"></i>
              <span>Gaveta de Sumário Normativo ({filteredHeadings.length} seções)</span>
            </span>
            <span class="px-2 py-0.5 rounded bg-[#16181d] text-white font-mono text-[10px] group-open:bg-[#9E2424] transition-colors">
              ABRIR / FECHAR
            </span>
          </summary>
          <nav class="p-3 border-t-2 border-[#16181d] bg-white space-y-1 max-h-64 overflow-y-auto text-xs font-body font-medium">
            {filteredHeadings.map((h) => (
              <a
                href={`#${h.slug}`}
                class={`block py-1.5 px-2 rounded-lg hover:bg-[#f4f0ea] hover:text-secondary transition-colors truncate ${h.depth === 1 ? 'font-bold text-foreground' : h.depth === 2 ? 'pl-3 text-gray-700' : 'pl-5 text-gray-500'}`}
              >
                {h.text}
              </a>
            ))}
          </nav>
        </details>
      </div>
    )}

    <!-- Corpo do Artigo / Documento Transcrito -->
    <main class="lg:col-span-8 xl:col-span-9 bg-white border-3 border-border rounded-xl shadow-md p-5 sm:p-7 lg:p-9 min-w-0">
      <article class="cagp-doc-reader prose prose-sm sm:prose-base lg:prose-lg max-w-[72ch] mx-auto text-foreground leading-relaxed">
        <Content />
      </article>

      <!-- Rodapé do Leitor -->
      <footer class="mt-8 pt-4 border-t-2 border-border flex items-center justify-between flex-wrap gap-3 text-xs text-gray-700">
        <span class="font-mono font-bold">Fonte: Centro Acadêmico de Gestão Pública (CAGP UFMG)</span>
        <div class="flex items-center gap-2">
          <a href="#top" class="font-head font-bold uppercase text-secondary hover:underline inline-flex items-center gap-1 tracking-wide">
            <i class="bi bi-arrow-up" aria-hidden="true"></i> Voltar ao Topo
          </a>
          <span>•</span>
          <a href={asset(`/documentos/${meta.pdf}`)} download class="font-head font-bold uppercase text-secondary hover:underline inline-flex items-center gap-1 tracking-wide">
            <i class="bi bi-download" aria-hidden="true"></i> Baixar PDF
          </a>
        </div>
      </footer>
    </main>

    <!-- Barra Lateral Sticky: Sumário do Documento (Desktop) -->
    {filteredHeadings.length > 0 && (
      <aside class="hidden lg:block lg:col-span-4 xl:col-span-3 sticky top-20 max-h-[calc(100dvh-6rem)] overflow-y-auto cagp-card p-4 bg-white border-3 border-border rounded-xl shadow space-y-2 text-xs">
        <div class="flex items-center justify-between border-b-2 border-border pb-2.5">
          <span class="font-head font-bold uppercase text-xs tracking-wider text-foreground flex items-center gap-1.5">
            <i class="bi bi-list-nested text-secondary" aria-hidden="true"></i>
            Sumário Navegável
          </span>
          <span class="font-mono text-xs text-foreground font-bold">{filteredHeadings.length} seções</span>
        </div>

        <nav id="cagp-toc-nav" class="space-y-1 max-h-[calc(100dvh-10rem)] overflow-y-auto pr-1">
          {filteredHeadings.map((h) => (
            <a
              href={`#${h.slug}`}
              data-toc-slug={h.slug}
              class={`toc-link block py-1.5 px-2 rounded-lg transition-colors truncate hover:bg-muted hover:text-secondary border border-transparent ${
                h.depth === 1
                  ? 'font-head uppercase font-bold text-foreground text-xs'
                  : h.depth === 2
                  ? 'pl-3 text-gray-700 text-xs font-body font-medium'
                  : 'pl-5 text-gray-500 text-[11px] font-body'
              }`}
            >
              {h.text}
            </a>
          ))}
        </nav>
      </aside>
    )}
  </div>
</BaseLayout>

<style is:global>
  /* Tipografia Editorial Neobrutalista para o Leitor de Documentos */
  .cagp-doc-reader {
    font-family: var(--font-body, 'Space Grotesk', system-ui, sans-serif);
    color: #0A0A0A;
  }

  .cagp-doc-reader h1 {
    font-family: var(--font-head, 'Bricolage Grotesque', sans-serif);
    font-size: clamp(1.35rem, 2.5vw, 1.875rem);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: #0A0A0A;
    margin-top: 2rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 3px solid #0A0A0A;
  }

  .cagp-doc-reader h2 {
    font-family: var(--font-head, 'Bricolage Grotesque', sans-serif);
    font-size: 1.25rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: #8B1E2D;
    margin-top: 1.75rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.25rem;
    border-bottom: 2px solid #0A0A0A;
  }

  .cagp-doc-reader h3 {
    font-family: var(--font-head, 'Bricolage Grotesque', sans-serif);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #0A0A0A;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .cagp-doc-reader h4 {
    font-family: var(--font-head, 'Bricolage Grotesque', sans-serif);
    font-size: 0.95rem;
    font-weight: 700;
    color: #0A0A0A;
    margin-top: 1rem;
    margin-bottom: 0.5rem;
  }

  .cagp-doc-reader p {
    font-size: 0.95rem;
    line-height: 1.7;
    margin-bottom: 1rem;
    color: #0A0A0A;
  }

  .cagp-doc-reader ul,
  .cagp-doc-reader ol {
    margin-top: 0.5rem;
    margin-bottom: 1rem;
    padding-left: 1.5rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .cagp-doc-reader ul {
    list-style-type: disc;
  }

  .cagp-doc-reader ol {
    list-style-type: decimal;
  }

  .cagp-doc-reader li {
    margin-bottom: 0.35rem;
  }

  .cagp-doc-reader blockquote {
    border: 2px solid #0A0A0A;
    border-left: 6px solid #8B1E2D;
    border-radius: 12px;
    padding: 0.85rem 1.15rem;
    margin: 1.25rem 0;
    background-color: #FFFFFF;
    font-style: italic;
    color: #0A0A0A;
    box-shadow: 3px 3px 0 0 #0A0A0A;
  }

  .cagp-doc-reader table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.25rem 0;
    font-size: 0.85rem;
    border: 2px solid #0A0A0A;
    border-radius: 12px;
    display: block;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    box-shadow: 3px 3px 0 0 #0A0A0A;
    background: #FFFFFF;
  }

  .cagp-doc-reader th {
    background-color: #F4F1EA;
    border: 2px solid #0A0A0A;
    padding: 0.6rem 0.75rem;
    font-family: var(--font-head, 'Bricolage Grotesque', sans-serif);
    font-weight: 800;
    text-transform: uppercase;
    text-align: left;
    color: #0A0A0A;
    white-space: nowrap;
  }

  .cagp-doc-reader td {
    border: 1px solid #0A0A0A;
    padding: 0.5rem 0.75rem;
    color: #0A0A0A;
    vertical-align: top;
  }

  .cagp-doc-reader tr:nth-child(even) td {
    background-color: #FAFAFA;
  }

  .cagp-doc-reader hr {
    border: 0;
    border-top: 2px solid #0A0A0A;
    margin: 2rem 0;
  }

  .cagp-doc-reader strong {
    font-weight: 700;
    color: #0A0A0A;
  }

  .cagp-doc-reader code {
    font-family: var(--font-mono, 'Space Mono', monospace);
    font-size: 0.85em;
    background-color: #F7F5F0;
    border: 1.5px solid #0A0A0A;
    padding: 0.15rem 0.35rem;
    border-radius: 6px;
  }

  /* Destaque ativo no Sumário (TOC) */
  .toc-link.is-active {
    background-color: #8B1E2D;
    color: #FFFFFF !important;
    font-weight: 700;
    border: 1.5px solid #0A0A0A;
    box-shadow: 2px 2px 0 0 #0A0A0A;
  }
</style>

<script>
  // Barra de Progresso de Leitura & IntersectionObserver para o Sumário
  function setupDocReader() {
    const progressBar = document.getElementById('cagp-reading-progress');
    const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-link');

    // 1. Barra de Progresso
    const updateProgress = () => {
      const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
      if (scrollHeight <= 0) return;
      const progress = (window.scrollY / scrollHeight) * 100;
      if (progressBar) {
        progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      }
    };

    window.addEventListener('scroll', updateProgress, { passive: true });
    updateProgress();

    // 2. IntersectionObserver para o TOC
    if (tocLinks.length === 0) return;

    const headings = Array.from(document.querySelectorAll<HTMLElement>('.cagp-doc-reader h1, .cagp-doc-reader h2, .cagp-doc-reader h3'));
    if (headings.length === 0) return;

    const observer = new IntersectionObserver(
      (entries) => {
        let activeId = '';
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            activeId = entry.target.id;
          }
        });

        if (activeId) {
          tocLinks.forEach((link) => {
            const match = link.getAttribute('data-toc-slug') === activeId;
            link.classList.toggle('is-active', match);
          });
        }
      },
      { rootMargin: '-80px 0px -70% 0px' }
    );

    headings.forEach((h) => observer.observe(h));
  }

  document.addEventListener('astro:page-load', setupDocReader);
</script>
