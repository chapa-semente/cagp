---
// src/pages/carreira/talentos.astro — Banco de Talentos Discente GP (Super App CAGP UFMG)
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import JourneyNav from '@/components/ui/JourneyNav.astro';
import { CarreiraTalentosForm } from '@/components/features/carreira/CarreiraTalentosForm';
import { route } from '@/lib/paths';

const badges = [
  { label: 'Cofre 100% Local no Navegador', variant: 'green' as const, icon: 'bi-shield-check' },
  { label: 'Sem Servidor Central (Privacidade Total)', variant: 'purple' as const, icon: 'bi-lock-fill' },
  { label: 'Exportação para Currículo & Lattes', variant: 'orange' as const, icon: 'bi-file-earmark-person-fill' },
  { label: 'Proposta 11 • Empresa Júnior GP', variant: 'dark' as const, icon: 'bi-rocket-takeoff-fill' },
];
---

<BaseLayout
  title="Banco de Talentos GP • CAGP FAFICH/UFMG"
  description="Cadastre seu perfil de competências em Gestão Pública (SEI, Lei 14.133, PPA, MROSC) salvo com privacidade total no cofre local do seu navegador para processos seletivos."
  mode="operate"
>
  <div class="space-y-6 max-w-6xl mx-auto">
    <!-- Barra Superior Fixa / Breadcrumb (Mobile-First com Retorno Rápido) -->
    <div
      id="cagp-talentos-back-bar"
      class="sticky top-0 z-30 -mx-3 sm:-mx-6 mb-2 bg-background/95 backdrop-blur-sm border-b-3 border-border px-3 sm:px-6 py-2.5 flex items-center justify-between gap-3 shadow-xs select-none"
    >
      <div class="flex items-center gap-2">
        <a
          href={route('/carreira')}
          class="min-h-[44px] px-3.5 py-1.5 rounded-xl bg-card hover:bg-muted border-2 border-border text-xs font-heading font-extrabold uppercase text-foreground no-underline inline-flex items-center gap-2 shadow-xs active:translate-x-0.5 active:translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 transition-all"
        >
          <span aria-hidden="true">&larr;</span>
          <span>Voltar ao Hub de Carreira</span>
        </a>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-muted-foreground uppercase">
        <span class="hidden sm:inline">Eixo 4 • Carreira</span>
        <span class="hidden sm:inline">•</span>
        <span class="text-primary">Banco de Talentos</span>
      </div>
    </div>

    <PageHeader
      axisId="carreira"
      mode="operate"
      condensed={true}
      showAxisNav={false}
      title="Banco de Talentos GP"
      subtitle="Mapeamento de competências práticas em Gestão Pública (SEI, Lei 14.133, Orçamento, MROSC), integração com currículo Lattes/LinkedIn e geração instantânea de resumo profissional."
      badges={badges}
    />

    <CarreiraTalentosForm client:load />

    <JourneyNav
      prev={{
        title: 'Hub de Carreira & Inserção Profissional',
        href: '/carreira',
        desc: 'Retorne ao painel central com visão geral de vagas, Empresa Júnior e Banco de Talentos.',
      }}
      next={{
        title: 'Radar de Vagas & Editais Públicos',
        href: '/carreira/vagas',
        desc: 'Consulte os editais de estágio e trainee abertos no Estado e na Prefeitura de BH.',
      }}
    />
  </div>
</BaseLayout>
