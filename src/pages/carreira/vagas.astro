---
// src/pages/carreira/vagas.astro — Mural Completo de Vagas & Editais Públicos (Super App CAGP UFMG)
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import JourneyNav from '@/components/ui/JourneyNav.astro';
import { CarreiraVagasMural } from '@/components/features/carreira/CarreiraVagasMural';
import { route } from '@/lib/paths';

const badges = [
  { label: 'Proposta 12 • Radar de Vagas', variant: 'orange' as const, icon: 'bi-megaphone-fill' },
  { label: 'Lei Federal 11.788/2008', variant: 'blue' as const, icon: 'bi-journal-check' },
  { label: 'Órgãos Públicos & OSCs', variant: 'green' as const, icon: 'bi-building-check' },
  { label: 'Atualização Permanente', variant: 'purple' as const, icon: 'bi-broadcast' },
];
---

<BaseLayout
  title="Radar de Vagas & Editais Públicos • CAGP FAFICH/UFMG"
  description="Mural de editais de estágio, trainees em gestão pública e vagas em órgãos públicos (SEPLAG, PBH, TCE, MPMG, ALMG) e OSCs conectadas à Proposta 12 da Chapa Semente."
  mode="read"
>
  <div class="space-y-6 max-w-6xl mx-auto">
    <!-- Barra Superior Fixa / Breadcrumb (Mobile-First com Retorno Rápido) -->
    <div
      id="cagp-vagas-back-bar"
      class="sticky top-0 z-30 -mx-3 sm:-mx-6 mb-2 bg-background/95 backdrop-blur-sm border-b-3 border-border px-3 sm:px-6 py-2.5 flex items-center justify-between gap-3 shadow-xs select-none"
    >
      <div class="flex items-center gap-2">
        <a
          href={route('/carreira')}
          class="min-h-[44px] px-3.5 py-1.5 rounded-xl bg-card hover:bg-muted border-2 border-border text-xs font-heading font-extrabold uppercase text-foreground no-underline inline-flex items-center gap-2 shadow-xs active:translate-x-0.5 active:translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-1 transition-all"
        >
          <span aria-hidden="true">&larr;</span>
          <span>Voltar ao Hub de Carreira</span>
        </a>
      </div>
      <div class="flex items-center gap-2 text-xs font-mono font-bold text-muted-foreground uppercase">
        <span class="hidden sm:inline">Eixo 4 • Carreira</span>
        <span class="hidden sm:inline">•</span>
        <span class="text-primary">Radar de Vagas</span>
      </div>
    </div>

    <PageHeader
      axisId="carreira"
      mode="read"
      condensed={true}
      showAxisNav={false}
      title="Radar de Vagas, Estágios &amp; Trainees"
      subtitle="Conectado à Proposta 12 da Chapa Semente: divulgação ativa e curadoria de oportunidades remuneradas em órgãos do Estado de Minas Gerais, Prefeitura de Belo Horizonte, tribunais e terceiro setor."
      badges={badges}
    />

    <CarreiraVagasMural client:load />

    <JourneyNav
      prev={{
        title: 'Hub de Carreira & Inserção Profissional',
        href: '/carreira',
        desc: 'Retorne ao painel central com visão geral de vagas, Empresa Júnior e Banco de Talentos.',
      }}
      next={{
        title: 'Banco de Talentos GP (Cofre Local)',
        href: '/carreira/talentos',
        desc: 'Cadastre suas competências técnicas e exporte seu currículo para processos seletivos.',
      }}
    />
  </div>
</BaseLayout>
