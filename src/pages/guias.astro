---
// /guias — Hub da aba Guias (Modelo B). Primeiro os guias, grupo por grupo; depois os documentos mais pedidos.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import HubItemList from '@/components/shell/HubItemList.astro';
import DocumentosMaisPedidos from '@/components/features/guias/DocumentosMaisPedidos.astro';
import { getAxisById } from '@/lib/navigationRegistry';

const axis = getAxisById('guias')!;
// Um bloco por grupo, na ordem do curso (documentos, começando, no campus, durante, apoio, terminando,
// dúvidas), cada um com o seu título e no máximo cinco quadros (DESIGN.md › Hub de aba).
const guias = axis.items.filter((i) => i.type !== 'hub');
const grupos = (axis.groups ?? [])
  .map((g) => ({ ...g, itens: guias.filter((i) => i.group === g.id) }))
  .filter((g) => g.itens.length > 0);
---

<BaseLayout
  title="Guias"
  description="Passo a passo dos trâmites do curso de Gestão Pública da UFMG e os documentos mais pedidos, prontos para baixar e enviar."
  mode="operate"
>
  <PageHeader
    title="Guias"
    subtitle="O passo a passo de cada trâmite e os documentos que você precisa."
    mode="operate"
    condensed={true}
  />

  <div class="space-y-10 sm:space-y-12">
    <div class="space-y-8 sm:space-y-10">
      {grupos.map((g) => <HubItemList items={g.itens} heading={g.title} headingId={`guias-${g.id}`} />)}
    </div>
    <DocumentosMaisPedidos />
  </div>
</BaseLayout>
