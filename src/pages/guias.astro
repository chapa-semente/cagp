---
// /guias — Hub da aba Guias (Modelo B). Primeiro o bloco com todos os guias; depois os documentos mais pedidos.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import HubItemList from '@/components/shell/HubItemList.astro';
import DocumentosMaisPedidos from '@/components/features/guias/DocumentosMaisPedidos.astro';
import { getAxisById } from '@/lib/navigationRegistry';

const axis = getAxisById('guias')!;
// Um bloco só com todos os guias, na ordem do curso (documentos, começando, durante, terminando, dúvidas).
const ordem = (axis.groups ?? []).map((g) => g.id);
const guias = axis.items
  .filter((i) => i.type !== 'hub')
  .sort((x, y) => ordem.indexOf(x.group ?? '') - ordem.indexOf(y.group ?? ''));
---

<BaseLayout
  title="Guias"
  description="Passo a passo dos trâmites do curso de Gestão Pública da UFMG e os documentos mais pedidos, prontos para baixar e enviar."
  mode="operate"
>
  <PageHeader
    title="Guias"
    subtitle="O passo a passo de cada trâmite e os documentos que você precisa."
    mode="operate"
    condensed={true}
  />

  <div class="space-y-10 sm:space-y-12">
    <HubItemList items={guias} />
    <DocumentosMaisPedidos />
  </div>
</BaseLayout>
