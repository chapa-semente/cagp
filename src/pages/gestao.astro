---
// gestao.astro - A4 Guia: 4 sub-views (Eleições 2026 · Organograma · Equipe · Contas)
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/ui/PageHeader.astro';
import SegmentedControl from '../components/ui/SegmentedControl.astro';
import JourneyNav from '../components/ui/JourneyNav.astro';
import GestaoOrganograma from '../components/features/gestao/GestaoOrganograma.astro';
import GestaoEquipe from '../components/features/gestao/GestaoEquipe.astro';
import GestaoContas from '../components/features/gestao/GestaoContas.astro';
import { GestaoDiretoriaAndEstatuto } from '../components/features/gestao/GestaoDiretoriaAndEstatuto';
import { TeamGrid, type TeamMember } from '../components/boldkit/blocks/team-section';
import { asset, route } from '@/lib/paths';

const gestaoMembers: TeamMember[] = [
  {
    name: 'Gabriel Sathler',
    role: '1. Presidência (DIPRE • Art. 28)',
    bio: 'Representação institucional perante a Reitoria e Colegiado, assinatura de convênios e criação do SuperApp discente.',
    image: asset('/images/chapa/Gabriel Sathler.jpg'),
    social: { email: 'cagp@fafich.ufmg.br' },
  },
  {
    name: 'Lívia Martins',
    role: '2. Assessoria da Presidência (DIPRE • Art. 28)',
    bio: 'Idealizadora do Manual "Como se Formar", direção de arte institucional e banco de currículos integrado.',
    image: asset('/images/chapa/Livia Martins.jpeg'),
    social: { email: 'cagp@fafich.ufmg.br' },
  },
  {
    name: 'Larissa Prado',
    role: '3. Vice-Presidência (DIPRE • Art. 28)',
    bio: 'Acolhimento estudantil, coordenação do canal de escuta permanente ("Fala com o CA") e integração de calouros.',
    image: asset('/images/chapa/Larissa Prado.png'),
    social: { email: 'cagp@fafich.ufmg.br' },
  },
  {
    name: 'Mariana Presti',
    role: '4. Diretoria Acadêmica (DIAC • Art. 31)',
    bio: 'Orientação sobre percursos curriculares, mapeamento dos 11 núcleos de pesquisa do DCP e diálogo com o Colegiado.',
    image: asset('/images/chapa/MarianaPresti.jpeg'),
    social: { email: 'cagp@fafich.ufmg.br' },
  },
  {
    name: 'Nilo Neto',
    role: 'Vice-Diretoria Acadêmica (DIAC • Art. 31)',
    bio: 'Apoio à coordenação de pesquisa discente, fomento à iniciação científica e aproximação com os laboratórios do DCP.',
    image: asset('/images/chapa/Nilo Neto.png'),
    social: { email: 'cagp@fafich.ufmg.br' },
  },
  {
    name: 'João Pedro Fragoso',
    role: '5. Comunicação & Marketing (DIMAC • Art. 34)',
    bio: 'Seriedade institucional, portal de notícias, atualização de ementas junto ao Colegiado e mídias sociais.',
    image: asset('/images/chapa/João Pedro Fragoso.jpg'),
    social: { email: 'cagp@fafich.ufmg.br' },
  },
  {
    name: 'Vitória Moraes',
    role: '6. Diretoria Financeira (DIFI • Art. 30)',
    bio: 'Livro-Caixa Aberto centavo a centavo, emissão mensal do RREO e tutoriais de assistência estudantil FUMP.',
    image: asset('/images/chapa/Vitoria.png'),
    social: { email: 'cagp@fafich.ufmg.br' },
  },
  {
    name: 'Ítalo de Morais',
    role: '7. Articulação & Assuntos Políticos (DIAP • Art. 32)',
    bio: 'Representação no Conselho de CAs (CEB), interlocução com DA FAFICH, DCE UFMG e ENECAP (Campo de Públicas).',
    image: asset('/images/chapa/Italo.png'),
    social: { email: 'cagp@fafich.ufmg.br' },
  },
  {
    name: 'David',
    role: '8. Diretoria de Assuntos Jurídicos (DIJUR • Art. 29)',
    bio: 'Consultoria normativa interna, guarda dos Livros de Atas, defesa de direitos estudantis e conformidade estatutária.',
    social: { email: 'cagp@fafich.ufmg.br' },
  },
  {
    name: 'Clarisse',
    role: '9. Diretoria de Cultura & Integração (DICULT • Art. 33)',
    bio: 'Recepção de calouros, Semana Acadêmica, cineclubes temáticos, vivência noturna e eventos culturais na FAFICH.',
    social: { email: 'cagp@fafich.ufmg.br' },
  },
];

const tabs = [
  { id: 'v0', shortLabel: 'Eleições 2026', fullLabel: 'Processo Eleitoral 2026', hash: '#eleicoes' },
  { id: 'v1', shortLabel: 'Organograma', fullLabel: 'Organograma da Gestão', hash: '#organograma' },
  { id: 'v2', shortLabel: '9 Diretorias', fullLabel: 'As 9 Pastas & Diretorias', hash: '#equipe' },
  { id: 'v3', shortLabel: 'Contas', fullLabel: 'Prestação de Contas', hash: '#contas' },
];

const badges = [
  { label: 'Eleições: 25 e 26/11 no CAGP', variant: 'red' as const, icon: 'bi-calendar-check' },
  { label: 'Edital Oficial Publicado', variant: 'gold' as const, icon: 'bi-file-earmark-pdf' },
  { label: '9 Pastas & Diretorias', variant: 'dark' as const, icon: 'bi-diagram-3-fill' },
  { label: 'Chapa Semente Concorrente', variant: 'blue' as const, icon: 'bi-flower1' },
];
---

<BaseLayout
  title="Processo Eleitoral & Diretorias"
  description="Processo eleitoral 2026, edital de convocação da Junta Eleitoral, candidatura da Chapa Semente e organograma regimental do CAGP FAFICH/UFMG."
  mode="read"
>
  <PageHeader
    title="Processo Eleitoral & Diretorias do CAGP"
    subtitle="O CAGP encontra-se em processo eleitoral para a gestão 2026. Conheça o cronograma oficial da Junta Eleitoral, as regras do edital, as propostas da Chapa Semente e a estrutura regimental das 7 diretorias executivas."
    badges={badges}
    mode="read"
  />

  <SegmentedControl tabs={tabs} defaultTab="v0" />

  <!-- Sub-view 0: Eleições 2026 & Edital de Convocação -->
  <section id="ws-panel-v0" class="cagp-workspace-view space-y-6" data-ws-panel="v0">
    <div id="eleicoes" class="cagp-anchor-target scroll-mt-24"></div>

    <!-- Banner Cronograma e Junta Eleitoral -->
    <div class="p-5 sm:p-6 rounded-xl border-3 border-border bg-card shadow-md space-y-4">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pb-3 border-b-2 border-border">
        <div>
          <span class="font-mono text-xs font-bold uppercase tracking-widest text-primary block">
            Junta Eleitoral CAGP 2026 • Edital de Convocação
          </span>
          <h2 class="font-heading text-lg sm:text-xl font-black text-foreground m-0">
            Cronograma Oficial das Eleições 2026
          </h2>
        </div>

        <a
          href={asset('/documentos/edital-eleicoes-cagp-2026.pdf')}
          download="edital-eleicoes-cagp-2026.pdf"
          class="px-4 py-2 min-h-[44px] inline-flex items-center gap-2 rounded-xl bg-primary hover:bg-primary-hover text-white border-3 border-border font-heading font-extrabold text-xs uppercase tracking-wider no-underline shadow-xs transition-all shrink-0 active:translate-x-0.5 active:translate-y-0.5"
        >
          <span>Baixar Edital Oficial (PDF)</span>
          <span>↓</span>
        </a>
      </div>

      <!-- Grid dos 6 Prazos do Edital com Quebra Fluida -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 pt-1">
        <div class="p-3 rounded-lg border-3 border-border bg-white shadow-xs">
          <span class="font-mono text-xs font-bold text-muted-foreground block">04/11/2026</span>
          <span class="font-heading font-black text-xs uppercase text-foreground block mt-0.5">Edital Publicado</span>
          <span class="text-xs font-sans text-muted-foreground block mt-1">Convocação oficial</span>
        </div>
        <div class="p-3 rounded-lg border-3 border-border bg-white shadow-xs">
          <span class="font-mono text-xs font-bold text-muted-foreground block">04 a 10/11</span>
          <span class="font-heading font-black text-xs uppercase text-foreground block mt-0.5">Inscrições</span>
          <span class="text-xs font-sans text-muted-foreground block mt-1">Até 23h59 via e-mail</span>
        </div>
        <div class="p-3 rounded-lg border-3 border-border bg-white shadow-xs">
          <span class="font-mono text-xs font-bold text-muted-foreground block">11/11/2026</span>
          <span class="font-heading font-black text-xs uppercase text-foreground block mt-0.5">Homologação</span>
          <span class="text-xs font-sans text-muted-foreground block mt-1">Divulgação de chapas</span>
        </div>
        <div class="p-3 rounded-lg border-2 border-accent bg-card">
          <span class="font-mono text-xs font-bold text-accent block">11 a 24/11</span>
          <span class="font-heading font-black text-xs uppercase text-foreground block mt-0.5">Campanha</span>
          <span class="text-xs font-sans text-muted-foreground block mt-1">Debate e diálogo aberto</span>
        </div>
        <div class="p-3 rounded-lg border-2 border-primary bg-card">
          <span class="font-mono text-xs font-bold text-primary block">24/11 às 18h</span>
          <span class="font-heading font-black text-xs uppercase text-foreground block mt-0.5">Debate Oficial</span>
          <span class="text-xs font-sans text-muted-foreground block mt-1">Local a definir</span>
        </div>
        <div class="p-3 rounded-lg border-3 border-border bg-primary text-white shadow-xs">
          <span class="font-mono text-xs font-bold text-[#FFD6A5] block">25 e 26/11</span>
          <span class="font-heading font-black text-xs uppercase text-white block mt-0.5">Votação no CAGP</span>
          <span class="text-xs font-sans text-white block mt-1">17h às 22h30 • Presencial</span>
        </div>
      </div>

      <!-- Regras da Junta Eleitoral e Normas de Votação -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
        <div class="p-4 rounded-xl border-3 border-border bg-white shadow-xs space-y-2">
          <span class="font-heading font-black text-xs uppercase text-primary block">
            Junta Eleitoral 2026 (Comissão Eleitoral)
          </span>
          <p class="text-xs font-sans text-foreground leading-relaxed m-0">
            Composta por 3 estudantes de Gestão Pública eleitos em Assembleia Geral: <strong>Fernanda Abadia Couto</strong>, <strong>Laura Borges Souza</strong> e <strong>Anderson Batista de Sousa Santos</strong>.<br />
            Contato institucional para dúvidas, inscrições e recursos: <span class="font-mono font-bold text-primary">juntaeleitoralcagp2026@gmail.com</span>.
          </p>
        </div>

        <div class="p-4 rounded-xl border-3 border-border bg-[#FFFBEB] space-y-2">
          <span class="font-heading font-black text-xs uppercase text-warning block">
            Regras de Votação &amp; Boca de Urna (Art. 17 e 20)
          </span>
          <p class="text-xs font-sans text-foreground leading-relaxed m-0">
            Podem votar todos os estudantes matriculados em Gestão Pública portando documento oficial com foto. É estritamente vedada a prática de campanha eleitoral no <strong>1º andar da FAFICH</strong> durante os dois dias de eleição (25 e 26 de novembro).
          </p>
        </div>
      </div>
    </div>

    <!-- Card Destaque: Candidatura da Chapa Semente -->
    <div class="p-6 rounded-xl border-3 border-border bg-card shadow-[4px_4px_0_0_#FE8812] flex flex-col md:flex-row items-center justify-between gap-5">
      <div class="flex items-center gap-4">
        <div class="w-16 h-16 rounded-2xl bg-white p-2 border-3 border-border shadow-sm flex items-center justify-center shrink-0">
          <img
            src={asset('/logos/semente/semente-simbolo.webp')}
            alt="Chapa Semente"
            class="w-full h-full object-contain"
          />
        </div>
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="font-heading text-lg font-bold text-foreground">
              Chapa Semente
            </span>
            <span class="px-2 py-0.5 rounded-full bg-accent text-foreground font-mono text-xs font-black uppercase">
              Candidata Inscrita
            </span>
          </div>
          <p class="text-xs font-sans text-content-secondary leading-relaxed max-w-xl m-0">
            A Chapa Semente apresenta sua <strong>Carta-Programa com 14 propostas</strong> divididas em 4 eixos (Transparência, Cultura, Desenvolvimento de Carreiras e Comunicação), além do compromisso público de manutenção e entrega deste Superapp à comunidade acadêmica.
          </p>
        </div>
      </div>

      <a
        href={route('/chapa-semente')}
        class="px-5 py-3 min-h-[44px] inline-flex items-center gap-2 rounded-xl bg-primary hover:bg-[#4A216E] text-white border-3 border-border font-heading font-black text-xs uppercase tracking-wider no-underline shadow transition-all shrink-0 active:translate-x-0.5 active:translate-y-0.5"
      >
        <span>Ver Carta-Programa Completa</span>
        <span class="text-accent">→</span>
      </a>
    </div>
  </section>

  <!-- Sub-view 1: Organograma Funcional -->
  <section id="ws-panel-v1" class="cagp-workspace-view" data-ws-panel="v1" hidden>
    <div id="organograma" class="cagp-anchor-target scroll-mt-24"></div>
    <GestaoDiretoriaAndEstatuto client:visible />
    <GestaoOrganograma />
  </section>

  <!-- Sub-view 2: Equipe por Diretoria -->
  <section id="ws-panel-v2" class="cagp-workspace-view space-y-4" data-ws-panel="v2" hidden>
    <div id="equipe" class="cagp-anchor-target scroll-mt-24"></div>
    <TeamGrid
      client:visible
      title="Diretoria Executiva"
      subtitle="Governança Estatutária"
      description="Composição das 7 diretorias executivas regimentais responsáveis pela representação discente."
      members={gestaoMembers}
      columns={3}
      className="py-4 px-0"
    />
    <GestaoEquipe />
  </section>

  <!-- Sub-view 3: Prestação de Contas & RREO -->
  <section id="ws-panel-v3" class="cagp-workspace-view" data-ws-panel="v3" hidden>
    <div id="contas" class="cagp-anchor-target scroll-mt-24"></div>
    <GestaoContas />
  </section>

  <!-- Journey Navigation Trail -->
  <JourneyNav
    prev={{
      title: 'O Centro Acadêmico (CAGP)',
      href: '/sobre',
      desc: 'História, governança, estatuto interno e esferas de representação.',
    }}
    next={{
      title: 'Mapa Panorâmico do Super App',
      href: '/mapa-do-site',
      desc: 'Visão panorâmica e taxonômica de todas as 14 rotas ativas do portal discente.',
    }}
  />
</BaseLayout>
