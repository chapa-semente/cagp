---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ErrorPageBlock } from '../components/boldkit/blocks/error-pages';
import { route } from '../lib/paths';
---

<BaseLayout
  title="404 — Página Não Encontrada"
  description="A rota solicitada não foi localizada no Superapp do Centro Acadêmico de Gestão Pública (CAGP FAFICH/UFMG)."
>
  <div class="my-8 rounded-xl border-3 border-[#16181d] bg-white shadow-[8px_8px_0px_#16181d] p-6 sm:p-10 space-y-8">
    <ErrorPageBlock
      code="404"
      message="Rota ou processo não localizado no arquivo da FAFICH."
      homeHref={route('/')}
    />

    <div class="border-t-3 border-[#16181d] pt-6">
      <span class="font-mono text-xs font-black uppercase text-[#9E2424] block text-center mb-4">
        Atalhos de Resgate Rápido pelos 5 Eixos Canônicos
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
        <a
          href={route('/')}
          class="p-3.5 rounded-xl border-3 border-[#16181d] bg-white hover:bg-[#FFFDF9] shadow-[3px_3px_0px_#16181d] no-underline text-[#16181d]"
        >
          <span class="font-mono text-[10px] font-bold text-[#9E2424] block">EIXO 1</span>
          <span class="font-heading text-xs font-black uppercase">Hoje &amp; Campus</span>
        </a>
        <a
          href={route('/calouros')}
          class="p-3.5 rounded-xl border-3 border-[#16181d] bg-white hover:bg-[#FFFDF9] shadow-[3px_3px_0px_#16181d] no-underline text-[#16181d]"
        >
          <span class="font-mono text-[10px] font-bold text-[#5B2A86] block">EIXO 2</span>
          <span class="font-heading text-xs font-black uppercase">Manual Calouros</span>
        </a>
        <a
          href={route('/percurso')}
          class="p-3.5 rounded-xl border-3 border-[#16181d] bg-white hover:bg-[#FFFDF9] shadow-[3px_3px_0px_#16181d] no-underline text-[#16181d]"
        >
          <span class="font-mono text-[10px] font-bold text-[#266264] block">EIXO 3</span>
          <span class="font-heading text-xs font-black uppercase">Grade &amp; 600h</span>
        </a>
        <a
          href={route('/documentos')}
          class="p-3.5 rounded-xl border-3 border-[#16181d] bg-white hover:bg-[#FFFDF9] shadow-[3px_3px_0px_#16181d] no-underline text-[#16181d]"
        >
          <span class="font-mono text-[10px] font-bold text-[#FF8811] block">EIXO 4</span>
          <span class="font-heading text-xs font-black uppercase">Acervo &amp; PDFs</span>
        </a>
        <a
          href={route('/gestao')}
          class="p-3.5 rounded-xl border-3 border-[#16181d] bg-white hover:bg-[#FFFDF9] shadow-[3px_3px_0px_#16181d] no-underline text-[#16181d]"
        >
          <span class="font-mono text-[10px] font-bold text-[#C4161C] block">EIXO 5</span>
          <span class="font-heading text-xs font-black uppercase">CAGP &amp; Semente</span>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
