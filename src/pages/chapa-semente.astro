---
import MarkerWord from '@/components/ui/MarkerWord.astro';
// src/pages/chapa-semente.astro — Campanha da Chapa Semente (volume Cartaz, arquétipo Campanha)
// Ordem: prova ao vivo (o site já é a Proposta 3) → o que já funciona → 14 propostas → 12 integrantes → quando e onde votar.
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyNav from '../components/ui/JourneyNav.astro';
import { CartaPropostaInteractive } from '../components/features/semente/CartaPropostaInteractive';
import { ChapaSementeTour } from '../components/features/semente/ChapaSementeTour';
import { PropostasTourButton } from '../components/features/semente/PropostasTourButton';
import { CHAPA_LEADERS, CHAPA_NOME, CHAPA_NUMERO, CHAPA_ROTULO, getLeaderPhotoUrl } from '@/lib/chapaSementeData';
import { asset, route } from '@/lib/paths';
import { Marquee, MarqueeItem, MarqueeSeparator } from '../components/ui/marquee';
import EstagioIlustra from '@/components/ui/EstagioIlustra.astro';
import CagpIcon from '@/components/ui/CagpIcon.astro';
import { resolveCagpIconName } from '@/lib/cagpIcons';
import { getItemByPath } from '@/lib/navigationRegistry';
import BotaoCompartilhar from '@/components/ui/BotaoCompartilhar.astro';
import GritoDeVoto from '@/components/ui/GritoDeVoto.astro';
import { corpoDoVoto } from '@/lib/compartilhar';
import '@/styles/campanha-detalhe.css';

const MARQUEE = [
  `Vote ${CHAPA_NOME} · 25 e 26/11 · 17h às 22h30`,
  'Faz o S!',
  '12 pessoas, 14 propostas, 1 site no ar',
  'Toda mudança começa pequena',
  'Leve documento com foto',
];

const EDITAL_PDF = asset('/documentos/edital-eleicoes-cagp-2026.pdf');
/** Convite pro grupo da turma (a data, o lugar e a assinatura entram na hora de mandar). */
const CONVITE = `🌱 A Semente é a ${CHAPA_ROTULO} na eleição do CAGP e já pôs no ar um site com os guias do curso: documentos, estágio, 600h, FUMP, calouros.\nDá uma olhada e conhece as ${CHAPA_LEADERS.length} pessoas da chapa:`;
const TOTAL = String(CHAPA_LEADERS.length).padStart(2, '0');

/** Funções reais do site (nada simulado entra aqui). */
const jaFuncionaBase = [
  { title: 'Calcular as suas 600h', desc: 'Extensão e atividades complementares, com o que ainda falta.', href: route('/acg') + '#calculadora' },
  { title: 'Fazer o estágio sem travar', desc: 'Passo a passo, modelos de termo e para quem enviar.', href: route('/estagio') },
  { title: 'Pedir auxílio da FUMP', desc: 'O que cada nível garante e como pedir sem perder prazo.', href: route('/permanencia') },
  { title: 'Chegar como calouro', desc: 'Os primeiros 30 dias e onde fica cada sala da FAFICH.', href: route('/calouros') },
  { title: 'Achar formulários e normas', desc: 'PPC, regulamento e modelos de requerimento num só lugar.', href: route('/documentos') },
  { title: 'Escolher optativas', desc: 'Catálogo de optativas e formação livre do curso.', href: route('/optativas') },
];
// Cada ferramenta leva o ícone e a cor da aba onde a página mora (registro de navegação).
const jaFunciona = jaFuncionaBase.map((t) => {
  const dono = getItemByPath(t.href.split('#')[0]);
  return { ...t, aba: dono?.axis.id ?? 'guias', icone: resolveCagpIconName(dono?.item.icon ?? 'compass') };
});
---

<BaseLayout
  mode="persuade"
  hideFloatingPill
  title={CHAPA_NOME}
  description="A Semente é a Chapa 2 na eleição do Centro Acadêmico de Gestão Pública da UFMG: o site que você está usando já é a nossa Proposta 3. Veja as 14 propostas, os 12 integrantes e quando votar (25 e 26/11)."
>
  <div class="cs-page">
    <!-- 1. TOPO: a prova é a ferramenta funcionando -->
    <section aria-labelledby="cs-hero-title" class="cs-hero">
      <div class="cs-hero-copy">
        <div class="cs-hero-marca">
          <img
            src={asset('/logos/semente/semente-horizontal-branco.webp')}
            alt="Chapa Gestão Pública Semente"
            width="768"
            height="229"
            class="h-10 sm:h-12 w-auto"
          />
          <p class="sk-chapa-num m-0">
            <span class="sk-chapa-num-rotulo">Chapa</span>
            <span class="sk-chapa-num-n">{CHAPA_NUMERO}</span>
          </p>
        </div>
        <h1 id="cs-hero-title" class="cs-display">Você já está usando a nossa <MarkerWord onColor class="cs-marker">proposta</MarkerWord>.</h1>
        <p class="cs-hero-lede">
          A Proposta 3 da nossa carta-programa é um site para o curso. É este aqui: ideia nossa, construída há muito
          tempo, já no ar e feita pra ficar com os estudantes.
        </p>
        <p class="cs-accent">Toda mudança começa pequena.</p>
        <GritoDeVoto onColor tamanho="lg" />
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="#propostas" class="cs-btn cs-btn-accent">Ver as 14 propostas</a>
          <a href="#votar" class="cs-vote-link">Dias 25 e 26/11, das 17h às 22h30: como votar <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>

      <!-- O broto da chapa, como adesivo, com os três números que são fato (12 pessoas, 14 propostas, 1 site). -->
      <div class="cs-hero-arte" aria-hidden="true">
        <EstagioIlustra nivel={3} comFundo class="cs-hero-broto" />
        <span class="sk-adesivo cs-hero-ad cs-hero-ad-1">12 pessoas</span>
        <span class="sk-adesivo cs-hero-ad cs-hero-ad-2">14 propostas</span>
        <span class="sk-adesivo cs-hero-ad cs-hero-ad-3">1 site no ar</span>
      </div>
    </section>

    <!-- Marquee da campanha (DESIGN.md › Marquee: 1 por página, só em Cartaz). CSS puro, sem hidratar. -->
    <div class="rounded-xl border-3 border-border bg-foreground text-white overflow-hidden" aria-hidden="true">
      <Marquee speed="slow" pauseOnHover className="bg-foreground text-white border-0 shadow-none py-2.5">
        {MARQUEE.map((t) => (
          <>
            <MarqueeItem className="text-sm font-heading font-bold uppercase tracking-[0.04em] text-white">{t}</MarqueeItem>
            <MarqueeSeparator><span class="inline-block w-2 h-2 rounded-full bg-accent align-middle"></span></MarqueeSeparator>
          </>
        ))}
      </Marquee>
    </div>

    <!-- 2. QUANDO E ONDE VOTAR (logo depois do topo: quem chega indeciso precisa disto primeiro) -->
    <section id="votar" aria-labelledby="cs-votar-title" class="cs-vote scroll-mt-24">
      <h2 id="cs-votar-title" class="cs-headline cs-on-color">Quando e onde votar</h2>
      <dl class="cs-vote-list">
        <div>
          <dt>Nosso número</dt>
          <dd><strong>{CHAPA_ROTULO}</strong>. É o número da Semente nesta eleição.</dd>
        </div>
        <div>
          <dt>Votação</dt>
          <dd><strong>25 e 26 de novembro</strong>, das 17h às 22h30, no CAGP. Voto secreto.</dd>
        </div>
        <div>
          <dt>Quem vota</dt>
          <dd>Todo estudante com matrícula ativa em Gestão Pública, levando documento oficial com foto.</dd>
        </div>
        <div>
          <dt>Debate</dt>
          <dd>24 de novembro, às 18h. Local a definir.</dd>
        </div>
        <div>
          <dt>Mandato</dt>
          <dd>A chapa eleita dirige o CAGP por 1 ano (Regimento, art. 48).</dd>
        </div>
      </dl>
      <p class="cs-vote-note">
        Nos dias de votação é proibido fazer campanha no 1º andar da FAFICH (edital, art. 17).
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="cs-btn cs-btn-accent" data-cs-ics>
          <i class="bi bi-calendar-plus" aria-hidden="true" data-cs-ics-icon></i>
          <span data-cs-ics-label>Lembrar na agenda</span>
        </button>
        <a href={route('/gestao')} class="cs-btn cs-btn-ghost-light">
          Tudo sobre a eleição
        </a>
      </div>
      <p class="cs-ics-note" data-cs-ics-note aria-live="polite"></p>
    </section>
    <!-- 3. OS INTEGRANTES (os rostos antes das propostas) -->
    <section id="integrantes" aria-labelledby="cs-integrantes-title" class="scroll-mt-24 space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-2 max-w-[68ch]">
          <h2 id="cs-integrantes-title" class="cs-headline">Os {CHAPA_LEADERS.length} integrantes</h2>
          <p class="text-base text-muted-foreground m-0">
            Cada pessoa responde por uma área do centro acadêmico e por uma parte do site.
          </p>
        </div>
        <ChapaSementeTour variant="compact" buttonText="Rever o tour da chapa" />
      </div>

      <ul class="cs-team" role="list" data-masonry>
        {CHAPA_LEADERS.map((leader, idx) => {
          const photo = getLeaderPhotoUrl(leader.photoFilename);
          const firstName = leader.name.split(' ')[0];
          return (
            <li id={leader.targetId} class="cs-member scroll-mt-24">
              <span id={leader.id} class="cagp-anchor-target" aria-hidden="true"></span>
              <div class="cs-member-photo">
                {photo ? (
                  <img
                    src={photo}
                    alt={`${leader.name}, ${leader.role}`}
                    loading="lazy"
                    decoding="async"
                    style={leader.photoPosition ? `object-position:${leader.photoPosition}` : undefined}
                  />
                ) : (
                  <span class="cs-member-initials" aria-hidden="true">{leader.initials}</span>
                )}
                <span class="cs-counter" aria-hidden="true">{String(idx + 1).padStart(2, '0')}/{TOTAL}</span>
              </div>
              <div class="space-y-0.5">
                <h3 class="cs-member-name"><a href={route(`/chapa-semente/${leader.id}`)}>{leader.name}</a></h3>
                <p class="cs-member-role">{leader.role}</p>
              </div>
              <details class="cs-details">
                <summary>Ler a fala de {firstName}</summary>
                <div class="space-y-3 pt-3">
                  {leader.quote && (
                    <blockquote class="m-0 text-sm text-foreground leading-relaxed">“{leader.quote}”</blockquote>
                  )}
                  <p class="m-0 text-sm text-muted-foreground leading-snug">
                    <strong class="text-foreground">O problema:</strong> {leader.painPoint}
                  </p>
                  <p class="m-0 text-sm text-muted-foreground leading-snug">
                    <strong class="text-foreground">Já funciona:</strong> {leader.solution}
                  </p>
                </div>
              </details>
              <a href={leader.toolHref} class="cs-member-link">
                <span>{leader.toolLabel}</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- 4. O QUE JÁ FUNCIONA (faixa roxa) -->
    <section aria-labelledby="cs-funciona-title" class="cs-band">
      <h2 id="cs-funciona-title" class="cs-headline cs-on-color">O que já funciona no site</h2>
      <p class="cs-band-lede">Isto não é promessa: está no ar hoje e você pode usar agora.</p>
      <ul class="cs-tools" role="list">
        {jaFunciona.map((t) => (
          <li>
            <a href={t.href} class="cs-tool" data-nav-axis={t.aba}>
              <span class="sk-tile sk-tile-broto" aria-hidden="true">
                <CagpIcon name={t.icone} class="sk-tile-glifo" />
                <svg class="sk-broto" viewBox="-46 -110 72 118"><use href="#sg-folha" /></svg>
              </span>
              <span class="min-w-0 flex-1">
                <span class="cs-tool-title">{t.title}</span>
                <span class="cs-tool-desc">{t.desc}</span>
              </span>
              <i class="bi bi-arrow-right text-lg shrink-0" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 5. AS 14 PROPOSTAS -->
    <section id="propostas" aria-labelledby="cs-propostas-title" class="scroll-mt-24 space-y-5">
      <div class="space-y-2 max-w-[68ch]">
        <h2 id="cs-propostas-title" class="cs-headline">As 14 propostas</h2>
        <p class="text-base text-muted-foreground m-0">
          O texto integral da carta-programa, em 4 eixos. Abra uma proposta para ler a íntegra, ou veja uma por uma com quem vai tocar cada uma.
        </p>
        <PropostasTourButton className="mt-2 w-full sm:w-auto" />
      </div>
      <CartaPropostaInteractive client:visible />
    </section>

    <!-- 6. KIT DE DIVULGAÇÃO: quem já decidiu o voto vira quem espalha (artes em public/og/kit/) -->
    <section id="divulgar" aria-labelledby="cs-kit-title" class="scroll-mt-24 space-y-5">
      <div class="space-y-2 max-w-[68ch]">
        <h2 id="cs-kit-title" class="cs-headline">Ajude a espalhar</h2>
        <p class="text-base text-muted-foreground m-0">
          Vai votar na Semente? Conte pra turma. A arte e os textos já estão prontos.
        </p>
      </div>
      <div class="cs-kit">
        <div class="cd-ficha cd-kit" style="--cd-kit-arte:8.5rem">
          <img
            src={asset('/og/kit/story-voto.jpg')}
            alt="Arte de story: Eu voto Chapa 2, com os 12 integrantes, a data e o local da eleição"
            width="1080"
            height="1920"
            class="cd-kit-arte"
            loading="lazy"
            decoding="async"
          />
          <div class="cd-secao">
            <h3 class="cd-h2">Pro story e pro status</h3>
            <p class="cd-texto">A arte “Eu voto {CHAPA_ROTULO}” já vem no tamanho do story. Baixe, poste e cole o link do site.</p>
            <div class="cd-acoes">
              <a href={asset('/og/kit/story-voto.jpg')} download="eu-voto-chapa-2-semente.jpg" class="sk-btn sk-btn-roxo">
                <i class="bi bi-download" aria-hidden="true"></i>
                Baixar a arte
              </a>
              <BotaoCompartilhar corpo={corpoDoVoto()} url={route('/')} tom="voto" rotulo="Declarar meu voto" />
            </div>
          </div>
        </div>
        <div class="cd-ficha">
          <h3 class="cd-h2">Sua foto com a moldura da chapa</h3>
          <p class="cd-texto">“Gostosas com {CHAPA_ROTULO}”, “As BB quer Semente”, “Faz o S!”: escolha a moldura, ponha a sua foto e poste no perfil, no feed ou no story.</p>
          <div class="cd-acoes">
            <a href={route('/chapa-semente/moldura')} class="sk-btn sk-btn-folha">
              <i class="bi bi-camera" aria-hidden="true"></i>
              Fazer minha moldura
            </a>
          </div>
        </div>
        <div class="cd-ficha">
          <h3 class="cd-h2">Pro grupo da turma</h3>
          <p class="cd-texto">Um convite curto, com a data e o lugar da eleição e o link do site.</p>
          <div class="cd-acoes">
            <BotaoCompartilhar corpo={CONVITE} url={route('/')} tom="convite" variante="roxo" rotulo="Mandar o convite" />
            <BotaoCompartilhar corpo={CONVITE} url={route('/')} tom="convite" variante="copiar" />
          </div>
          <p class="cd-texto">
            Cada proposta e cada pessoa da chapa tem a sua página, com link e arte próprios: abra uma e use o botão de mandar.
          </p>
        </div>
      </div>
    </section>

    <!-- O fechamento com o pedido de voto é a FaixaDeVoto, que o BaseLayout põe no fim de toda página. -->
  </div>

  <JourneyNav
    prev={{
      title: 'Hoje no campus',
      href: '/',
      desc: 'Volte à página inicial do Super App.',
    }}
    next={{
      title: 'História e regimento do CAGP',
      href: '/sobre',
      desc: 'O estatuto e os marcos do centro acadêmico.',
    }}
  />
</BaseLayout>

<script>
  import { downloadPresetIcs } from '@/lib/calendar/icsGenerator';

  document.querySelectorAll<HTMLButtonElement>('[data-cs-ics]').forEach((btn) =>
    btn.addEventListener('click', () => {
      downloadPresetIcs('eleicoes-cagp-2026');
      const label = btn.querySelector<HTMLElement>('[data-cs-ics-label]');
      const icon = btn.querySelector<HTMLElement>('[data-cs-ics-icon]');
      const note = btn.closest('section')?.querySelector<HTMLElement>('[data-cs-ics-note]');
      if (label) label.textContent = 'Lembrete baixado';
      if (icon) icon.className = 'bi bi-calendar-check';
      btn.classList.add('is-saved');
      if (note) note.textContent = 'Abra o arquivo .ics para salvar os dias 25 e 26/11 na sua agenda.';
    }),
  );
</script>

<style>
  .cs-page {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-block: 0.75rem 3rem;
  }
  @media (min-width: 1024px) {
    .cs-page { gap: 4.5rem; }
  }

  /* Tipografia (Poppins 400/700 apenas) */
  .cs-display {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-wrap: balance;
    color: #fff;
  }
  .cs-headline {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.2;
    text-wrap: balance;
    color: var(--color-foreground);
  }
  .cs-headline.cs-on-color { color: #fff; }
  .cs-label {
    margin: 0;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .cs-vote-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-weight: 700;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .cs-vote-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .cs-accent {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  .cs-display :global(.cs-marker) { font-size: 1.12em; text-transform: none; }

  /* 1. Topo (Cartaz roxo) */
  .cs-hero {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem 1.25rem;
    border: 3px solid #1f1f1f;
    border-radius: 16px;
    background: var(--color-primary);
    box-shadow: 6px 6px 0 0 #1f1f1f;
  }
  @media (min-width: 1024px) {
    .cs-hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
      gap: 2.5rem;
      padding: 2.5rem;
    }
  }
  .cs-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .cs-hero-marca { display: flex; align-items: center; gap: 1.25rem; }
  .cs-hero-lede {
    margin: 0;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.6;
    color: #fff;
    text-wrap: pretty;
  }

  /* O broto em adesivo, inclinado, com três etiquetas ao redor */
  .cs-hero-arte { position: relative; justify-self: center; width: min(100%, 21rem); padding: 1.25rem 1.5rem 1.75rem; }
  .cs-hero-arte :global(.cs-hero-broto) {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border: 3px solid #1f1f1f;
    border-radius: 28% 8% 28% 8%;
    box-shadow: 6px 6px 0 0 var(--color-accent), 12px 12px 0 0 #1f1f1f;
    rotate: 3deg;
  }
  .cs-hero-ad { position: absolute; top: auto; left: auto; font-size: 0.875rem; padding: 0.375rem 0.625rem; }
  .cs-hero-ad-1 { top: 0.25rem; left: 0; rotate: -7deg; }
  .cs-hero-ad-2 { top: 42%; right: -0.25rem; rotate: 5deg; background: #ffc83d; }
  .cs-hero-ad-3 { bottom: 0.5rem; left: 1rem; rotate: -4deg; background: var(--color-accent); }

  .cs-ics-note {
    margin: 0;
    min-height: 1.25rem;
    font-size: 0.875rem;
    line-height: 1.5;
    color: #fff;
  }
  .cs-btn.is-saved { background: #fff; }

  /* Botões */
  .cs-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border: 3px solid #1f1f1f;
    border-radius: 12px;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    cursor: pointer;
    box-shadow: 4px 4px 0 0 #1f1f1f;
    transition: transform 150ms var(--ease-snap, ease-out), box-shadow 150ms var(--ease-snap, ease-out);
  }
  .cs-btn:hover { transform: translate(-1px, -1px); box-shadow: 6px 6px 0 0 #1f1f1f; }
  .cs-btn:active { transform: translate(4px, 4px); box-shadow: none; }
  .cs-btn:focus-visible { outline: 3px solid var(--color-accent); outline-offset: 3px; }
  /* O laranja é o botão de destaque: cantos da folha do símbolo. */
  .cs-btn-accent { background: var(--color-accent); color: #1f1f1f; border-radius: 26px 7px 26px 7px; padding-inline: 1.5rem; }
  .cs-btn-ghost-light { background: #fff; color: #1f1f1f; }

  /* 2. Faixa petróleo */
  .cs-band {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 1.75rem 1.25rem;
    border-radius: 16px;
    background: var(--color-primary);
  }
  @media (min-width: 1024px) {
    .cs-band { padding: 2.5rem; }
  }
  .cs-band-lede {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: #fff;
  }
  .cs-tools {
    display: grid;
    gap: 0.75rem;
    margin: 0.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .cs-tools { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1280px) {
    .cs-tools { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .cs-tool {
