---
import MarkerWord from '@/components/ui/MarkerWord.astro';
// src/pages/chapa-semente.astro — Campanha da Chapa Semente (volume Cartaz, arquétipo Campanha)
// Ordem: prova ao vivo (o site já é a Proposta 3) → o que já funciona → 14 propostas → 12 integrantes → quando e onde votar.
import BaseLayout from '../layouts/BaseLayout.astro';
import JourneyNav from '../components/ui/JourneyNav.astro';
import { CartaPropostaInteractive } from '../components/features/semente/CartaPropostaInteractive';
import { ChapaSementeTour } from '../components/features/semente/ChapaSementeTour';
import { CHAPA_LEADERS, getLeaderPhotoUrl } from '@/lib/chapaSementeData';
import { asset, route } from '@/lib/paths';
import { Marquee, MarqueeItem, MarqueeSeparator } from '../components/ui/marquee';

const MARQUEE = [
  'Vote Semente · 25 e 26/11 · 17h às 22h30',
  '12 pessoas, 14 propostas, 1 site no ar',
  'Toda mudança começa pequena',
  'Leve documento com foto',
];

const EDITAL_PDF = asset('/documentos/edital-eleicoes-cagp-2026.pdf');
const TOTAL = String(CHAPA_LEADERS.length).padStart(2, '0');

/** Funções reais do site (nada simulado entra aqui). */
const jaFunciona = [
  { title: 'Calcular as suas 600h', desc: 'Extensão e atividades complementares, com o que ainda falta.', href: route('/acg') + '#calculadora' },
  { title: 'Fazer o estágio sem travar', desc: 'Passo a passo, modelos de termo e para quem enviar.', href: route('/estagio') },
  { title: 'Pedir auxílio da FUMP', desc: 'O que cada nível garante e como pedir sem perder prazo.', href: route('/permanencia') },
  { title: 'Chegar como calouro', desc: 'Os primeiros 30 dias e onde fica cada sala da FAFICH.', href: route('/calouros') },
  { title: 'Achar formulários e normas', desc: 'PPC, regulamento e modelos de requerimento num só lugar.', href: route('/documentos') },
  { title: 'Escolher optativas', desc: 'Catálogo de optativas e formação livre do curso.', href: route('/optativas') },
];
---

<BaseLayout
  mode="persuade"
  hideFloatingPill
  title="Chapa Semente"
  description="Chapa Semente na eleição do Centro Acadêmico de Gestão Pública da UFMG: o site que você está usando já é a nossa Proposta 3. Veja as 14 propostas, os 12 integrantes e quando votar (25 e 26/11)."
>
  <div class="cs-page">
    <!-- 1. TOPO: a prova é a ferramenta funcionando -->
    <section aria-labelledby="cs-hero-title" class="cs-hero">
      <div class="cs-hero-copy">
        <img
          src={asset('/logos/semente/semente-horizontal-branco.webp')}
          alt="Chapa Gestão Pública Semente"
          width="768"
          height="229"
          class="h-10 sm:h-12 w-auto"
        />
        <h1 id="cs-hero-title" class="cs-display">Você já está usando a nossa <MarkerWord onColor class="cs-marker">proposta</MarkerWord>.</h1>
        <p class="cs-hero-lede">
          A Proposta 3 da nossa carta-programa é um site para o curso. É este aqui: já está no ar e fica com
          os estudantes mesmo se a gente perder a eleição.
        </p>
        <p class="cs-accent">Toda mudança começa pequena.</p>
        <div class="flex flex-wrap items-center gap-x-5 gap-y-3">
          <a href="#propostas" class="cs-btn cs-btn-accent">Ver as 14 propostas</a>
          <a href="#votar" class="cs-vote-link">Votação 25 e 26/11, 17h às 22h30 <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
        </div>
      </div>

      <!-- Ferramenta real, ao vivo: a prova vem antes do discurso -->
      <form class="cs-calc" data-cs-calc aria-labelledby="cs-calc-title" onsubmit="return false">
        <h2 id="cs-calc-title" class="cs-calc-title">Teste agora: quanto falta das suas 600h?</h2>
        <div class="grid grid-cols-2 gap-3">
          <label class="cs-field" data-cs-field="ext">
            <span>Extensão</span>
            <span class="cs-input-wrap">
              <input type="number" inputmode="numeric" min="0" max="300" step="1" placeholder="0" name="ext" aria-describedby="cs-calc-help" />
              <span class="cagp-stamp-badge is-visto cs-visto" data-cs-visto hidden>Visto</span>
            </span>
            <span class="cs-track" aria-hidden="true"><span class="cs-track-fill" data-cs-fill></span></span>
          </label>
          <label class="cs-field" data-cs-field="aac">
            <span>Complementares</span>
            <span class="cs-input-wrap">
              <input type="number" inputmode="numeric" min="0" max="300" step="1" placeholder="0" name="aac" aria-describedby="cs-calc-help" />
              <span class="cagp-stamp-badge is-visto cs-visto" data-cs-visto hidden>Visto</span>
            </span>
            <span class="cs-track" aria-hidden="true"><span class="cs-track-fill" data-cs-fill></span></span>
          </label>
        </div>
        <p id="cs-calc-help" class="text-sm text-muted-foreground m-0">
          O curso exige 300h de extensão e 300h de atividades complementares. Nada sai do seu celular.
        </p>
        <div class="cs-calc-result" data-cs-result>
          <div class="cs-calc-readout" aria-live="polite">
            <span class="cs-numeral" data-cs-left>600h</span>
            <span class="text-sm text-foreground" data-cs-msg>faltam para fechar as 600h</span>
          </div>
          <svg class="cs-sprout" viewBox="0 0 64 96" aria-hidden="true" focusable="false">
            <path class="cs-soil" d="M4 92h56" />
            <g class="cs-leaf" data-cs-leaf>
              <path d="M14 90C6 70 9 46 26 28 37 17 49 10 60 5c-3 19-7 41-19 60C33 79 24 88 14 90Z" />
            </g>
          </svg>
          <div class="cs-done" data-cs-done hidden>
            <span class="cagp-big-stamp is-semente">
              <span class="cagp-big-stamp-title">600h completas</span>
              <span class="cagp-big-stamp-sub">Agora é pedir a integralização</span>
            </span>
          </div>
        </div>
        <a href={route('/acg') + '#calculadora'} class="cs-link">Lançar atividade por atividade na calculadora completa <i class="bi bi-arrow-right" aria-hidden="true"></i></a>
      </form>
    </section>

    <!-- Marquee da campanha (DESIGN.md › Marquee: 1 por página, só em Cartaz). CSS puro, sem hidratar. -->
    <div class="rounded-xl border-3 border-border bg-foreground text-white overflow-hidden" aria-hidden="true">
      <Marquee speed="slow" pauseOnHover className="bg-foreground text-white border-0 shadow-none py-2.5">
        {MARQUEE.map((t) => (
          <>
            <MarqueeItem className="text-sm font-heading font-bold uppercase tracking-[0.04em] text-white">{t}</MarqueeItem>
            <MarqueeSeparator><span class="inline-block w-2 h-2 rounded-full bg-accent align-middle"></span></MarqueeSeparator>
          </>
        ))}
      </Marquee>
    </div>

    <!-- 2. O QUE JÁ FUNCIONA (faixa petróleo) -->
    <section aria-labelledby="cs-funciona-title" class="cs-band">
      <h2 id="cs-funciona-title" class="cs-headline cs-on-color">O que já funciona no site</h2>
      <p class="cs-band-lede">Isto não é promessa: está no ar hoje e você pode usar agora.</p>
      <ul class="cs-tools" role="list">
        {jaFunciona.map((t) => (
          <li>
            <a href={t.href} class="cs-tool">
              <span class="min-w-0">
                <span class="cs-tool-title">{t.title}</span>
                <span class="cs-tool-desc">{t.desc}</span>
              </span>
              <i class="bi bi-arrow-right text-lg shrink-0" aria-hidden="true"></i>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- 3. AS 14 PROPOSTAS -->
    <section id="propostas" aria-labelledby="cs-propostas-title" class="scroll-mt-24 space-y-5">
      <div class="space-y-2 max-w-[68ch]">
        <h2 id="cs-propostas-title" class="cs-headline">As 14 propostas</h2>
        <p class="text-base text-muted-foreground m-0">
          O texto integral da carta-programa, em 4 eixos. Abra uma proposta para ler a íntegra.
        </p>
      </div>
      <CartaPropostaInteractive client:visible />
    </section>

    <!-- 4. OS INTEGRANTES -->
    <section id="integrantes" aria-labelledby="cs-integrantes-title" class="scroll-mt-24 space-y-5">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4">
        <div class="space-y-2 max-w-[68ch]">
          <h2 id="cs-integrantes-title" class="cs-headline">Os {CHAPA_LEADERS.length} integrantes</h2>
          <p class="text-base text-muted-foreground m-0">
            Cada pessoa responde por uma área do centro acadêmico e por uma parte do site.
          </p>
        </div>
        <ChapaSementeTour client:idle variant="compact" buttonText="Rever o tour da chapa" />
      </div>

      <ul class="cs-team" role="list" data-masonry>
        {CHAPA_LEADERS.map((leader, idx) => {
          const photo = getLeaderPhotoUrl(leader.photoFilename);
          const firstName = leader.name.split(' ')[0];
          return (
            <li id={leader.targetId} class="cs-member scroll-mt-24">
              <span id={leader.id} class="cagp-anchor-target" aria-hidden="true"></span>
              <div class="cs-member-photo">
                {photo ? (
                  <img
                    src={photo}
                    alt={`${leader.name}, ${leader.role}`}
                    loading="lazy"
                    decoding="async"
                    style={leader.photoPosition ? `object-position:${leader.photoPosition}` : undefined}
                  />
                ) : (
                  <span class="cs-member-initials" aria-hidden="true">{leader.initials}</span>
                )}
                <span class="cs-counter" aria-hidden="true">{String(idx + 1).padStart(2, '0')}/{TOTAL}</span>
              </div>
              <div class="space-y-0.5">
                <h3 class="cs-member-name">{leader.name}</h3>
                <p class="cs-member-role">{leader.role}</p>
              </div>
              <details class="cs-details">
                <summary>Ler a fala de {firstName}</summary>
                <div class="space-y-3 pt-3">
                  {leader.quote && (
                    <blockquote class="m-0 text-sm text-foreground leading-relaxed">“{leader.quote}”</blockquote>
                  )}
                  <p class="m-0 text-sm text-muted-foreground leading-snug">
                    <strong class="text-foreground">O problema:</strong> {leader.painPoint}
                  </p>
                  <p class="m-0 text-sm text-muted-foreground leading-snug">
                    <strong class="text-foreground">Já funciona:</strong> {leader.solution}
                  </p>
                </div>
              </details>
              <a href={leader.toolHref} class="cs-member-link">
                <span>{leader.toolLabel}</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
              </a>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- 5. QUANDO E ONDE VOTAR (fechamento com a ação) -->
    <section id="votar" aria-labelledby="cs-votar-title" class="cs-vote scroll-mt-24">
      <h2 id="cs-votar-title" class="cs-headline cs-on-color">Quando e onde votar</h2>
      <dl class="cs-vote-list">
        <div>
          <dt>Votação</dt>
          <dd><strong>25 e 26 de novembro</strong>, das 17h às 22h30, no CAGP. Voto secreto.</dd>
        </div>
        <div>
          <dt>Quem vota</dt>
          <dd>Todo estudante com matrícula ativa em Gestão Pública, levando documento oficial com foto.</dd>
        </div>
        <div>
          <dt>Debate</dt>
          <dd>24 de novembro, às 18h. Local a definir.</dd>
        </div>
        <div>
          <dt>Mandato</dt>
          <dd>A chapa eleita dirige o CAGP por 1 ano (Regimento, art. 48).</dd>
        </div>
      </dl>
      <p class="cs-vote-note">
        Nos dias de votação é proibido fazer campanha no 1º andar da FAFICH (edital, art. 17).
      </p>
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="cs-btn cs-btn-accent" data-cs-ics>
          <i class="bi bi-calendar-plus" aria-hidden="true" data-cs-ics-icon></i>
          <span data-cs-ics-label>Lembrar na agenda</span>
        </button>
        <a href={route('/gestao')} class="cs-btn cs-btn-ghost-light">
          Tudo sobre a eleição
        </a>
      </div>
      <p class="cs-ics-note" data-cs-ics-note aria-live="polite"></p>
    </section>
  </div>

  <JourneyNav
    prev={{
      title: 'Hoje no campus',
      href: '/',
      desc: 'Volte à página inicial do Super App.',
    }}
    next={{
      title: 'História e regimento do CAGP',
      href: '/sobre',
      desc: 'O estatuto e os marcos do centro acadêmico.',
    }}
  />
</BaseLayout>

<script>
  import { downloadPresetIcs } from '@/lib/calendar/icsGenerator';

  const clamp = (v: string) => Math.min(300, Math.max(0, Math.floor(Number(v) || 0)));

  /** Remonta a animação de impacto do carimbo (DESIGN.md › Movimento). */
  const restamp = (el: HTMLElement) => {
    el.hidden = false;
    el.style.animation = 'none';
    void el.offsetWidth;
    el.style.animation = '';
  };

  document.querySelectorAll<HTMLFormElement>('[data-cs-calc]').forEach((form) => {
    const left = form.querySelector<HTMLElement>('[data-cs-left]');
    const msg = form.querySelector<HTMLElement>('[data-cs-msg]');
    const leaf = form.querySelector<SVGGElement>('[data-cs-leaf]');
    const result = form.querySelector<HTMLElement>('[data-cs-result]');
    const done = form.querySelector<HTMLElement>('[data-cs-done]');
    const doneStamp = done?.querySelector<HTMLElement>('.cagp-big-stamp');
    const halves = new Map<string, boolean>();
    let wasDone = false;

    const field = (name: string) => {
      const wrap = form.querySelector<HTMLElement>(`[data-cs-field="${name}"]`);
      const hours = clamp((form.elements.namedItem(name) as HTMLInputElement).value);
      wrap?.querySelector<HTMLElement>('[data-cs-fill]')?.style.setProperty('--p', String(hours / 300));
      const visto = wrap?.querySelector<HTMLElement>('[data-cs-visto]');
      const full = hours >= 300;
      if (visto) {
        if (full && !halves.get(name)) restamp(visto);
        if (!full) visto.hidden = true;
      }
      halves.set(name, full);
      return hours;
    };

    const update = () => {
      const ext = field('ext');
      const aac = field('aac');
      const total = ext + aac;
      const falta = 600 - total;
      // A folha brota a partir de um broto mínimo e cresce com as horas.
      leaf?.style.setProperty('--grow', String(0.28 + 0.72 * (total / 600)));
      if (!left || !msg) return;

      const isDone = falta <= 0;
      result?.classList.toggle('is-done', isDone);
      if (done && doneStamp) {
        if (isDone && !wasDone) {
          done.hidden = false;
          restamp(doneStamp);
        }
        if (!isDone) done.hidden = true;
      }
      wasDone = isDone;

      if (isDone) {
        left.textContent = '600h';
        msg.textContent = 'completas. Agora é pedir a integralização.';
        return;
      }
      left.textContent = `${falta}h`;
      const parts: string[] = [];
      if (ext < 300) parts.push(`${300 - ext}h de extensão`);
      if (aac < 300) parts.push(`${300 - aac}h de complementares`);
      msg.textContent = total === 0 ? 'faltam para fechar as 600h' : `faltam: ${parts.join(' e ')}`;
    };
    form.addEventListener('input', update);
    update();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-cs-ics]').forEach((btn) =>
    btn.addEventListener('click', () => {
      downloadPresetIcs('eleicoes-cagp-2026');
      const label = btn.querySelector<HTMLElement>('[data-cs-ics-label]');
      const icon = btn.querySelector<HTMLElement>('[data-cs-ics-icon]');
      const note = btn.closest('section')?.querySelector<HTMLElement>('[data-cs-ics-note]');
      if (label) label.textContent = 'Lembrete baixado';
      if (icon) icon.className = 'bi bi-calendar-check';
      btn.classList.add('is-saved');
      if (note) note.textContent = 'Abra o arquivo .ics para salvar os dias 25 e 26/11 na sua agenda.';
    }),
  );
</script>

<style>
  .cs-page {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    margin-block: 0.75rem 3rem;
  }
  @media (min-width: 1024px) {
    .cs-page { gap: 4.5rem; }
  }

  /* Tipografia (Poppins 400/700 apenas) */
  .cs-display {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.75rem, 1.4rem + 1.6vw, 2.25rem);
    line-height: 1.05;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    text-wrap: balance;
    color: #fff;
  }
  .cs-headline {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
    line-height: 1.2;
    text-wrap: balance;
    color: var(--color-foreground);
  }
  .cs-headline.cs-on-color { color: #fff; }
  .cs-label {
    margin: 0;
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-variant-numeric: tabular-nums;
  }
  .cs-vote-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-weight: 700;
    font-size: 1rem;
    font-variant-numeric: tabular-nums;
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .cs-vote-link:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }
  .cs-accent {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 0.875rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #fff;
  }
  .cs-display :global(.cs-marker) { font-size: 1.12em; text-transform: none; }

  /* 1. Topo (Cartaz roxo) */
  .cs-hero {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem 1.25rem;
    border: 3px solid #1f1f1f;
    border-radius: 16px;
    background: var(--color-primary);
    box-shadow: 6px 6px 0 0 #1f1f1f;
  }
  @media (min-width: 1024px) {
    .cs-hero {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      align-items: center;
      gap: 2.5rem;
      padding: 2.5rem;
    }
  }
  .cs-hero-copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
  }
  .cs-hero-lede {
    margin: 0;
    max-width: 52ch;
    font-size: 1rem;
    line-height: 1.6;
    color: #fff;
    text-wrap: pretty;
  }

  /* Calculadora ao vivo (ficha branca dentro do Cartaz) */
  .cs-calc {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 1.25rem;
    border: 3px solid #1f1f1f;
    border-radius: 12px;
    background: #fff;
    box-shadow: 3px 3px 0 0 #1f1f1f;
  }
  .cs-calc-title {
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.125rem;
    line-height: 1.3;
    color: var(--color-foreground);
  }
  .cs-field {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-foreground);
  }
  .cs-field input {
    min-height: 48px;
    width: 100%;
    padding: 0 0.75rem;
    border: 3px solid #1f1f1f;
    border-radius: 12px;
    background: #fff;
    font-size: 1rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    box-shadow: 2px 2px 0 0 #1f1f1f;
  }
  .cs-field input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 2px;
    box-shadow: 3px 3px 0 0 #1f1f1f;
  }
  .cs-calc-result {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.25rem 0.625rem;
    padding: 0.875rem 1rem;
    border-radius: 12px;
    background: #f4f2ec;
  }
  .cs-numeral {
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 2.5rem;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    color: var(--color-primary);
  }
  .cs-link {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }

  .cs-input-wrap { position: relative; display: block; }
  .cs-input-wrap input { padding-right: 4.25rem; }
  .cs-visto[hidden] { display: none; }
  .cs-visto {
    position: absolute;
    top: 50%;
    right: 0.5rem;
    margin-top: -0.8rem;
    pointer-events: none;
    animation: cagpStampImpact var(--duration-stamp, 240ms) var(--ease-stamp, cubic-bezier(0.7, 0, 0.84, 0)) both;
  }
  .cs-track {
    display: block;
    height: 8px;
    overflow: hidden;
    border: 2px solid #1f1f1f;
    border-radius: 999px;
    background: #e9e5da;
  }
  .cs-track-fill {
    display: block;
    height: 100%;
    background: var(--color-secondary);
    transform-origin: left center;
    transform: scaleX(var(--p, 0));
    transition: transform 300ms var(--ease-snap, ease-out);
  }

  /* Resultado: a folha do símbolo brota com as horas */
  .cs-calc-result {
    position: relative;
    justify-content: space-between;
    flex-wrap: nowrap;
    align-items: flex-end;
    min-height: 7rem;
  }
  .cs-calc-readout {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 0;
  }
  .cs-sprout {
    flex: none;
    width: 3.5rem;
    height: 5.25rem;
    overflow: visible;
  }
  .cs-soil {
    stroke: #1f1f1f;
    stroke-width: 3;
    stroke-linecap: round;
  }
  .cs-leaf {
    fill: var(--color-accent);
    transform-box: fill-box;
    transform-origin: 0% 100%;
    transform: scale(var(--grow, 0.28));
    transition: transform 420ms var(--ease-snap, ease-out);
