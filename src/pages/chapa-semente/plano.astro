---
// /chapa-semente/plano — Painel de execução da Chapa 2 · Semente (19/11/2026).
// 4 abas via SegmentedControl (zero React): Em 1 minuto (#em-1-minuto), As 14 fichas (#fichas),
// Orçamento e riscos (#orcamento) e Texto completo do plano (#completo; 109 páginas até 22/11/2026, hoje PLANO_PAGINAS).
// Desde 22/11/2026 a aba Em 1 minuto e a aba das fichas mostram também as propostas que vieram de estudantes.
// Arquétipo: leitura e painel comparativo (volume Papel). Dados: src/lib/planoExecucao.ts e src/lib/planoResumoData.ts.
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import SegmentedControl, { type TabItem } from '@/components/ui/SegmentedControl.astro';
import PlanoPainelOrcamento from '@/components/features/semente/PlanoPainelOrcamento.astro';
import PlanoTranscrito from '@/components/features/semente/PlanoTranscrito.astro';
import { PROPOSTA_STOPS } from '@/lib/propostasTour';
import {
  PLANO_MANDATO,
  PLANO_PAGINAS,
  PLANO_PDF_COMPLETO,
  PLANO_PDF_RESUMO,
  PLANO_PROPOSTAS,
  PLANO_SECOES,
  PLANO_SUMARIO,
  resumoExecucaoDaProposta,
} from '@/lib/planoExecucao';
import {
  PLANO_AUTOCRITICA,
  PLANO_CALOURADA_CONJUNTA,
  PLANO_FUMP,
  PLANO_LINHA_TEMPO,
  PLANO_NUMEROS_DESTAQUE,
  PLANO_ROTINAS_FIXAS,
} from '@/lib/planoResumoData';
import {
  CONVITE_IDEIA,
  PROPOSTAS_DE_ESTUDANTES,
  resumoDaPropostaDeEstudante,
  rotaDaPropostaDeEstudante,
} from '@/lib/propostasDeEstudantes';
import { asset, route } from '@/lib/paths';
import '@/styles/plano-documento.css';

const puro = (html: string) => html.replace(/<[^>]+>/g, '');

const ABAS_DO_PLANO: TabItem[] = [
  { id: 'resumo', shortLabel: 'Em 1 min', fullLabel: 'Em 1 minuto', hash: '#em-1-minuto' },
  { id: 'fichas', shortLabel: '14 fichas', fullLabel: 'As 14 fichas', hash: '#fichas' },
  { id: 'orcamento', shortLabel: 'Orçamento', fullLabel: 'Orçamento e riscos', hash: '#orcamento' },
  { id: 'completo', shortLabel: `${PLANO_PAGINAS} págs`, fullLabel: `Texto completo (${PLANO_PAGINAS} págs)`, hash: '#completo' },
];

const FICHAS = PLANO_PROPOSTAS.map((p) => {
  const stop = PROPOSTA_STOPS.find((s) => s.id === p.id);
  const resumo = resumoExecucaoDaProposta(p.id);
  const seloJaFeito = p.id === 3 ? 'Já entregue: é este site' : stop?.jaFeito?.selo;
  return {
    id: p.id,
    boletimPdf: p.boletimPdf,
    nomeCurto: stop?.titulo ?? resumo?.tituloPlano ?? `Proposta ${p.id}`,
    tituloPlano: resumo?.tituloPlano ?? stop?.titulo ?? `Proposta ${p.id}`,
    impacto: resumo?.impacto ?? '',
    custo: resumo?.custo ?? p.custo,
    gratis: resumo?.gratis ?? p.custo === 'R$ 0,00',
    custoNota: resumo?.custoNota ?? '',
    selo: seloJaFeito ?? resumo?.selo ?? '',
    comecou: Boolean(seloJaFeito),
    quemResponde: resumo?.quemResponde ?? '',
    primeiraData: resumo?.primeiraData ?? '',
    primeiraEntrega: resumo?.primeiraEntrega ?? '',
    planoB: resumo?.planoB ?? '',
  };
});

const QTD_GRATIS = FICHAS.filter((f) => f.gratis).length;
const QTD_PAGAS = FICHAS.length - QTD_GRATIS;
const QTD_COMECOU = FICHAS.filter((f) => f.comecou).length;

// Propostas que vieram de estudantes (22/11/2026): fora das 14, com o mesmo resumo de ficha.
const ESTUDANTES = PROPOSTAS_DE_ESTUDANTES.map((e) => ({ ...e, rota: rotaDaPropostaDeEstudante(e), resumo: resumoDaPropostaDeEstudante(e) }));
---

<BaseLayout
  mode="read"
  title="O plano da Semente"
  description={`Cada uma das 14 propostas da Chapa 2, e a que veio de um estudante, com data, custo, quem responde e plano B. Resumo em 1 minuto, orçamento em 3 cenários, boletins em PDF e texto completo (${PLANO_PAGINAS} págs).`}
>
  <PageHeader
    title="O plano da Semente"
    marker="plano"
    subtitle="Cada proposta com entrega, data, custo, quem responde e plano B."
    axisId="chapa"
    activeId="chapa-plano"
    mode="read"
    condensed={true}
  />

  <div class="pd-pagina">
    <!-- Faixa permanente dos PDFs (resumo em 1 página primeiro, para abrir ou mandar no grupo) -->
    <section class="pd-anexos" aria-labelledby="pd-anexos">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <h2 id="pd-anexos" class="pd-h2-curto">Baixar ou mandar em PDF</h2>
        <span class="font-heading text-xs font-bold uppercase tracking-[0.04em] text-content-secondary tabular-nums">
          Mandato {PLANO_MANDATO}
        </span>
      </div>
      <ul class="pd-arquivos" role="list">
        <li>
          <a href={asset(PLANO_PDF_RESUMO)} target="_blank" rel="noopener" class="pd-arquivo is-principal">
            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
            <span>
              <b>O plano em uma página</b>
              <small>1 página · 260 KB · rápido para ler e mandar no grupo</small>
            </span>
          </a>
        </li>
        <li>
          <a href={asset(PLANO_PDF_COMPLETO)} target="_blank" rel="noopener" class="pd-arquivo">
            <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
            <span>
              <b>O plano completo</b>
              <small>{PLANO_PAGINAS} páginas · 4,5 MB · todas as propostas, quadros e orçamento</small>
            </span>
          </a>
        </li>
      </ul>
      <details class="pd-boletins">
        <summary>Os boletins em PDF, um por proposta (14 da carta e {ESTUDANTES.length} de estudante)</summary>
        <ul class="pd-boletins-lista" role="list">
          {FICHAS.map((b) => (
            <li>
              <a href={`${route(`/propostas/${b.id}`)}#plano`} class="pd-boletim-nome">
                <span class="pd-boletim-n">{b.id}</span>
                {b.nomeCurto}
              </a>
              <a href={asset(b.boletimPdf)} target="_blank" rel="noopener" class="pd-boletim-pdf">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                PDF<span class="sr-only"> do boletim da proposta {b.id}</span>
              </a>
            </li>
          ))}
          {ESTUDANTES.map((e) => (
            <li>
              <a href={`${route(e.rota)}#plano`} class="pd-boletim-nome">
                <span class="pd-boletim-n is-estudante">E{e.numero}</span>
                {e.titulo}
              </a>
              <a href={asset(e.plano.boletimPdf)} target="_blank" rel="noopener" class="pd-boletim-pdf">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                PDF<span class="sr-only"> do boletim da proposta de estudante nº {e.numero}</span>
              </a>
            </li>
          ))}
        </ul>
      </details>
    </section>

    <!-- Controle segmentado com 4 abas (zero React) -->
    <SegmentedControl tabs={ABAS_DO_PLANO} defaultTab="resumo" showViewAll={false} />

    <!-- ABA 1: EM 1 MINUTO (hash #em-1-minuto para não colidir com #resumo dentro da Aba 4) -->
    <div id="ws-panel-resumo" data-ws-panel="resumo" role="tabpanel" aria-labelledby="ws-tab-resumo" class="cagp-workspace-view pd-painel-aba">
      <!-- 1. Os 3 grandes números -->
      <ul class="pd-olhada" role="list" aria-label="Resumo em três números">
        {PLANO_NUMEROS_DESTAQUE.map((n) => (
          <li class="pd-olhada-card">
            <strong class="pd-olhada-num">{n.numero}</strong>
            <span class="pd-olhada-rotulo">{n.rotulo}</span>
            <span class="pd-olhada-desc">{n.desc}</span>
          </li>
        ))}
      </ul>

      <!-- Errata (22/11/2026): a regra do desconto para fumpistas mudou, e a antiga fica à vista ao lado da nova. -->
      <section id="errata" class="pd-card-papel pd-errata scroll-mt-24" aria-labelledby="pd-errata-title">
        <div class="flex flex-wrap items-center gap-2">
          <span class="pd-selo is-claro">Errata · {PLANO_FUMP.errata.data}</span>
          <h2 id="pd-errata-title" class="pd-h2-curto">Corrigimos o desconto para fumpistas</h2>
        </div>
        <dl class="pd-errata-lista">
          <div class="pd-errata-antes"><dt>Antes</dt><dd>{PLANO_FUMP.errata.antes}</dd></div>
          <div><dt>Agora</dt><dd>{PLANO_FUMP.errata.agora}</dd></div>
        </dl>
        <p class="m-0 text-base leading-relaxed text-foreground">{PLANO_FUMP.errata.motivo}</p>
        <p class="m-0 text-sm leading-relaxed text-content-secondary">
          {PLANO_FUMP.errata.orcamento} A errata abre o PDF do plano, e a seção 6.1 traz a conta inteira.
        </p>
      </section>

      <!-- 2. O que isso quer dizer pra você -->
      <section class="pd-abertura" aria-labelledby="pd-muda">
        <h2 id="pd-muda" class="pd-abertura-titulo">O que isso quer dizer pra você</h2>
        <p class="pd-abertura-lede">
          Se a Semente for eleita, cada uma das 14 propostas tem <strong>entrega, data e lugar para você conferir</strong>.
          Nos primeiros cem dias, quase tudo custa zero e depende só de gestão: contas reais no portal até 31 de janeiro,
          reunião aberta todo mês e o primeiro boletim de contas em 15 de março.
        </p>
        <ul class="pd-abertura-lista">
          <li><b>Nove das 14 propostas têm custo fixo zero (R$ 0,00).</b> O site já está no ar (revisão externa só se a reunião aberta aprovar) e as demais somam R$ 6.521,05 com teto protegido.</li>
          <li><b>Em cada calourada, {PLANO_FUMP.desconto} de desconto para fumpistas</b>, em até 60 ingressos por festa, na compra antecipada. <a href="#errata" class="font-bold text-primary underline underline-offset-[0.22em]">Corrigido em {PLANO_FUMP.errata.data}</a>.</li>
          <li><b>Toda proposta tem um plano B por escrito:</b> o que a gestão faz se a primeira ideia não der certo.</li>
          {ESTUDANTES.map((e) => (
            <li>
              <b>Uma proposta veio de um estudante:</b> {e.titulo}, ideia de {e.quem.nome} ({e.quem.periodo}), já com data, quem responde e plano B. Custo no caixa: {e.plano.custo.replace(' ', '\u00a0')}.{' '}
              <a href={route(e.rota)} class="font-bold text-primary underline underline-offset-[0.22em]">Ver a proposta</a>
            </li>
          ))}
          <li><b>Vale para o mandato de {PLANO_MANDATO}.</b> Nenhuma parceria citada no plano está fechada.</li>
        </ul>
      </section>

      <!-- 3. Autocrítica: a mesma régua -->
      <section class="pd-card-papel" aria-labelledby="pd-autocritica-title">
        <div class="flex flex-wrap items-center gap-2">
          <span class="pd-selo">Transparência</span>
          <h2 id="pd-autocritica-title" class="pd-h2-curto">{PLANO_AUTOCRITICA.titulo}</h2>
        </div>
        <p class="m-0 text-base leading-relaxed text-foreground">{PLANO_AUTOCRITICA.texto}</p>
        <p class="m-0 text-sm leading-relaxed text-content-secondary" data-faixa-debate>
          <a href={route('/chapa-semente/debate')} class="inline-flex min-h-[44px] items-center gap-1.5 font-bold text-primary underline underline-offset-[0.22em]">
            Veja a mesma régua aplicada à gestão 2025–2026, à nova carta e à dívida na Análise da gestão (debate 24/11)
            <i class="bi bi-arrow-right" aria-hidden="true"></i>
          </a>
        </p>
      </section>

      <!-- 4. Linha do tempo dos 100 dias ao fim do mandato -->
      <section class="pd-card-papel" aria-labelledby="pd-crono-title">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 id="pd-crono-title" class="pd-h2-curto">Quando cada marco acontece</h2>
          <span class="pd-selo is-claro">Primeiros 100 dias marcados</span>
        </div>
        <ol class="pd-crono-lista" role="list">
          {PLANO_LINHA_TEMPO.map((m) => (
            <li class:list={['pd-crono-item', m.destaque && 'is-destaque']}>
              <div class="pd-crono-topo">
                <strong class="pd-crono-data">{m.data}</strong>
                <div class="flex flex-wrap gap-1.5">
                  {m.cemDias && <span class="pd-selo">100 dias</span>}
                  <span class="pd-selo is-claro tabular-nums">Prop. {m.propostas}</span>
                </div>
              </div>
              <p class="m-0 text-sm leading-relaxed text-foreground">{m.fato}</p>
            </li>
          ))}
        </ol>
      </section>

      <!-- 5. Rotinas fixas + desconto FUMP (25%, com errata) + Possibilidade -->
      <div class="pd-orc-grade-dupla">
        <section class="pd-card-papel" aria-labelledby="pd-rotinas-title">
          <h2 id="pd-rotinas-title" class="pd-h2-curto">O que roda no calendário fixo</h2>
          <ul class="pd-rotinas-grid" role="list">
            {PLANO_ROTINAS_FIXAS.map((r) => (
              <li class="pd-rotina-item">
                <strong class="font-heading text-sm font-bold text-primary">{r.ritmo}</strong>
                <p class="m-0 text-sm leading-snug text-foreground">{r.entrega}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="pd-card-papel" aria-labelledby="pd-fump-title">
          <div class="flex flex-wrap items-center gap-2">
            <span class="pd-selo tabular-nums">{PLANO_FUMP.desconto} FUMP</span>
            <h2 id="pd-fump-title" class="pd-h2-curto">{PLANO_FUMP.titulo}</h2>
          </div>
          <ul class="pd-lista text-sm">
            <li>{PLANO_FUMP.publico}</li>
            <li>{PLANO_FUMP.teto}</li>
            <li>{PLANO_FUMP.prioridade}</li>
            <li>{PLANO_FUMP.conferencia}</li>
            <li>{PLANO_FUMP.transparencia}</li>
          </ul>
          <p class="pd-nota-curta">Corrigido em {PLANO_FUMP.errata.data}: era {PLANO_FUMP.errata.antes}. <a href="#errata">Por que mudou</a></p>
        </section>
      </div>

      <section class="pd-card-papel" aria-labelledby="pd-possibilidade-title">
        <div class="flex flex-wrap items-center gap-2">
          <span class="pd-selo">{PLANO_CALOURADA_CONJUNTA.selo}</span>
          <h2 id="pd-possibilidade-title" class="pd-h2-curto">{PLANO_CALOURADA_CONJUNTA.titulo}</h2>
        </div>
        <p class="m-0 text-sm leading-relaxed text-foreground">{PLANO_CALOURADA_CONJUNTA.resumo}</p>
        <div class="flex flex-wrap gap-3 pt-1">
          <a href="#fichas" class="sk-btn sk-btn-folha text-foreground">
            Ver as 14 fichas <i class="bi bi-arrow-right" aria-hidden="true"></i>
          </a>
          <a href="#orcamento" class="sk-btn">
            Abrir orçamento e 3 cenários
          </a>
        </div>
      </section>

      <!-- 6. O que veio de estudantes (22/11/2026): seção 6.3 do plano. -->
      {ESTUDANTES.map((e) => (
        <section class="pd-card-papel pd-estudante" aria-labelledby={`pd-estudante-${e.id}`}>
          <div class="flex flex-wrap items-center gap-2">
            <span class="pd-selo is-estudante">Ideia de estudante · E{e.numero}</span>
            <h2 id={`pd-estudante-${e.id}`} class="pd-h2-curto">{e.titulo}</h2>
          </div>
          <p class="sk-credito">
            <span class="sk-credito-quem">Ideia de <b>{e.quem.nome}</b></span>
            <span class="sk-credito-quando">{e.quem.periodo} · {e.quando.curto}</span>
          </p>
          <p class="m-0 text-sm leading-relaxed text-foreground">{e.impacto}</p>
          <p class="m-0 text-sm leading-relaxed text-content-secondary">
            Fica fora das 14 da carta e não muda o orçamento: custo no caixa de {e.plano.custo.replace(' ', '\u00a0')}. {CONVITE_IDEIA.texto}
          </p>
          <div class="flex flex-wrap gap-3 pt-1">
            <a href={route(e.rota)} class="sk-btn sk-btn-roxo">
              Ver a proposta <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
            <a href={route(`${CONVITE_IDEIA.href}&de=/chapa-semente/plano`)} class="sk-btn">
              {CONVITE_IDEIA.rotulo}
            </a>
          </div>
        </section>
      ))}
    </div>

    <!-- ABA 2: AS 14 FICHAS (filtrável com JS puro, zero React) -->
    <div id="ws-panel-fichas" data-ws-panel="fichas" role="tabpanel" aria-labelledby="ws-tab-fichas" hidden class="cagp-workspace-view pd-painel-aba">
      <section class="pd-card-papel" aria-labelledby="pd-fichas-title">
        <div class="space-y-1">
          <h2 id="pd-fichas-title" class="pd-h2-curto">As 14 fichas de execução</h2>
          <p class="pd-nota-curta">
            Todas as propostas têm impacto direto, primeira data, responsável, plano B e boletim em PDF.
          </p>
        </div>
        <div class="pd-filtros" role="group" aria-label="Filtrar fichas de execução" data-fichas-filtros>
          <button type="button" class="pd-filtro-btn is-ativo" data-ficha-filtro="todas" aria-pressed="true">
            Todas <span class="tabular-nums">({FICHAS.length})</span>
          </button>
          <button type="button" class="pd-filtro-btn" data-ficha-filtro="gratis" aria-pressed="false">
            Sem custo no caixa <span class="tabular-nums">({QTD_GRATIS})</span>
          </button>
          <button type="button" class="pd-filtro-btn" data-ficha-filtro="orcamento" aria-pressed="false">
            Com orçamento <span class="tabular-nums">({QTD_PAGAS})</span>
          </button>
          <button type="button" class="pd-filtro-btn" data-ficha-filtro="comecou" aria-pressed="false">
            Já no ar ou começou <span class="tabular-nums">({QTD_COMECOU})</span>
          </button>
        </div>
      </section>

      <ul class="pd-fichas-grid" role="list" data-fichas-lista>
        {FICHAS.map((f) => (
          <li
            class="pd-card-papel pd-ficha-resumo"
            data-ficha-card
            data-gratis={f.gratis ? '1' : '0'}
            data-comecou={f.comecou ? '1' : '0'}
          >
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div class="flex items-center gap-2">
                <span class="pd-boletim-n">{f.id}</span>
                {f.selo && <span class:list={['pd-selo', !f.comecou && 'is-claro']}>{f.selo}</span>}
              </div>
              <span class:list={['pd-selo tabular-nums', !f.gratis && 'is-claro']}>Custo: {f.custo}</span>
            </div>

            <h3 class="font-heading text-lg font-bold leading-snug m-0 text-foreground">{f.tituloPlano}</h3>
            <p class="m-0 text-sm leading-relaxed text-foreground">{f.impacto}</p>

            <dl class="m-0 grid gap-1 text-sm leading-snug text-content-secondary border-t-2 border-muted pt-2.5">
              {f.primeiraEntrega && (
                <div>
                  <dt class="inline font-bold text-foreground">1ª entrega ({f.primeiraData}): </dt>
                  <dd class="m-0 inline tabular-nums">{f.primeiraEntrega}</dd>
                </div>
              )}
              <div>
                <dt class="inline font-bold text-foreground">Quem responde: </dt>
                <dd class="m-0 inline">{f.quemResponde}</dd>
              </div>
              {f.planoB && (
                <div>
                  <dt class="inline font-bold text-foreground">Plano B: </dt>
                  <dd class="m-0 inline">{f.planoB}</dd>
                </div>
              )}
              {(f.id === 3 || !f.gratis) && f.custoNota && (
                <div>
                  <dt class="inline font-bold text-foreground">Nota de custo: </dt>
                  <dd class="m-0 inline">{f.custoNota}</dd>
                </div>
              )}
            </dl>

            <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t-2 border-muted pt-2.5">
              <a href={`${route(`/propostas/${f.id}`)}#plano`} class="pd-ficha-link">
                Ver cronograma e plano B
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
              </a>
              <a href={asset(f.boletimPdf)} target="_blank" rel="noopener" class="pd-boletim-pdf border-2 border-border rounded-lg">
                <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                Boletim PDF
              </a>
            </div>
          </li>
        ))}
      </ul>

      <!-- As fichas que vieram de estudantes (22/11/2026): depois das 14 e fora dos filtros, que contam só a carta. -->
      {ESTUDANTES.length > 0 && (
        <section class="pd-estudantes-fichas" aria-labelledby="pd-estudantes-fichas-title">
          <h2 id="pd-estudantes-fichas-title" class="pd-h2-curto">E as que vieram de estudantes</h2>
          <ul class="pd-fichas-grid" role="list">
            {ESTUDANTES.map((e) => (
              <li class="pd-card-papel pd-ficha-resumo pd-estudante">
                <div class="flex flex-wrap items-center justify-between gap-2">
                  <div class="flex items-center gap-2">
                    <span class="pd-boletim-n is-estudante">E{e.numero}</span>
                    {e.plano.selo && <span class="pd-selo is-claro">{e.plano.selo}</span>}
                  </div>
                  <span class="pd-selo tabular-nums">Custo: {e.plano.custo}</span>
                </div>

                <h3 class="font-heading text-lg font-bold leading-snug m-0 text-foreground">{e.titulo}</h3>
                <p class="sk-credito">
                  <span class="sk-credito-quem">Ideia de <b>{e.quem.nome}</b></span>
                  <span class="sk-credito-quando">{e.quem.periodo} · {e.quando.curto}</span>
                </p>
                <p class="m-0 text-sm leading-relaxed text-foreground">{e.impacto}</p>

                <dl class="m-0 grid gap-1 text-sm leading-snug text-content-secondary border-t-2 border-muted pt-2.5">
                  {e.resumo.primeiraEntrega && (
                    <div>
                      <dt class="inline font-bold text-foreground">1ª entrega ({e.resumo.primeiraData}): </dt>
                      <dd class="m-0 inline tabular-nums">{e.resumo.primeiraEntrega}</dd>
                    </div>
                  )}
                  <div>
                    <dt class="inline font-bold text-foreground">Quem responde: </dt>
                    <dd class="m-0 inline">{e.resumo.quemResponde}</dd>
                  </div>
                  {e.resumo.planoB && (
                    <div>
                      <dt class="inline font-bold text-foreground">Plano B: </dt>
                      <dd class="m-0 inline">{e.resumo.planoB}</dd>
                    </div>
                  )}
                </dl>

                <div class="mt-auto flex flex-wrap items-center justify-between gap-2 border-t-2 border-muted pt-2.5">
                  <a href={`${route(e.rota)}#plano`} class="pd-ficha-link">
                    Ver cronograma e plano B
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                  </a>
                  <a href={asset(e.plano.boletimPdf)} target="_blank" rel="noopener" class="pd-boletim-pdf border-2 border-border rounded-lg">
                    <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
                    Boletim PDF
                  </a>
                </div>
              </li>
            ))}
            <li class="pd-card-papel pd-convite-ideia">
              <h3 class="font-heading text-lg font-bold leading-snug m-0 text-foreground">{CONVITE_IDEIA.titulo}</h3>
              <p class="m-0 text-sm leading-relaxed text-foreground">{CONVITE_IDEIA.texto}</p>
              <a href={route(`${CONVITE_IDEIA.href}&de=/chapa-semente/plano`)} class="sk-btn sk-btn-roxo justify-self-start">
                <i class="bi bi-lightbulb" aria-hidden="true"></i>
                {CONVITE_IDEIA.rotulo}
              </a>
            </li>
          </ul>
        </section>
      )}
    </div>

    <!-- ABA 3: ORÇAMENTO E RISCOS (painel interativo sem React) -->
    <div id="ws-panel-orcamento" data-ws-panel="orcamento" role="tabpanel" aria-labelledby="ws-tab-orcamento" hidden class="cagp-workspace-view pd-painel-aba">
      <PlanoPainelOrcamento />
    </div>

    <!-- ABA 4: TEXTO COMPLETO (PLANO_PAGINAS) -->
    <div id="ws-panel-completo" data-ws-panel="completo" role="tabpanel" aria-labelledby="ws-tab-completo" hidden class="cagp-workspace-view pd-painel-aba">
      <!-- Índice recolhível no mobile/tablet; abaixo de 1120px substitui a barra lateral -->
      <details class="pd-sumario-mobile" data-sumario-mobile>
        <summary aria-expanded="false">Índice das {PLANO_PAGINAS} páginas (toque para ir direto a uma seção)</summary>
        <nav class="pd-sumario pd-sumario-dentro" aria-labelledby="pd-sumario">
          <h2 id="pd-sumario" class="pd-h2-curto">O plano inteiro, aqui na página</h2>
          <ol role="list">
            {PLANO_SECOES.map((s) => (
              <li class:list={[/^Parte /.test(puro(s.cabeca.html)) && 'is-parte']}>
                <a href={`#${s.cabeca.id}`} set:html={s.cabeca.html} />
              </li>
            ))}
          </ol>
        </nav>
      </details>

      <!-- A transcrição. A partir de 1120px, o sumário acompanha parado à direita. -->
      <div class="pd-leitura">
        <article class="pd-doc" aria-label="Plano de execução 2026-2027, texto completo">
          <header class="pd-doc-cabeca">
            <p class="pd-doc-titulo">Plano de execução 2026-2027: como a Semente vai cumprir cada proposta</p>
            <p class="pd-doc-sub">Plano de execução das 14 propostas da carta-programa da Chapa Semente para o Centro Acadêmico de Gestão Pública da UFMG. Belo Horizonte, novembro de 2026.</p>
          </header>
          {PLANO_SECOES.map((s) => <PlanoTranscrito secao={s} />)}
        </article>

        <aside class="pd-lado" aria-labelledby="pd-lado-titulo">
          <div class="pd-lado-cabeca">
            <p id="pd-lado-titulo" class="pd-lado-titulo">Neste plano</p>
            <span class="pd-lado-progresso" aria-hidden="true"><span data-pd-progresso></span></span>
          </div>
          <nav class="pd-lado-nav" aria-labelledby="pd-lado-titulo">
            <ol role="list">
              {PLANO_SUMARIO.map((item) => (
                <li class:list={[item.parte && 'is-parte']} data-pd-secao={item.id}>
                  <a href={`#${item.id}`} data-pd-alvo={item.id} set:html={item.html} />
                  {item.filhos.length > 0 && (
                    <ol role="list" class="pd-lado-filhos">
                      {item.filhos.map((f) => (
                        <li><a href={`#${f.id}`} data-pd-alvo={f.id} set:html={f.html} /></li>
                      ))}
                    </ol>
                  )}
                </li>
              ))}
            </ol>
          </nav>
          <div class="pd-lado-acoes">
            <a href={asset(PLANO_PDF_COMPLETO)} target="_blank" rel="noopener" class="pd-lado-pdf">
              <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i>
              <span><b>Abrir o PDF completo</b><small>{PLANO_PAGINAS} páginas · 4,5 MB</small></span>
            </a>
            <a href="#pd-anexos" class="pd-lado-link">Resumo em 1 página e os 14 boletins</a>
          </div>
        </aside>
      </div>
    </div>

  </div>
</BaseLayout>

<script>
  function iniciarFiltrosFichasPlano() {
    const botoes = document.querySelectorAll<HTMLButtonElement>('[data-ficha-filtro]');
    const cartoes = document.querySelectorAll<HTMLElement>('[data-ficha-card]');
    if (!botoes.length || !cartoes.length) return;
    const barra = botoes[0].closest<HTMLElement>('[data-fichas-filtros]');
    if (!barra || barra.dataset.cagpFichasBound === '1') return;
    barra.dataset.cagpFichasBound = '1';

    botoes.forEach((btn) => {
      btn.addEventListener('click', () => {
        const alvo = btn.dataset.fichaFiltro;
        botoes.forEach((b) => {
          const ativo = b.dataset.fichaFiltro === alvo;
          b.classList.toggle('is-ativo', ativo);
          b.setAttribute('aria-pressed', ativo ? 'true' : 'false');
        });
        cartoes.forEach((card) => {
          const mostra =
            alvo === 'todas' ||
            (alvo === 'gratis' && card.dataset.gratis === '1') ||
            (alvo === 'orcamento' && card.dataset.gratis === '0') ||
            (alvo === 'comecou' && card.dataset.comecou === '1');
          card.hidden = !mostra;
        });
      });
    });
  }

  // Sumário ao lado + gaveta mobile na Aba 4: observa quando a aba sai de `hidden`.
  function iniciarSumarioDoPlano() {
    const painelCompleto = document.getElementById('ws-panel-completo');
    const lado = document.querySelector<HTMLElement>('.pd-lado');
    const doc = document.querySelector<HTMLElement>('.pd-doc');
    const gavetaMobile = document.querySelector<HTMLDetailsElement>('[data-sumario-mobile]');
    if (gavetaMobile && gavetaMobile.dataset.cagpGavetaBound !== '1') {
      gavetaMobile.dataset.cagpGavetaBound = '1';
      const resumo = gavetaMobile.querySelector('summary');
      gavetaMobile.addEventListener('toggle', () => {
        resumo?.setAttribute('aria-expanded', gavetaMobile.open ? 'true' : 'false');
      });
      gavetaMobile.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          gavetaMobile.open = false;
        });
      });
    }

    if (!lado || !doc) return;
    const links = new Map<string, HTMLAnchorElement>();
    lado.querySelectorAll<HTMLAnchorElement>('[data-pd-alvo]').forEach((a) => links.set(a.dataset.pdAlvo!, a));
    const titulos = Array.from(doc.querySelectorAll<HTMLElement>('h2[id], h3[id]')).filter((h) => links.has(h.id));
    const barra = lado.querySelector<HTMLElement>('[data-pd-progresso]');

    let atual = '';
    const marcar = (id: string) => {
      if (!id || id === atual) return;
      atual = id;
      lado.querySelectorAll('[aria-current]').forEach((el) => el.removeAttribute('aria-current'));
      lado.querySelectorAll('.is-aberta').forEach((el) => el.classList.remove('is-aberta'));
      const link = links.get(id);
      if (!link) return;
      link.setAttribute('aria-current', 'location');
      const secao = link.closest<HTMLElement>('[data-pd-secao]');
      secao?.classList.add('is-aberta');
      const pai = secao?.querySelector<HTMLAnchorElement>(':scope > a');
      if (pai && pai !== link) pai.setAttribute('aria-current', 'true');
      const nav = lado.querySelector<HTMLElement>('.pd-lado-nav');
      if (nav) {
        const r = link.getBoundingClientRect();
        const n = nav.getBoundingClientRect();
        if (r.top < n.top || r.bottom > n.bottom) nav.scrollTop += r.top - n.top - n.height / 3;
      }
    };

    const atualizar = () => {
      if (painelCompleto?.hidden) return;
      let id = titulos[0]?.id ?? '';
      for (const h of titulos) {
        if (h.getBoundingClientRect().top - 160 <= 0) id = h.id;
        else break;
      }
      marcar(id);
      if (barra) {
        const r = doc.getBoundingClientRect();
        const feito = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - window.innerHeight)));
        barra.style.transform = `scaleX(${feito})`;
      }
    };

    let pedido = 0;
    const agendar = () => {
      if (pedido) return;
      pedido = requestAnimationFrame(() => {
        pedido = 0;
        atualizar();
      });
    };

    const observer = painelCompleto
      ? new MutationObserver(() => {
          if (!painelCompleto.hidden) agendar();
        })
      : null;
    if (painelCompleto && observer) {
      observer.observe(painelCompleto, { attributes: true, attributeFilter: ['hidden'] });
    }

    window.addEventListener('scroll', agendar, { passive: true });
    document.addEventListener(
      'astro:before-swap',
      () => {
        window.removeEventListener('scroll', agendar);
        observer?.disconnect();
      },
      { once: true },
    );
    atualizar();
  }

  function iniciarPlano() {
    iniciarFiltrosFichasPlano();
    iniciarSumarioDoPlano();
  }
  iniciarPlano();
  document.addEventListener('astro:page-load', iniciarPlano);
</script>
