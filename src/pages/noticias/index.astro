---
// src/pages/noticias/index.astro — Subseção de Início (Hoje) · Mural Completo de Notícias & Eventos
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CagpNewsMural } from '../../components/features/cagp/CagpNewsMural';
import { getCollection } from 'astro:content';
import { SIMULATED_NEWS, type SimulatedNewsItem } from '@/lib/simulatedData';

const rawNoticias = await getCollection('noticias');

const noticiasItems: SimulatedNewsItem[] = rawNoticias.length > 0
  ? rawNoticias.map((doc) => ({
      id: doc.id,
      slug: doc.data.slug,
      simulated: true,
      category: doc.data.category,
      tag: doc.data.tag,
      tagColor: doc.data.tagColor,
      title: doc.data.title,
      summary: doc.data.summary,
      body: doc.data.summary,
      fullContent: doc.data.highlights || [],
      highlights: doc.data.highlights || [],
      author: doc.data.author,
      readingTime: doc.data.readingTime,
      meta: doc.data.meta,
      dateLabel: doc.data.dateLabel,
      ctaLabel: doc.data.ctaLabel,
      ctaHref: doc.data.ctaHref,
      relatedLinks: doc.data.relatedLinks || [],
      relevantRoles: (doc.data.relevantRoles as any) || [],
      motif: doc.data.motif,
    }))
  : SIMULATED_NEWS;
---

<BaseLayout
  title="Mural de Notícias & Eventos — Início"
  description="Mural de notícias, convocações de assembleia, editais de estágio, congressos acadêmicos, calourada e eventos do Bacharelado em Gestão Pública UFMG."
  mode="read"
  activePage="hoje"
  activeGroup="hoje"
>
  <div class="py-2 space-y-6" data-context-type="news">
    <header id="cagp-noticias-header" class="border-b-3 border-[#16181d] pb-4 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div class="space-y-1.5">
        <div class="flex flex-wrap items-center gap-2">
          <span class="px-2.5 py-0.5 rounded-md bg-primary text-white font-mono text-[11px] font-bold uppercase border-2 border-[#16181d] shadow-[2px_2px_0_0_#16181d]">
            Eixo 1 • Comunicação Transparente
          </span>
          <span class="px-2.5 py-0.5 rounded-md bg-accent text-[#16181d] font-mono text-[11px] font-bold uppercase border-2 border-[#16181d] shadow-[2px_2px_0_0_#16181d]">
            Proposta Materializada • Chapa Semente
          </span>
        </div>
        <h1 class="font-heading text-2xl sm:text-3xl font-extrabold uppercase text-foreground tracking-tight m-0">
          Mural de Notícias, Eventos &amp; Carreiras • CAGP
        </h1>
        <p class="text-xs sm:text-sm font-sans text-muted-foreground m-0 max-w-[70ch] font-medium">
          Subseção editorial de Início: convocações de assembleia, oportunidades de estágio,
          chamadas de congressos, seminários e comunicados da vida discente no campus.
        </p>
      </div>
      <a
        href="/chapa-semente"
        class="min-h-[44px] px-4 py-2 rounded-xl bg-accent hover:bg-[#E07406] text-[#16181d] border-3 border-[#16181d] shadow-[4px_4px_0_0_#16181d] hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-[2px_2px_0_0_#16181d] active:translate-x-[4px] active:translate-y-[4px] active:shadow-none font-heading text-xs font-black uppercase tracking-wide no-underline inline-flex items-center justify-center gap-2 shrink-0 transition-all self-start md:self-auto"
      >
        <span>Vote Chapa Semente • 25 e 26/Nov</span>
        <span aria-hidden="true">&rarr;</span>
      </a>
    </header>

    <CagpNewsMural items={noticiasItems} client:load />
  </div>
</BaseLayout>
