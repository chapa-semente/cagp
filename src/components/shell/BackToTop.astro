---
// BackToTop.astro - Botão Flutuante de Retorno ao Topo com Física Tátil
---

<button
  type="button"
  id="cagp-back-to-top"
  class="fixed bottom-[calc(5.25rem+env(safe-area-inset-bottom,0px))] sm:bottom-6 right-4 sm:right-6 z-[1030] w-11 h-11 min-w-[44px] min-h-[44px] sm:w-auto sm:h-auto p-0 sm:px-3 sm:py-2.5 bg-card text-foreground border-3 border-border rounded-xl shadow-[3px_3px_0_0_#1F1F1F] hover:bg-muted active:translate-x-1 active:translate-y-1 active:shadow-none transition-[opacity,transform,box-shadow] duration-150 opacity-0 pointer-events-none flex items-center justify-center gap-1.5 font-heading text-xs font-bold uppercase cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none"
  aria-label="Voltar ao início da página"
  title="Voltar ao Topo"
>
  <svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 10l7-7m0 0l7 7m-7-7v18"/></svg>
  <span class="hidden sm:inline">Topo</span>
</button>

<script>
  function setupBackToTop() {
    const btn = document.getElementById('cagp-back-to-top');
    if (!btn) return;

    const toggle = () => {
      if (window.scrollY > 280) {
        btn.classList.remove('opacity-0', 'pointer-events-none');
        btn.classList.add('opacity-100', 'pointer-events-auto');
      } else {
        btn.classList.add('opacity-0', 'pointer-events-none');
        btn.classList.remove('opacity-100', 'pointer-events-auto');
      }
    };

    window.addEventListener('scroll', toggle, { passive: true });
    btn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
    toggle();
  }

  document.addEventListener('astro:page-load', setupBackToTop);
</script>
