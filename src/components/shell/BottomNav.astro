---
// src/components/shell/BottomNav.astro — Barra inferior do celular (< 768px), Modelo B por tarefa.
// Abas e aba ativa vêm do registro (navigationRegistry.ts); não há mapa paralelo aqui.
import { AXIS_REGISTRY, getAxisByPath } from '@/lib/navigationRegistry';
import { getCagpIconSvg, resolveCagpIconName } from '@/lib/cagpIcons';
import { asset } from '@/lib/paths';

const activeAxis = getAxisByPath(Astro.url.pathname);

const ICONS: Record<string, string> = {
  hoje: 'hoje',
  guias: 'thesis',
  curso: 'curriculo',
  mais: 'menu',
};
---

<nav
  id="cagp-bottom-nav"
  class="md:hidden fixed inset-x-0 bottom-0 z-[1040] bg-white border-t-3 border-border select-none"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
  aria-label="Navegação principal"
>
  <div class="max-w-lg mx-auto px-0.5 py-1.5 grid grid-cols-5 items-center">
    {AXIS_REGISTRY.map((axis) => {
      const isCurrent = activeAxis?.id === axis.id;
      const isChapa = axis.id === 'chapa';
      const isMais = axis.id === 'mais';
      const iconSvg = isChapa ? '' : getCagpIconSvg(resolveCagpIconName(ICONS[axis.id] ?? axis.icon), 'w-5 h-5');

      return (
        <a
          href={axis.rootHref}
          data-bottom-axis={axis.id}
          data-opens-sheet={isMais ? 'mais' : undefined}
          aria-haspopup={isMais ? 'dialog' : undefined}
          aria-current={isCurrent ? 'page' : undefined}
          class={`cagp-bottom-axis-item flex flex-col items-center justify-center gap-1 min-h-[52px] min-w-0 py-1 px-0 rounded-xl no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset ${
            isCurrent ? 'is-active text-primary' : 'text-foreground'
          }`}
        >
          <span class="cagp-bottom-axis-pill w-11 h-7 rounded-lg flex items-center justify-center border-2">
            {isChapa ? (
              <img
                src={asset('/logos/semente/semente-simbolo.webp')}
                alt=""
                width={466}
                height={603}
                class="h-5 w-auto"
                aria-hidden="true"
              />
            ) : (
              <span class="flex" aria-hidden="true" set:html={iconSvg} />
            )}
          </span>
          <span class="text-xs font-heading font-bold uppercase tracking-[0.01em] leading-tight text-center max-w-full">
            {axis.mobileLabel}
          </span>
        </a>
      );
    })}
  </div>
</nav>

<style>
  /* Pílula: transparente em repouso; ativa = roxo + contorno grafite + sombra Chip (DESIGN.md › Navigation). */
  .cagp-bottom-axis-pill {
    background: transparent;
    border-color: transparent;
    color: var(--color-foreground);
    transition: background-color 150ms var(--ease-snap, ease), border-color 150ms;
  }
  .cagp-bottom-axis-item.is-active .cagp-bottom-axis-pill {
    background: var(--color-primary);
    border-color: var(--color-border);
    color: #fff;
    box-shadow: 2px 2px 0 0 var(--color-border);
  }
  /* O símbolo da Semente é asset policromático: na aba ativa ganha um fundo branco
     para manter a zona de proteção e não sumir sobre o roxo. */
  .cagp-bottom-axis-item[data-bottom-axis='chapa'].is-active .cagp-bottom-axis-pill {
    background: #fff;
  }
  .cagp-bottom-axis-item:active .cagp-bottom-axis-pill {
    transform: translateY(1px);
  }
</style>

<script>
  import { getAxisByPath } from '@/lib/navigationRegistry';

  function syncMobileBottomNav() {
    const nav = document.getElementById('cagp-bottom-nav');
    if (!nav) return;
    const activeId = getAxisByPath(window.location.pathname)?.id;

    nav.querySelectorAll<HTMLAnchorElement>('[data-bottom-axis]').forEach((link) => {
      const isCurrent = link.dataset.bottomAxis === activeId;
      link.classList.toggle('is-active', isCurrent);
      link.classList.toggle('text-primary', isCurrent);
      link.classList.toggle('text-foreground', !isCurrent);
      if (isCurrent) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');

      // "Mais" abre o painel por cima da página; o href /mais fica como fallback sem JS.
      if (link.dataset.opensSheet === 'mais' && !(link as any).__mais_bound) {
        (link as any).__mais_bound = true;
        link.addEventListener('click', (e) => {
          if (e.metaKey || e.ctrlKey || e.shiftKey) return;
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('cagp:open-mais'));
        });
      }
    });
  }

  syncMobileBottomNav();
  document.addEventListener('astro:page-load', syncMobileBottomNav);
</script>
