---
// src/components/shell/BottomNav.astro — Barra Inferior Mobile (< 768px) com os 5 Eixos Canônicos (Proposta A)
import { AXIS_REGISTRY, getAxisByPath } from '../../lib/navigationRegistry';
import { getCagpIconSvg, resolveCagpIconName } from '../../lib/cagpIcons';

const currentPath = Astro.url.pathname;
const activeAxis = getAxisByPath(currentPath) || AXIS_REGISTRY[0];
---

<nav
  id="cagp-bottom-nav"
  class="md:hidden fixed inset-x-0 bottom-0 z-[1040] bg-white border-t border-[#DFDBD2] select-none"
  style="padding-bottom: env(safe-area-inset-bottom, 0px);"
  aria-label="Navegação Principal Mobile (5 Eixos)"
>
  <div
    id="cagp-bottom-nav-container"
    class="max-w-lg mx-auto px-2 py-1.5 grid grid-cols-5 gap-1 items-center"
  >
    {AXIS_REGISTRY.map((axis) => {
      const isCurrent = activeAxis.id === axis.id;
      const iconSvg = getCagpIconSvg(resolveCagpIconName(axis.id), 'w-5 h-5');

      return (
        <a
          href={axis.rootHref}
          data-bottom-axis={axis.id}
          aria-current={isCurrent ? 'page' : undefined}
          class={`cagp-bottom-axis-item flex flex-col items-center justify-center gap-0.5 min-h-[48px] py-1 px-1 rounded-xl no-underline transition-all ${
            isCurrent
              ? 'is-active text-[#8B1E2D] font-bold'
              : 'text-[#57534E] hover:text-[#8B1E2D] font-medium'
          }`}
        >
          <span
            class={`cagp-bottom-axis-pill w-10 h-7 rounded-full flex items-center justify-center transition-all ${
              isCurrent ? 'bg-[#8B1E2D]/12 text-[#8B1E2D]' : 'bg-transparent'
            }`}
            set:html={iconSvg}
          />
          <span class="text-[11px] tracking-tight leading-none truncate max-w-full">
            {axis.name}
          </span>
        </a>
      );
    })}
  </div>
</nav>

<script>
  function syncMobileBottomNav() {
    const nav = document.getElementById('cagp-bottom-nav');
    if (!nav) return;

    const baseUrl = (document.documentElement.dataset.baseUrl || '/').replace(/\/$/, '');
    let cleanPath = window.location.pathname;
    if (baseUrl && cleanPath.startsWith(baseUrl)) {
      cleanPath = cleanPath.slice(baseUrl.length) || '/';
    }
    cleanPath = cleanPath.replace(/\/index\.html$/, '') || '/';

    let activeId = 'hoje';
    if (cleanPath.startsWith('/curso') || cleanPath.startsWith('/calouros') || cleanPath.startsWith('/pesquisa')) {
      activeId = 'curso';
    } else if (
      cleanPath.startsWith('/percurso') ||
      cleanPath.startsWith('/acg') ||
      cleanPath.startsWith('/estagio') ||
      cleanPath.startsWith('/tcc') ||
      cleanPath.startsWith('/optativas')
    ) {
      activeId = 'curriculo';
    } else if (
      cleanPath.startsWith('/documentos') ||
      cleanPath.startsWith('/faq') ||
      cleanPath.startsWith('/mapa-do-site')
    ) {
      activeId = 'acervo';
    } else if (
      cleanPath.startsWith('/sobre') ||
      cleanPath.startsWith('/gestao') ||
      cleanPath.startsWith('/transparencia')
    ) {
      activeId = 'cagp';
    }

    nav.querySelectorAll<HTMLAnchorElement>('[data-bottom-axis]').forEach((link) => {
      const id = link.getAttribute('data-bottom-axis');
      const isCurrent = id === activeId;
      const pill = link.querySelector('.cagp-bottom-axis-pill');
      link.classList.toggle('is-active', isCurrent);
      link.classList.toggle('text-[#8B1E2D]', isCurrent);
      link.classList.toggle('font-bold', isCurrent);
      link.classList.toggle('text-[#57534E]', !isCurrent);
      link.classList.toggle('font-medium', !isCurrent);
      if (pill) {
        pill.classList.toggle('bg-[#8B1E2D]/12', isCurrent);
        pill.classList.toggle('text-[#8B1E2D]', isCurrent);
      }
      if (isCurrent) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });
  }

  syncMobileBottomNav();
  document.addEventListener('astro:page-load', syncMobileBottomNav);
</script>
