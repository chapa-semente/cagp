---
// CampaignBanner.astro - Faixa Permanente Neobrutalista da Chapa Semente + Marquee Institucional
// Cores Oficiais: Laranja #FF8811, Roxo #5B2A86, Verde Petróleo #266264, Rubro CAGP #9E2424
import { asset } from '../../lib/paths';
---

<aside
  id="cagp-campaign-banner"
  transition:persist="campaign-banner"
  class="w-full bg-[#5B2A86] text-white border-b-3 border-border select-none text-xs transition-all duration-200 z-[1050] relative shadow-sm"
>
  <!-- Micro-faixa Tricolor de Identidade (Laranja Germinar + Rubro CAGP + Verde Petróleo) -->
  <div class="h-[5px] w-full flex border-b-2 border-border" aria-hidden="true">
    <div class="h-full w-1/3 bg-[#FF8811]"></div>
    <div class="h-full w-1/3 bg-[#9E2424]"></div>
    <div class="h-full w-1/3 bg-[#266264]"></div>
  </div>

  <div class="max-w-7xl mx-auto px-3.5 sm:px-6 py-2.5 flex items-center justify-between gap-3">
    <div class="flex items-center gap-2.5 sm:gap-3.5 flex-1 min-w-0">
      <!-- Logo Oficial da Chapa Semente em Destaque Visual Neobrutalista -->
      <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-xl overflow-hidden border-3 border-border shadow-sm shrink-0 bg-white flex items-center justify-center p-1">
        <img
          src={asset('/logos/semente/simbolo_semente_fiel.svg')}
          alt="Logo Oficial da Chapa Semente"
          class="w-full h-full object-contain"
          loading="eager"
        />
      </div>

      <div class="flex flex-col gap-1 flex-1 min-w-0">
        <div class="flex items-center gap-1.5 flex-wrap">
          <!-- Badge Principal: Chapa Semente com assinatura tipográfica no último E -->
          <span class="inline-flex items-center font-heading text-[11px] sm:text-xs font-extrabold tracking-wider uppercase bg-white text-[#5B2A86] px-2.5 py-0.5 rounded-full border-2 border-border shadow-xs shrink-0 -rotate-1">
            CHAPA SEM<span>E</span>NT<span class="text-[#FF8811]">E</span>
          </span>

          <!-- Badge Secundário: Verde Petróleo da Chapa -->
          <span class="hidden sm:inline-flex items-center font-heading text-[11px] font-extrabold uppercase bg-[#266264] text-white px-2.5 py-0.5 rounded-lg border-2 border-border shadow-xs shrink-0">
            POTENCIAL EM AÇÃO
          </span>

          <!-- Badge Institucional CAGP -->
          <span class="hidden lg:inline-flex items-center font-heading text-[11px] font-extrabold uppercase bg-[#9E2424] text-white px-2.5 py-0.5 rounded-lg border-2 border-border shadow-xs shrink-0">
            FAFICH • UFMG
          </span>

          <span id="cagp-chapa-semente-anchor" class="hidden md:inline-flex items-center text-[11px] font-mono font-bold text-[#FFD6A5]">
            • Gestão &amp; Transparência
          </span>
        </div>

        <!-- Texto Oficial com Destaque WCAG AAA -->
        <p id="cagp-banner-text" class="text-[11px] sm:text-xs font-sans text-white/95 leading-relaxed m-0 line-clamp-1 max-w-[76ch] transition-all">
          Este portal é uma realização da <strong class="text-[#FF8811] font-extrabold">Chapa Semente</strong> para o <strong>CAGP UFMG</strong>. Eleições nos dias <strong>25 e 26/Nov</strong>. Independentemente do resultado eleitoral, <strong>o código e a plataforma serão entregues à comunidade</strong> (Proposta 3 do Eixo 1).
        </p>
      </div>
    </div>

    <!-- Ações Rápidas: Link para Propostas + Alternância de texto -->
    <div class="flex items-center gap-2 shrink-0">
      <a
        href={asset('/chapa-semente')}
        class="hidden sm:inline-flex items-center gap-1 px-3 py-1.5 min-h-[40px] bg-white hover:bg-[#FFFDF9] text-[#5B2A86] border-2 border-border rounded-xl text-[11px] font-heading font-black uppercase tracking-wider no-underline shadow-xs transition-all active:translate-x-0.5 active:translate-y-0.5"
      >
        <span>Carta-Programa</span>
        <span class="text-[#FF8811]">→</span>
      </a>

      <button
        type="button"
        id="cagp-banner-toggle-btn"
        class="px-3 py-1.5 min-h-[40px] bg-[#FF8811] hover:bg-[#E07406] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-[#16181d] border-2 border-border rounded-xl text-[11px] font-heading font-extrabold uppercase shrink-0 flex items-center justify-center gap-1 transition-all cursor-pointer shadow-xs"
        aria-expanded="false"
        aria-controls="cagp-banner-text"
        title="Expandir ou recolher compromisso da Chapa Semente"
      >
        <span id="cagp-banner-toggle-label">Compromisso</span>
        <span id="cagp-banner-toggle-icon" class="text-[10px]" aria-hidden="true">▼</span>
      </button>
    </div>
  </div>
</aside>

<script>
  function setupCampaignBanner() {
    const banner = document.getElementById('cagp-campaign-banner');
    const toggleBtn = document.getElementById('cagp-banner-toggle-btn');
    const bannerText = document.getElementById('cagp-banner-text');
    const toggleIcon = document.getElementById('cagp-banner-toggle-icon');
    if (!banner || !toggleBtn || !bannerText || !toggleIcon) return;

    let isExpanded = false;
    toggleBtn.onclick = () => {
      isExpanded = !isExpanded;
      toggleBtn.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        bannerText.classList.remove('line-clamp-1');
        toggleIcon.textContent = '▲';
      } else {
        bannerText.classList.add('line-clamp-1');
        toggleIcon.textContent = '▼';
      }
    };
  }

  setupCampaignBanner();
  document.addEventListener('astro:page-load', setupCampaignBanner);
</script>
