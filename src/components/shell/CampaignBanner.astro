---
// CampaignBanner.astro - Faixa Permanente Neobrutalista da Chapa Semente + Marquee Institucional
// Cores Oficiais: Laranja #FE8812, Roxo #5B2A85, Verde Petróleo #266264 (Rubro CAGP #9E2424 = apenas selo)
import { asset } from '@/lib/paths';
---

<aside
  id="cagp-campaign-banner"
  transition:persist="campaign-banner"
  data-collapsed="false"
  class="sticky top-0 w-full bg-primary text-white border-b-3 border-border select-none text-xs transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] z-[1050] shadow-sm overflow-hidden"
>
  <!-- Micro-faixa Tricolor Semente (Laranja Germinar + Branco + Verde-Petróleo) -->
  <div class="h-[4px] w-full flex border-b-2 border-border shrink-0" aria-hidden="true">
    <div class="h-full w-1/3 bg-accent"></div>
    <div class="h-full w-1/3 bg-white"></div>
    <div class="h-full w-1/3 bg-secondary"></div>
  </div>

  <!-- Modo Smart Scroll Colapsado (24px total height com micro-faixa: h-5 = 20px + 4px = 24px) -->
  <div
    id="cagp-banner-compact-strip"
    class="hidden h-5 max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-3 sm:px-6 items-center justify-between gap-2 bg-primary text-white"
  >
    <a
      href={asset('/chapa-semente')}
      class="inline-flex items-center gap-1.5 text-xs font-mono font-extrabold uppercase tracking-wider text-white no-underline truncate"
    >
      <span class="inline-block w-2 h-2 rounded-full bg-accent border border-border shrink-0"></span>
      <span class="truncate">PROPOSTA MATERIALIZADA SEMENTE • VOTE 25 E 26/11</span>
    </a>

    <button
      type="button"
      id="cagp-banner-restore-btn"
      class="inline-flex items-center gap-1 px-2 py-0 h-4 bg-accent text-foreground border border-border rounded text-xs font-heading font-black uppercase tracking-wider cursor-pointer shrink-0 hover:bg-[#E07406] transition-transform active:scale-95 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1 focus-visible:ring-offset-primary disabled:opacity-50 disabled:pointer-events-none"
      title="Restaurar faixa completa de compromisso da Chapa Semente"
    >
      <span class="hidden sm:inline">Compromisso Semente <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
      <span class="sm:hidden">Compromisso <i class="bi bi-chevron-down" aria-hidden="true"></i></span>
    </button>
  </div>

  <!-- Corpo Completo do Banner no Topo (scrollY <= 80px) -->
  <div
    id="cagp-banner-full-body"
    class="max-w-[1440px] 2xl:max-w-[1600px] mx-auto px-3 sm:px-6 py-2 flex items-center justify-between gap-2.5 sm:gap-3 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
  >
    <div class="flex items-center gap-2.5 sm:gap-3.5 flex-1 min-w-0">
      <!-- Logo oficial em negativo branco sobre o roxo (manual: arquivos 3 e 12) — nunca rotacionado -->
      <a
        href={asset('/chapa-semente')}
        class="shrink-0 flex items-center rounded-lg py-1 no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-2 focus-visible:ring-offset-primary"
        title="Conheça as 14 propostas da Chapa Semente"
      >
        <img
          src={asset('/logos/semente/semente-simbolo-branco.webp')}
          alt="Chapa Semente"
          width="466"
          height="603"
          class="h-9 w-auto sm:hidden"
          loading="eager"
        />
        <img
          src={asset('/logos/semente/semente-horizontal-branco.webp')}
          alt="Chapa Gestão Pública Semente"
          width="768"
          height="229"
          class="hidden sm:block h-10 w-auto"
          loading="eager"
        />
      </a>

      <div class="flex flex-col gap-1 flex-1 min-w-0">
        <div class="flex items-center gap-1.5 flex-wrap">
          <!-- Selo de Proposta Materializada -->
          <span class="inline-flex items-center font-mono text-xs sm:text-xs font-extrabold uppercase bg-accent text-foreground px-2 py-0.5 rounded-lg border-2 border-border shadow-xs shrink-0">
            PROPOSTA MATERIALIZADA
          </span>

          <!-- Badge Secundário: Verde Petróleo da Chapa -->
          <span class="hidden md:inline-flex items-center font-heading text-xs font-extrabold uppercase bg-teal-700 text-white px-2.5 py-0.5 rounded-lg border-2 border-border shadow-xs shrink-0">
            VOTE 25 E 26/11
          </span>

          <span id="cagp-chapa-semente-anchor" class="hidden xl:inline-flex items-center text-xs font-mono font-bold text-[#FFD6A5]">
            • Eixo 1 (Proposta 3) Entregue à FAFICH
          </span>
        </div>

        <!-- Texto Oficial com Destaque WCAG AAA -->
        <div id="cagp-banner-text" class="cagp-expand cagp-expand--peek text-sm leading-normal max-w-[82ch]" style="--expand-peek: 1lh;">
          <div class="cagp-expand-inner">
            <p class="font-sans text-white m-0">
              Este SuperApp já é uma <strong class="text-[#FEF3C7] font-extrabold underline decoration-[#FE8812] underline-offset-4">proposta da Chapa Semente materializada</strong> antes da urna para o <strong>CAGP FAFICH/UFMG</strong>. Conheça nossas <strong>14 propostas</strong> e vote nos dias <strong>25 e 26 de novembro</strong>!
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Ações Rápidas: CTA Laranja Germinar + Alternância de texto / Smart Scroll -->
    <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
      <a
        href={asset('/chapa-semente')}
        class="inline-flex items-center gap-1.5 px-2.5 sm:px-3.5 py-1.5 min-h-[40px] bg-accent hover:bg-[#E07406] text-foreground border-3 border-border rounded-xl text-xs sm:text-xs font-heading font-black uppercase tracking-wider no-underline shadow-xs transition-all active:translate-x-0.5 active:translate-y-0.5 active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1 focus-visible:ring-offset-primary"
      >
        <span class="hidden sm:inline">14 Propostas • Vote 25 e 26/11</span>
        <span class="sm:hidden">Vote 25-26/11</span>
        <i class="bi bi-arrow-right" aria-hidden="true"></i>
      </a>

      <button
        type="button"
        id="cagp-banner-toggle-btn"
        class="px-2.5 sm:px-3 py-1.5 min-h-[40px] bg-white hover:bg-card active:translate-x-0.5 active:translate-y-0.5 active:shadow-none text-primary border-3 border-border rounded-xl text-xs sm:text-xs font-heading font-extrabold uppercase shrink-0 flex items-center justify-center gap-1 transition-all cursor-pointer shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white focus-visible:ring-offset-1 focus-visible:ring-offset-primary disabled:opacity-50 disabled:pointer-events-none"
        aria-expanded="false"
        aria-controls="cagp-banner-text"
        title="Expandir compromisso ou recolher faixa"
      >
        <span id="cagp-banner-toggle-label">Compromisso</span>
        <i id="cagp-banner-toggle-icon" class="bi bi-chevron-down text-xs cagp-expand-chevron" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</aside>

<script>
  function setupCampaignBanner() {
    const banner = document.getElementById('cagp-campaign-banner');
    const toggleBtn = document.getElementById('cagp-banner-toggle-btn');
    const restoreBtn = document.getElementById('cagp-banner-restore-btn');
    const bannerText = document.getElementById('cagp-banner-text');
    const toggleIcon = document.getElementById('cagp-banner-toggle-icon');
    const compactStrip = document.getElementById('cagp-banner-compact-strip');
    const fullBody = document.getElementById('cagp-banner-full-body');
    if (!banner || !toggleBtn || !bannerText || !toggleIcon || !compactStrip || !fullBody) return;

    let isTextExpanded = false;
    let manualMinimized = false;
    try {
      manualMinimized = localStorage.getItem('cagp_banner_minimized') === 'true';
    } catch {
      manualMinimized = false;
    }

    const applyCollapsedState = (collapsed: boolean) => {
      banner.setAttribute('data-collapsed', collapsed ? 'true' : 'false');
      if (collapsed) {
        compactStrip.classList.remove('hidden');
        compactStrip.classList.add('flex');
        fullBody.classList.add('hidden');
        fullBody.classList.remove('flex');
      } else {
        compactStrip.classList.add('hidden');
        compactStrip.classList.remove('flex');
        fullBody.classList.remove('hidden');
        fullBody.classList.add('flex');
      }
    };

    // Chrome Budget Rule: fora do volume Cartaz a faixa já nasce colapsada.
    const visitorMode = document.documentElement.dataset.visitorMode || 'operate';
    const quietPage = visitorMode !== 'persuade' && visitorMode !== 'experience';

    const handleScroll = () => {
      const y = window.scrollY || document.documentElement.scrollTop || 0;
      if (y > 80 || manualMinimized || quietPage) {
        applyCollapsedState(true);
      } else if (y <= 40 && !manualMinimized) {
        applyCollapsedState(false);
      }
    };

    // Mesma física da gaveta de Regras da calculadora ACG (.cagp-expand--peek em global.css).
    const setTextExpanded = (expanded: boolean) => {
      isTextExpanded = expanded;
      toggleBtn.setAttribute('aria-expanded', String(expanded));
      bannerText.classList.toggle('is-open', expanded);
    };

    toggleBtn.onclick = () => setTextExpanded(!isTextExpanded);

    if (restoreBtn) {
      restoreBtn.onclick = () => {
        manualMinimized = false;
        try {
          localStorage.removeItem('cagp_banner_minimized');
        } catch {}
        applyCollapsedState(false);
        setTextExpanded(true);
      };
    }

    handleScroll();
    if (!(window as any).__cagp_banner_scroll_bound) {
      (window as any).__cagp_banner_scroll_bound = true;
      window.addEventListener('scroll', handleScroll, { passive: true });
    }
  }

  setupCampaignBanner();
  document.addEventListener('astro:page-load', setupCampaignBanner);
</script>
