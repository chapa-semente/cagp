---
// PageFooter.astro - Rodapé Institucional Neobrutalista (Chancelas UFMG + CAGP Candangos + Chapa Semente)
import { FooterMultiColumn, type FooterColumn, type FooterSocialLink } from '@/components/boldkit/blocks/footer-section';
import { asset, route } from '@/lib/paths';

const footerColumns: FooterColumn[] = [
  {
    title: 'Eixos do SuperApp',
    links: [
      { label: 'Hoje & Campus', href: route('/') },
      { label: 'O Bacharelado', href: route('/curso') },
      { label: 'Calouros (1º Período)', href: route('/calouros') },
      { label: 'Central Curricular 10P', href: route('/percurso') },
      { label: 'Extensão & ACG (600h)', href: route('/acg') },
      { label: 'Estágio & TCC', href: route('/estagio') },
    ],
  },
  {
    title: 'Governança Discente',
    links: [
      { label: 'O CAGP UFMG', href: route('/sobre') },
      { label: 'Diretoria Executiva', href: route('/gestao') },
      { label: 'Chapa Semente 2026', href: route('/chapa-semente') },
      { label: 'Portal da Transparência', href: route('/transparencia') },
      { label: 'Acervo de Documentos', href: route('/documentos') },
    ],
  },
  {
    title: 'Suporte & Inclusão',
    links: [
      { label: 'Dúvidas Regimentais', href: route('/faq') },
      { label: 'Acessibilidade & NAI', href: route('/faq#acessibilidade') },
      { label: 'Configurações do Cofre', href: route('/configuracoes') },
      { label: 'Mapa Panorâmico', href: route('/mapa-do-site') },
      { label: 'Feedback sobre o site', href: 'mailto:chapa.semente.gp@gmail.com?subject=Feedback%20sobre%20o%20site' },
    ],
  },
];

const socialLinks: FooterSocialLink[] = [
  { platform: 'instagram', href: 'https://instagram.com/cagpufmg' },
];
import EstagiosFaixa from './EstagiosFaixa.astro';
---

<EstagiosFaixa />

<footer id="cagp-page-footer" class="relative z-10 w-full bg-card border-t-3 border-border py-8 px-4 sm:px-6 select-none text-xs text-foreground pb-24 sm:pb-10">
  <!-- Barra Cromática Tri-Camada Superior -->
  <div class="max-w-[1360px] mx-auto space-y-6">
    <!-- Régua de Chancelas Conjuntas (Chapa Semente como Realizadora + CAGP UFMG) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pb-6 border-b-3 border-border">
      <!-- 1. REALIZAÇÃO PRINCIPAL: CHAPA SEMENTE -->
      <a
        href={route('/chapa-semente')}
        class="p-4 rounded-xl border-2 border-border bg-white shadow-sm flex items-center gap-3.5 no-underline text-inherit hover:translate-y-[-1px] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        title="Conheça a Carta-Programa da Chapa Semente"
      >
        <div class="min-w-0 flex-1">
          <img
            src={asset('/logos/semente/semente-horizontal.webp')}
            alt="Chapa Gestão Pública Semente"
            width="768"
            height="229"
            loading="lazy"
            class="h-12 w-auto max-w-full"
          />
          <span class="block font-heading font-bold text-base leading-tight text-foreground mt-3">
            Toda mudança começa pequena.
          </span>
        </div>
      </a>

      <!-- 2. ENTIDADE REPRESENTADA: CAGP UFMG (Os Candangos de Bruno Giorgi, 1959) -->
      <div class="p-4 rounded-xl border-2 border-border bg-white shadow-sm flex items-center gap-3.5">
        <div class="w-12 h-12 rounded-xl bg-white flex items-center justify-center p-1.5 border-2 border-border shadow-xs shrink-0">
          <img
            src={asset('/logos/cagp/10_simbolo_transparente_positivo.svg')}
            alt="Símbolo Os Candangos (Bruno Giorgi, 1959) — CAGP"
            class="w-full h-full object-contain"
          />
        </div>
        <div class="min-w-0">
          <div class="font-heading font-black text-base uppercase tracking-tight text-foreground leading-none">
            CAGP
          </div>
          <div class="h-[3px] w-24 bg-ufmg-red my-1" aria-hidden="true"></div>
          <div class="font-heading text-xs font-extrabold tracking-wide uppercase">
            <span class="text-foreground">FAFICH</span>{' '}
            <span class="text-ufmg-red">UFMG</span>
          </div>
        </div>
      </div>
    </div>

    <!-- LogoCloud Oficial: Órgãos Universitários, Assistência Estudantil e Sistemas -->
    <div class="pb-6 border-b-3 border-border space-y-3">
      <div class="flex items-center justify-between">
        <h3 class="font-heading text-xs font-extrabold text-foreground m-0">
          Ecossistema Institucional UFMG
        </h3>
        <span class="font-mono text-xs font-bold text-secondary uppercase tabular-nums">
          Fontes Oficiais Verificadas
        </span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-2.5">
        <a
          href="https://www.ufmg.br/prograd/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl border-3 border-border bg-white shadow-xs hover:translate-y-[-1px] transition-all flex items-center justify-center h-12 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          title="PROGRAD — Pró-Reitoria de Graduação UFMG"
        >
          <img src={asset('/logos/ufmg/assinaturas/prograd-ufmg.jpg')} alt="PROGRAD UFMG" class="max-h-8 max-w-full object-contain" />
        </a>
        <a
          href="https://www.ufmg.br/proex/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl border-3 border-border bg-white shadow-xs hover:translate-y-[-1px] transition-all flex items-center justify-center h-12 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          title="PROEX — Pró-Reitoria de Extensão UFMG"
        >
          <img src={asset('/logos/ufmg/assinaturas/proex-ufmg.jpg')} alt="PROEX UFMG" class="max-h-8 max-w-full object-contain" />
        </a>
        <a
          href="https://www.ufmg.br/prae/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl border-3 border-border bg-white shadow-xs hover:translate-y-[-1px] transition-all flex items-center justify-center h-12 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          title="PRAE — Pró-Reitoria de Assuntos Estudantis"
        >
          <img src={asset('/logos/ufmg/assinaturas/prae-ufmg.png')} alt="PRAE UFMG" class="max-h-8 max-w-full object-contain" />
        </a>
        <a
          href="https://www.fump.ufmg.br/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl border-3 border-border bg-white shadow-xs hover:translate-y-[-1px] transition-all flex items-center justify-center h-12 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          title="FUMP — Fundação Universitária Mendes Pimentel"
        >
          <img src={asset('/logos/fump/03-fump-sinae-logo-colorido-fundo-branco.png')} alt="FUMP SINAE" class="max-h-8 max-w-full object-contain" />
        </a>
        <a
          href="https://www.ufmg.br/nai/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl border-3 border-border bg-white shadow-xs hover:translate-y-[-1px] transition-all flex items-center justify-center h-12 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          title="NAI — Núcleo de Acessibilidade e Inclusão"
        >
          <img src={asset('/logos/ufmg/assinaturas/nai-ufmg.png')} alt="NAI UFMG" class="max-h-8 max-w-full object-contain" />
        </a>
        <a
          href="https://sistemas.ufmg.br/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl border-3 border-border bg-white shadow-xs hover:translate-y-[-1px] transition-all flex items-center justify-center h-12 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          title="Portal minhaUFMG"
        >
          <img src={asset('/logos/minhaufmg/logo-minha-ufmg.png')} alt="minhaUFMG" class="max-h-7 max-w-full object-contain" />
        </a>
        <a
          href="https://sistemas.ufmg.br/"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2 rounded-xl border-3 border-border bg-white shadow-xs hover:translate-y-[-1px] transition-all flex items-center justify-center h-12 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          title="SIGA UFMG — Sistema Acadêmico da Graduação"
        >
          <img src={asset('/logos/siga/siga-ufmg-fundo-branco.webp')} alt="SIGA UFMG" class="max-h-8 max-w-full object-contain" />
        </a>
      </div>
    </div>

    <!-- Informações de Atendimento & Navegação Rápida -->
    <div class="flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
      <div class="space-y-1.5 max-w-xl">
        <p class="font-heading font-extrabold text-sm uppercase tracking-wide text-foreground m-0">
          Centro Acadêmico de Gestão Pública — Gestão Estudantil &amp; Super App Discente
        </p>
        <p class="text-xs font-sans text-muted-foreground leading-relaxed m-0 max-w-prose">
          Av. Pres. Antônio Carlos, 6627 — Campus Pampulha, Belo Horizonte - MG • CEP 31270-901<br />
          Secretaria GP: Sala 2039 (4ª feira, 13h–19h • Tel: <span class="tabular-nums">3409-3826</span>) • CEAG 2º Andar (Seg a Sex, 08h–22h) • Coordenação (Profª Isabele Mitozo):{' '}
          <span class="font-mono font-bold text-secondary">coordgestaopublicaufmg@gmail.com</span> / <span class="font-mono font-bold text-foreground">gestaopublica@ufmg.br</span>
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2.5 text-xs font-heading font-extrabold uppercase">
        <a
          href={route('/chapa-semente')}
          class="px-3.5 py-2.5 min-h-[44px] inline-flex items-center gap-1.5 rounded-xl border-3 border-border bg-primary text-white shadow-sm hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-xs no-underline transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          <span class="w-2 h-2 rounded-full bg-accent"></span>
          <span>Chapa Semente</span>
        </a>
        <a
          href={route('/mapa-do-site')}
          class="px-3.5 py-2.5 min-h-[44px] inline-flex items-center rounded-xl border-3 border-border bg-card text-foreground shadow-sm hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-xs hover:bg-muted no-underline transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          Mapa do Site
        </a>
        <a
          href={route('/faq')}
          class="px-3.5 py-2.5 min-h-[44px] inline-flex items-center rounded-xl border-3 border-border bg-card text-foreground shadow-sm hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-xs hover:bg-muted no-underline transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          Dúvidas &amp; NAI
        </a>
        <a
          href={route('/documentos')}
          class="px-3.5 py-2.5 min-h-[44px] inline-flex items-center rounded-xl border-3 border-border bg-card text-foreground shadow-sm hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-xs hover:bg-muted no-underline transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          Documentos
        </a>
        <a
          href={route('/transparencia')}
          class="px-3.5 py-2.5 min-h-[44px] inline-flex items-center rounded-xl border-3 border-border bg-card text-foreground shadow-sm hover:translate-x-[1px] hover:translate-y-[1px] hover:shadow-xs no-underline transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        >
          Transparência
        </a>
        <button
          type="button"
          onclick="window.dispatchEvent(new CustomEvent('cagp:open-settings'))"
          class="px-3.5 py-2.5 min-h-[44px] inline-flex items-center rounded-xl border-2 border-border bg-white text-foreground shadow-sm hover:-translate-x-px hover:-translate-y-px hover:shadow-md hover:bg-primary-tint active:translate-x-0.5 active:translate-y-0.5 active:shadow-none cursor-pointer font-heading text-xs font-bold uppercase tracking-[0.03em] transition-[transform,box-shadow,background-color] duration-(--duration-press) ease-(--ease-spring-snappy) focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none"
          aria-label="Abrir painel de configurações"
        >
          Ajustes
        </button>
      </div>
    </div>

    <!-- BoldKit Multi-Column Footer Grid -->
    <div class="pt-6 border-t-3 border-border">
      <FooterMultiColumn
        client:visible
        columns={footerColumns}
        socialLinks={socialLinks}
        copyright="© 2026 Chapa Semente"
        className="py-2 px-0 bg-transparent border-t-0"
      />
    </div>
  </div>
</footer>
