---
// PageFooter.astro — Rodapé enxuto (DESIGN.md › Rodapé; decisão de 11/11/2026: 5 links).
// Faixa "da semente ao fruto" → chancela da Chapa Semente como realizadora (sem o selo do CAGP) →
// cinco links do site → portais da UFMG e atendimento em texto → linha de direitos.
// Sem colunas de links (repetiam a navegação com outros nomes) e sem ilha React.
import { asset, route } from '@/lib/paths';
import { ATENDIMENTO_CURSO } from '@/data/acolhimento';
import { CHAPA_INSTAGRAM, CHAPA_INSTAGRAM_URL } from '@/lib/chapaSementeData';
import EstagiosFaixa from './EstagiosFaixa.astro';

const links = [
  { label: 'Documentos', href: route('/documentos') },
  { label: 'Dúvidas', href: route('/faq') },
  // "?de=" preenche o campo "em que página" de quem vai reclamar daquela página.
  { label: 'Achou um erro? Fala com a gente', href: `${route('/ouvidoria')}?de=${encodeURIComponent(Astro.url.pathname)}` },
  { label: 'Transparência', href: route('/transparencia') },
  { label: 'Mapa do site', href: route('/mapa-do-site') },
];

const portais = [
  { label: 'SIGA e minhaUFMG', href: 'https://sistemas.ufmg.br/' },
  { label: 'FUMP', href: 'https://www.fump.ufmg.br/' },
  { label: 'PRAE', href: 'https://www.ufmg.br/prae/' },
  { label: 'NAI', href: 'https://www.ufmg.br/nai/' },
  { label: 'Prograd', href: 'https://www.ufmg.br/prograd/' },
  { label: 'Proex', href: 'https://www.ufmg.br/proex/' },
];
---

<EstagiosFaixa />

<footer id="cagp-page-footer" class="relative z-10 w-full bg-card border-t-3 border-border py-8 px-4 sm:px-6 text-foreground pb-24 sm:pb-10">
  <!-- Barra Cromática Tri-Camada Superior -->
  <div class="max-w-[1360px] mx-auto space-y-6">
    <div>
      <!-- REALIZAÇÃO: CHAPA SEMENTE (o selo do CAGP saiu do rodapé em 13/11/2026) -->
      <a
        href={route('/chapa-semente')}
        class="w-full md:w-fit md:min-w-[24rem] p-4 rounded-xl border-2 border-border bg-white shadow-sm flex items-center gap-3.5 no-underline text-inherit hover:translate-y-[-1px] transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        title="Conheça a Carta-Programa da Chapa 2, a Semente"
      >
        <div class="min-w-0 flex-1">
          <img
            src={asset('/logos/semente/semente-horizontal.webp')}
            alt="Chapa Gestão Pública Semente"
            width="768"
            height="229"
            loading="lazy"
            class="h-12 w-auto max-w-full"
          />
          <span class="block font-heading font-bold text-base leading-tight text-foreground mt-3">
            Toda mudança começa pequena.
          </span>
        </div>
      </a>
    </div>

    <!-- Cinco links do site -->
    <nav aria-label="Atalhos do rodapé">
      <ul class="cagp-footer-links" role="list">
        {links.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav>

    <!-- Portais da UFMG e atendimento: texto, sem nuvem de logos -->
    <div class="cagp-footer-info">
      <p>
        <strong>Portais da UFMG</strong>
        {portais.map((p, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            <a href={p.href} target="_blank" rel="noopener noreferrer">{p.label}</a>
          </>
        ))}
      </p>
      <p>
        <strong>Atendimento do curso</strong>
        Secretaria de Gestão Pública, sala 2039 da FAFICH (quartas, 13h às 19h), telefone <span class="tabular-nums">3409-3826</span>.
        CEAG, 2º andar (segunda a sexta, 8h às 22h). Coordenação:{' '}
        <a href={`mailto:${ATENDIMENTO_CURSO.coordenacao.email}`}>{ATENDIMENTO_CURSO.coordenacao.email}</a>{' '}ou{' '}
        <a href={`mailto:${ATENDIMENTO_CURSO.secretaria.email}`}>{ATENDIMENTO_CURSO.secretaria.email}</a>.
      </p>
      <p>
        <strong>CAGP</strong>
        <a href={CHAPA_INSTAGRAM_URL} target="_blank" rel="noopener noreferrer">Instagram da Chapa 2, {CHAPA_INSTAGRAM}</a>
        <span aria-hidden="true"> · </span>
        <button type="button" onclick="window.dispatchEvent(new CustomEvent('cagp:open-settings'))">Ajustes de leitura</button>
      </p>
    </div>

    <p class="cagp-footer-direitos">© 2026 Chapa Semente</p>
  </div>
</footer>

<style>
  .cagp-footer-links { display: flex; flex-wrap: wrap; gap: 0.75rem; margin: 0; padding: 0; list-style: none; }
  .cagp-footer-links a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 1.125rem;
    border: 3px solid var(--color-border);
    border-radius: 12px;
    background: #fff;
    color: var(--color-foreground);
    font: 700 0.875rem/1 var(--font-heading);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    text-decoration: none;
    box-shadow: 3px 3px 0 0 var(--shadow-color, var(--color-border));
    transition: translate var(--duration-press) var(--ease-spring-snappy), box-shadow var(--duration-press) var(--ease-spring-snappy);
  }
  .cagp-footer-links a:hover { translate: -1px -1px; box-shadow: 5px 5px 0 0 var(--shadow-color, var(--color-border)); }
  .cagp-footer-links a:active { translate: 3px 3px; box-shadow: 0 0 0 0 var(--color-border); }
  .cagp-footer-links a:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 3px; }
  .cagp-footer-info { display: grid; gap: 0.875rem; max-width: 68ch; }
  .cagp-footer-info p { margin: 0; font-size: 0.875rem; line-height: 1.6; color: var(--color-muted-foreground); overflow-wrap: anywhere; }
  .cagp-footer-info strong { display: block; color: var(--color-foreground); }
  .cagp-footer-info :is(a, button) {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-primary);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.22em;
    cursor: pointer;
  }
  .cagp-footer-info :is(a, button):focus-visible { outline: 2px solid var(--color-primary); outline-offset: 2px; }
  .cagp-footer-direitos { margin: 0; padding-top: 1rem; border-top: 2px solid var(--color-border); font-size: 0.875rem; color: var(--color-muted-foreground); }
</style>
