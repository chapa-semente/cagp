---
// src/components/shell/SuperAppHeader.astro — Cabeçalho do celular (< 768px), Modelo B.
// [‹ voltar] Título · [Buscar] [Perfil]. O "voltar" usa o histórico quando a página anterior
// é deste site; senão leva à raiz da aba. Na raiz da aba não há seta.
import { AXIS_REGISTRY, getItemByPath, normalizePathname } from '@/lib/navigationRegistry';
import { getCagpIconSvg } from '@/lib/cagpIcons';

const cleanPath = normalizePathname(Astro.url.pathname);
const isHome = cleanPath === '/';
const owner = getItemByPath(Astro.url.pathname);
const axis = owner?.axis ?? AXIS_REGISTRY[0];
const isAxisRoot = owner ? normalizePathname(axis.rootHref) === cleanPath : false;
// Na raiz mostra o nome da aba; dentro dela, o nome curto da página.
const title = owner && !isAxisRoot ? owner.item.shortLabel : axis.name;
---

<header
  id="cagp-super-app-header"
  class={`${isHome ? 'hidden' : 'block md:hidden'} sticky top-0 z-[1030] w-full bg-white border-b-3 border-border select-none`}
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div class="px-3 h-14 flex items-center justify-between gap-2">
    <div class="flex items-center gap-1 min-w-0 flex-1">
      {!isAxisRoot && (
        <a
          href={axis.rootHref}
          id="cagp-header-back"
          data-fallback-href={axis.rootHref}
          class="w-11 h-11 min-w-[44px] rounded-xl flex items-center justify-center text-foreground no-underline shrink-0 hover:bg-muted focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary"
          aria-label="Voltar"
        >
          <i class="bi bi-arrow-left text-lg" aria-hidden="true"></i>
        </a>
      )}
      <span class={`font-heading text-base font-bold truncate ${isAxisRoot ? 'pl-1' : ''}`}>{title}</span>
    </div>

    <div class="flex items-center gap-1.5 shrink-0">
      <button
        type="button"
        id="cagp-btn-spotlight"
        class="w-11 h-11 min-w-[44px] rounded-xl bg-white hover:bg-muted border-3 border-border text-primary flex items-center justify-center cursor-pointer active:translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        aria-label="Buscar no site"
      >
        <span class="flex" aria-hidden="true" set:html={getCagpIconSvg('search', 'w-4 h-4')} />
      </button>

      <button
        type="button"
        id="cagp-btn-passport"
        class="w-11 h-11 min-w-[44px] justify-center rounded-xl bg-primary hover:bg-primary-hover border-3 border-border flex items-center cursor-pointer active:translate-y-0.5 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
        aria-label="Abrir meu perfil e Passaporte"
      >
        <span
          id="cagp-header-avatar-slot"
          class="w-7 h-7 rounded-lg bg-white text-primary border-2 border-border flex items-center justify-center text-xs font-heading font-bold overflow-hidden"
        >
          GP
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  import { renderAvatarHtml } from '@/lib/avatarHelper';

  function cameFromThisSite(): boolean {
    try {
      return Boolean(document.referrer) && new URL(document.referrer).origin === window.location.origin && history.length > 1;
    } catch {
      return false;
    }
  }

  function setupHeaderListeners() {
    const dispatch = (evt: string) => window.dispatchEvent(new CustomEvent(evt));

    const spotlightBtn = document.getElementById('cagp-btn-spotlight');
    if (spotlightBtn) spotlightBtn.onclick = () => dispatch('cagp:open-spotlight');

    const passportBtn = document.getElementById('cagp-btn-passport');
    if (passportBtn) passportBtn.onclick = () => dispatch('cagp:open-passport');

    // Com o ClientRouter, navegações internas não mudam document.referrer; guardamos a origem.
    const back = document.getElementById('cagp-header-back') as HTMLAnchorElement | null;
    if (back) {
      back.onclick = (e) => {
        const internal = sessionStorage.getItem('cagp_nav_internal') === '1' || cameFromThisSite();
        if (internal && history.length > 1) {
          e.preventDefault();
          history.back();
        }
      };
    }

    const avatarSlot = document.getElementById('cagp-header-avatar-slot');
    if (avatarSlot) {
      try {
        const raw = localStorage.getItem('cagp_student_profile_v1');
        if (raw) {
          const profile = JSON.parse(raw);
          if (profile.avatarPreset) {
            avatarSlot.innerHTML = renderAvatarHtml(profile.avatarPreset, profile.prideChoice);
          }
        }
      } catch {
        // sem perfil salvo
      }
    }
  }

  setupHeaderListeners();
  document.addEventListener('astro:page-load', setupHeaderListeners);
  // Qualquer troca de página feita pelo ClientRouter é navegação interna.
  document.addEventListener('astro:after-swap', () => {
    try {
      sessionStorage.setItem('cagp_nav_internal', '1');
    } catch {
      // armazenamento bloqueado: cai no referrer
    }
  });
  window.addEventListener('cagp:vault-updated', setupHeaderListeners);
</script>
