---
// src/components/shell/SuperAppHeader.astro — Barra Superior Mobile para Sub-rotas (Neobrutalista)
import { AXIS_REGISTRY, getAxisByPath, normalizePathname } from '../../lib/navigationRegistry';
import { getCagpIconSvg, resolveCagpIconName } from '../../lib/cagpIcons';

const cleanPath = normalizePathname(Astro.url.pathname);
const isHomeActive = cleanPath === '/' || cleanPath === '';
const activeAxis = getAxisByPath(Astro.url.pathname) || AXIS_REGISTRY[0];
---

<header
  id="cagp-super-app-header"
  class={`${
    isHomeActive ? 'hidden' : 'block md:hidden'
  } sticky top-0 z-[1030] w-full bg-white border-b-[3px] border-[#0A0A0A] select-none transition-colors shadow-[0_2px_0_0_#0A0A0A]`}
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div class="px-3 py-2 flex items-center justify-between gap-2">
    <!-- Esquerda: Botão Menu Unificado (44x44px) + Eixo Ativo -->
    <div class="flex items-center gap-2 min-w-0 flex-1">
      <button
        type="button"
        id="cagp-mobile-menu-btn"
        class="w-11 h-11 rounded-xl bg-[#FBF8F3] hover:bg-[#F4F1EA] border-[2.5px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-[#0A0A0A] hover:text-[#5B2A86] flex items-center justify-center shrink-0 transition-all cursor-pointer active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Abrir Menu Geral"
        aria-label="Abrir gaveta de navegação"
      >
        <span set:html={getCagpIconSvg('menu', 'w-5 h-5')} />
      </button>

      <a
        href={activeAxis.rootHref}
        class="inline-flex items-center gap-1.5 text-xs font-bold text-[#5B2A86] no-underline min-w-0 truncate py-1"
      >
        <span class="shrink-0" set:html={getCagpIconSvg(resolveCagpIconName(activeAxis.id), 'w-4 h-4')} />
        <span class="font-heading text-sm font-extrabold uppercase tracking-tight text-[#0A0A0A] truncate">
          {activeAxis.number}. {activeAxis.name}
        </span>
      </a>
    </div>

    <!-- Direita: Ações Rápidas Táteis Neobrutalistas -->
    <div class="flex items-center gap-1.5 shrink-0">
      <button
        type="button"
        id="cagp-btn-spotlight"
        class="w-11 h-11 rounded-xl bg-[#FBF8F3] hover:bg-[#F4F1EA] border-[2.5px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-[#0A0A0A] flex items-center justify-center transition-all cursor-pointer active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Buscar no Super App (⌘K)"
        aria-label="Abrir busca Spotlight"
      >
        <span class="text-[#5B2A86]" set:html={getCagpIconSvg('search', 'w-4 h-4')} />
      </button>

      <button
        type="button"
        id="cagp-btn-campus"
        class="w-11 h-11 rounded-xl bg-[#FBF8F3] hover:bg-[#F4F1EA] border-[2.5px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-[#0A0A0A] flex items-center justify-center relative transition-all cursor-pointer active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Plantão Noturno • RU II & Circular"
        aria-label="Abrir status do Campus Agora"
      >
        <span set:html={getCagpIconSvg('bell', 'w-4 h-4')} />
        <span class="w-2.5 h-2.5 rounded-full bg-[#15803D] border border-black absolute top-1.5 right-1.5 animate-pulse"></span>
      </button>

      <button
        type="button"
        id="cagp-btn-passport"
        class="min-h-[44px] pl-1.5 pr-3 py-1 rounded-xl bg-[#5B2A86] hover:bg-[#4A216E] text-white border-[2.5px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-xs font-heading font-bold flex items-center gap-1.5 transition-all cursor-pointer active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Abrir Passaporte Discente"
        aria-label="Abrir Passaporte Discente"
      >
        <span
          id="cagp-header-avatar-slot"
          class="w-7 h-7 rounded-lg bg-white/20 border border-white/40 flex items-center justify-center text-[11px] font-heading font-extrabold overflow-hidden"
        >
          GP
        </span>
        <span class="text-xs font-bold font-sans">Perfil</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { renderAvatarHtml } from '../../lib/avatarHelper';

  function setupHeaderListeners() {
    const dispatch = (evt: string) => window.dispatchEvent(new CustomEvent(evt));

    const spotlightBtn = document.getElementById('cagp-btn-spotlight');
    if (spotlightBtn) spotlightBtn.onclick = () => dispatch('cagp:open-spotlight');

    const campusBtn = document.getElementById('cagp-btn-campus');
    if (campusBtn) campusBtn.onclick = () => dispatch('cagp:open-campus');

    const passportBtn = document.getElementById('cagp-btn-passport');
    if (passportBtn) passportBtn.onclick = () => dispatch('cagp:open-passport');

    const mobileMenuBtn = document.getElementById('cagp-mobile-menu-btn');
    if (mobileMenuBtn) {
      mobileMenuBtn.onclick = () => {
        if (typeof (window as any).__cagp_open_drawer === 'function') {
          (window as any).__cagp_open_drawer();
        } else {
          dispatch('cagp:open-sidebar');
        }
      };
    }

    const avatarSlot = document.getElementById('cagp-header-avatar-slot');
    if (avatarSlot) {
      try {
        const raw = localStorage.getItem('cagp_student_profile_v1');
        if (raw) {
          const profile = JSON.parse(raw);
          if (profile.avatarPreset) {
            avatarSlot.innerHTML = renderAvatarHtml(profile.avatarPreset, profile.prideChoice);
          }
        }
      } catch (e) {}
    }
  }

  setupHeaderListeners();
  document.addEventListener('astro:page-load', setupHeaderListeners);
  window.addEventListener('cagp:vault-updated', setupHeaderListeners);
</script>
