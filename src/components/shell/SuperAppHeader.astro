---
// src/components/shell/SuperAppHeader.astro — Barra Superior Mobile para Sub-rotas (Eliminada no Tablet/Desktop onde AppShellSidebar atua)
import { AXIS_REGISTRY, getAxisByPath, normalizePathname } from '../../lib/navigationRegistry';
import { getCagpIconSvg, resolveCagpIconName } from '../../lib/cagpIcons';

const cleanPath = normalizePathname(Astro.url.pathname);
const isHomeActive = cleanPath === '/' || cleanPath === '';
const activeAxis = getAxisByPath(Astro.url.pathname) || AXIS_REGISTRY[0];
---

<header
  id="cagp-super-app-header"
  class={`${
    isHomeActive ? 'hidden' : 'block md:hidden'
  } sticky top-0 z-[1030] w-full bg-white border-b border-[#DFDBD2] select-none transition-colors`}
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div class="px-3 py-2 flex items-center justify-between gap-2">
    <!-- Esquerda: Botão Menu Unificado (44x44px) + Eixo Ativo -->
    <div class="flex items-center gap-2 min-w-0 flex-1">
      <button
        type="button"
        id="cagp-mobile-menu-btn"
        class="w-11 h-11 rounded-xl bg-[#FBF8F3] hover:bg-[#F4F1EA] border border-[#DFDBD2] text-[#292524] hover:text-[#8B1E2D] flex items-center justify-center shrink-0 transition-colors cursor-pointer"
        title="Abrir Menu Geral"
        aria-label="Abrir gaveta de navegação"
      >
        <span set:html={getCagpIconSvg('menu', 'w-5 h-5')} />
      </button>

      <a
        href={activeAxis.rootHref}
        class="inline-flex items-center gap-1.5 text-xs font-bold text-[#8B1E2D] no-underline min-w-0 truncate py-1"
      >
        <span class="shrink-0" set:html={getCagpIconSvg(resolveCagpIconName(activeAxis.id), 'w-4 h-4')} />
        <span class="font-['Oswald'] text-sm uppercase tracking-wide text-[#0A0A0A] truncate">
          {activeAxis.number}. {activeAxis.name}
        </span>
      </a>
    </div>

    <!-- Direita: Ações Rápidas Táteis (44x44px mínimo) -->
    <div class="flex items-center gap-1.5 shrink-0">
      <button
        type="button"
        id="cagp-btn-spotlight"
        class="w-11 h-11 rounded-full bg-[#FBF8F3] hover:bg-[#F4F1EA] border border-[#DFDBD2] text-[#292524] flex items-center justify-center transition-colors cursor-pointer"
        title="Buscar no Super App (⌘K)"
        aria-label="Abrir busca Spotlight"
      >
        <span class="text-[#8B1E2D]" set:html={getCagpIconSvg('search', 'w-4 h-4')} />
      </button>

      <button
        type="button"
        id="cagp-btn-campus"
        class="w-11 h-11 rounded-full bg-[#FBF8F3] hover:bg-[#F4F1EA] border border-[#DFDBD2] text-[#292524] flex items-center justify-center relative transition-colors cursor-pointer"
        title="Plantão Noturno • RU II & Circular"
        aria-label="Abrir status do Campus Agora"
      >
        <span set:html={getCagpIconSvg('bell', 'w-4 h-4')} />
        <span class="w-2 h-2 rounded-full bg-[#15803D] absolute top-2 right-2"></span>
      </button>

      <button
        type="button"
        id="cagp-btn-passport"
        class="min-h-[44px] pl-1.5 pr-3 py-1 rounded-full bg-[#8B1E2D] hover:bg-[#6E1420] text-white text-xs font-semibold flex items-center gap-1.5 transition-colors cursor-pointer shadow-2xs"
        title="Abrir Passaporte Discente"
        aria-label="Abrir Passaporte Discente"
      >
        <span
          id="cagp-header-avatar-slot"
          class="w-7 h-7 rounded-full bg-white/15 flex items-center justify-center text-[11px] font-['Oswald'] font-bold overflow-hidden"
        >
          GP
        </span>
        <span class="text-xs font-bold">Perfil</span>
      </button>
    </div>
  </div>
</header>

<script>
  import { renderAvatarHtml } from '../../lib/avatarHelper';

  function setupHeaderListeners() {
    const dispatch = (evt: string) => window.dispatchEvent(new CustomEvent(evt));

    const spotlightBtn = document.getElementById('cagp-btn-spotlight');
    if (spotlightBtn) spotlightBtn.onclick = () => dispatch('cagp:open-spotlight');

    const campusBtn = document.getElementById('cagp-btn-campus');
    if (campusBtn) campusBtn.onclick = () => dispatch('cagp:open-campus');

    const passportBtn = document.getElementById('cagp-btn-passport');
    if (passportBtn) passportBtn.onclick = () => dispatch('cagp:open-passport');

    const mobileMenuBtn = document.getElementById('cagp-mobile-menu-btn');
    if (mobileMenuBtn) {
      mobileMenuBtn.onclick = (e) => {
        e.stopPropagation();
        if ((window as any).__cagp_toggle_drawer) {
          (window as any).__cagp_toggle_drawer();
        } else {
          dispatch('cagp:toggle-drawer');
        }
      };
    }

    if (!(window as any).__cagp_header_events_bound) {
      (window as any).__cagp_header_events_bound = true;
      window.addEventListener('keydown', (e) => {
        if (e.altKey && (e.key === 'a' || e.key === 'A')) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('cagp:open-a11y'));
        } else if (e.altKey && (e.key === 's' || e.key === 'S')) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('cagp:open-settings'));
        }
      });
      window.addEventListener('cagp:vault-updated', () => {
        (window as any).__cagp_update_avatar?.();
      });
    }

    const updateHeaderAvatar = () => {
      const slot = document.getElementById('cagp-header-avatar-slot');
      if (!slot) return;
      try {
        const raw = localStorage.getItem('cagp_student_profile_v1');
        const profile = raw ? JSON.parse(raw) : null;
        slot.innerHTML = renderAvatarHtml(profile, 'sm');
      } catch {
        slot.textContent = 'GP';
      }
    };

    (window as any).__cagp_update_avatar = updateHeaderAvatar;
    updateHeaderAvatar();
  }

  setupHeaderListeners();
  document.addEventListener('astro:page-load', setupHeaderListeners);
</script>
