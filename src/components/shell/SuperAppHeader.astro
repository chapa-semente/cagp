---
// src/components/shell/SuperAppHeader.astro — Barra Superior Mobile para Sub-rotas (Neobrutalista)
import { AXIS_REGISTRY, getAxisByPath, normalizePathname } from '@/lib/navigationRegistry';
import { getCagpIconSvg, resolveCagpIconName } from '@/lib/cagpIcons';

const cleanPath = normalizePathname(Astro.url.pathname);
const isHomeActive = cleanPath === '/' || cleanPath === '';
const activeAxis = getAxisByPath(Astro.url.pathname) || AXIS_REGISTRY[0];
const axisRoot = normalizePathname(activeAxis.rootHref);
const isAxisRoot = cleanPath === axisRoot;
---

<header
  id="cagp-super-app-header"
  class={`${
    isHomeActive ? 'hidden' : 'block md:hidden'
  } sticky top-0 z-[1030] w-full bg-white border-b-3 border-border select-none transition-colors shadow-xs`}
  style="padding-top: env(safe-area-inset-top, 0px);"
>
  <div class="px-3 py-2 flex items-center justify-between gap-2">
    <!-- Esquerda: Botão Menu Unificado (44x44pt) + Eixo Ativo -->
    <div class="flex items-center gap-2 min-w-0 flex-1">
      <button
        type="button"
        id="cagp-mobile-menu-btn"
        class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-white hover:bg-muted border-3 border-border shadow-xs text-foreground hover:text-primary flex items-center justify-center shrink-0 transition-all cursor-pointer active:translate-x-0.5 active:translate-y-0.5 active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none disabled:cursor-not-allowed"
        title="Abrir Menu Geral"
        aria-label="Abrir gaveta de navegação"
      >
        <span set:html={getCagpIconSvg('menu', 'w-5 h-5')} />
      </button>

      <a
        href={activeAxis.rootHref}
        class="inline-flex items-center gap-1.5 min-h-[44px] px-1 no-underline min-w-0 rounded-lg text-foreground hover:text-primary"
        aria-label={isAxisRoot ? `Eixo ${activeAxis.name}` : `Voltar para ${activeAxis.name}`}
      >
        {isAxisRoot
          ? <span class="shrink-0 text-primary" set:html={getCagpIconSvg(resolveCagpIconName(activeAxis.id), 'w-4 h-4')} />
          : <i class="bi bi-arrow-left shrink-0 text-base" aria-hidden="true"></i>}
        <span class="font-heading text-sm font-bold uppercase truncate">{activeAxis.name}</span>
      </a>
    </div>

    <!-- Direita: Ações Rápidas Táteis Neobrutalistas (44x44pt) -->
    <div class="flex items-center gap-1.5 shrink-0">
      <button
        type="button"
        id="cagp-btn-spotlight"
        class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-white hover:bg-muted border-3 border-border shadow-xs text-foreground flex items-center justify-center transition-all cursor-pointer active:translate-x-0.5 active:translate-y-0.5 active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none disabled:cursor-not-allowed"
        title="Buscar (⌘K)"
        aria-label="Buscar (⌘K)"
      >
        <span class="text-primary" set:html={getCagpIconSvg('search', 'w-4 h-4')} />
      </button>

      <button
        type="button"
        id="cagp-btn-campus"
        class="w-11 h-11 min-w-[44px] min-h-[44px] rounded-xl bg-white hover:bg-muted border-3 border-border shadow-xs text-foreground flex items-center justify-center relative transition-all cursor-pointer active:translate-x-0.5 active:translate-y-0.5 active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none disabled:cursor-not-allowed"
        title="Plantão Noturno • RU II & Circular"
        aria-label="Abrir status do Campus Agora"
      >
        <span set:html={getCagpIconSvg('bell', 'w-4 h-4')} />
        <span class="w-2.5 h-2.5 rounded-full bg-success border border-border absolute top-1.5 right-1.5"></span>
      </button>

      <button
        type="button"
        id="cagp-btn-passport"
        class="min-h-[44px] min-w-[44px] w-11 h-11 justify-center rounded-xl bg-primary hover:bg-primary-hover text-primary-foreground border-3 border-border shadow-xs text-xs font-heading font-bold flex items-center gap-1.5 transition-all cursor-pointer active:translate-x-0.5 active:translate-y-0.5 active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 disabled:opacity-50 disabled:pointer-events-none disabled:cursor-not-allowed"
        title="Abrir Passaporte Discente"
        aria-label="Abrir Passaporte Discente"
      >
        <span
          id="cagp-header-avatar-slot"
          class="w-7 h-7 rounded-lg bg-white text-primary border-2 border-border flex items-center justify-center text-xs font-heading font-extrabold overflow-hidden"
        >
          GP
        </span>
      </button>
    </div>
  </div>
</header>

<script>
  import { renderAvatarHtml } from '@/lib/avatarHelper';

  function setupHeaderListeners() {
    const dispatch = (evt: string) => window.dispatchEvent(new CustomEvent(evt));

    const spotlightBtn = document.getElementById('cagp-btn-spotlight');
    if (spotlightBtn) spotlightBtn.onclick = () => dispatch('cagp:open-spotlight');

    const campusBtn = document.getElementById('cagp-btn-campus');
    if (campusBtn) campusBtn.onclick = () => dispatch('cagp:open-campus');

    const passportBtn = document.getElementById('cagp-btn-passport');
    if (passportBtn) passportBtn.onclick = () => dispatch('cagp:open-passport');

    const mobileMenuBtn = document.getElementById('cagp-mobile-menu-btn');
    if (mobileMenuBtn) {
      mobileMenuBtn.onclick = () => {
        if (typeof (window as any).__cagp_open_drawer === 'function') {
          (window as any).__cagp_open_drawer();
        } else {
          dispatch('cagp:open-drawer');
        }
      };
    }

    const avatarSlot = document.getElementById('cagp-header-avatar-slot');
    if (avatarSlot) {
      try {
        const raw = localStorage.getItem('cagp_student_profile_v1');
        if (raw) {
          const profile = JSON.parse(raw);
          if (profile.avatarPreset) {
            avatarSlot.innerHTML = renderAvatarHtml(profile.avatarPreset, profile.prideChoice);
          }
        }
      } catch (e) {}
    }
  }

  setupHeaderListeners();
  document.addEventListener('astro:page-load', setupHeaderListeners);
  window.addEventListener('cagp:vault-updated', setupHeaderListeners);
</script>
