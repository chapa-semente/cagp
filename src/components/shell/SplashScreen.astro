---
// SplashScreen.astro — Abertura do site: a semente germina enquanto o site carrega de verdade.
//
// Aparece em toda abertura (carregamento completo da página), nunca nas trocas internas do ClientRouter.
// Cada estágio da planta é um passo real do carregamento, nesta ordem:
//   1 semente = HTML pronto · 2 raiz = fontes · 3 broto = página e ilhas (window load)
//   4 fruto  = cache offline instalado (service worker ativo), só onde há service worker.
// Dura ~1,1s quando tudo já está em cache; espera o cache até um teto de 4,5s na primeira visita ou
// depois de uma atualização. CSS e script são inline para pintar antes do resto do bundle.
// Sem JS o bloco some sozinho (noscript + animação de segurança).
import { asset } from '@/lib/paths';
---

<div id="cagp-splash" data-stage="0" role="status" aria-live="polite">
  <div class="cagp-splash-box">
    <svg class="cagp-splash-planta" viewBox="0 0 240 240" aria-hidden="true">
      <!-- 4. fruto -->
      <circle class="s4 pop" cx="150" cy="58" r="15" fill="#FFC83D" />
      <path class="s4 pop" d="M120 96c-30 0-48-16-50-44 30 0 48 16 50 44z" fill="#6DB33F" />
      <!-- 3. broto -->
      <path class="s3 draw" pathLength="1" d="M120 148V64" stroke="#6DB33F" />
      <path class="s3 pop late" d="M120 122c0-30 16-48 46-50 0 30-16 48-46 50z" fill="#6DB33F" />
      <!-- 2. raiz -->
      <path class="s2 draw" pathLength="1" d="M120 160v54" stroke="#FFC83D" />
      <path class="s2 draw" pathLength="1" d="M120 172c-12 10-28 12-44 26" stroke="#FFC83D" />
      <path class="s2 draw" pathLength="1" d="M120 180c12 8 26 8 40 22" stroke="#FFC83D" />
      <!-- chão -->
      <path d="M28 150h184" stroke="#FFFFFF" stroke-width="6" stroke-linecap="round" fill="none" />
      <!-- 1. semente -->
      <path class="s1 seed" d="M120 132c12 8 16 18 16 24a16 16 0 0 1-32 0c0-6 4-16 16-24z" fill="#FE8812" />
    </svg>

    <img class="cagp-splash-logo" src={asset('/logos/semente/semente-horizontal-branco.webp')} alt="Chapa Gestão Pública Semente" width="768" height="229" />

    <ol class="cagp-splash-steps" aria-hidden="true"><li></li><li></li><li></li><li></li></ol>
    <p class="cagp-splash-label">Plantando a semente</p>
  </div>
</div>

<noscript><style is:inline>#cagp-splash{display:none!important}</style></noscript>

<style is:inline>
  #cagp-splash {
    position: fixed;
    inset: 0;
    z-index: 1300;
    display: grid;
    place-items: center;
    background: #5B2A85;
    color: #fff;
    font-family: 'Poppins', system-ui, sans-serif;
    clip-path: inset(0 0 0 0);
    transition: clip-path 520ms cubic-bezier(0.16, 1, 0.3, 1);
    /* Rede de segurança: se o script não rodar, o bloco some em 8s e o site segue utilizável. */
    animation: cagp-splash-failsafe 1ms linear 8s forwards;
  }
  html.cagp-booted #cagp-splash { display: none; }
  #cagp-splash.is-leaving { clip-path: inset(0 0 100% 0); pointer-events: none; }
  @keyframes cagp-splash-failsafe { to { visibility: hidden; pointer-events: none; } }

  .cagp-splash-box { width: min(78vw, 300px); display: grid; justify-items: center; gap: 18px; }
  .cagp-splash-planta { width: min(56vw, 220px); height: auto; overflow: visible; }
  .cagp-splash-logo { width: min(52vw, 190px); height: auto; }
  .cagp-splash-label { margin: 0; min-height: 1.4em; font-size: 0.875rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; text-align: center; }

  .cagp-splash-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; width: 100%; margin: 0; padding: 0; list-style: none; }
  .cagp-splash-steps li { height: 8px; border: 2px solid #fff; border-radius: 9999px; transition: background-color 200ms linear; }
  #cagp-splash[data-stage='1'] .cagp-splash-steps li:nth-child(-n + 1),
  #cagp-splash[data-stage='2'] .cagp-splash-steps li:nth-child(-n + 2),
  #cagp-splash[data-stage='3'] .cagp-splash-steps li:nth-child(-n + 3),
  #cagp-splash[data-stage='4'] .cagp-splash-steps li { background: #fff; }
  #cagp-splash[data-stage='4'] .cagp-splash-steps li:last-child { background: #FE8812; border-color: #FE8812; }

  .cagp-splash-planta .draw { fill: none; stroke-width: 8; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 420ms cubic-bezier(0.16, 1, 0.3, 1); }
  .cagp-splash-planta .pop { transform-box: fill-box; transform-origin: 50% 100%; transform: scale(0); transition: transform 460ms linear(0, 0.166, 0.494, 0.803, 1.011, 1.109, 1.126, 1.097, 1.053, 1.015, 0.993, 0.987, 0.99, 0.996, 1); }
  .cagp-splash-planta .pop.late { transition-delay: 160ms; }
  .cagp-splash-planta .seed { transform-box: fill-box; transform-origin: 50% 100%; transform: translateY(-90px) scale(0.6); opacity: 0; transition: transform 380ms linear(0, 0.166, 0.494, 0.803, 1.011, 1.109, 1.126, 1.097, 1.053, 1.015, 0.993, 0.987, 0.99, 0.996, 1), opacity 80ms linear; }

  #cagp-splash:not([data-stage='0']) .seed { transform: none; opacity: 1; }
  #cagp-splash:is([data-stage='2'], [data-stage='3'], [data-stage='4']) .s2.draw,
  #cagp-splash:is([data-stage='3'], [data-stage='4']) .s3.draw { stroke-dashoffset: 0; }
  #cagp-splash:is([data-stage='3'], [data-stage='4']) .s3.pop,
  #cagp-splash[data-stage='4'] .s4.pop { transform: scale(1); }
</style>

<script is:inline>
  (function () {
    var root = document.documentElement;
    var el = document.getElementById('cagp-splash');
    // Trocas internas de página (ClientRouter) nunca mostram a abertura de novo.
    if (!window.__cagpSplashSetup) {
      window.__cagpSplashSetup = true;
      document.addEventListener('astro:before-swap', function (e) {
        if (e.newDocument) e.newDocument.documentElement.classList.add('cagp-booted');
      });
      document.addEventListener('astro:after-swap', function () {
        root.classList.add('cagp-booted');
      });
    }
    var off = false;
    try { off = sessionStorage.getItem('cagp_splash_off') === '1'; } catch (e) {}
    if (!el || window.__cagpBooted || off) {
      root.classList.add('cagp-booted');
      return;
    }
    window.__cagpBooted = true;

    var label = el.querySelector('.cagp-splash-label');
    var LABELS = ['', 'Plantando a semente', 'Criando raiz', 'Brotando', 'Pronto pra usar'];
    var STEP = 240; // intervalo mínimo entre estágios: a planta sempre cresce, mesmo com tudo em cache
    var reached = 0;
    var shown = 0;
    var timer = null;
    var started = Date.now();

    function paint() {
      timer = null;
      if (shown < reached) {
        shown += 1;
        el.setAttribute('data-stage', String(shown));
        if (label) label.textContent = LABELS[shown];
        if (shown === 3 && waitsForCache && reached < 4 && label) label.textContent = 'Guardando o site no seu celular';
      }
      if (shown < reached) timer = setTimeout(paint, STEP);
      else if (shown === 4) setTimeout(leave, 380);
    }
    function reach(n) {
      if (n > reached) reached = n;
      if (!timer) timer = setTimeout(paint, shown === 0 ? 60 : STEP);
    }
    function leave() {
      if (el.classList.contains('is-leaving')) return;
      el.classList.add('is-leaving');
      setTimeout(function () {
        root.classList.add('cagp-booted');
        window.dispatchEvent(new CustomEvent('cagp:splash-done'));
      }, 540);
    }

    var local = /^(localhost|127\.0\.0\.1|0\.0\.0\.0)$/.test(location.hostname);
    var waitsForCache = 'serviceWorker' in navigator && location.protocol === 'https:' && !local;

    reach(1);
    var fonts = document.fonts && document.fonts.ready ? document.fonts.ready : Promise.resolve();
    fonts.then(function () { reach(2); }, function () { reach(2); });
    function onLoad() {
      reach(3);
      if (!waitsForCache) return reach(4);
      // Com o cache já ativo isto resolve na hora; na primeira visita espera a instalação terminar.
      navigator.serviceWorker.ready.then(function () { reach(4); }, function () { reach(4); });
    }
    if (document.readyState === 'complete') onLoad();
    else window.addEventListener('load', onLoad, { once: true });

    // Teto: sinal ruim não prende ninguém. O cache segue instalando por trás.
    setTimeout(function () { reach(4); }, Math.max(0, 4500 - (Date.now() - started)));
  })();
</script>
