---
// src/components/shell/AxisNavBar.astro — Barra de Pílulas do Eixo (Apple HIG & Neo-Brutalista CAGP)
import {
  type AxisId,
  getAxisById,
  getAxisByPath,
  getActiveItemId,
} from '@/lib/navigationRegistry';
import CagpIcon from '@/components/ui/CagpIcon.astro';

interface Props {
  axisId?: AxisId;
  activeId?: string;
  showBadge?: boolean;
  className?: string;
}

const {
  axisId: explicitAxisId,
  activeId: explicitActiveId,
  showBadge = true,
  className = '',
} = Astro.props;

// Resolução inteligente do Eixo a partir da rota atual se não fornecido
const currentPath = Astro.url.pathname;
const axis = explicitAxisId ? getAxisById(explicitAxisId) : getAxisByPath(currentPath);

// Se não estiver em um dos eixos (ex: página especial isolada), não renderiza
const activeItemId = axis
  ? explicitActiveId || getActiveItemId(axis, currentPath, Astro.url.hash)
  : '';
---

{axis && (
  <nav
    class={`cagp-axis-navbar-wrap mb-3 select-none ${className}`}
    aria-label={`Navegação do Eixo ${axis.number}: ${axis.name}`}
  >
    <div class="cagp-axis-navbar-container flex items-center gap-1.5 overflow-x-auto py-1 scrollbar-none">
      {/* Badge do Eixo */}
      {showBadge && (
        <div class="cagp-axis-badge shrink-0 flex items-center gap-1.5 px-3 py-1.5 bg-foreground text-background text-white rounded-xl border-3 border-border shadow-xs text-xs font-heading font-extrabold uppercase tracking-tight">
          <CagpIcon name={axis.icon} className="w-3.5 h-3.5 text-accent" />
          <span>{axis.name}</span>
        </div>
      )}

      {/* Pílulas de Navegação das Ferramentas / Páginas */}
      <div class="cagp-axis-pills flex items-center gap-1.5 shrink-0">
        {axis.items.map((item) => {
          const isActive = item.id === activeItemId;
          return (
            <a
              href={item.href}
              data-axis-id={item.id}
              data-axis-href={item.href}
              class={`cagp-axis-pill min-h-[44px] px-3.5 py-1.5 rounded-xl flex items-center gap-1.5 text-xs font-heading font-extrabold uppercase tracking-tight transition-all duration-150 no-underline shrink-0 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 ${
                isActive
                  ? 'is-active bg-primary text-white font-extrabold border-3 border-border shadow-xs -translate-y-0.5'
                  : 'bg-white text-foreground font-bold border-3 border-border shadow-xs hover:bg-muted hover:-translate-y-0.5 hover:shadow-sm'
              }`}
              aria-current={isActive ? 'page' : undefined}
              title={item.description}
            >
              <CagpIcon name={item.icon} className={`w-3.5 h-3.5 ${isActive ? 'text-white' : 'text-foreground'}`} />
              <span class="hidden sm:inline">{item.label}</span>
              <span class="inline sm:hidden">{item.shortLabel}</span>
            </a>
          );
        })}
      </div>
    </div>
  </nav>
)}

<style>
  .cagp-axis-navbar-container {
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
    touch-action: pan-x;
    mask-image: linear-gradient(to right, transparent 0px, black 16px, black calc(100% - 16px), transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0px, black 16px, black calc(100% - 16px), transparent 100%);
  }
  .cagp-axis-pill {
    scroll-snap-align: start;
  }
  .cagp-axis-pill:active {
    transform: scale(0.96);
  }
</style>

<script>
  function setupAxisNavBar() {
    const bars = document.querySelectorAll<HTMLElement>('.cagp-axis-navbar-wrap');
    bars.forEach((bar) => {
      const pills = bar.querySelectorAll<HTMLAnchorElement>('.cagp-axis-pill');
      if (!pills.length) return;

      const updateActivePill = () => {
        const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
        const currentHash = window.location.hash;

        let matchedPill: HTMLAnchorElement | null = null;

        // 1. Prioridade para correspondência de hash se existir
        if (currentHash) {
          pills.forEach((p) => {
            const href = p.getAttribute('href') || '';
            if (href.includes(currentHash)) {
              matchedPill = p;
            }
          });
        }

        // 2. Prioridade para correspondência exata de pathname
        if (!matchedPill) {
          pills.forEach((p) => {
            const href = p.getAttribute('href') || '';
            const pathOnly = href.split('#')[0].replace(/\/$/, '') || '/';
            if (pathOnly === currentPath || (pathOnly !== '/' && currentPath.startsWith(pathOnly))) {
              matchedPill = p;
            }
          });
        }

        // 3. Fallback: primeira pill
        if (!matchedPill && pills.length > 0) {
          matchedPill = pills[0];
        }

        if (matchedPill) {
          // Centralizar suavemente no viewport mobile (BUG-17)
          (matchedPill as HTMLElement).scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });

          pills.forEach((p) => {
            const isMatch = p === matchedPill;
            p.classList.toggle('is-active', isMatch);
            p.classList.toggle('bg-primary', isMatch);
            p.classList.toggle('text-white', isMatch);
            p.classList.toggle('font-extrabold', isMatch);
            p.classList.toggle('border-3', isMatch);
            p.classList.toggle('border-border', isMatch);
            p.classList.toggle('shadow-xs', isMatch);

            p.classList.toggle('bg-white', !isMatch);
            p.classList.toggle('text-foreground', !isMatch);
            p.classList.toggle('font-bold', !isMatch);

            if (isMatch) {
              p.setAttribute('aria-current', 'page');
            } else {
              p.removeAttribute('aria-current');
            }

            if (!(p as any).__haptic_bound) {
              (p as any).__haptic_bound = true;
              p.addEventListener('click', () => {
                if (typeof navigator !== 'undefined' && 'vibrate' in navigator) {
                  navigator.vibrate(15);
                }
              });
            }
          });
        }
      };

      updateActivePill();
      window.addEventListener('hashchange', updateActivePill);
    });
  }

  setupAxisNavBar();
  document.addEventListener('astro:page-load', setupAxisNavBar);
</script>
