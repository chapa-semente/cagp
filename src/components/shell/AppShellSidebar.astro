---
// src/components/shell/AppShellSidebar.astro — Sidebar Responsiva Neobrutalista Integral
// RetroUI Neobrutalism (Borders 3px, Radius 12px, Chunky Shadows, Bricolage & Space Grotesk)
import { AXIS_REGISTRY, getAxisByPath } from '../../lib/navigationRegistry';
import { SHORTCUTS_CATALOG, DEFAULT_SHORTCUT_IDS } from '../../lib/shortcutsCatalog';
import { getCagpIconSvg, resolveCagpIconName } from '../../lib/cagpIcons';
import { asset, route } from '../../lib/paths';

const currentPath = Astro.url.pathname;
const activeAxis = getAxisByPath(currentPath) || AXIS_REGISTRY[0];
---

<!-- Backdrop Overlay Unificado (Mobile e Tablet) -->
<div
  id="cagp-sidebar-backdrop"
  class="fixed inset-0 bg-black/60 z-[1085] transition-opacity duration-200 pointer-events-none opacity-0 xl:hidden"
  aria-hidden="true"
></div>

<aside
  id="cagp-app-sidebar"
  class="cagp-app-sidebar flex flex-col justify-between bg-white border-r-[3px] border-[#0A0A0A] select-none overflow-x-hidden shrink-0"
  aria-label="Navegação Principal Lateral"
  data-shortcuts-catalog={JSON.stringify(SHORTCUTS_CATALOG)}
  data-shortcuts-defaults={JSON.stringify(DEFAULT_SHORTCUT_IDS)}
>
  <!-- Topo Rolável: Marca + Botões de Ação + 5 Eixos Canônicos + Atalhos -->
  <div class="flex flex-col flex-1 min-h-0 overflow-y-auto no-scrollbar p-2.5 xl:p-4 gap-4">
    <!-- Cabeçalho da Sidebar: Identidade CAGP + Botões Responsivos (Fechar no Mobile / Alternar no Tablet) -->
    <div class="cagp-sidebar-header flex flex-col xl:flex-row items-center xl:justify-between gap-2 pb-3 border-b-[3px] border-[#0A0A0A]">
      <a
        href={route('/')}
        class="flex items-center justify-center xl:justify-start gap-3 p-1 rounded-xl hover:bg-[#FBF8F3] transition-transform no-underline group min-h-[44px] min-w-0"
        aria-label="Início — Centro Acadêmico de Gestão Pública UFMG"
        title="Início — CAGP UFMG"
      >
        <div class="w-10 h-10 rounded-xl bg-[#9E2424] text-white flex items-center justify-center shrink-0 border-[3px] border-[#0A0A0A] shadow-[2.5px_2.5px_0_0_#0A0A0A] group-hover:translate-x-[-1px] group-hover:translate-y-[-1px] group-hover:shadow-[3.5px_3.5px_0_0_#0A0A0A] transition-all">
          <img
            src={asset('/logos/cagp/12_simbolo_transparente_negativo.svg')}
            alt=""
            class="w-6 h-6 object-contain"
            onerror="this.style.display='none'"
          />
        </div>
        <div class="sidebar-expanded-block hidden xl:block min-w-0">
          <span class="font-heading text-sm font-extrabold uppercase tracking-tight text-[#0A0A0A] block leading-none">
            CAGP UFMG
          </span>
          <span class="text-[11px] font-sans text-[#57534E] font-medium block mt-1 truncate">
            Gestão Pública • FAFICH
          </span>
        </div>
      </a>

      <!-- 1. Botão Fechar no Mobile (< 768px) -->
      <button
        type="button"
        id="cagp-sidebar-close-btn"
        class="md:hidden w-11 h-11 rounded-xl bg-[#FBF8F3] hover:bg-[#F4F1EA] border-[3px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-[#0A0A0A] hover:text-[#9E2424] flex items-center justify-center transition-all cursor-pointer shrink-0 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Fechar menu lateral"
        aria-label="Fechar menu lateral"
      >
        <span set:html={getCagpIconSvg('close', 'w-5 h-5')} />
      </button>

      <!-- 2. Botão de Alternar Largura no Tablet (768px a 1279px) -->
      <button
        type="button"
        id="cagp-sidebar-toggle-btn"
        class="hidden md:flex xl:hidden w-10 h-8 rounded-xl bg-[#FBF8F3] hover:bg-[#F4F1EA] border-[3px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-[#0A0A0A] hover:text-[#9E2424] items-center justify-center transition-all cursor-pointer shrink-0 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Alternar largura da barra lateral (Rail / Completa)"
        aria-label="Alternar expansão da barra lateral"
      >
        <span set:html={getCagpIconSvg('sidebar', 'w-4 h-4')} />
      </button>
    </div>

    <!-- Navegação Primária: Os 5 Eixos Canônicos com Acordeão Inteligente -->
    <nav aria-label="Cinco Eixos do Curso" class="space-y-1.5" id="cagp-sidebar-axes-nav">
      <div class="sidebar-expanded-show hidden xl:flex items-center justify-between px-2.5 mb-1.5">
        <span class="text-[11px] font-mono uppercase tracking-wider text-[#57534E] font-bold">
          5 Eixos Canônicos
        </span>
        <span class="text-[11px] font-mono text-[#9E2424] font-bold tabular-nums">PPC 2020</span>
      </div>

      {AXIS_REGISTRY.map((axis) => {
        const isCurrentAxis = activeAxis.id === axis.id;
        const iconSvg = getCagpIconSvg(resolveCagpIconName(axis.id), 'w-5 h-5 shrink-0');
        const subItems = axis.items.filter((item) => !item.isOverview);
        const hasSubItems = subItems.length > 0;

        return (
          <div class="space-y-1" data-axis-group={axis.id}>
            <div class="flex items-center gap-1">
              <a
                href={axis.rootHref}
                data-axis-link={axis.id}
                data-axis-root={axis.rootHref}
                aria-current={isCurrentAxis ? 'page' : undefined}
                class={`cagp-sidebar-axis-link flex-1 flex flex-col xl:flex-row items-center xl:justify-between gap-1 xl:gap-2.5 px-2 xl:px-3 py-2 xl:py-2.5 rounded-xl no-underline transition-all min-h-[48px] xl:min-h-[44px] min-w-0 ${
                  isCurrentAxis
                    ? 'is-active bg-[#9E2424] text-white font-bold border-[2.5px] border-[#0A0A0A] shadow-[3px_3px_0_0_#0A0A0A]'
                    : 'text-[#0A0A0A] hover:bg-[#FBF8F3] hover:text-[#9E2424] font-semibold border-[2px] border-transparent hover:border-[#0A0A0A]'
                }`}
                title={`${axis.number}. ${axis.name} — ${axis.tagline}`}
              >
                <div class="cagp-sidebar-axis-content flex flex-col xl:flex-row items-center gap-1 xl:gap-2.5 min-w-0 truncate">
                  <span class="cagp-sidebar-icon flex items-center justify-center shrink-0" set:html={iconSvg} />
                  <span class="cagp-sidebar-axis-label text-[10px] xl:text-xs font-heading font-bold tracking-tight leading-tight text-center xl:text-left truncate max-w-[72px] xl:max-w-none">
                    {axis.name}
                  </span>
                </div>
                <span
                  class={`cagp-sidebar-axis-num sidebar-expanded-show hidden xl:inline-flex items-center justify-center text-[11px] font-mono font-bold px-1.5 py-0.5 rounded-md tabular-nums shrink-0 border ${
                    isCurrentAxis
                      ? 'bg-white/20 text-white border-white/40'
                      : 'bg-[#F4F1EA] text-[#0A0A0A] border-[#0A0A0A]/20'
                  }`}
                >
                  0{axis.number}
                </span>
              </a>

              {/* Botão de Alternância do Acordeão quando houver sub-rotas */}
              {hasSubItems && (
                <button
                  type="button"
                  data-axis-accordion-toggle={axis.id}
                  class={`sidebar-expanded-show hidden xl:flex w-8 h-8 rounded-lg hover:bg-[#F4F1EA] border border-transparent hover:border-[#0A0A0A] items-center justify-center transition-colors cursor-pointer shrink-0 ${
                    isCurrentAxis ? 'text-[#9E2424]' : 'text-[#78716C] hover:text-[#9E2424]'
                  }`}
                  title={`Alternar sub-rotas de ${axis.name}`}
                  aria-label={`Alternar sub-rotas de ${axis.name}`}
                  aria-expanded={isCurrentAxis ? 'true' : 'false'}
                >
                  <span
                    class={`cagp-accordion-arrow inline-flex transition-transform duration-200 ${isCurrentAxis ? 'rotate-180' : ''}`}
                    set:html={getCagpIconSvg('chevron-down', 'w-3.5 h-3.5')}
                  />
                </button>
              )}
            </div>

            {/* Sub-rotas com visualização em acordeão inteligente */}
            {hasSubItems && (
              <div
                data-axis-subnav={axis.id}
                class={`cagp-axis-subnav ${
                  isCurrentAxis ? 'flex' : 'hidden'
                } flex-col pl-6 pr-1 py-1 space-y-0.5 border-l-[3px] border-[#9E2424] ml-4`}
              >
                {subItems.map((sub) => (
                  <a
                    href={sub.href}
                    data-axis-sublink={sub.href}
                    class="text-xs font-sans font-medium text-[#0A0A0A] hover:text-[#9E2424] hover:bg-[#FBF8F3] px-2.5 py-1.5 rounded-lg no-underline flex items-center justify-between transition-colors truncate min-h-[36px]"
                  >
                    <span class="truncate">{sub.shortLabel || sub.label}</span>
                    <span class="text-[11px] font-bold text-[#9E2424]" aria-hidden="true">&rarr;</span>
                  </a>
                ))}
              </div>
            )}
          </div>
        );
      })}
    </nav>

    <!-- Seção de Atalhos Favoritos do Student Vault -->
    <div class="pt-3 border-t-[3px] border-[#0A0A0A]">
      <!-- Cabeçalho no Desktop, Tablet Expandido e Mobile -->
      <div class="sidebar-expanded-show hidden xl:flex items-center justify-between px-2.5 mb-1.5">
        <span class="text-[11px] font-mono uppercase tracking-wider text-[#57534E] font-bold">
          Meus Atalhos
        </span>
        <button
          type="button"
          id="cagp-sidebar-edit-shortcuts"
          class="text-xs font-bold text-[#9E2424] hover:underline cursor-pointer bg-transparent border-0 p-0"
          title="Personalizar atalhos favoritos"
        >
          Editar
        </button>
      </div>

      <!-- Cabeçalho no Modo Rail Tablet (Separador Sutil) -->
      <div class="sidebar-rail-only flex xl:hidden items-center justify-center py-1">
        <span class="w-6 h-[2px] bg-[#0A0A0A]"></span>
      </div>

      <!-- 1. Lista Completa de Atalhos (Desktop xl, Tablet Expandido e Mobile) -->
      <div id="cagp-sidebar-shortcuts-list" class="sidebar-expanded-show hidden xl:flex flex-col space-y-1">
        {DEFAULT_SHORTCUT_IDS.filter((id) => id !== 'menu').slice(0, 4).map((id) => {
          const item = SHORTCUTS_CATALOG.find((s) => s.id === id) || SHORTCUTS_CATALOG[0];
          const iconSvg = getCagpIconSvg(resolveCagpIconName(item.icon), 'w-4 h-4 shrink-0');
          return (
            <a
              href={item.href}
              data-sidebar-shortcut={item.id}
              data-action={item.isAction ? item.actionEvent : undefined}
              class="flex items-center justify-between gap-2.5 px-2.5 py-1.5 rounded-xl border border-transparent hover:border-[#0A0A0A] hover:bg-[#FBF8F3] text-xs text-[#0A0A0A] hover:text-[#9E2424] no-underline transition-all min-h-[38px]"
            >
              <span class="flex items-center gap-2 min-w-0 truncate">
                <span class="text-[#9E2424]" set:html={iconSvg} />
                <span class="truncate font-sans font-bold">{item.label}</span>
              </span>
              <span class="text-[10px] font-mono font-bold bg-[#EFE9E0] px-1.5 py-0.5 rounded border border-black/20 text-[#57534E]">{item.category}</span>
            </a>
          );
        })}
      </div>

      <!-- 2. Ícones Táteis Diretos de Atalhos no Modo Rail (Tablet md..xl) -->
      <div id="cagp-sidebar-shortcuts-rail" class="sidebar-rail-only flex xl:hidden flex-col items-center gap-1.5">
        {DEFAULT_SHORTCUT_IDS.filter((id) => id !== 'menu').slice(0, 4).map((id) => {
          const item = SHORTCUTS_CATALOG.find((s) => s.id === id) || SHORTCUTS_CATALOG[0];
          const iconSvg = getCagpIconSvg(resolveCagpIconName(item.icon), 'w-5 h-5 shrink-0');
          return (
            <a
              href={item.href}
              data-sidebar-shortcut={item.id}
              data-action={item.isAction ? item.actionEvent : undefined}
              class="w-11 h-11 rounded-xl bg-[#FBF8F3] hover:bg-[#F4F1EA] text-[#0A0A0A] hover:text-[#9E2424] border-[2.5px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] flex items-center justify-center transition-all cursor-pointer no-underline group active:translate-x-0.5 active:translate-y-0.5 active:shadow-none shrink-0"
              title={`${item.fullLabel} (${item.category}) — Toque para abrir`}
              aria-label={item.label}
            >
              <span class="text-[#9E2424] group-hover:scale-110 transition-transform" set:html={iconSvg} />
            </a>
          );
        })}

        <!-- Botão Discreto de Edição no Modo Rail (+) -->
        <button
          type="button"
          id="cagp-rail-edit-shortcuts-btn"
          class="w-8 h-8 rounded-lg text-[#0A0A0A] hover:text-[#9E2424] hover:bg-[#FBF8F3] border-2 border-dashed border-[#0A0A0A] flex items-center justify-center transition-colors cursor-pointer mt-1 font-bold"
          title="Personalizar Meus Atalhos"
          aria-label="Personalizar Meus Atalhos"
        >
          <span class="text-xs leading-none">+</span>
        </button>
      </div>
    </div>
  </div>

  <!-- Base da Sidebar: Trio de Ferramentas Rápidas + Cartão do Estudante (Ancorada com shrink-0) -->
  <div class="p-2.5 xl:p-3 border-t-[3px] border-[#0A0A0A] bg-[#FBF8F3] space-y-2.5 shrink-0">
    <!-- 1. Linha de Ações Expandida (Desktop, Tablet Expandido e Mobile) -->
    <div class="cagp-sidebar-actions-row sidebar-expanded-show hidden xl:flex items-center gap-1.5 w-full min-w-0">
      <!-- Busca Spotlight: flex-1 com ⌘K -->
      <button
        type="button"
        id="cagp-sidebar-spotlight-btn"
        class="flex-1 min-w-0 min-h-[44px] px-2.5 py-1.5 rounded-xl bg-white hover:bg-[#F4F1EA] border-[2.5px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-[#0A0A0A] text-xs font-bold flex items-center justify-between gap-1.5 transition-all cursor-pointer shrink-0 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Busca Universal (⌘K ou Ctrl+K)"
        aria-label="Abrir Busca Universal Spotlight"
      >
        <span class="flex items-center gap-1.5 truncate">
          <span class="text-[#9E2424]" set:html={getCagpIconSvg('search', 'w-4 h-4')} />
          <span class="truncate font-sans font-bold">Buscar...</span>
        </span>
        <kbd class="text-[10px] font-mono font-bold bg-[#EFE9E0] text-[#0A0A0A] px-1.5 py-0.5 rounded border border-[#0A0A0A] shrink-0">
          ⌘K
        </kbd>
      </button>

      <!-- Botão de Acessibilidade -->
      <button
        type="button"
        id="cagp-sidebar-a11y-btn"
        class="w-10 h-10 min-h-[44px] min-w-[40px] rounded-xl bg-white hover:bg-[#F4F1EA] border-[2.5px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-[#0A0A0A] flex items-center justify-center transition-all cursor-pointer shrink-0 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Acessibilidade e Ajustes de Leitura (Alt+A)"
        aria-label="Abrir Preferências de Acessibilidade"
      >
        <span set:html={getCagpIconSvg('sliders', 'w-4 h-4')} />
      </button>

      <!-- Botão de Configurações e Cofre Local -->
      <button
        type="button"
        id="cagp-sidebar-settings-btn"
        class="w-10 h-10 min-h-[44px] min-w-[40px] rounded-xl bg-white hover:bg-[#F4F1EA] border-[2.5px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-[#0A0A0A] flex items-center justify-center transition-all cursor-pointer shrink-0 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Ajustes e Cofre Local (Alt+S)"
        aria-label="Abrir Ajustes e Cofre Local"
      >
        <span set:html={getCagpIconSvg('settings', 'w-4 h-4')} />
      </button>
    </div>

    <!-- 2. Ações Táteis Verticais no Modo Rail Tablet (88px) -->
    <div class="sidebar-rail-only flex xl:hidden flex-col items-center gap-1.5 w-full">
      <button
        type="button"
        id="cagp-rail-spotlight-btn"
        class="w-11 h-11 rounded-xl bg-white hover:bg-[#F4F1EA] border-[2.5px] border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] text-[#0A0A0A] flex items-center justify-center transition-all cursor-pointer shrink-0 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
        title="Busca Universal (⌘K)"
        aria-label="Abrir Busca Universal Spotlight"
      >
        <span class="text-[#9E2424]" set:html={getCagpIconSvg('search', 'w-4 h-4')} />
      </button>

      <div class="flex items-center gap-1">
        <button
          type="button"
          id="cagp-rail-a11y-btn"
          class="w-8 h-8 rounded-lg bg-white hover:bg-[#F4F1EA] border-[2px] border-[#0A0A0A] shadow-[1.5px_1.5px_0_0_#0A0A0A] text-[#0A0A0A] flex items-center justify-center transition-all cursor-pointer shrink-0 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
          title="Acessibilidade (Alt+A)"
          aria-label="Abrir Preferências de Acessibilidade"
        >
          <span set:html={getCagpIconSvg('sliders', 'w-3.5 h-3.5')} />
        </button>

        <button
          type="button"
          id="cagp-rail-settings-btn"
          class="w-8 h-8 rounded-lg bg-white hover:bg-[#F4F1EA] border-[2px] border-[#0A0A0A] shadow-[1.5px_1.5px_0_0_#0A0A0A] text-[#0A0A0A] flex items-center justify-center transition-all cursor-pointer shrink-0 active:translate-x-0.5 active:translate-y-0.5 active:shadow-none"
          title="Ajustes e Cofre Local (Alt+S)"
          aria-label="Abrir Ajustes e Cofre Local"
        >
          <span set:html={getCagpIconSvg('settings', 'w-3.5 h-3.5')} />
        </button>
      </div>
    </div>

    <!-- Cartão Resumo do Discente (Passaporte) -->
    <button
      type="button"
      id="cagp-sidebar-passport-btn"
      class="w-full bg-white hover:bg-[#F4F1EA] border-[3px] border-[#0A0A0A] rounded-xl p-2 flex items-center justify-center xl:justify-start gap-2.5 text-left transition-all cursor-pointer shadow-[3px_3px_0_0_#0A0A0A] hover:shadow-[4px_4px_0_0_#0A0A0A] active:translate-x-0.5 active:translate-y-0.5 active:shadow-none group min-h-[50px]"
      title="Abrir Passaporte Discente e Perfil"
      aria-label="Abrir Passaporte Discente"
    >
      <div
        id="cagp-sidebar-avatar"
        class="w-10 h-10 rounded-lg bg-[#9E2424] text-white font-heading font-extrabold text-xs flex items-center justify-center shrink-0 border-2 border-[#0A0A0A] shadow-[1.5px_1.5px_0_0_#0A0A0A] overflow-hidden"
      >
        GP
      </div>
      <div class="sidebar-expanded-block hidden xl:block flex-1 min-w-0">
        <p id="cagp-sidebar-student-name" class="text-xs font-heading font-bold text-[#0A0A0A] truncate m-0 leading-tight">
          Estudante GP
        </p>
        <div class="flex items-center gap-1.5 mt-0.5">
          <span class="w-2 h-2 rounded-full bg-[#15803D] shrink-0 border border-black" aria-hidden="true"></span>
          <span id="cagp-sidebar-student-meta" class="text-[11px] font-mono font-bold text-[#15803D] truncate tabular-nums">
            1º Período • Calouro
          </span>
        </div>
      </div>
    </button>
  </div>
</aside>

<script>
  import { initAppShellSidebar } from '../../lib/sidebarController';

  initAppShellSidebar();
  document.addEventListener('astro:page-load', initAppShellSidebar);
</script>
