---
// PesquisaNucleos.astro - Sub-view 1: Os 11 Núcleos de Pesquisa do DCP/FAFICH
const nucleos = [
  {
    eixo: 'Eixo 1: Gestão Governamental, Burocracia & Políticas Públicas',
    icon: 'bi-building-gear',
    items: [
      {
        sigla: 'PUBLICUS',
        nome: 'Núcleo de Estudos em Gestão e Políticas Públicas',
        lider: 'Profa. Dra. Telma Maria Gonçalves Menicucci',
        tema: 'Referência em políticas sociais, Sistema Único de Saúde (SUS), reformas do Estado e arranjos federativos.',
        tags: ['Políticas Sociais', 'SUS & Saúde', 'Capacidades Estatais', 'Avaliação'],
      },
      {
        sigla: 'CEPPI',
        nome: 'Centro de Pesquisas em Política e Internet',
        lider: 'Profa. Dra. Isabele Batista Mitozo',
        tema: 'Governo digital, transparência ativa, e-Gov, mídias sociais no setor público e enfrentamento à desinformação.',
        tags: ['Governo Aberto', 'Transparência', 'Deliberação Digital', 'Mídias Sociais'],
      },
      {
        sigla: 'NESTH',
        nome: 'Núcleo de Estudos Sobre o Trabalho Humano',
        lider: 'Prof. Carlos Roberto Horta e Profa. Flávia Alves',
        tema: 'Relações de trabalho na burocracia do Estado, ergonomia funcional e precarização de vínculos.',
        tags: ['Burocracia Pública', 'Gestão de Pessoas', 'Carreiras de Estado'],
      },
    ]
  },
  {
    eixo: 'Eixo 2: Legislativo, Justiça & Relações Internacionais',
    icon: 'bi-bank',
    items: [
      {
        sigla: 'CEL',
        nome: 'Centro de Estudos Legislativos',
        lider: 'Profa. Dra. Magna Maria Inácio',
        tema: 'Processo decisório no Congresso Nacional e assembleias estaduais, coalizões de governo e relações Executivo-Legislativo.',
        tags: ['Presidencialismo de Coalizão', 'Processo Legislativo', 'Orçamento'],
      },
      {
        sigla: 'FEMJUSP',
        nome: 'Feminismos, Justiça e Segurança Pública',
        lider: 'Profa. Dra. Ludmila Ribeiro',
        tema: 'Sistema de justiça criminal, violência de gênero, atuação policial e políticas penitenciárias.',
        tags: ['Segurança Pública', 'Justiça Criminal', 'Gênero & Violência'],
      },
      {
        sigla: 'MARGEM & OJB',
        nome: 'Democracia, Justiça e Observatório da Justiça Brasileira',
        lider: 'Prof. Dr. Leonardo Avritzer',
        tema: 'Instituições judiciais, ativismo do STF, transições democráticas e controle de constitucionalidade.',
        tags: ['Judiciário & Política', 'Democracia', 'STF'],
      },
      {
        sigla: 'RIPPERP',
        nome: 'Rede de Pesquisa em Política Externa e Relações Internacionais',
        lider: 'Prof. Dr. Dawisson Belém Lopes',
        tema: 'Cooperação sul-sul, diplomacia pública federativa de estados e municípios, e paradiplomacia.',
        tags: ['Política Externa', 'Diplomacia Federativa', 'Comércio Internacional'],
      },
    ]
  },
  {
    eixo: 'Eixo 3: Democracia Participativa, Gênero & Opinião Pública',
    icon: 'bi-people',
    items: [
      {
        sigla: 'PRODEP',
        nome: 'Projeto Democracia Participativa',
        lider: 'Prof. Dr. Leonardo Avritzer',
        tema: 'Orçamento participativo, conselhos gestores de políticas públicas e conferências nacionais.',
        tags: ['Orçamento Participativo', 'Conselhos de Políticas', 'Participação'],
      },
      {
        sigla: 'INCT / IDDC',
        nome: 'Instituto da Democracia e Democratização da Comunicação',
        lider: 'Rede Nacional sediada no DCP/UFMG',
        tema: 'Pesquisa eleitoral comparada, confiança nas instituições republicanas e integridade do debate público.',
        tags: ['Opinião Pública', 'Comunicação Pública', 'Integridade Institucional'],
      },
      {
        sigla: 'NEPEM',
        nome: 'Núcleo de Estudos e Pesquisas sobre a Mulher',
        lider: 'Profa. Dra. Marlise Matos',
        tema: 'Representação política feminina, transversalidade de gênero em planos plurianuais e direitos humanos.',
        tags: ['Mulheres na Política', 'Políticas de Gênero', 'Interseccionalidade'],
      },
      {
        sigla: 'CECOMP',
        nome: 'Centro de Estudos do Comportamento Político',
        lider: 'Prof. Dr. Mario Fuks',
        tema: 'Cultura política, comportamento eleitoral, engajamento cívico juvenil e socialização democrática.',
        tags: ['Cultura Política', 'Comportamento Eleitoral', 'Juventude'],
      },
    ]
  }
];
---

<div class="space-y-6 text-[#0A0A0A]">
  <div class="cagp-tool-box p-5 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[4px_4px_0_0_#0A0A0A] space-y-4">
    <div class="border-b-2 border-[#0A0A0A] pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <div class="flex items-center gap-2">
          <i class="bi bi-diagram-3-fill text-[#8B1E2D] text-xl" aria-hidden="true"></i>
          <h3 class="font-head text-base sm:text-lg font-black uppercase text-[#0A0A0A] m-0 tracking-wide">
            Os 11 Núcleos de Pesquisa do DCP (Conceito 7 CAPES)
          </h3>
        </div>
        <p class="text-xs text-gray-700 mt-0.5 m-0 font-body font-medium">
          Projetos de iniciação científica e extensão com inserção prática na gestão pública:
        </p>
      </div>
      <span class="cagp-badge cagp-badge-red font-mono font-bold">
        Até 90h AAC
      </span>
    </div>

    {nucleos.map((eixoGroup) => (
      <div class="space-y-3 pt-2">
        <div class="flex items-center gap-2">
          <i class={`bi ${eixoGroup.icon} text-[#8B1E2D] text-lg`} aria-hidden="true"></i>
          <span class="font-head text-xs font-black uppercase text-[#8B1E2D] tracking-wider">
            {eixoGroup.eixo}
          </span>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-3.5">
          {eixoGroup.items.map((item) => (
            <div class="cagp-card p-4 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col justify-between shadow-[2px_2px_0_0_#0A0A0A] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[4px_4px_0_0_#0A0A0A] transition-all">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="font-head font-black text-xs uppercase text-[#8B1E2D] tracking-wide">
                    {item.sigla}
                  </span>
                  <span class="cagp-badge font-mono text-[10px] font-bold">DCP/UFMG</span>
                </div>
                <h4 class="font-head font-bold text-xs uppercase text-[#0A0A0A] leading-tight mb-1.5 tracking-wide">
                  {item.nome}
                </h4>
                <p class="text-[11px] text-gray-600 mb-1.5 font-body">
                  <strong>Coordenação:</strong> {item.lider}
                </p>
                <p class="text-xs text-gray-700 leading-relaxed mb-3 font-body font-medium">
                  {item.tema}
                </p>
              </div>
              <div class="flex flex-wrap gap-1.5 pt-2.5 border-t-2 border-[#0A0A0A]">
                {item.tags.map((t) => (
                  <span class="cagp-badge font-mono text-[10px] font-medium">
                    {t}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>