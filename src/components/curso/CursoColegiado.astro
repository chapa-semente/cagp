---
// CursoColegiado.astro - Sub-view 3: Colegiado do Curso, NDE & Secretaria
import { asset, route } from '../../lib/paths';

const coordenacao = {
  coordenadora: 'Profª Isabele Batista Mitozo',
  emailCoord: 'coordgestaopublicaufmg@gmail.com',
  subcoordenadora: 'Profª Ludmila Mendonça Lopes Ribeiro',
  emailSub: 'ludmila.ribeiro@gmail.com',
};

const secretarios = {
  secretaria: 'Wander Wenceslau Pereira / Ubirajara Dutra',
  horario: 'Quarta-feira, das 13h00 às 19h00',
  sala: 'FAFICH, 2º Andar, Sala F-2039',
  telefone: '(31) 3409-3826',
  email: 'gestaopublica@ufmg.br',
};

const ceag = {
  local: 'FAFICH, 2º Andar (em frente aos caixas eletrônicos)',
  horario: 'Segunda a sexta-feira, das 08h00 às 22h00',
  atribuicoes: 'Protocolo de requerimentos acadêmicos padrão (trancamentos, regime especial, colação de grau, exame especial), autenticação de atestados e declarações.',
};

const ndeMembros = [
  { nome: 'Profª Isabele Batista Mitozo', papel: 'Presidente do NDE / Coordenadora', email: 'coordgestaopublicaufmg@gmail.com' },
  { nome: 'Profª Ludmila Mendonça Lopes Ribeiro', papel: 'Subcoordenadora do Colegiado', email: 'ludmila.ribeiro@gmail.com' },
  { nome: 'Prof. Paulo Ricardo Diniz Filho', papel: 'Docente DCP / FAFICH', email: 'paulo.ng.diniz@gmail.com' },
  { nome: 'Prof. Marcus Abílio Pereira', papel: 'Docente DCP / FAFICH', email: 'magopebh@gmail.com' },
  { nome: 'Prof. João Carlos Amoroso Botelho', papel: 'Docente DCP / FAFICH', email: 'joaocarlosbotelho@hotmail.com' },
  { nome: 'Profª Natália Guimarães Duarte Sátyro', papel: 'Docente DCP / FAFICH', email: 'nsatyro@gmail.com' },
];

const colegiadoRepresentantes = [
  { orgao: 'Ciência Política (DCP/FAFICH)', titular: 'Prof. Paulo Ricardo Diniz Filho', suplente: 'Prof. Lucas Gelape' },
  { orgao: 'Ciência Política (DCP/FAFICH)', titular: 'Prof. Lucas Pereira Rezende', suplente: 'Prof. José Angelo Machado' },
  { orgao: 'Sociologia (DSO/FAFICH)', titular: 'Profª Ana Paula Vasconcelos Gonçalves', suplente: 'Profª Elaine Meire Vilela' },
  { orgao: 'Economia (ECN/FACE)', titular: 'Profª Lizia de Figueiredo', suplente: 'Profª Clara Zanon' },
  { orgao: 'Representação Discente', titular: 'Nina Queirolo Lage (CAGP)', suplente: 'Diretoria Colegiada CAGP' },
];

const atosCurso = [
  {
    sigla: 'PPC 2020',
    titulo: 'Projeto Pedagógico do Curso',
    desc: 'Estrutura completa de 3.000h, competências e percursos formativos.',
    file: 'ppc-gestao-publica-ufmg.pdf',
    slug: 'ppc-gestao-publica-ufmg',
  },
  {
    sigla: 'N-20229',
    titulo: 'Regulamento do Curso de Graduação',
    desc: 'Normas de matrícula mínima (180h), AAC (120d), estágio e TCC.',
    file: 'regulamento-gestao-publica-ufmg.pdf',
    slug: 'regulamento-gestao-publica-ufmg',
  },
  {
    sigla: 'Res. 07/2016',
    titulo: 'Planejamento de Horário & Oferta',
    desc: 'Diretrizes curriculares de alocação de salas e turnos na FAFICH.',
    file: 'resolucao-07-2016-planejamento-horario.pdf',
  },
  {
    sigla: 'Res. 08/2016',
    titulo: 'Distribuição de Vagas Remanescentes',
    desc: 'Critérios de reopção, transferências e novo título no Colegiado.',
    file: 'resolucao-08-2016-distribuicao-vagas-remanescentes.pdf',
  },
];
---

<div class="space-y-6 text-[#0A0A0A]">
  {/* Atendimento Presencial: Secretaria vs. CEAG */}
  <div class="cagp-tool-box p-5 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[4px_4px_0_0_#0A0A0A] space-y-4">
    <div class="border-b-2 border-[#0A0A0A] pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <div class="flex items-center gap-2">
          <i class="bi bi-door-open-fill text-[#8B1E2D] text-xl" aria-hidden="true"></i>
          <h3 class="font-head text-base sm:text-lg font-black uppercase text-[#0A0A0A] m-0 tracking-wide">
            Atendimento Acadêmico: Secretaria & CEAG
          </h3>
        </div>
        <p class="text-xs text-gray-700 mt-0.5 font-body font-medium">Canais oficiais de atendimento ao turno noturno da FAFICH/UFMG:</p>
      </div>
      <span class="cagp-badge cagp-badge-red font-mono font-bold">
        Sala F-2039 & CEAG 2º Andar
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-xs font-body font-medium">
      {/* Secretaria do Colegiado */}
      <div class="cagp-card p-4 bg-white space-y-2 border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A]">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <i class="bi bi-person-badge-fill text-[#8B1E2D] text-lg" aria-hidden="true"></i>
            <span class="font-head font-bold uppercase text-xs text-[#8B1E2D] tracking-wide">Secretaria de Gestão Pública</span>
          </div>
          <span class="cagp-badge cagp-badge-red text-[10px] font-mono font-bold">Presencial Quarta</span>
        </div>
        <p class="text-xs text-gray-800 m-0"><strong>Local:</strong> {secretarios.sala}</p>
        <p class="text-xs text-gray-800 m-0"><strong>Atendimento:</strong> {secretarios.secretaria}</p>
        <p class="text-xs text-gray-800 m-0"><strong>Horário Presencial:</strong> {secretarios.horario}</p>
        <p class="text-xs text-gray-800 m-0"><strong>Telefone:</strong> <span class="font-mono">{secretarios.telefone}</span></p>
        <p class="text-xs text-gray-800 m-0"><strong>E-mail:</strong> <span class="font-mono text-[#8B1E2D] font-bold">{secretarios.email}</span></p>
        <p class="text-[11px] text-gray-600 italic mt-2 m-0">Aproveitamento de estudos, Formação Complementar Aberta (FCA) e reuniões com a coordenação.</p>
      </div>

      {/* CEAG Noturno */}
      <div class="cagp-card p-4 bg-white space-y-2 border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A]">
        <div class="flex items-center justify-between mb-2">
          <div class="flex items-center gap-2">
            <i class="bi bi-clock-history text-[#0A0A0A] text-lg" aria-hidden="true"></i>
            <span class="font-head font-bold uppercase text-xs text-[#0A0A0A] tracking-wide">CEAG FAFICH (Graduação)</span>
          </div>
          <span class="cagp-badge cagp-badge-dark text-[10px] font-mono font-bold">08h às 22h</span>
        </div>
        <p class="text-xs text-gray-800 m-0"><strong>Local:</strong> {ceag.local}</p>
        <p class="text-xs text-gray-800 m-0"><strong>Plantão Contínuo:</strong> {ceag.horario}</p>
        <p class="text-xs text-gray-700 leading-relaxed mt-1 m-0">{ceag.atribuicoes}</p>
        <div class="p-3 bg-white rounded-lg border-2 border-[#0A0A0A] mt-2 shadow-[1px_1px_0_0_#0A0A0A]">
          <p class="text-[11px] text-gray-700 font-medium m-0">
            <strong>Dica Noturna:</strong> Para entregar atestados médicos e requerimentos padrão do DRCA após as 19h, dirija-se diretamente ao guichê do CEAG.
          </p>
        </div>
      </div>
    </div>
  </div>

  {/* Coordenação do Curso & NDE */}
  <div class="cagp-tool-box p-5 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[4px_4px_0_0_#0A0A0A] space-y-4">
    <div class="border-b-2 border-[#0A0A0A] pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <div class="flex items-center gap-2">
          <i class="bi bi-mortarboard-fill text-[#8B1E2D] text-lg" aria-hidden="true"></i>
          <h3 class="font-head text-base sm:text-lg font-black uppercase text-[#0A0A0A] m-0 tracking-wide">
            Coordenação Didática & Núcleo Docente Estruturante (NDE)
          </h3>
        </div>
        <p class="text-xs text-gray-700 mt-0.5 font-body font-medium">Gestão pedagógica e aperfeiçoamento contínuo do PPC de Gestão Pública:</p>
      </div>
      <span class="cagp-badge cagp-badge-dark font-mono text-xs font-bold">Mandato Vigente 2026</span>
    </div>

    {/* Coordenação Titular e Sub */}
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-body">
      <div class="cagp-card p-4 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A]">
        <span class="text-[11px] font-head uppercase font-bold text-[#8B1E2D] tracking-wide block">Coordenadora do Colegiado</span>
        <h4 class="font-head text-base font-bold uppercase text-[#0A0A0A] mt-1 m-0 tracking-wide">{coordenacao.coordenadora}</h4>
        <p class="text-xs text-gray-700 mt-1.5 m-0 font-medium">E-mail: <a href={`mailto:${coordenacao.emailCoord}`} class="font-mono text-[#8B1E2D] underline font-bold">{coordenacao.emailCoord}</a></p>
      </div>
      <div class="cagp-card p-4 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A]">
        <span class="text-[11px] font-head uppercase font-bold text-gray-700 tracking-wide block">Subcoordenadora do Colegiado</span>
        <h4 class="font-head text-base font-bold uppercase text-[#0A0A0A] mt-1 m-0 tracking-wide">{coordenacao.subcoordenadora}</h4>
        <p class="text-xs text-gray-700 mt-1.5 m-0 font-medium">E-mail: <a href={`mailto:${coordenacao.emailSub}`} class="font-mono text-[#8B1E2D] underline font-bold">{coordenacao.emailSub}</a></p>
      </div>
    </div>

    {/* Membros do NDE */}
    <div class="mt-4">
      <span class="font-head font-bold uppercase text-xs text-[#0A0A0A] block mb-2.5 tracking-wide">
        Membros do Núcleo Docente Estruturante (NDE):
      </span>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {ndeMembros.map((m) => (
          <div class="p-3 bg-white border-2 border-[#0A0A0A] rounded-xl text-xs shadow-[2px_2px_0_0_#0A0A0A]">
            <strong class="text-[#0A0A0A] font-head uppercase tracking-wide text-xs block">{m.nome}</strong>
            <span class="text-[11px] text-gray-700 font-body font-medium block mt-0.5">{m.papel}</span>
            <span class="text-[11px] font-mono text-[#8B1E2D] font-bold block mt-1">{m.email}</span>
          </div>
        ))}
      </div>
    </div>

    {/* Representação por Departamento */}
    <div class="mt-4 pt-4 border-t-2 border-[#0A0A0A]">
      <span class="font-head font-bold uppercase text-xs text-[#0A0A0A] block mb-2.5 tracking-wide">
        Composição Interdepartamental do Colegiado:
      </span>
      <div class="space-y-2">
        {colegiadoRepresentantes.map((r) => (
          <div class="p-3 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between text-xs gap-1.5 shadow-[1px_1px_0_0_#0A0A0A]">
            <span class="font-head font-bold text-[#8B1E2D] uppercase tracking-wide">{r.orgao}:</span>
            <span class="text-gray-800 font-body font-medium"><strong>Titular:</strong> {r.titular} | <strong>Suplente:</strong> {r.suplente}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  {/* Atos Mestres & Normas do Curso: Leitura Direta e Download */}
  <div class="cagp-tool-box p-5 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[4px_4px_0_0_#0A0A0A] space-y-4">
    <div class="border-b-2 border-[#0A0A0A] pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <h4 class="font-head font-black text-base uppercase text-[#0A0A0A] m-0 flex items-center gap-2 tracking-wide">
          <i class="bi bi-file-earmark-ruled-fill text-[#8B1E2D] text-lg" aria-hidden="true" />
          <span>Atos Mestres e Normas Oficiais do Curso</span>
        </h4>
        <p class="text-xs text-gray-700 mt-0.5 m-0 font-body font-medium">Legislação estruturante com leitura digital e download de PDFs assinados:</p>
      </div>
      <span class="text-xs text-[#0A0A0A] font-mono font-bold">4 Documentos</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {atosCurso.map((doc) => (
        <div class="cagp-card p-4 bg-white flex flex-col justify-between border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A]">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="cagp-badge cagp-badge-red text-[10px] font-mono font-bold">{doc.sigla}</span>
              <span class="text-[11px] text-gray-600 font-mono font-bold">PDF Oficial</span>
            </div>
            <h5 class="font-head font-bold text-sm uppercase text-[#0A0A0A] m-0 mb-1.5 tracking-wide">{doc.titulo}</h5>
            <p class="text-xs text-gray-700 leading-snug m-0 font-body font-medium">{doc.desc}</p>
          </div>

          <div class="flex items-center gap-2 mt-4 pt-3 border-t-2 border-[#0A0A0A]">
            {doc.slug && (
              <a
                href={route(`/documentos/${doc.slug}`)}
                class="cagp-btn-secondary text-xs py-2 px-3 no-underline flex items-center gap-1.5 font-head font-bold uppercase tracking-wider"
                title="Abrir no leitor digital"
              >
                <i class="bi bi-book-half" aria-hidden="true" />
                <span>Ler Transcrição</span>
              </a>
            )}
            <a
              href={asset(`/documentos/${doc.file}`)}
              download
              class="cagp-btn-primary text-xs py-2 px-3.5 no-underline flex items-center gap-1.5 ml-auto font-head font-bold uppercase tracking-wider"
              title={`Baixar ${doc.titulo}`}
            >
              <i class="bi bi-download" aria-hidden="true" />
              <span>Baixar PDF</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
