---
// src/components/widgets/OverviewGestaoWidget.astro — Widget do Processo Eleitoral e Talentos (Eixo 5: O CAGP)
import { route } from '../../lib/paths';
---

<div class="cagp-card p-5 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col justify-between h-full shadow-[3px_3px_0_0_#0A0A0A] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[4px_4px_0_0_#0A0A0A] transition-all select-none">
  <div>
    <!-- Header do Widget -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-lg bg-[#8B1E2D] text-white flex items-center justify-center text-lg border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
          <i class="bi bi-people-fill text-white" aria-hidden="true"></i>
        </span>
        <div>
          <h3 class="font-head font-bold text-sm uppercase text-[#0A0A0A] leading-tight m-0 tracking-wide">
            Processo Eleitoral & Diretorias
          </h3>
          <span class="text-[11px] text-gray-700 font-mono font-medium">7 Diretorias Estatutárias</span>
        </div>
      </div>
      <span class="px-2 py-0.5 rounded-md font-head text-xs font-bold bg-[#8B1E2D] text-white border border-[#0A0A0A] shadow-[1px_1px_0_0_#0A0A0A]">
        Eleições
      </span>
    </div>

    <!-- Conteúdo & Banco de Talentos -->
    <div class="space-y-2 mb-4">
      <p class="text-xs text-gray-700 leading-relaxed font-body font-medium">
        O CAGP está em período eleitoral. Conheça o organograma regimental (Art. 8º do Regimento), as 7 diretorias executivas e as comissões discentes.
      </p>

      <div class="p-3 bg-[#FBF8F3] border-2 border-[#0A0A0A] rounded-lg text-xs space-y-1.5 shadow-[1px_1px_0_0_#0A0A0A]">
        <div class="font-bold text-[#0A0A0A] flex items-center gap-1.5 font-head uppercase tracking-wider text-[11px]">
          <i class="bi bi-stars text-[#8B1E2D]" aria-hidden="true"></i>
          <span>Banco de Talentos Discente</span>
        </div>
        <p class="text-xs text-gray-700 font-body font-medium m-0">
          Cadastre suas habilidades no Passaporte para atuar em projetos, representação discente e comissões do centro acadêmico.
        </p>
      </div>
    </div>
  </div>

  <!-- Ação -->
  <a
    href={route('/gestao')}
    class="min-h-[44px] px-3.5 py-2 bg-[#0A0A0A] text-white hover:bg-[#8B1E2D] hover:text-white active:translate-x-[2px] active:translate-y-[2px] active:shadow-none rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline mt-2 border-2 border-[#0A0A0A] shadow-[3px_3px_0_0_#0A0A0A]"
  >
    <span>Conhecer Diretorias & Transição</span>
    <i class="bi bi-arrow-right" aria-hidden="true"></i>
  </a>
</div>
