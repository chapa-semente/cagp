---
// SobreGovernanca.astro - Sub-view 2: Governança Estatutária e Estrutura Orgânica
import { route, asset } from '../../lib/paths';

const diretorias = [
  { sigla: 'DIPRE', nome: '1. Diretoria da Presidência', icon: 'bi-bank', desc: 'Presidência e Vice-Presidência. Representação jurídica, institucional e política perante a UFMG e a sociedade (Art. 28).' },
  { sigla: 'DIJUR', nome: '2. Diretoria de Assuntos Jurídicos', icon: 'bi-shield-check', desc: 'Atas de assembleias, arquivo institucional, conformidade jurídica e transparência (Art. 29).' },
  { sigla: 'DIFI', nome: '3. Diretoria Financeira', icon: 'bi-cash-coin', desc: 'Livro-caixa, prestação de contas e RREO mensal, e gestão dos itens do curso (Art. 30).' },
  { sigla: 'DIAC', nome: '4. Diretoria Acadêmica', icon: 'bi-mortarboard', desc: 'Acompanhamento discente junto ao Colegiado, NDE, percursos curriculares e AAC/extensão (Art. 31).' },
  { sigla: 'DIAP', nome: '5. Diretoria de Articulação e Assuntos Políticos', icon: 'bi-diagram-3', desc: 'Relações institucionais com CEB, DA FAFICH, DCE UFMG e campo de públicas (Art. 32).' },
  { sigla: 'DICULT', nome: '6. Diretoria de Cultura', icon: 'bi-palette', desc: 'Calouradas semestrais, eventos culturais, debates extracurriculares e esportes (Art. 33).' },
  { sigla: 'DIMAC', nome: '7. Diretoria de Marketing e Comunicação', icon: 'bi-broadcast-pin', desc: 'Redes sociais, murais da FAFICH e manutenção contínua do Super App discente (Art. 34).' },
];
---

<div class="space-y-6 text-[#0A0A0A] font-body">
  <div class="bg-white border-[3px] border-[#0A0A0A] rounded-xl p-5 sm:p-6 shadow-[4px_4px_0_0_#0A0A0A] space-y-4">
    <div class="border-b-2 border-[#0A0A0A] pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-[#8B1E2D] text-white flex items-center justify-center border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
            <i class="bi bi-diagram-3-fill text-base" aria-hidden="true"></i>
          </div>
          <h3 class="font-head text-base sm:text-lg font-extrabold uppercase text-[#0A0A0A] m-0 tracking-tight">
            Estrutura em 7 Diretorias Executivas (Regimento de 14/10/2024)
          </h3>
        </div>
        <p class="text-xs text-[#0A0A0A] mt-1 m-0 font-medium">Divisão funcional de competências para garantir eficiência e transparência:</p>
      </div>
      <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-[#8B1E2D] text-white border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
        Regimento 14/10/2024
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 text-xs">
      {diretorias.map((d) => (
        <div class="p-3.5 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A] flex items-start gap-3">
          <div class="w-9 h-9 rounded-lg bg-white border-2 border-[#0A0A0A] flex items-center justify-center text-[#8B1E2D] shrink-0 mt-0.5 shadow-[2px_2px_0_0_#0A0A0A]">
            <i class={`bi ${d.icon} text-base`} aria-hidden="true" />
          </div>
          <div class="min-w-0">
            <span class="font-head font-extrabold uppercase text-[#8B1E2D] text-xs block mb-1">{d.nome}</span>
            <p class="text-xs text-[#0A0A0A] leading-snug font-medium m-0">{d.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="p-4 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[3px_3px_0_0_#0A0A0A] text-xs space-y-1.5 mt-4">
      <div class="flex items-center gap-2 mb-1">
        <i class="bi bi-check2-square text-[#15803D] text-base" aria-hidden="true"></i>
        <span class="font-head font-extrabold uppercase text-xs text-[#0A0A0A]">
          Processo Eleitoral Democrático
        </span>
      </div>
      <p class="text-xs text-[#0A0A0A] leading-relaxed font-medium m-0">
        A Diretoria Executiva é eleita anualmente por voto direto, secreto e universal de todos os estudantes regularmente matriculados no curso. As eleições são conduzidas por Comissão Eleitoral independente sorteada em Assembleia Geral.
      </p>
    </div>

    <div class="pt-3 border-t-2 border-[#0A0A0A] flex items-center gap-3 flex-wrap">
      <a
        href={route('/documentos/regimento-interno-cagp-ufmg')}
        class="min-h-[44px] px-3.5 py-2 bg-white hover:bg-muted text-[#0A0A0A] font-head font-bold uppercase text-xs tracking-wider border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A] hover:shadow-[3px_3px_0_0_#0A0A0A] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
      >
        <i class="bi bi-eye" aria-hidden="true"></i> Ler Regimento Transcrito
      </a>
      <a
        href={asset('/documentos/regimento-interno-cagp-ufmg.pdf')}
        download
        class="min-h-[44px] px-4 py-2 bg-[#8B1E2D] hover:bg-[#9E2424] text-white font-head font-bold uppercase text-xs tracking-wider border-2 border-[#0A0A0A] rounded-xl shadow-[3px_3px_0_0_#0A0A0A] hover:shadow-[4px_4px_0_0_#0A0A0A] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
      >
        <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Baixar Regimento CAGP (PDF)
      </a>
      <a
        href={asset('/documentos/regimento-geral-ufmg.pdf')}
        download
        class="min-h-[44px] px-3.5 py-2 bg-[#0A0A0A] hover:bg-[#8B1E2D] text-white font-head font-bold uppercase text-xs tracking-wider border-2 border-[#0A0A0A] rounded-xl shadow-[3px_3px_0_0_#0A0A0A] hover:shadow-[4px_4px_0_0_#0A0A0A] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
      >
        <i class="bi bi-building" aria-hidden="true"></i> Regimento Geral UFMG (PDF)
      </a>
    </div>
  </div>
</div>
