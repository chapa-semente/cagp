---
// src/components/features/calouros/CalouroCentralOverview.astro — Visão Geral do Guia do Calouro (Padrão Dossiê Tátil)
import { CalouroChecklistWidget } from './checklist/CalouroChecklistWidget';
import CagpIcon from '../../ui/CagpIcon.astro';
---

<div class="cagp-calouro-central-overview space-y-6 select-none text-[#0A0A0A]">
  {/* Apresentação do Guia do Calouro */}
  <div class="p-5 sm:p-6 bg-white border border-[#DFDBD2] rounded-3xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-start gap-3.5">
      <span class="w-11 h-11 rounded-2xl bg-[#8B1E2D] text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
        <CagpIcon name="checklist" class="w-6 h-6" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#8B1E2D]">
            Acolhimento Discente &amp; Sobrevivência
          </span>
          <span class="text-[#A8A29E]">•</span>
          <span class="text-xs text-[#57534E] font-mono">1º Período Noturno</span>
        </div>
        <h2 class="font-['Oswald'] text-lg sm:text-xl font-bold uppercase text-[#0A0A0A] leading-tight m-0">
          Manual de Sobrevivência na FAFICH &amp; Campus Pampulha
        </h2>
        <p class="text-xs text-[#57534E] mt-1 max-w-3xl leading-relaxed m-0">
          Checklist interativo dos primeiros 30 dias, linha do tempo da rotina noturna (RU Setorial II às 18h15 e último Circular às 22h45), espaços da faculdade e bolsas FUMP.
        </p>
      </div>
    </div>
  </div>

  {/* Bento Grid dos Widgets de Calouro */}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {/* Widget do Checklist */}
    <CalouroChecklistWidget client:load />

    {/* Card da Rotina Noturna */}
    <div class="p-5 sm:p-6 bg-white border border-[#DFDBD2] rounded-3xl flex flex-col justify-between h-full shadow-xs hover:border-[#8B1E2D]/50 transition-all">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-xl bg-[#8B1E2D]/10 text-[#8B1E2D] flex items-center justify-center border border-[#8B1E2D]/20 shrink-0">
              <CagpIcon name="moon" class="w-4 h-4" />
            </span>
            <div>
              <h3 class="font-['Oswald'] font-bold text-sm uppercase text-[#0A0A0A] leading-tight m-0">
                Rotina Noturna &amp; RU
              </h3>
              <span class="text-[11px] text-[#57534E] font-mono">17h30 às 22h45</span>
            </div>
          </div>
          <span class="px-2.5 py-0.5 rounded-full font-['Oswald'] text-[11px] font-bold bg-[#8B1E2D] text-white">
            Crucial
          </span>
        </div>

        <p class="text-xs text-[#292524] leading-relaxed mb-4">
          Jantar às 18h15 no RU II Setorial para evitar filas, aulas das 19h às 22h30 e último circular da FAFICH às 22h45.
        </p>

        <div class="p-3 bg-[#FBF8F3] border border-[#DFDBD2] rounded-xl mb-4 flex items-center justify-between text-xs">
          <span class="text-[#57534E]">Último Ônibus:</span>
          <span class="font-mono font-bold text-[#8B1E2D]">22h45 (Circular)</span>
        </div>
      </div>

      <a
        href="#rotina-noturna"
        class="min-h-[44px] px-4 py-2 bg-[#8B1E2D] hover:bg-[#6D1723] active:scale-95 text-white rounded-xl font-['Oswald'] text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline shadow-xs"
      >
        <span>Ver Rotina Noturna</span>
        <CagpIcon name="chevron-right" class="w-3.5 h-3.5" />
      </a>
    </div>

    {/* Card dos Espaços & FUMP */}
    <div class="p-5 sm:p-6 bg-white border border-[#DFDBD2] rounded-3xl flex flex-col justify-between h-full shadow-xs hover:border-[#15803D]/50 transition-all">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-xl bg-[#15803D]/10 text-[#15803D] flex items-center justify-center border border-[#15803D]/20 shrink-0">
              <CagpIcon name="building" class="w-4 h-4" />
            </span>
            <div>
              <h3 class="font-['Oswald'] font-bold text-sm uppercase text-[#0A0A0A] leading-tight m-0">
                FAFICH &amp; Apoio FUMP
              </h3>
              <span class="text-[11px] text-[#57534E] font-mono">Sec. F-2039, CEAG &amp; Bolsas</span>
            </div>
          </div>
          <span class="px-2.5 py-0.5 rounded-full font-['Oswald'] text-[11px] font-bold bg-[#15803D] text-white">
            Apoio
          </span>
        </div>

        <p class="text-xs text-[#292524] leading-relaxed mb-4">
          Localização da Secretaria do Colegiado (Sala F-2039), biblioteca e regras de isenção de RU e moradia FUMP.
        </p>

        <div class="p-3 bg-[#FBF8F3] border border-[#DFDBD2] rounded-xl mb-4 flex items-center justify-between text-xs">
          <span class="text-[#57534E]">Secretaria FAFICH:</span>
          <span class="font-mono font-bold text-[#0A0A0A]">Sala F-2039 (2º Andar)</span>
        </div>
      </div>

      <a
        href="#espacos"
        class="min-h-[44px] px-4 py-2 bg-[#0A0A0A] hover:bg-[#292524] active:scale-95 text-white rounded-xl font-['Oswald'] text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline shadow-xs"
      >
        <span>Mapear Espaços</span>
        <CagpIcon name="chevron-right" class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</div>
