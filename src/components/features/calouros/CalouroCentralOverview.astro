---
// src/components/features/calouros/CalouroCentralOverview.astro — Visão Geral do Guia do Calouro (Padrão Dossiê Tátil)
import { CalouroChecklistWidget } from './checklist/CalouroChecklistWidget';
import CagpIcon from '../../ui/CagpIcon.astro';
---

<div class="cagp-calouro-central-overview space-y-6 select-none text-[#0A0A0A]">
  {/* Apresentação do Guia do Calouro */}
  <div class="p-5 sm:p-6 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-[4px_4px_0_0_#0A0A0A]">
    <div class="flex items-start gap-3.5">
      <span class="w-12 h-12 rounded-xl bg-[#8B1E2D] text-white flex items-center justify-center shrink-0 mt-0.5 border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
        <CagpIcon name="checklist" class="w-6 h-6 text-white" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-head uppercase font-bold tracking-wider text-[#8B1E2D]">
            Acolhimento Discente &amp; Sobrevivência
          </span>
          <span class="text-[#0A0A0A]">•</span>
          <span class="text-xs text-[#0A0A0A] font-mono font-bold">1º Período Noturno</span>
        </div>
        <h2 class="font-head text-lg sm:text-xl font-black uppercase text-[#0A0A0A] leading-tight m-0 tracking-wide">
          Manual de Sobrevivência na FAFICH &amp; Campus Pampulha
        </h2>
        <p class="text-xs text-gray-700 mt-1 max-w-3xl leading-relaxed m-0 font-body font-medium">
          Checklist interativo dos primeiros 30 dias, linha do tempo da rotina noturna (RU Setorial II às 18h15 e último Circular às 22h45), espaços da faculdade e bolsas FUMP.
        </p>
      </div>
    </div>
  </div>

  {/* Bento Grid dos Widgets de Calouro */}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    {/* Widget do Checklist */}
    <CalouroChecklistWidget client:load />

    {/* Card da Rotina Noturna */}
    <div class="p-5 sm:p-6 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col justify-between h-full shadow-[3px_3px_0_0_#0A0A0A] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[4px_4px_0_0_#0A0A0A] transition-all">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-lg bg-[#8B1E2D] text-white flex items-center justify-center border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] shrink-0">
              <CagpIcon name="moon" class="w-4 h-4 text-white" />
            </span>
            <div>
              <h3 class="font-head font-bold text-sm uppercase text-[#0A0A0A] leading-tight m-0 tracking-wide">
                Rotina Noturna &amp; RU
              </h3>
              <span class="text-[11px] text-gray-700 font-mono font-medium">17h30 às 22h45</span>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-md font-head text-[11px] font-bold bg-[#8B1E2D] text-white border border-[#0A0A0A] shadow-[1px_1px_0_0_#0A0A0A]">
            Crucial
          </span>
        </div>

        <p class="text-xs text-gray-700 leading-relaxed mb-4 font-body font-medium">
          Jantar às 18h15 no RU II Setorial para evitar filas, aulas das 19h às 22h30 e último circular da FAFICH às 22h45.
        </p>

        <div class="p-3 bg-white border-2 border-[#0A0A0A] rounded-lg mb-4 flex items-center justify-between text-xs shadow-[1px_1px_0_0_#0A0A0A]">
          <span class="text-gray-700 font-body font-medium">Último Ônibus:</span>
          <span class="font-mono font-bold text-[#8B1E2D]">22h45 (Circular)</span>
        </div>
      </div>

      <a
        href="#rotina-noturna"
        class="min-h-[44px] px-4 py-2 bg-[#8B1E2D] hover:bg-[#6D1723] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline shadow-[3px_3px_0_0_#0A0A0A] border-2 border-[#0A0A0A]"
      >
        <span>Ver Rotina Noturna</span>
        <CagpIcon name="chevron-right" class="w-3.5 h-3.5" />
      </a>
    </div>

    {/* Card dos Espaços & FUMP */}
    <div class="p-5 sm:p-6 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col justify-between h-full shadow-[3px_3px_0_0_#0A0A0A] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[4px_4px_0_0_#0A0A0A] transition-all">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-lg bg-[#15803D] text-white flex items-center justify-center border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] shrink-0">
              <CagpIcon name="building" class="w-4 h-4 text-white" />
            </span>
            <div>
              <h3 class="font-head font-bold text-sm uppercase text-[#0A0A0A] leading-tight m-0 tracking-wide">
                FAFICH &amp; Apoio FUMP
              </h3>
              <span class="text-[11px] text-gray-700 font-mono font-medium">Sec. F-2039, CEAG &amp; Bolsas</span>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-md font-head text-[11px] font-bold bg-[#15803D] text-white border border-[#0A0A0A] shadow-[1px_1px_0_0_#0A0A0A]">
            Apoio
          </span>
        </div>

        <p class="text-xs text-gray-700 leading-relaxed mb-4 font-body font-medium">
          Localização da Secretaria do Colegiado (Sala F-2039), biblioteca e regras de isenção de RU e moradia FUMP.
        </p>

        <div class="p-3 bg-white border-2 border-[#0A0A0A] rounded-lg mb-4 flex items-center justify-between text-xs shadow-[1px_1px_0_0_#0A0A0A]">
          <span class="text-gray-700 font-body font-medium">Secretaria FAFICH:</span>
          <span class="font-mono font-bold text-[#0A0A0A]">Sala F-2039 (2º Andar)</span>
        </div>
      </div>

      <a
        href="#espacos"
        class="min-h-[44px] px-4 py-2 bg-[#0A0A0A] hover:bg-[#292524] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline shadow-[3px_3px_0_0_#0A0A0A] border-2 border-[#0A0A0A]"
      >
        <span>Mapear Espaços</span>
        <CagpIcon name="chevron-right" class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</div>
