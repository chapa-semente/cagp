---
// src/components/features/calouros/espacos/CalouroEspacosCore.astro — Espaços Estratégicos da FAFICH e do Campus
const espacos = [
  {
    nome: 'Biblioteca Baeta Neves',
    local: '1º Andar da FAFICH',
    icon: 'bi-book-fill',
    desc: 'Mais de 180 mil volumes em humanidades e ciências sociais. Salões silenciosos de estudo individual e cabines climatizadas para grupos.',
    horario: 'Seg a Sex • 07h30 às 21h45',
  },
  {
    nome: 'Secretaria do Colegiado (Sala F-2039)',
    local: '2º Andar da FAFICH',
    icon: 'bi-door-open-fill',
    desc: 'Atendimento didático-pedagógico exclusivo com Norma Guedes para aproveitamento de estudos, FCA e despachos da coordenação. E-mail: gestaopublica@ufmg.br.',
    horario: 'Quarta-feira • 13h00 às 19h00',
  },
  {
    nome: 'CEAG FAFICH (Central da Graduação)',
    local: '2º Andar da FAFICH (em frente aos caixas eletrônicos)',
    icon: 'bi-headset',
    desc: 'Atendimento contínuo ao turno noturno. Protocolo geral de requerimentos acadêmicos padrão, atestados médicos, trancamentos e autenticação de certidões.',
    horario: 'Seg a Sex • 08h00 às 22h00',
  },
  {
    nome: 'Restaurante Universitário II (Setorial II)',
    local: 'Atrás da FAFICH (próximo ao ICB, ECI e FACE)',
    icon: 'bi-cup-hot-fill',
    desc: 'Jantar noturno subsidiado pela UFMG/FUMP. Acesso com a carteirinha física ou código digital do MinhaUFMG/SIGA.',
    horario: 'Jantar • 17h10 às 19h30',
  },
  {
    nome: 'Sede do CAGP & Centro de Convivência',
    local: 'Subsolo da FAFICH (Vão dos Centros Acadêmicos)',
    icon: 'bi-people-fill',
    desc: 'Espaço de acolhimento estudantil, sofás, micro-ondas, tomadas para carregar notebook e ponto de encontro discente.',
    horario: 'Acesso Livre aos Estudantes',
  },
  {
    nome: 'Xerox & Gráfica Rápida da FAFICH',
    local: '1º Andar (próximo à cantina)',
    icon: 'bi-printer-fill',
    desc: 'Impressão de artigos, encadernação de trabalhos, cópia de textos das pastas de professores e compra de fichas.',
    horario: 'Seg a Sex • 08h00 às 21h30',
  },
];
---

<div class="cagp-calouro-espacos space-y-6 select-none text-[#0A0A0A]">
  {/* Cabeçalho */}
  <div class="p-5 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-[4px_4px_0_0_#0A0A0A]">
    <div>
      <span class="text-xs font-head uppercase font-bold tracking-wider text-[#8B1E2D]">
        Mapeamento de Campo
      </span>
      <h3 class="font-head text-lg font-black uppercase text-[#0A0A0A] m-0 tracking-wide">
        Espaços Estratégicos no Prédio da FAFICH
      </h3>
      <p class="text-xs text-gray-700 mt-0.5 m-0 font-body font-medium">
        Locais indispensáveis para sua rotina acadêmica, estudo e alimentação.
      </p>
    </div>
    <span class="px-3 py-1.5 rounded-lg bg-[#0A0A0A] text-white font-mono text-xs font-bold shrink-0 border border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
      Guia de Espaços
    </span>
  </div>

  {/* Grid dos Espaços */}
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {espacos.map((esp) => (
      <div class="cagp-card p-5 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col justify-between shadow-[3px_3px_0_0_#0A0A0A] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[5px_5px_0_0_#0A0A0A] transition-all">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2.5">
              <span class="w-9 h-9 rounded-lg bg-[#8B1E2D] text-white flex items-center justify-center text-sm border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] shrink-0">
                <i class={`bi ${esp.icon}`} aria-hidden="true" />
              </span>
              <span class="font-head text-sm font-bold uppercase text-[#0A0A0A] truncate tracking-wide">{esp.nome}</span>
            </div>
          </div>

          <span class="inline-block text-[11px] font-mono font-bold text-[#8B1E2D] uppercase tracking-wide mb-2">
            {esp.local}
          </span>

          <p class="text-xs text-gray-700 leading-relaxed m-0 mb-3 font-body font-medium">
            {esp.desc}
          </p>
        </div>

        <div class="pt-3 border-t-2 border-[#0A0A0A] flex items-center justify-between text-xs text-gray-800 font-mono font-bold">
          <i class="bi bi-clock me-1 text-[#8B1E2D]" aria-hidden="true" />
          <span>{esp.horario}</span>
        </div>
      </div>
    ))}
  </div>
</div>
