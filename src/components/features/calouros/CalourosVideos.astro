---
// CalourosVideos.astro - Galeria de tutoriais oficiais em vídeo da UFMG
const videos = [
  {
    id: 'JpBGj59NPqs',
    title: 'Conheça o SIGA UFMG',
    desc: 'Tutorial completo do sistema acadêmico: matrícula, notas, comprovantes e histórico escolar.',
    source: 'Portal UFMG / CECOM',
  },
  {
    id: 'gZI42d0rrfk',
    title: 'MinhaUFMG ou App SIGA?',
    desc: 'Entenda as diferenças entre o portal web corporativo e o app móvel discente.',
    source: 'DTI UFMG',
  },
  {
    id: 'g8979vI6M-s',
    title: 'Carteira da UFMG & Bibliotecas',
    desc: 'Emissão da carteirinha de estudante, acesso aos restaurantes universitários e ao Sistema Pergamum.',
    source: 'Sistema de Bibliotecas BU/UFMG',
  },
  {
    id: '4DonihIQXSM',
    title: 'Acessibilidade & Inclusão (NAI)',
    desc: 'Recursos pedagógicos, adaptações e suporte do Núcleo de Acessibilidade e Inclusão.',
    source: 'NAI / Prograd UFMG',
  },
  {
    id: 'LzVLJ_zE8uM',
    title: 'Saúde Mental & Acolhimento',
    desc: 'Rede de apoio psicológico e assistência da DASE/PRAE para estudantes.',
    source: 'DASE / PRAE UFMG',
  },
  {
    id: 'dg8hXD2Qbp4',
    title: 'UFMG Contra o Assédio (Res. 07/25)',
    desc: 'Canais de acolhimento, Ouvidoria e a nova Resolução de Enfrentamento ao Assédio na UFMG.',
    source: 'Ouvidoria Geral UFMG',
  },
];
---

<div class="cagp-tool-box p-5 bg-white border-2 border-border rounded-xl shadow-md space-y-4 text-foreground">
  <div class="border-b-2 border-border pb-3 flex items-center justify-between flex-wrap gap-2">
    <div>
      <div class="flex items-center gap-2">
        <i class="bi bi-youtube text-ufmg-red text-xl" aria-hidden="true" />
        <h3 class="font-head text-base sm:text-lg font-black text-foreground m-0">
          Tutoriais Oficiais em Vídeo (UFMG & Sistemas)
        </h3>
      </div>
      <p class="text-xs text-gray-700 mt-0.5 font-body font-medium">
        Orientações institucionais em formato audiovisual para apoiar sua chegada à universidade:
      </p>
    </div>
    <span class="cagp-badge cagp-badge-red font-mono font-bold">
      6 Vídeos
    </span>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    {videos.map((v) => (
      <article class="cagp-card cagp-video-card overflow-hidden flex flex-col justify-between border-3 border-border rounded-xl shadow hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-md transition-all">
        <div
          class="cagp-video-thumb-wrap video-trigger cursor-pointer relative focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
          data-video-id={v.id}
          data-video-title={v.title}
          role="button"
          tabindex="0"
          aria-label={`Reproduzir vídeo: ${v.title}`}
        >
          <img
            src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
            alt={`Miniatura do tutorial oficial ${v.title}`}
            class="cagp-video-thumb w-full aspect-video object-cover"
            loading="lazy"
          />
          <div class="cagp-video-play-btn absolute inset-0 flex items-center justify-center bg-black/30 hover:bg-black/20 transition-all text-white text-3xl" aria-hidden="true">
            <span class="w-12 h-12 rounded-xl bg-ufmg-red text-white border-2 border-border shadow-sm flex items-center justify-center">
              <i class="bi bi-play-fill ml-0.5"></i>
            </span>
          </div>
        </div>
        <div class="p-3.5 flex flex-col flex-1 justify-between bg-white">
          <div>
            <h4 class="font-head font-bold text-xs text-foreground line-clamp-1 mb-1">
              {v.title}
            </h4>
            <p class="text-xs text-gray-700 line-clamp-2 leading-snug font-body font-medium m-0">
              {v.desc}
            </p>
          </div>
          <span class="text-xs font-mono font-bold text-gray-600 mt-2.5 block">
            {v.source}
          </span>
        </div>
      </article>
    ))}
  </div>
</div>

<script>
  function setupVideoPlayers() {
    const triggers = document.querySelectorAll<HTMLElement>('.video-trigger');
    triggers.forEach((trigger) => {
      const play = () => {
        const id = trigger.getAttribute('data-video-id');
        const title = trigger.getAttribute('data-video-title') || 'Vídeo';
        if (!id) return;
        trigger.innerHTML = `
          <iframe
            src="https://www.youtube-nocookie.com/embed/${id}?autoplay=1"
            title="${title}"
            style="width: 100%; height: 100%; border: 0;"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
          ></iframe>
        `;
      };

      trigger.addEventListener('click', play, { once: true });
      trigger.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          play();
        }
      }, { once: true });
    });
  }

  document.addEventListener('astro:page-load', setupVideoPlayers);
</script>
