---
// src/components/features/calouros/noturno/CalouroNoturnoCore.astro — Rotina Noturna, RU II, Circulares e Galeria dos Campi
import { asset } from '../../../../lib/paths';
import { CalouroNoturnoPlanner } from './CalouroNoturnoPlanner';

const timeline = [
  {
    hora: '17h10',
    titulo: 'Abertura do Jantar no RU II Setorial',
    desc: 'Início do jantar subsidiado aos fundos da FAFICH (próximo ao ICB, FACE e ECI), conforme Portaria PRAE nº 1.286/2026. Cardápio com opção proteica e vegetariana balanceada.',
    icon: 'bi-cup-hot-fill',
    badge: '17h10 – 19h30',
  },
  {
    hora: '18h00',
    titulo: 'Horário de Ouro para Jantar',
    desc: 'Janela de menor fila no RU II. Chegar entre 18h00 e 18h25 garante jantar tranquilo com tempo hábil para retornar à FAFICH antes do início das aulas.',
    icon: 'bi-star-fill',
    badge: 'Dica Veterana',
    highlight: true,
  },
  {
    hora: '19h00',
    titulo: 'Início das Aulas no Turno Noturno (Bloco 1)',
    desc: 'Início pontual do 1º bloco de aulas nas salas e auditórios da FAFICH (salas dos 2º e 3º andares).',
    icon: 'bi-mortarboard-fill',
    badge: '19h00 – 20h40',
  },
  {
    hora: '20h40',
    titulo: 'Intervalo & Convivência',
    desc: 'Intervalo de 20 minutos. Momento de café na cantina da FAFICH, convivência na salinha do CAGP e protocolos no CEAG 2º Andar (aberto até 22h).',
    icon: 'bi-chat-dots-fill',
    badge: '20h40 – 21h00',
  },
  {
    hora: '21h00',
    titulo: 'Segundo Bloco de Aulas',
    desc: 'Continuidade dos seminários de políticas públicas, debates e oficinas de laboratório.',
    icon: 'bi-book-half',
    badge: '21h00 – 22h30',
  },
  {
    hora: '22h30',
    titulo: 'Término das Aulas & Encerramento',
    desc: 'Final do turno noturno. Saída em grupos em direção aos pontos de ônibus da FAFICH, Av. Antônio Carlos e portaria Catalão.',
    icon: 'bi-moon-stars-fill',
    badge: '22h30',
  },
  {
    hora: '22h45',
    titulo: 'Último Circular Noturno',
    desc: 'Partida do último ônibus Circular Interno gratuito saindo da FAFICH em direção à Estação Pampulha (MOVE) e portarias.',
    icon: 'bi-bus-front-fill',
    badge: 'Último Carro',
    highlight: true,
  },
];

const circularesHorarios = [
  { linha: 'Linha 3 (Sentido ICEx / RU II)', saidas: ['16h40', '17h20', '18h00', '19h05'], itinerario: 'FAFICH, Farmácia, Setorial II (Jantar), Física, ICEx, FACE e Biblioteca Central.' },
  { linha: 'Linha 4 (Sentido Reitoria / RU II)', saidas: ['16h20', '17h00', '17h40', '18h35'], itinerario: 'Portaria Catalão, Reitoria, Praça de Serviços, Setorial II e Humanidades.' },
];

const mapasCampi = [
  {
    id: 'pampulha',
    titulo: 'Campus Pampulha (Detalhamento FAFICH & RU)',
    sub: 'Sede de Gestão Pública, CAD 2, Restaurantes I e II e paradas do Circular.',
    arquivo: 'mapa-pampulha-detalhado.jpg',
  },
  {
    id: 'saude',
    titulo: 'Campus Saúde (Centro-Sul)',
    sub: 'Faculdade de Medicina, Escola de Enfermagem e Hospital das Clínicas (HC/UFMG).',
    arquivo: 'mapa-saude.jpg',
  },
  {
    id: 'centro',
    titulo: 'Campus Centro (Área Central de BH)',
    sub: 'Faculdade de Direito e Escola de Arquitetura.',
    arquivo: 'mapa-centro2.jpg',
  },
  {
    id: 'moc',
    titulo: 'Campus Montes Claros (ICA)',
    sub: 'Instituto de Ciências Agrárias da UFMG no Norte de Minas.',
    arquivo: 'mapa-moc-722x1024.jpg',
  },
  {
    id: 'minas',
    titulo: 'Rede UFMG em Minas Gerais & Viver 2026',
    sub: 'Mapa integrado de unidades acadêmicas, museus, reservas e polos no estado.',
    arquivo: 'mapa-minas.jpg',
  },
];
---

<div class="cagp-calouro-noturno space-y-6 select-none text-foreground">
  {/* Cabeçalho */}
  <div class="p-5 bg-white border-3 border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-md">
    <div>
      <span class="text-xs font-head uppercase font-bold tracking-wider text-secondary">
        Guia Operacional do Turno Noturno
      </span>
      <h3 class="font-head text-lg font-black uppercase text-foreground m-0 tracking-wide">
        Linha do Tempo Noturna: Das 17h10 às 22h45
      </h3>
      <p class="text-xs text-gray-700 mt-0.5 m-0 font-body font-medium">
        Horários operacionais oficiais conforme a Portaria PRAE nº 1.286/2026 e escala de transporte da UFMG.
      </p>
    </div>
    <span class="px-3 py-1.5 rounded-lg bg-foreground text-background text-white font-mono text-xs font-bold shrink-0 border border-border shadow-sm">
      Turno Noturno Oficial
    </span>
  </div>

  {/* Cronograma Noturno & Planejador Interativo Neobrutalista */}
  <CalouroNoturnoPlanner client:load />

  {/* Ônibus Circulares & Acesso ao RU II */}
  <div class="p-5 bg-white border-3 border-border rounded-xl space-y-4 shadow-md">
    <div class="flex items-center justify-between border-b-2 border-border pb-3 flex-wrap gap-2">
      <div>
        <h4 class="font-head text-sm sm:text-base font-bold uppercase text-foreground m-0 flex items-center gap-2 tracking-wide">
          <i class="bi bi-bus-front-fill text-secondary text-lg" aria-hidden="true" />
          <span>Reforço Noturno dos Circulares 3 e 4 (Acesso ao Jantar no RU II)</span>
        </h4>
        <p class="text-xs text-gray-700 mt-0.5 m-0 font-body font-medium">Para atender ao deslocamento até o Setorial II, a Pró-Reitoria de Administração (PRA) estabeleceu horários de reforço:</p>
      </div>
      <span class="cagp-badge cagp-badge-green font-mono text-xs font-bold">Gratuito na Pampulha</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-body">
      {circularesHorarios.map((c) => (
        <div class="p-4 bg-white border-3 border-border rounded-xl space-y-2 shadow-sm">
          <span class="font-head font-black text-xs uppercase text-secondary tracking-wide block">{c.linha}</span>
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-gray-700 font-mono text-xs font-bold">Saídas especiais:</span>
            {c.saidas.map((s) => (
              <span class="px-2 py-0.5 rounded-md bg-white border-3 border-border font-mono font-bold text-xs text-foreground shadow-xs">{s}</span>
            ))}
          </div>
          <p class="text-xs text-gray-700 leading-snug m-0 font-medium">{c.itinerario}</p>
        </div>
      ))}
    </div>

    {/* Posição Política do CAGP */}
    <div class="p-4 bg-[#FDF8F8] border-2 border-secondary rounded-xl text-xs space-y-1.5 shadow-[2px_2px_0_0_#8B1E2D]">
      <div class="flex items-center gap-2 text-secondary font-head font-bold uppercase tracking-wide">
        <i class="bi bi-megaphone-fill text-base" aria-hidden="true"></i>
        <span>Posicionamento e Cobrança Política do CAGP</span>
      </div>
      <p class="text-xs text-gray-800 leading-relaxed m-0 font-body font-medium">
        O CAGP reivindica ativamente perante o DCE, a PRAE e a FUMP a <strong>reabertura do jantar no RU Setorial I</strong> (vizinho imediato à FAFICH, FAE e CAD 2) ou pontos emergenciais de alimentação na unidade. A subida íngreme até o Setorial II à noite sobrecarrega e penaliza discentes que trabalham o dia todo e chegam ao campus entre 18h30 e 19h00.
      </p>
    </div>
  </div>

  {/* Galeria Interativa Oficial de Mapas dos Campi */}
  <div class="p-5 bg-white border-3 border-border rounded-xl space-y-4 shadow-md" id="galeria-campi">
    <div class="flex items-center justify-between border-b-2 border-border pb-3 flex-wrap gap-2">
      <div>
        <h4 class="font-head text-base font-bold uppercase text-foreground m-0 flex items-center gap-2 tracking-wide">
          <i class="bi bi-map-fill text-secondary text-lg" aria-hidden="true" />
          <span>Galeria Oficial de Mapas dos Campi da UFMG</span>
        </h4>
        <p class="text-xs text-gray-700 mt-0.5 m-0 font-body font-medium">Consulte os mapas de orientação do Campus Pampulha, Saúde, Centro, Montes Claros e Minas Gerais:</p>
      </div>
      <a
        id="cagp-map-full-link"
        href={asset(`/imagens/${mapasCampi[0].arquivo}`)}
        target="_blank"
        rel="noopener noreferrer"
        class="min-h-[44px] cagp-btn-secondary text-xs py-2.5 px-4 no-underline shrink-0 flex items-center gap-1.5 font-head font-bold uppercase tracking-wider"
      >
        <i class="bi bi-arrows-fullscreen"></i> Ver em Alta Resolução
      </a>
    </div>

    {/* Botões do Seletor de Campi */}
    <div class="flex items-center gap-2 overflow-x-auto pb-1" role="tablist" aria-label="Seletor de Mapas dos Campi">
      {mapasCampi.map((m, idx) => (
        <button
          type="button"
          class={`cagp-map-tab-btn min-h-[44px] px-4 py-2 rounded-xl text-xs font-head uppercase font-bold tracking-wider transition-all whitespace-nowrap cursor-pointer active:translate-x-[1px] active:translate-y-[1px] ${
            idx === 0
              ? 'bg-secondary text-white shadow-sm border-3 border-border'
              : 'bg-white hover:bg-muted text-foreground border-3 border-border shadow-sm'
          }`}
          data-map-id={m.id}
          data-map-file={asset(`/imagens/${m.arquivo}`)}
          data-map-title={m.titulo}
          data-map-sub={m.sub}
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
        >
          {m.id === 'pampulha' ? 'Pampulha' : m.id === 'saude' ? 'Campus Saúde' : m.id === 'centro' ? 'Campus Centro' : m.id === 'moc' ? 'Montes Claros' : 'Minas Gerais'}
        </button>
      ))}
    </div>

    {/* Visor de Imagem do Mapa */}
    <div class="space-y-2.5">
      <div class="flex items-center justify-between gap-2">
        <div>
          <h5 id="cagp-map-current-title" class="font-head font-bold text-xs uppercase text-foreground m-0 tracking-wide">
            {mapasCampi[0].titulo}
          </h5>
          <p id="cagp-map-current-sub" class="text-xs text-gray-700 m-0 font-body font-medium">
            {mapasCampi[0].sub}
          </p>
        </div>
      </div>

      <div class="cagp-photo-frame rounded-xl border-3 border-[#16181d] shadow-[6px_6px_0_0_#16181d] overflow-hidden bg-[#16181d] text-background flex items-center justify-center min-h-[340px]">
        <img
          id="cagp-map-viewer-img"
          src={asset(`/imagens/${mapasCampi[0].arquivo}`)}
          alt={mapasCampi[0].titulo}
          class="w-full h-auto max-h-[580px] object-contain transition-opacity duration-150"
          loading="lazy"
        />
      </div>
    </div>
  </div>
</div>

<script>
  function initCampiMapGallery() {
    const tabBtns = document.querySelectorAll<HTMLButtonElement>('.cagp-map-tab-btn');
    const imgEl = document.getElementById('cagp-map-viewer-img') as HTMLImageElement | null;
    const fullLink = document.getElementById('cagp-map-full-link') as HTMLAnchorElement | null;
    const titleEl = document.getElementById('cagp-map-current-title');
    const subEl = document.getElementById('cagp-map-current-sub');

    if (!tabBtns.length || !imgEl) return;

    tabBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        tabBtns.forEach((b) => {
          b.classList.remove('bg-secondary', 'text-white', 'shadow-xs', 'border-secondary');
          b.classList.add('bg-white', 'text-foreground', 'border', 'border-muted');
          b.setAttribute('aria-selected', 'false');
        });

        btn.classList.remove('bg-white', 'text-foreground', 'border', 'border-muted');
        btn.classList.add('bg-secondary', 'text-white', 'shadow-xs', 'border-secondary');
        btn.setAttribute('aria-selected', 'true');

        const file = btn.getAttribute('data-map-file');
        const title = btn.getAttribute('data-map-title');
        const sub = btn.getAttribute('data-map-sub');

        if (file && imgEl) {
          imgEl.style.opacity = '0.3';
          setTimeout(() => {
            imgEl.src = file;
            imgEl.alt = title || '';
            imgEl.style.opacity = '1';
          }, 120);
        }
        if (fullLink && file) {
          fullLink.href = file;
        }
        if (titleEl && title) titleEl.textContent = title;
        if (subEl && sub) subEl.textContent = sub;
      });
    });
  }

  // Executar imediatamente e após trocas de view no Astro
  initCampiMapGallery();
  document.addEventListener('astro:page-load', initCampiMapGallery);
</script>
