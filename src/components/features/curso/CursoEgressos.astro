---
// CursoEgressos.astro - Sub-view 2: Inserção no Mercado de Trabalho, Salários e Cartões Comparativos de Carreira Pública
import { asset, route } from '@/lib/paths';

const carreirasComparativas = [
  {
    esfera: 'Executivo Federal (15%)',
    cargo: 'EPPGG Federal & Analista de Planejamento e Orçamento (APO)',
    orgao: 'MGI, MPO, ENAP, Ministérios e Autarquias Federais',
    inicial: 'R$ 20.924,80',
    topo: 'R$ 29.832,94',
    requisito: 'Diploma de Nível Superior (Qualquer Área / Gestão Pública) via CNU',
    badgeColor: 'bg-[#5B2A85] text-white',
    pontos: [
      'Formulação e avaliação de políticas públicas nacionais de grande escala',
      'Elaboração do Orçamento Federal (PPA, LDO e LOA) e governança pública',
      'Ocupação prioritária de cargos de direção (FCE/CCE) em Brasília',
    ],
  },
  {
    esfera: 'Executivo Estadual MG (37%)',
    cargo: 'Especialista em Políticas Públicas e Gestão Governamental (EPPGG-MG)',
    orgao: 'SEPLAG-MG, Cidade Administrativa e Secretarias de Estado',
    inicial: 'R$ 7.600 a R$ 11.200',
    topo: 'R$ 18.500+',
    requisito: 'Concurso Público Estadual SEPLAG / Processos Seletivos Estaduais',
    badgeColor: 'bg-secondary text-white',
    pontos: [
      'Maior empregador direto dos bacharéis em Gestão Pública da UFMG (37%)',
      'Gestão de compras públicas (Lei 14.133), contratos, convênios e MROSC',
      'Coordenação de programas estaduais em saúde, educação e desenvolvimento social',
    ],
  },
  {
    esfera: 'Executivo Municipal & Legislativo (13%+)',
    cargo: 'Gestor Público Municipal, Consultor Legislativo (ALMG/CMBH) & Controle',
    orgao: 'Prefeitura de BH (PBH), ALMG, CMBH e TCE-MG',
    inicial: 'R$ 8.500 a R$ 16.400',
    topo: 'R$ 28.000+',
    requisito: 'Concursos Municipais de Gestão/Planejamento e Consultoria Parlamentar',
    badgeColor: 'bg-[#134E4A] text-white',
    pontos: [
      'Planejamento urbano, orçamento municipal, regulação e políticas locais',
      'Assessoria técnica parlamentar, redação legislativa e fiscalização orçamentária',
      'Auditoria operacional de políticas públicas em Tribunais de Contas',
    ],
  },
  {
    esfera: 'Consultoria, OSCs & Organismos (18%)',
    cargo: 'Consultor de Políticas Públicas, GovTechs & Cooperação Internacional',
    orgao: 'PNUD/ONU, UNESCO, BID, Fundações e Consultorias Especializadas',
    inicial: 'R$ 6.500 a R$ 14.000',
    topo: 'R$ 22.000+',
    requisito: 'Seleções Técnicas por Competência, Editais Internacionais e Mercado',
    badgeColor: 'bg-[#FE8812] text-[#16181d]',
    pontos: [
      'Avaliação econométrica de impacto, ciência de dados públicos e indicadores ESG',
      'Estruturação de parcerias público-privadas e captação de recursos para municípios',
      'Gestão executiva no Terceiro Setor, institutos filantrópicos e think tanks',
    ],
  },
];
---

<div class="space-y-6 text-foreground">
  <!-- Estatísticas de Egressos Bento -->
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    <div class="cagp-card p-5 bg-white border-3 border-[#16181d] rounded-xl flex flex-col justify-between shadow-[6px_6px_0_0_#16181d]">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-secondary uppercase">Inserção Pública</span>
        <i class="bi bi-building-check text-secondary text-xl" aria-hidden="true"></i>
      </div>
      <span class="font-head text-3xl sm:text-4xl font-black text-secondary my-1">65%</span>
      <span class="text-xs text-gray-800 font-body font-medium">Atuando diretamente no Poder Executivo (Estadual 37%, Federal 15%, Municipal 13%)</span>
    </div>
    <div class="cagp-card p-5 bg-white border-3 border-[#16181d] rounded-xl flex flex-col justify-between shadow-[6px_6px_0_0_#16181d]">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-success uppercase">Faixa Salarial</span>
        <i class="bi bi-cash-stack text-success text-xl" aria-hidden="true"></i>
      </div>
      <span class="font-head text-3xl sm:text-4xl font-black text-success my-1">&gt; R$ 5.000</span>
      <span class="text-xs text-gray-800 font-body font-medium">Mais de 55% dos egressos formados superam esta faixa salarial</span>
    </div>
    <div class="cagp-card p-5 bg-white border-3 border-[#16181d] rounded-xl flex flex-col justify-between shadow-[6px_6px_0_0_#16181d]">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-[#5B2A85] uppercase">Alta Renda</span>
        <i class="bi bi-graph-up-arrow text-[#5B2A85] text-xl" aria-hidden="true"></i>
      </div>
      <span class="font-head text-3xl sm:text-4xl font-black text-[#5B2A85] my-1">&gt; R$ 10.000</span>
      <span class="text-xs text-gray-800 font-body font-medium">24% em carreiras de Estado de alta complexidade e direção</span>
    </div>
  </div>

  <!-- Cartões Comparativos de Carreira Pública (Estrutura Desinchada sem Cards Aninhados) -->
  <section class="space-y-4" aria-label="Cartões Comparativos de Carreira Pública">
    <div class="flex items-center justify-between gap-2.5 border-b-3 border-[#16181d] pb-3 flex-wrap">
      <div class="flex items-center gap-2.5">
        <i class="bi bi-briefcase-fill text-secondary text-xl" aria-hidden="true"></i>
        <div>
          <h3 class="font-head text-base sm:text-xl font-black uppercase text-[#16181d] m-0 tracking-wide">
            Cartões Comparativos de Carreira Pública
          </h3>
          <p class="text-xs text-gray-700 m-0 font-body font-medium">
            Comparativo de remuneração, requisitos e atribuições das 4 grandes frentes de atuação dos bacharéis:
          </p>
        </div>
      </div>
      <span class="px-3 py-1 rounded-lg bg-[#16181d] text-white font-mono text-xs font-bold">
        Pesquisa Oficial N=89
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs">
      {carreirasComparativas.map((c) => (
        <article class="p-5 bg-white border-3 border-[#16181d] rounded-xl flex flex-col justify-between shadow-[4px_4px_0_0_#16181d] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[6px_6px_0_0_#16181d] transition-all space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <span class={`px-2.5 py-1 rounded-md font-mono text-xs font-black uppercase border-2 border-[#16181d] shadow-[2px_2px_0_0_#16181d] ${c.badgeColor}`}>
                {c.esfera}
              </span>
              <span class="font-mono text-xs font-bold text-gray-700 bg-white px-2 py-0.5 rounded border border-[#16181d]">
                Bacharelado GP UFMG
              </span>
            </div>

            <div>
              <h4 class="font-head font-black uppercase text-sm sm:text-base text-[#16181d] m-0 leading-snug">
                {c.cargo}
              </h4>
              <p class="font-mono text-xs font-bold text-gray-700 mt-0.5 m-0">
                {c.orgao}
              </p>
            </div>

            <div class="grid grid-cols-2 gap-3 p-3 rounded-lg bg-[#FFFDF9] divide-x-2 divide-[#16181d]/15">
              <div>
                <span class="font-mono text-xs font-bold uppercase text-gray-600 block">Remuneração Inicial</span>
                <span class="font-head text-sm sm:text-base font-black text-[#15803D]">{c.inicial}</span>
              </div>
              <div class="pl-3">
                <span class="font-mono text-xs font-bold uppercase text-gray-600 block">Topo da Carreira</span>
                <span class="font-head text-sm sm:text-base font-black text-[#5B2A85]">{c.topo}</span>
              </div>
            </div>

            <ul class="space-y-1 pl-4 list-disc text-gray-800 font-body font-medium">
              {c.pontos.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>

          <div class="pt-3 border-t-2 border-[#16181d] font-mono text-xs text-gray-800">
            <strong>Via de Acesso:</strong> {c.requisito}
          </div>
        </article>
      ))}
    </div>

    <div class="pt-3 flex flex-wrap items-center justify-between gap-3">
      <a
        href={asset('/documentos/depoimentos-de-egressos.pdf')}
        download
        class="min-h-[44px] px-4 py-2.5 bg-secondary hover:bg-[#6D1723] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 text-white rounded-xl text-xs font-head uppercase font-black tracking-wider inline-flex items-center gap-2 transition-all no-underline border-3 border-[#16181d] shadow-[4px_4px_0_0_#16181d]"
      >
        <i class="bi bi-file-earmark-pdf text-base" aria-hidden="true"></i>
        <span>Baixar Relatório Oficial de Egressos (PDF)</span>
      </a>

      <a
        href={route('/chapa-semente#propostas')}
        class="min-h-[44px] px-4 py-2.5 bg-[#FE8812] hover:bg-[#e67300] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 text-[#16181d] rounded-xl text-xs font-head uppercase font-black tracking-wider inline-flex items-center gap-2 transition-all no-underline border-3 border-[#16181d] shadow-[4px_4px_0_0_#16181d]"
      >
        <i class="bi bi-check2-circle text-base" aria-hidden="true"></i>
        <span>Propostas 9, 10 e 11 (Carreira &amp; Empresa Jr) • Votar Semente →</span>
      </a>
    </div>
  </section>
</div>
