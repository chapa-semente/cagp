---
// CursoEgressos.astro - Sub-view 2: Inserção no Mercado de Trabalho, Salários e Cartões Comparativos de Carreira Pública
import { asset, route } from '@/lib/paths';

const carreirasComparativas = [
  {
    esfera: 'Executivo Federal (15%)',
    cargo: 'EPPGG Federal & Analista de Planejamento e Orçamento (APO)',
    orgao: 'MGI, MPO, ENAP, Ministérios e Autarquias Federais',
    inicial: 'R$ 20.924,80',
    topo: 'R$ 29.832,94',
    requisito: 'Diploma de Nível Superior (Qualquer Área / Gestão Pública) via CNU',
    badgeColor: 'bg-primary text-white',
    pontos: [
      'Formulação e avaliação de políticas públicas nacionais de grande escala',
      'Elaboração do Orçamento Federal (PPA, LDO e LOA) e governança pública',
      'Ocupação prioritária de cargos de direção (FCE/CCE) em Brasília',
    ],
  },
  {
    esfera: 'Executivo Estadual MG (37%)',
    cargo: 'Especialista em Políticas Públicas e Gestão Governamental (EPPGG-MG)',
    orgao: 'SEPLAG-MG, Cidade Administrativa e Secretarias de Estado',
    inicial: 'R$ 7.600 a R$ 11.200',
    topo: 'R$ 18.500+',
    requisito: 'Concurso Público Estadual SEPLAG / Processos Seletivos Estaduais',
    badgeColor: 'bg-secondary text-white',
    pontos: [
      'Maior empregador direto dos bacharéis em Gestão Pública da UFMG (37%)',
      'Gestão de compras públicas (Lei 14.133), contratos, convênios e MROSC',
      'Coordenação de programas estaduais em saúde, educação e desenvolvimento social',
    ],
  },
  {
    esfera: 'Executivo Municipal & Legislativo (13%+)',
    cargo: 'Gestor Público Municipal, Consultor Legislativo (ALMG/CMBH) & Controle',
    orgao: 'Prefeitura de BH (PBH), ALMG, CMBH e TCE-MG',
    inicial: 'R$ 8.500 a R$ 16.400',
    topo: 'R$ 28.000+',
    requisito: 'Concursos Municipais de Gestão/Planejamento e Consultoria Parlamentar',
    badgeColor: 'bg-petroleo-deep text-white',
    pontos: [
      'Planejamento urbano, orçamento municipal, regulação e políticas locais',
      'Assessoria técnica parlamentar, redação legislativa e fiscalização orçamentária',
      'Auditoria operacional de políticas públicas em Tribunais de Contas',
    ],
  },
  {
    esfera: 'Consultoria, OSCs & Organismos (18%)',
    cargo: 'Consultor de Políticas Públicas, GovTechs & Cooperação Internacional',
    orgao: 'PNUD/ONU, UNESCO, BID, Fundações e Consultorias Especializadas',
    inicial: 'R$ 6.500 a R$ 14.000',
    topo: 'R$ 22.000+',
    requisito: 'Seleções Técnicas por Competência, Editais Internacionais e Mercado',
    badgeColor: 'bg-accent text-foreground',
    pontos: [
      'Avaliação econométrica de impacto, ciência de dados públicos e indicadores ESG',
      'Estruturação de parcerias público-privadas e captação de recursos para municípios',
      'Gestão executiva no Terceiro Setor, institutos filantrópicos e think tanks',
    ],
  },
];
---

<div class="space-y-6 text-foreground">
  <!-- Pesquisa de Egressos 2023 (slides 7 e 49 da recepção dos ingressantes 2024/2). Números da fonte, sem arredondar pra cima. -->
  <div class="space-y-2">
    <dl class="grid grid-cols-1 sm:grid-cols-3 gap-4 m-0 cagp-reveal-stagger">
      <div class="p-5 bg-white border-2 border-border rounded-xl shadow-md">
        <dt class="text-sm font-heading font-bold text-foreground">No Poder Executivo</dt>
        <dd class="m-0 mt-1 font-heading font-bold text-4xl text-secondary tabular-nums leading-none" data-count-to="65" data-count-suffix="%">65%</dd>
        <dd class="m-0 mt-2 text-sm text-content-secondary">Estadual 37%, federal 15%, municipal 13%.</dd>
      </div>
      <div class="p-5 bg-white border-2 border-border rounded-xl shadow-md">
        <dt class="text-sm font-heading font-bold text-foreground">Ganham mais de R$ 5 mil</dt>
        <dd class="m-0 mt-1 font-heading font-bold text-4xl text-secondary tabular-nums leading-none" data-count-to="55" data-count-suffix="%">55%</dd>
        <dd class="m-0 mt-2 text-sm text-content-secondary">A maioria de quem respondeu.</dd>
      </div>
      <div class="p-5 bg-white border-2 border-border rounded-xl shadow-md">
        <dt class="text-sm font-heading font-bold text-foreground">Ganham mais de R$ 8 mil</dt>
        <dd class="m-0 mt-1 font-heading font-bold text-4xl text-primary tabular-nums leading-none" data-count-to="21" data-count-suffix="%">21%</dd>
        <dd class="m-0 mt-2 text-sm text-content-secondary">Acima de R$ 10 mil: 12%.</dd>
      </div>
    </dl>
    <p class="text-xs text-muted-foreground m-0">
      Fonte: Pesquisa de Egressos 2023 do curso (89 respondentes sobre local de trabalho e 88 sobre renda, de 349 graduados), apresentada na recepção dos ingressantes 2024/2.
    </p>
  </div>

  <!-- Cartões Comparativos de Carreira Pública (Estrutura Desinchada sem Cards Aninhados) -->
  <section class="space-y-4" aria-label="Cartões Comparativos de Carreira Pública">
    <div class="flex items-center justify-between gap-2.5 border-b-3 border-border pb-3 flex-wrap">
      <div class="flex items-center gap-2.5">
        <i class="bi bi-briefcase-fill text-secondary text-xl" aria-hidden="true"></i>
        <div>
          <h3 class="font-head text-base sm:text-xl font-black text-foreground m-0">
            Cartões Comparativos de Carreira Pública
          </h3>
          <p class="text-xs text-gray-700 m-0 font-body font-medium">
            Comparativo de remuneração, requisitos e atribuições das 4 grandes frentes de atuação dos bacharéis:
          </p>
        </div>
      </div>
      <span class="px-3 py-1 rounded-lg bg-foreground text-white font-mono text-xs font-bold">
        Pesquisa Oficial N=89
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 text-xs">
      {carreirasComparativas.map((c) => (
        <article class="p-5 bg-white border-2 border-border rounded-xl flex flex-col justify-between shadow-md hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-xl transition-all space-y-4">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <span class={`px-2.5 py-1 rounded-md font-mono text-xs font-black uppercase border-2 border-border shadow-sm ${c.badgeColor}`}>
                {c.esfera}
              </span>
              <span class="font-mono text-xs font-bold text-gray-700 bg-white px-2 py-0.5 rounded border border-border">
                Bacharelado GP UFMG
              </span>
            </div>

            <div>
              <h4 class="font-head font-black text-sm sm:text-base text-foreground m-0 leading-snug">
                {c.cargo}
              </h4>
              <p class="font-mono text-xs font-bold text-gray-700 mt-0.5 m-0">
                {c.orgao}
              </p>
            </div>

            <div class="grid grid-cols-2 gap-3 p-3 rounded-lg bg-white divide-x-2 divide-border/15">
              <div>
                <span class="font-mono text-xs font-bold uppercase text-gray-600 block">Remuneração Inicial</span>
                <span class="font-head text-sm sm:text-base font-black text-success">{c.inicial}</span>
              </div>
              <div class="pl-3">
                <span class="font-mono text-xs font-bold uppercase text-gray-600 block">Topo da Carreira</span>
                <span class="font-head text-sm sm:text-base font-black text-primary">{c.topo}</span>
              </div>
            </div>

            <ul class="space-y-1 pl-4 list-disc text-gray-800 font-body font-medium">
              {c.pontos.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>

          <div class="pt-3 border-t-2 border-border font-mono text-xs text-gray-800">
            <strong>Via de Acesso:</strong> {c.requisito}
          </div>
        </article>
      ))}
    </div>

    <div class="pt-3 flex flex-wrap items-center justify-between gap-3">
      <a
        href={asset('/documentos/depoimentos-de-egressos.pdf')}
        download
        class="min-h-[44px] px-4 py-2.5 bg-secondary hover:bg-secondary-hover active:translate-x-[2px] active:translate-y-[2px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 text-white rounded-xl text-xs font-head uppercase font-black tracking-wider inline-flex items-center gap-2 transition-all no-underline border-3 border-border shadow-md"
      >
        <i class="bi bi-file-earmark-pdf text-base" aria-hidden="true"></i>
        <span>Baixar Relatório Oficial de Egressos (PDF)</span>
      </a>

      <a
        href={route('/chapa-semente#propostas')}
        class="min-h-[44px] px-4 py-2.5 bg-accent hover:bg-accent-hover active:translate-x-[2px] active:translate-y-[2px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 text-foreground rounded-xl text-xs font-head uppercase font-black tracking-wider inline-flex items-center gap-2 transition-all no-underline border-3 border-border shadow-md"
      >
        <i class="bi bi-check2-circle text-base" aria-hidden="true"></i>
        <span>Propostas 9, 10 e 11 (Carreira &amp; Empresa Jr) • Votar Chapa 2 <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
      </a>
    </div>
  </section>
</div>
