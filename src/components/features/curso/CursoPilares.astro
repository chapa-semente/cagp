---
// CursoPilares.astro — As seis dimensões do currículo (PPC 2020) como lista de referência, sem grade de cards.
const PILARES = [
  { titulo: 'Ciência Política & Estado', texto: 'Sediado no DCP/UFMG (Conceito 7 CAPES), com base em teoria democrática e arranjos institucionais.' },
  { titulo: 'Economia & Finanças Públicas', texto: 'Disciplinas com a FACE/UFMG sobre orçamento, tributação, responsabilidade fiscal e previdência.' },
  { titulo: 'Direito Administrativo', texto: 'Controle de legalidade, licitações (Lei 14.133), contratos administrativos e probidade.' },
  { titulo: 'Métodos & Avaliação', texto: 'Estatística aplicada, análise quantitativa e avaliação ex-ante e ex-post de políticas públicas.' },
  { titulo: 'Estudos Urbanos & Regionais', texto: 'Planejamento metropolitano, gestão habitacional e sustentabilidade com o Cedeplar/IGC.' },
  { titulo: 'Prática & Extensão', texto: '300h de extensão obrigatória nos laboratórios DCP 195/196, com atendimento a prefeituras e órgãos estaduais.' },
];
---

<section class="rounded-xl border-3 border-border bg-card shadow-lg p-4 sm:p-5" aria-labelledby="curso-pilares-titulo">
  <h3 id="curso-pilares-titulo" class="font-heading font-extrabold text-base sm:text-lg leading-tight m-0">
    O que o currículo cobre
  </h3>
  <p class="text-sm text-muted-foreground mt-1 mb-4">Seis dimensões do Projeto Pedagógico (PPC 2020).</p>
  <dl class="m-0 grid grid-cols-1 md:grid-cols-2 gap-x-8">
    {PILARES.map((p) => (
      <div class="py-3 border-t-2 border-border">
        <dt class="font-heading font-bold text-base leading-snug">{p.titulo}</dt>
        <dd class="m-0 mt-0.5 text-sm text-muted-foreground leading-relaxed text-pretty">{p.texto}</dd>
      </div>
    ))}
  </dl>
</section>
