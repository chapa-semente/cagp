---
// CursoVisao.astro - Sub-view 1: Visão Geral, História dos Candangos, Identidade Institucional e Cientometria
import { CursoCandangosAndTimeline } from './CursoCandangosAndTimeline';
---

<div class="space-y-6 text-foreground">
  <!-- Dados Fundamentais Bento -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3.5">
    <div class="cagp-card p-4 bg-white border-2 border-border rounded-xl flex flex-col justify-between shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-secondary uppercase">Conceito MEC</span>
        <i class="bi bi-award-fill text-secondary text-lg" aria-hidden="true"></i>
      </div>
      <span class="font-head text-3xl font-black text-secondary my-1">Nota 4</span>
      <span class="text-xs text-gray-700 font-body font-medium">Escala 1 a 5 CPC/Enade</span>
    </div>
    <div class="cagp-card p-4 bg-white border-2 border-border rounded-xl flex flex-col justify-between shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-foreground uppercase">Fundação</span>
        <i class="bi bi-calendar-event-fill text-foreground text-lg" aria-hidden="true"></i>
      </div>
      <span class="font-head text-3xl font-black text-foreground my-1">2009</span>
      <span class="text-xs text-gray-700 font-body font-medium">Expansão via REUNI</span>
    </div>
    <div class="cagp-card p-4 bg-white border-2 border-border rounded-xl flex flex-col justify-between shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-success uppercase">Carga Total</span>
        <i class="bi bi-clock-history text-success text-lg" aria-hidden="true"></i>
      </div>
      <span class="font-head text-3xl font-black text-success my-1">3.000h</span>
      <span class="text-xs text-gray-700 font-body font-medium">200 créditos (10 períodos)</span>
    </div>
    <div class="cagp-card p-4 bg-white border-2 border-border rounded-xl flex flex-col justify-between shadow-md">
      <div class="flex items-center justify-between">
        <span class="text-xs font-mono font-bold text-info uppercase">Vagas SiSU</span>
        <i class="bi bi-person-lines-fill text-info text-lg" aria-hidden="true"></i>
      </div>
      <span class="font-head text-3xl font-black text-info my-1">80 Vagas</span>
      <span class="text-xs text-gray-700 font-body font-medium">40 no 1º e 40 no 2º sem.</span>
    </div>
  </div>

  <!-- História dos Candangos, Linha do Tempo Animada & Carreiras Comparativas -->
  <CursoCandangosAndTimeline client:visible />

  <!-- Missão & Lotação (Estrutura Desinchada sem Cards Aninhados) -->
  <section class="p-5 sm:p-6 bg-white border-2 border-border rounded-2xl shadow-xl space-y-4" aria-label="Excelência Acadêmica">
    <div class="flex items-center gap-2.5 border-b-3 border-border pb-3">
      <i class="bi bi-mortarboard-fill text-secondary text-xl" aria-hidden="true"></i>
      <h3 class="font-head text-base sm:text-xl font-black text-foreground m-0">
        Excelência Acadêmica &amp; Conceito 7 CAPES
      </h3>
    </div>
    <p class="text-xs sm:text-sm text-gray-800 leading-relaxed font-body font-medium m-0">
      Sediado na <strong>Faculdade de Filosofia e Ciências Humanas (FAFICH)</strong> e vinculado ao <strong>Departamento de Ciência Política (DCP)</strong> — centro de pesquisa com nota máxima nacional (<strong>Conceito 7 CAPES</strong>) —, o curso alia teoria democrática, análise de políticas públicas e métodos quantitativos.
    </p>
    <blockquote class="p-4 rounded-xl bg-primary-tint border-2 border-border text-xs sm:text-sm italic text-gray-900 shadow-sm font-body">
      "O objetivo geral do curso é formar profissionais críticos e reflexivos para o desempenho competente da função de gestor público, diretamente comprometidos com a efetivação do interesse público e a equidade social."
      <footer class="text-xs text-gray-700 not-italic mt-2 font-bold font-head uppercase tracking-wide">
        — Projeto Pedagógico do Curso (PPC 2020, p. 21)
      </footer>
    </blockquote>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-1 text-xs">
      <div class="p-4 bg-white border-2 border-border rounded-xl flex items-start gap-3 shadow-sm">
        <i class="bi bi-moon-stars-fill text-secondary text-xl shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <span class="font-head font-bold uppercase text-foreground block tracking-wide">Turno Noturno</span>
          <span class="text-xs text-gray-700 font-body font-medium">Aulas de 19h00 às 22h30, viabilizando estágio governamental durante o dia.</span>
        </div>
      </div>
      <div class="p-4 bg-white border-2 border-border rounded-xl flex items-start gap-3 shadow-sm">
        <i class="bi bi-people-fill text-foreground text-xl shrink-0 mt-0.5" aria-hidden="true"></i>
        <div>
          <span class="font-head font-bold uppercase text-foreground block tracking-wide">Corpo Discente Ativo</span>
          <span class="text-xs text-gray-700 font-body font-medium">426 estudantes ativos: 356 na versão vigente N-20229 e 70 na transição N-20152.</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Cientometria do Campo de Públicas -->
  <section class="p-5 sm:p-6 bg-white border-2 border-border rounded-2xl shadow-xl space-y-4" aria-label="Cientometria do Campo de Públicas">
    <div class="border-b-3 border-border pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <div class="flex items-center gap-2">
          <i class="bi bi-pie-chart-fill text-secondary text-lg" aria-hidden="true"></i>
          <h3 class="font-head text-base sm:text-xl font-black text-foreground m-0">
            Cientometria do Campo de Públicas
          </h3>
        </div>
        <p class="text-xs text-gray-700 mt-0.5 font-body font-medium">
          Estudo pioneiro na <em>Revista de Sociologia e Política</em> mapeou 14 bacharelados públicos brasileiros em dois grandes grupos:
        </p>
      </div>
      <span class="cagp-badge cagp-badge-red font-mono font-bold">
        Clemente et al. (2022)
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
      <div class="cagp-card p-4 bg-white border-2 border-secondary rounded-xl shadow-[3px_3px_0_0_#8B1E2D]">
        <div class="flex items-center gap-2 mb-2">
          <i class="bi bi-diagram-3-fill text-secondary text-lg shrink-0" aria-hidden="true"></i>
          <span class="font-head font-black uppercase text-secondary text-sm block tracking-wide">
            Cluster de Gestão de Políticas Públicas (UFMG)
          </span>
        </div>
        <div class="flex flex-wrap gap-1.5 mb-2.5">
          <span class="cagp-badge cagp-badge-dark font-mono text-xs">UFMG</span>
          <span class="cagp-badge font-mono text-xs">USP Leste</span>
          <span class="cagp-badge font-mono text-xs">UFABC</span>
          <span class="cagp-badge font-mono text-xs">UFRN</span>
        </div>
        <ul class="list-disc pl-4 space-y-1 text-gray-800 text-xs font-body font-medium">
          <li>Foco no <strong>ciclo completo de políticas</strong>: formulação, implementação e avaliação.</li>
          <li>Forte base em Ciência Política, Teoria Democrática e Sociologia.</li>
          <li>Capacitação em econometria aplicada e métodos quantitativos.</li>
        </ul>
      </div>

      <div class="cagp-card p-4 bg-white border-2 border-border rounded-xl shadow">
        <div class="flex items-center gap-2 mb-2">
          <i class="bi bi-archive-fill text-gray-700 text-lg shrink-0" aria-hidden="true"></i>
          <span class="font-head font-black uppercase text-gray-900 text-sm block tracking-wide">
            Cluster Tradicional de Burocracia Organizacional
          </span>
        </div>
        <div class="flex flex-wrap gap-1.5 mb-2.5">
          <span class="cagp-badge font-mono text-xs">FJP</span>
          <span class="cagp-badge font-mono text-xs">UFLA</span>
          <span class="cagp-badge font-mono text-xs">UDESC</span>
          <span class="cagp-badge font-mono text-xs">UNIFAL</span>
        </div>
        <ul class="list-disc pl-4 space-y-1 text-gray-700 text-xs font-body font-medium">
          <li>Foco em rotinas administrativas internas e logística de compras públicas.</li>
          <li>Derivado da administração privada transposta para o setor público.</li>
          <li>Ênfase em controle de conformidade e gestão de departamentos.</li>
        </ul>
      </div>
    </div>
  </section>
</div>