---
// src/components/features/acg/AcgCentralOverview.astro — Visão Geral da Central de Horas & Certificados (600h)
import { AcgCalculatorWidget } from './calculator/AcgCalculatorWidget';
import { AcgGuardianWidget } from './guardian/AcgGuardianWidget';
import AcgTramitacaoWidget from './tramitacao/AcgTramitacaoWidget.astro';
import CagpIcon from '@/components/ui/CagpIcon.astro';
import { asset } from '@/lib/paths';
---

<div class="cagp-acg-central-overview space-y-6 select-none" data-context-type="cert">
  <!-- Apresentação da Central de Horas -->
  <div class="p-6 bg-card border-2 border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md text-foreground">
    <div class="flex items-start gap-3.5">
      <span class="w-12 h-12 rounded-xl bg-secondary text-secondary-foreground flex items-center justify-center shrink-0 mt-0.5 border-2 border-border shadow-xs">
        <CagpIcon name="clock" class="w-6 h-6" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-heading uppercase font-extrabold tracking-wider text-secondary">
            Central de Horas &amp; Certificados
          </span>
          <span class="text-foreground font-bold">•</span>
          <span class="text-xs text-muted-foreground font-mono">600 horas totais</span>
        </div>
        <h2 class="font-heading text-lg sm:text-xl font-extrabold text-foreground leading-tight m-0">
          Extensão Obrigatória (300h) &amp; Atividades Complementares (AAC • 300h)
        </h2>
        <p class="font-sans text-xs text-muted-foreground mt-1 max-w-3xl leading-relaxed m-0">
          Monitore sua integralização, cadastre certificados no Guardião de 120 dias corridos e consulte o protocolo oficial do Colegiado (Formulário N-20229).
        </p>
      </div>
    </div>
  </div>

  <!-- Bento Grid de Widgets Reativos -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <AcgCalculatorWidget client:load />
    <AcgGuardianWidget client:load />
    <AcgTramitacaoWidget />
  </div>

  <!-- Banner de Acesso Rápido ao Formulário N-20229 -->
  <div class="p-6 bg-card border-2 border-border rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-md text-foreground">
    <div class="flex items-center gap-3.5">
      <span class="w-12 h-12 rounded-xl bg-foreground text-background flex items-center justify-center shrink-0 border border-border shadow-xs">
        <CagpIcon name="file-text" class="w-6 h-6 text-accent" />
      </span>
      <div>
        <h3 class="font-heading text-sm font-extrabold text-foreground leading-tight m-0">
          Requerimento Oficial de AAC (Versão N-20229)
        </h3>
        <p class="font-sans text-xs text-muted-foreground mt-0.5 m-0">
          Formulário padrão do Colegiado para solicitação de aproveitamento de carga horária.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2.5 w-full sm:w-auto">
      <a
        href={asset('/documentos/requerimento-atividade-integralizadora-credito-v20229.pdf')}
        download
        class="min-h-[44px] flex-1 sm:flex-none px-4 py-2.5 bg-secondary hover:bg-secondary-hover text-secondary-foreground rounded-xl text-xs font-heading uppercase font-extrabold tracking-wider flex items-center justify-center gap-2 transition-all no-underline border-3 border-border shadow-xs hover:translate-x-[1px] hover:translate-y-[1px] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none"
      >
        <CagpIcon name="download" class="w-4 h-4" />
        <span>Baixar PDF</span>
      </a>
      <a
        href="#protocolo-colegiado"
        class="min-h-[44px] px-4 py-2.5 bg-card hover:bg-muted text-foreground border-3 border-border rounded-xl text-xs font-heading uppercase font-extrabold flex items-center justify-center transition-all no-underline shadow-xs hover:translate-x-[1px] hover:translate-y-[1px] active:translate-x-[3px] active:translate-y-[3px] active:shadow-none"
      >
        <span>Ver Guia</span>
      </a>
    </div>
  </div>
</div>
