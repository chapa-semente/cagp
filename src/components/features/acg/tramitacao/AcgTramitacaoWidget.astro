---
// src/components/features/acg/tramitacao/AcgTramitacaoWidget.astro — Widget de Resumo da Tramitação Colegiado N-20229
import { asset } from '../../../../lib/paths';
---

<div class="cagp-card p-5 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col justify-between h-full shadow-[3px_3px_0_0_#0A0A0A] hover:shadow-[1.5px_1.5px_0_0_#0A0A0A] hover:translate-x-[1px] hover:translate-y-[1px] transition-all">
  <div>
    <div className="flex items-center justify-between gap-2 mb-3.5">
      <div class="flex items-center gap-2.5">
        <span class="w-10 h-10 rounded-xl bg-[#9E2424]/10 text-[#9E2424] flex items-center justify-center text-lg border border-[#9E2424] shadow-[1px_1px_0_0_#0A0A0A]">
          <i class="bi bi-file-earmark-check" aria-hidden="true" />
        </span>
        <div>
          <h3 class="font-head font-bold text-sm uppercase text-[#0A0A0A] leading-tight m-0">
            Protocolo Colegiado N-20229
          </h3>
          <span class="text-[11px] text-[#57534E] font-mono">Requerimento em PDF & E-mail</span>
        </div>
      </div>
      <span class="px-2.5 py-1 rounded-md font-head text-[11px] font-bold bg-[#9E2424] text-white border border-[#0A0A0A] shadow-[1px_1px_0_0_#0A0A0A]">
        Oficial
      </span>
    </div>

    <p class="font-body text-xs text-[#292524] leading-relaxed mb-3.5">
      Fluxo oficial em 4 passos: preenchimento do formulário N-20229, anexação de comprovantes e envio direto para a Coordenação (<code class="text-[11px] font-mono bg-[#FBF8F3] px-1 py-0.5 rounded border border-[#0A0A0A]">coordgestaopublica@gmail.com</code>).
    </p>

    <!-- Pílulas dos 4 Passos -->
    <div class="grid grid-cols-2 gap-2 mb-4 text-[11px]">
      <div class="p-2 bg-[#FBF8F3] rounded-lg border border-[#0A0A0A] flex items-center gap-2 shadow-[1px_1px_0_0_#0A0A0A]">
        <span class="w-5 h-5 rounded-full bg-[#9E2424] text-white flex items-center justify-center text-[10px] font-bold shrink-0">1</span>
        <span class="text-[#0A0A0A] font-medium truncate">Identificação</span>
      </div>
      <div class="p-2 bg-[#FBF8F3] rounded-lg border border-[#0A0A0A] flex items-center gap-2 shadow-[1px_1px_0_0_#0A0A0A]">
        <span class="w-5 h-5 rounded-full bg-[#9E2424] text-white flex items-center justify-center text-[10px] font-bold shrink-0">2</span>
        <span class="text-[#0A0A0A] font-medium truncate">Modalidade</span>
      </div>
      <div class="p-2 bg-[#FBF8F3] rounded-lg border border-[#0A0A0A] flex items-center gap-2 shadow-[1px_1px_0_0_#0A0A0A]">
        <span class="w-5 h-5 rounded-full bg-[#9E2424] text-white flex items-center justify-center text-[10px] font-bold shrink-0">3</span>
        <span class="text-[#0A0A0A] font-medium truncate">E-mail DCP</span>
      </div>
      <div class="p-2 bg-[#FBF8F3] rounded-lg border border-[#0A0A0A] flex items-center gap-2 shadow-[1px_1px_0_0_#0A0A0A]">
        <span class="w-5 h-5 rounded-full bg-[#9E2424] text-white flex items-center justify-center text-[10px] font-bold shrink-0">4</span>
        <span class="text-[#0A0A0A] font-medium truncate">Sec. F-2039</span>
      </div>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-3 border-t-2 border-[#0A0A0A]/20">
    <a
      href="#protocolo-colegiado"
      class="flex-1 min-h-[44px] px-4 py-2.5 bg-[#0A0A0A] hover:bg-[#9E2424] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-1.5 transition-all no-underline border-2 border-[#0A0A0A] shadow-[2.5px_2.5px_0_0_#0A0A0A]"
    >
      <span>Ver Passo a Passo</span>
      <i class="bi bi-arrow-right" aria-hidden="true" />
    </a>
    <a
      href={asset('/documentos/requerimento-atividade-integralizadora-credito-v20229.pdf')}
      download
      class="min-h-[44px] min-w-[44px] px-3 py-2 bg-white hover:bg-[#F3ECE0] text-[#0A0A0A] border-2 border-[#0A0A0A] rounded-xl flex items-center justify-center transition-all no-underline shrink-0 shadow-[2.5px_2.5px_0_0_#0A0A0A] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
      title="Baixar Requerimento Oficial em PDF"
      aria-label="Baixar Requerimento Oficial em PDF"
    >
      <i class="bi bi-file-earmark-pdf-fill text-[#9E2424] text-lg" aria-hidden="true" />
    </a>
  </div>
</div>
