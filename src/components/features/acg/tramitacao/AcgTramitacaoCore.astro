---
// src/components/features/acg/tramitacao/AcgTramitacaoCore.astro — Guia & Protocolo de Tramitação Colegiado N-20229 (Padrão Dossiê Tátil)
import { asset } from '../../../../lib/paths';
import CagpIcon from '../../../ui/CagpIcon.astro';
import type { CagpIconName } from '../../../../lib/cagpIcons';

const modalidadesAAC: { mod: string; iconName: CagpIconName; teto: string; comp: string; fatal?: boolean }[] = [
  { mod: 'I. Pesquisa Interinstitucional', iconName: 'curso', teto: '75h', comp: 'Relatório formal assinado com orientador de outra IES pública ou órgão de pesquisa.' },
  { mod: 'II. Monitoria Acadêmica', iconName: 'thesis', teto: '45h', comp: 'Relatório final de monitoria assinado com docente titular na UFMG.' },
  { mod: 'III. Eventos I (Ouvinte)', iconName: 'clock', teto: '60h', comp: 'Certificado com carga horária expressa. Prazo decadencial fatal de 120 dias corridos!', fatal: true },
  { mod: 'IV. Grupos de Estudo', iconName: 'users', teto: '30h', comp: 'Declaração de participação regular com parecer e validação de docente.' },
  { mod: 'V. Iniciação Científica (UFMG)', iconName: 'curriculo', teto: '90h', comp: 'PIBIC ou voluntário cadastrado na PRPq com relatório aprovado.' },
  { mod: 'VI. Pesquisa Bibliográfica', iconName: 'file-text', teto: '30h', comp: 'Texto científico orientado por docente (distinto do TCC).' },
  { mod: 'VII. Trabalho em Anais', iconName: 'stamp', teto: '30h', comp: 'Apresentação oral ou pôster publicado em anais. Prazo de 120 dias corridos!', fatal: true },
  { mod: 'VIII. Artigo em Periódico', iconName: 'newspaper', teto: '60h', comp: 'Artigo aceito ou publicado em periódico científico classificado no Qualis/CAPES.' },
  { mod: 'IX. Vivência Profissional', iconName: 'briefcase', teto: '60h', comp: 'Estágio não obrigatório com TCE ativo em órgão público ou terceiro setor.' },
];

const steps: { num: string; title: string; desc: string; badge: string; iconName: CagpIconName }[] = [
  {
    num: '1',
    title: 'Identificação do(a) Estudante',
    desc: 'Preencha seus dados cadastrais (nome completo, Nº de Matrícula, telefone e e-mail institucional @ufmg.br). Certifique-se de que a versão curricular indicada é a N-20229.',
    badge: 'Passo 1',
    iconName: 'passport',
  },
  {
    num: '2',
    title: 'Classificação da Atividade & Créditos',
    desc: 'Indique o Tipo (Modalidades I a IX do Art. 15), período de realização (início e término), entidade promotora e a quantidade de créditos solicitados (1 crédito = 15h comprovadas).',
    badge: 'Passo 2',
    iconName: 'checklist',
  },
  {
    num: '3',
    title: 'Envio para Análise da Coordenação',
    desc: 'Após preencher e assinar o formulário, anexe os certificados comprobatórios (com link/código de autenticidade eletrônica) e envie para o e-mail da Coordenação: coordgestaopublica@gmail.com solicitando a análise e assinatura da Coordenadora.',
    badge: 'Passo 3',
    iconName: 'file-text',
  },
  {
    num: '4',
    title: 'Impressão e Protocolo na Secretaria',
    desc: 'Com o documento assinado e deferido pela Coordenação, imprima o requerimento homologado e leve pessoalmente à Secretaria do Curso (Sala F-2039 com Norma Guedes) para protocolar a validação e lançamento definitivo no histórico escolar do SIGA.',
    badge: 'Passo 4',
    iconName: 'building',
  },
];
---

<div class="cagp-tramitacao-core space-y-6 select-none text-[#0A0A0A]">
  <!-- Alerta do Prazo Fatal de 120 Dias (Art. 15, § 4º) -->
  <div class="p-5 rounded-xl bg-red-50 border-[3px] border-[#9E2424] shadow-[4px_4px_0_0_#9E2424] space-y-3">
    <div class="flex items-center gap-2.5">
      <div class="p-1.5 rounded-lg bg-[#9E2424] text-white shrink-0 border border-[#0A0A0A]">
        <CagpIcon name="alert-triangle" class="w-4 h-4" />
      </div>
      <h3 class="font-head font-black text-sm uppercase text-[#9E2424] tracking-wide m-0">
        Fique Atento ao Prazo Regimental Decadencial de 120 Dias Corridos!
      </h3>
    </div>
    <p class="font-body text-xs text-[#292524] leading-relaxed m-0">
      Conforme o <strong>Art. 15, § 4º (incisos III e VII) do Regulamento do Curso</strong>, certificados de participação como ouvinte em congressos/seminários (Modalidade III) e apresentação de trabalhos em anais (Modalidade VII) devem ser protocolados no <strong>prazo fatal de até 120 dias corridos</strong> após a data de emissão. O Colegiado de Gestão Pública indefere sumariamente qualquer certificado protocolado fora do prazo.
    </p>
    <div class="p-3 bg-white rounded-lg border-2 border-[#0A0A0A] text-xs font-body text-[#57534E] shadow-[2px_2px_0_0_#0A0A0A]">
      <strong class="text-[#0A0A0A] font-bold">Regra Benéfica de Recesso:</strong> Para eventos ocorridos durante as férias ou recesso acadêmico da UFMG, a contagem do prazo inicia-se a partir do <em>primeiro dia letivo do semestre regular subsequente</em> à emissão do documento.
    </div>
  </div>

  <!-- Tutorial Visual com Imagem Anotada e Pins Recalibrados -->
  <div class="p-6 bg-white border-[3px] border-[#0A0A0A] rounded-xl space-y-5 shadow-[4px_4px_0_0_#0A0A0A]">
    <div class="border-b-2 border-[#0A0A0A] pb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <span class="text-[11px] font-head uppercase font-bold tracking-wider text-[#9E2424]">
          Guia Visual Passo a Passo
        </span>
        <h3 class="font-head text-base sm:text-lg font-black uppercase text-[#0A0A0A] m-0">
          Como Preencher o Requerimento de AAC (Versão N-20229)
        </h3>
        <p class="font-body text-xs text-[#57534E] mt-0.5 m-0">
          Preencha um formulário para cada atividade extracurricular que desejar integralizar na sua carga horária de optativas (Art. 15):
        </p>
      </div>

      <a
        href={asset('/documentos/requerimento-atividade-integralizadora-credito-v20229.pdf')}
        download
        class="min-h-[44px] px-4 py-2.5 bg-[#9E2424] hover:bg-[#851E1E] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl text-xs font-head uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline shrink-0 border-2 border-[#0A0A0A] shadow-[2.5px_2.5px_0_0_#0A0A0A]"
      >
        <CagpIcon name="download" class="w-4 h-4" />
        <span>Baixar Requerimento Oficial (PDF)</span>
      </a>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-start pt-2">
      <!-- Visual Anotado com Print e Pins -->
      <div class="cagp-doc-preview-wrapper border-2 border-[#0A0A0A] rounded-xl overflow-hidden shadow-[3px_3px_0_0_#0A0A0A]" role="region" aria-label="Visualização anotada do formulário de Requerimento de Atividade Integralizadora de Crédito">
        <img
          src={asset('/imagens/tutoriais/print-requerimento-aac-1.png')}
          alt="Formulário oficial de Requerimento de Atividade Integralizadora de Crédito AAC do Colegiado de Gestão Pública com marcações numeradas"
          class="cagp-doc-preview-img"
          loading="lazy"
        />

        <!-- Box 1 & Pin 1: Identificação -->
        <div class="cagp-doc-box" style="top: 15.7%; left: 13.5%; width: 76.8%; height: 6%;" aria-hidden="true"></div>
        <button type="button" class="cagp-doc-pin" style="top: 15.7%; left: 13.5%;" aria-label="Ponto 1: Identificação do Requerente">1</button>

        <!-- Box 2 & Pin 2: Dados da Atividade -->
        <div class="cagp-doc-box" style="top: 23.9%; left: 13.5%; width: 76.8%; height: 22.5%;" aria-hidden="true"></div>
        <button type="button" class="cagp-doc-pin" style="top: 23.9%; left: 13.5%;" aria-label="Ponto 2: Dados da Atividade e Créditos Requeridos">2</button>

        <!-- Box 3 & Pin 3: Documentos e Assinatura -->
        <div class="cagp-doc-box" style="top: 49%; left: 13.5%; width: 76.8%; height: 21.2%;" aria-hidden="true"></div>
        <button type="button" class="cagp-doc-pin" style="top: 49%; left: 13.5%;" aria-label="Ponto 3: Comprovação e Assinatura do Requerente">3</button>
      </div>

      <!-- Linha do Tempo dos 4 Passos Oficiais -->
      <div class="space-y-3">
        {steps.map((st) => (
          <div class="p-4 bg-white border-2 border-[#0A0A0A] rounded-xl flex items-start gap-3.5 shadow-[2px_2px_0_0_#0A0A0A]">
            <span class="w-8 h-8 rounded-lg bg-[#9E2424] text-white flex items-center justify-center font-head text-sm font-black shrink-0 border border-[#0A0A0A] shadow-[1px_1px_0_0_#0A0A0A]">
              {st.num}
            </span>
            <div class="min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="px-2 py-0.5 rounded-md bg-[#9E2424] text-white font-mono text-[10px] font-bold border border-[#0A0A0A]">{st.badge}</span>
                <h4 class="font-head text-xs font-bold uppercase text-[#0A0A0A] leading-tight m-0 truncate">
                  {st.title}
                </h4>
              </div>
              <p class="font-body text-xs text-[#57534E] leading-relaxed m-0">
                {st.desc}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Duas Colunas: 1. Extensão (300h) vs 2. AAC (Até 300h) -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <!-- Coluna 1: Extensão Obrigatória (300h) -->
    <div class="p-6 bg-white border-[3px] border-[#0A0A0A] rounded-xl space-y-4 shadow-[4px_4px_0_0_#0A0A0A]">
      <div class="flex items-center justify-between border-b-2 border-[#0A0A0A] pb-3 flex-wrap gap-2">
        <div>
          <span class="text-[10px] font-mono text-[#9E2424] font-bold uppercase block">Resolução CEPE 10/2019</span>
          <div class="flex items-center gap-2 mt-0.5">
            <CagpIcon name="curriculo" class="w-4 h-4 text-[#9E2424]" />
            <h4 class="font-head font-bold text-sm uppercase text-[#0A0A0A] m-0">1. Extensão Obrigatória (300h)</h4>
          </div>
        </div>
        <span class="px-2.5 py-1 rounded-md bg-[#9E2424] text-white font-mono text-xs font-bold border border-[#0A0A0A] shadow-[1px_1px_0_0_#0A0A0A]">10% do Curso</span>
      </div>

      <p class="font-body text-xs text-[#292524] leading-relaxed m-0">
        Exigência nacional de curricularização da extensão que conecta os estudantes a projetos comunitários e órgãos de gestão pública:
      </p>

      <ul class="font-body text-xs text-[#57534E] space-y-2 list-disc pl-4 m-0 leading-relaxed">
        <li>
          <strong>Laboratórios de Extensão (DCP 195 e 196):</strong> 90 horas cada (total de até 180h / 12 créditos) em consultoria governamental aplicada nos 7º e 8º períodos.
        </li>
        <li>
          <strong>ATLAS Consultoria Jr.:</strong> Atividades na empresa júnior contam como Atividades Interinstitucionais de Extensão (até 90h / 6 créditos).
        </li>
        <li>
          <strong>Projetos PROEX / SIEX:</strong> Atuação bolsista ou voluntária em programas com registro ativo no SIEX/UFMG (até 90h / 6 créditos).
        </li>
        <li>
          <strong>Cursos Interinstitucionais de Extensão:</strong> Cursos e oficinas em Escolas de Governo reconhecidas (ENAP, FJP, etc., até 120h / 8 créditos).
        </li>
      </ul>
    </div>

    <!-- Coluna 2: Horas Complementares AAC (Até 300h) -->
    <div class="p-6 bg-white border-[3px] border-[#0A0A0A] rounded-xl space-y-4 shadow-[4px_4px_0_0_#0A0A0A]">
      <div class="flex items-center justify-between border-b-2 border-[#0A0A0A] pb-3 flex-wrap gap-2">
        <div>
          <span class="text-[10px] font-mono text-[#57534E] font-bold uppercase block">Regulamento Art. 15</span>
          <div class="flex items-center gap-2 mt-0.5">
            <CagpIcon name="curso" class="w-4 h-4 text-[#266264]" />
            <h4 class="font-head font-bold text-sm uppercase text-[#0A0A0A] m-0">2. Horas AAC (Até 300h)</h4>
          </div>
        </div>
        <span class="px-2.5 py-1 rounded-md bg-[#266264] text-white font-mono text-xs font-bold border border-[#0A0A0A] shadow-[1px_1px_0_0_#0A0A0A]">15h = 1 Crédito</span>
      </div>

      <p class="font-body text-xs text-[#292524] leading-relaxed m-0">
        Atividades extracurriculares facultativas que abatem créditos de optativas do Núcleo Específico:
      </p>

      <div class="overflow-x-auto text-xs max-h-64 overflow-y-auto rounded-xl border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
        <table class="w-full text-left border-collapse">
          <thead>
            <tr class="border-b-2 border-[#0A0A0A] bg-[#9E2424] text-white">
              <th class="p-3 font-head uppercase font-bold text-white">Modalidade</th>
              <th class="p-3 font-head uppercase font-bold text-white text-center">Teto</th>
              <th class="p-3 font-head uppercase font-bold text-white">Comprovação</th>
            </tr>
          </thead>
          <tbody class="divide-y border-[#0A0A0A] bg-white font-body">
            {modalidadesAAC.map((m) => (
              <tr class={m.fatal ? 'bg-red-50/70' : 'hover:bg-muted'}>
                <td class="p-3 font-bold text-[#0A0A0A]">
                  <div class="flex items-center gap-2">
                    <CagpIcon name={m.iconName} class="w-4 h-4 text-[#57534E] shrink-0" />
                    <span>{m.mod}</span>
                  </div>
                </td>
                <td class="p-3 text-center font-mono font-bold">{m.teto}</td>
                <td class="p-3 text-[#57534E] text-[11px]">{m.comp}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- Perguntas Práticas dos Veteranos -->
  <div class="p-6 bg-white border-[3px] border-[#0A0A0A] rounded-xl space-y-4 shadow-[4px_4px_0_0_#0A0A0A]">
    <h4 class="font-head text-base uppercase font-bold text-[#0A0A0A] flex items-center gap-2 m-0">
      <CagpIcon name="shield" class="w-4 h-4 text-[#9E2424]" />
      <span>Dúvidas Práticas e Recomendações dos Veteranos:</span>
    </h4>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs font-body text-[#292524]">
      <div class="p-4 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A]">
        <strong class="text-[#0A0A0A] font-head uppercase font-bold block mb-1">Mesmo evento para Extensão e AAC?</strong>
        Não. Uma mesma atividade não pode ser duplicada entre categorias. O estudante escolhe se a atividade preenche Extensão ou AAC.
      </div>
      <div class="p-4 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A]">
        <strong class="text-[#0A0A0A] font-head uppercase font-bold block mb-1">Atividades anteriores à matrícula?</strong>
        Não. O Art. 15, § 1º determina que as atividades devem ser realizadas estritamente durante o período em que o estudante estiver matriculado.
      </div>
      <div class="p-4 bg-white border-2 border-[#0A0A0A] rounded-xl shadow-[2px_2px_0_0_#0A0A0A]">
        <strong class="text-[#0A0A0A] font-head uppercase font-bold block mb-1">E se a solicitação for indeferida?</strong>
        Conforme o Art. 16, a atividade indeferida não pode ser reapresentada na mesma modalidade, mas cabe recurso administrativo ao Colegiado.
      </div>
    </div>
  </div>
</div>
