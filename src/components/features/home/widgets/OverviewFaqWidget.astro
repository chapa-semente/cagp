---
// src/components/widgets/OverviewFaqWidget.astro — Widget de FAQ e Busca Rápida (Eixo 4: Acervo)
import { route } from '@/lib/paths';

const topFaqs = [
  { label: 'Trancamento de Matrícula (Mín. 180h)', icon: 'bi-clock-history' },
  { label: 'Aproveitamento de Estudos (Até 2ºP)', icon: 'bi-mortarboard' },
  { label: 'Quebra de Pré-requisito no Colegiado', icon: 'bi-signpost-split' },
];
---

<div class="cagp-card p-5 bg-white border-3 border-border rounded-xl flex flex-col justify-between h-full shadow hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-md transition-all select-none">
  <div>
    <!-- Header do Widget -->
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-lg bg-warning text-white flex items-center justify-center text-lg border-3 border-border shadow-sm">
          <i class="bi bi-question-circle text-white" aria-hidden="true"></i>
        </span>
        <div>
          <h3 class="font-head font-bold text-sm uppercase text-foreground leading-tight m-0 tracking-wide">
            FAQ da Graduação
          </h3>
          <span class="text-[11px] text-gray-700 font-mono font-medium">22 Respostas Regimentais</span>
        </div>
      </div>
      <span class="px-2 py-0.5 rounded-md font-head text-xs font-bold bg-warning text-white border border-border shadow-xs">
        22 dúvidas
      </span>
    </div>

    <!-- Dúvidas Mais Consultadas -->
    <div class="space-y-2 mb-4">
      <p class="text-xs text-gray-700 leading-relaxed font-body font-medium">
        Respostas fundamentadas no Regulamento N-20229 e Resoluções CEPE/UFMG sobre a vida acadêmica.
      </p>

      <div class="space-y-2">
        <span class="text-xs font-head uppercase tracking-wider text-foreground font-bold">
          Dúvidas Frequentes:
        </span>
        {topFaqs.map((f) => (
          <div class="p-2.5 bg-white border-3 border-border rounded-lg text-xs flex items-center gap-2 text-gray-800 shadow-xs">
            <i class={`bi ${f.icon} text-secondary text-sm shrink-0`} aria-hidden="true" />
            <span class="font-medium truncate font-body">{f.label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Ação -->
  <a
    href={route('/faq')}
    class="min-h-[44px] px-3.5 py-2 bg-foreground text-background text-white hover:bg-warning active:translate-x-[2px] active:translate-y-[2px] active:shadow-none rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline mt-2 border-3 border-border shadow"
  >
    <span>Explorar Todas as 22 Dúvidas</span>
    <i class="bi bi-arrow-right" aria-hidden="true"></i>
  </a>
</div>
