---
// GestaoContas.astro - Sub-view 3: Transparência ativa e prestação de contas
import { route, asset } from '@/lib/paths';
---

<div class="space-y-6 text-foreground font-body">
  <!-- Mecanismos de Transparência Ativa -->
  <div class="bg-white border-[3px] border-border rounded-xl p-5 sm:p-6 shadow-md space-y-4">
    <div class="border-b-2 border-border pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-success text-white flex items-center justify-center border-3 border-border shadow-sm">
            <i class="bi bi-cash-coin text-base" aria-hidden="true"></i>
          </div>
          <h3 class="font-head text-base sm:text-lg font-extrabold text-foreground m-0">
            Transparência Ativa &amp; Prestação de Contas
          </h3>
        </div>
        <p class="text-xs text-foreground mt-1 m-0 font-medium">
          Instrumentos de fiscalização contábil previstos no Regimento Interno (Arts. 8º, 15, 29 e 30):
        </p>
      </div>
      <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-success-tint text-success border-3 border-border shadow-sm">
        Publicidade Irrevogável
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div class="p-4 bg-white border-2 border-border rounded-xl shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 text-secondary mb-2 pb-2 border-b border-border">
            <div class="w-8 h-8 rounded-lg bg-white text-secondary border-3 border-border flex items-center justify-center shrink-0 shadow-xs">
              <i class="bi bi-file-earmark-spreadsheet-fill text-base" aria-hidden="true"></i>
            </div>
            <h4 class="font-head font-extrabold text-xs text-foreground m-0">RREO Mensal</h4>
          </div>
          <p class="text-xs text-foreground leading-relaxed mb-3 font-medium">
            Elaboração e publicação periódica do <strong>Relatório Resumido de Execução Orçamentária</strong> pela DIFI, discriminando todas as receitas e despesas executadas.
          </p>
        </div>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-bold bg-secondary text-white border border-border w-fit">
          Art. 30, Inciso V
        </span>
      </div>

      <div class="p-4 bg-white border-2 border-border rounded-xl shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 text-foreground mb-2 pb-2 border-b border-border">
            <div class="w-8 h-8 rounded-lg bg-white text-foreground border-3 border-border flex items-center justify-center shrink-0 shadow-xs">
              <i class="bi bi-journal-text text-base" aria-hidden="true"></i>
            </div>
            <h4 class="font-head font-extrabold text-xs text-foreground m-0">Livro de Atas</h4>
          </div>
          <p class="text-xs text-foreground leading-relaxed mb-3 font-medium">
            Registro sistemático de todas as deliberações das reuniões de diretoria e Assembleias Gerais, arquivadas sob tutela da DIJUR e acessíveis no Drive institucional do CAGP.
          </p>
        </div>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-bold bg-foreground text-background text-white border border-border w-fit">
          Art. 29, Inciso VII
        </span>
      </div>

      <div class="p-4 bg-white border-2 border-border rounded-xl shadow-sm flex flex-col justify-between">
        <div>
          <div class="flex items-center gap-2 text-success mb-2 pb-2 border-b border-border">
            <div class="w-8 h-8 rounded-lg bg-white text-success border-3 border-border flex items-center justify-center shrink-0 shadow-xs">
              <i class="bi bi-clock-history text-base" aria-hidden="true"></i>
            </div>
            <h4 class="font-head font-extrabold text-xs text-foreground m-0">Acesso em 3 Dias</h4>
          </div>
          <p class="text-xs text-foreground leading-relaxed mb-3 font-medium">
            Qualquer discente regularmente matriculado tem o direito estatutário de solicitar extratos bancários, notas fiscais e relatórios contábeis, com envio em <strong>até 3 dias úteis</strong>.
          </p>
        </div>
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-bold bg-success text-white border border-border w-fit">
          Art. 15, Inciso V
        </span>
      </div>
    </div>

    <!-- Canal de Acesso à Informação Discente -->
    <div class="p-5 bg-white border-2 border-border rounded-xl shadow space-y-3 mt-4">
      <div class="flex items-center justify-between flex-wrap gap-2 border-b-2 border-border pb-2.5">
        <div class="flex items-center gap-2">
          <i class="bi bi-envelope-open-fill text-secondary" aria-hidden="true"></i>
          <h4 class="font-head text-xs sm:text-sm font-extrabold text-foreground m-0">
            Solicitação de Acesso a Documentos ou Balancetes
          </h4>
        </div>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-mono font-bold bg-success-tint text-success border border-border">
          Lei de Acesso à Informação Discente
        </span>
      </div>
      <p class="text-xs text-foreground leading-relaxed font-medium m-0">
        Para requerer vistas de extratos contábeis, atas ou pareceres regimentais, basta enviar um e-mail com nome e número de matrícula para nossa ouvidoria financeira e jurídica. O prazo de resposta regimental é de até 72 horas úteis.
      </p>
      <div class="flex flex-wrap gap-2.5 pt-2">
        <a
          href={route('/transparencia')}
          class="min-h-[44px] px-3.5 py-2 bg-secondary hover:bg-secondary text-white font-head font-bold uppercase text-xs tracking-wider border-3 border-border rounded-xl shadow hover:shadow-md active:translate-x-[2px] active:translate-y-[2px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
        >
          <i class="bi bi-cash-coin" aria-hidden="true"></i> Abrir Portal da Transparência Completo
        </a>
        <a
          href={route('/documentos/regimento-interno-cagp-ufmg')}
          class="min-h-[44px] px-3.5 py-2 bg-white hover:bg-muted text-foreground font-head font-bold uppercase text-xs tracking-wider border-3 border-border rounded-xl shadow-sm hover:shadow active:translate-x-[1px] active:translate-y-[1px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
        >
          <i class="bi bi-eye" aria-hidden="true"></i> Ler Regimento Transcrito
        </a>
        <a
          href={asset('/documentos/regimento-interno-cagp-ufmg.pdf')}
          download
          class="min-h-[44px] px-3.5 py-2 bg-primary text-white hover:bg-primary-hover text-white font-head font-bold uppercase text-xs tracking-wider border-3 border-border rounded-xl shadow hover:shadow-md active:translate-x-[2px] active:translate-y-[2px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
        >
          <i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> Regimento 2024 (PDF)
        </a>
      </div>
    </div>
  </div>
</div>
