---
// GestaoOrganograma.astro - Sub-view 1: Fluxo deliberativo e organograma institucional
import { asset } from '@/lib/paths';
---

<div class="space-y-6 text-foreground font-body">
  <!-- Hero institucional -->
  <div class="bg-white border-[3px] border-border rounded-xl p-5 sm:p-6 shadow-md space-y-4">
    <div class="flex items-center justify-between border-b-2 border-border pb-3 flex-wrap gap-2">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-secondary text-white flex items-center justify-center border-3 border-border shadow-sm">
          <i class="bi bi-people-fill text-base" aria-hidden="true"></i>
        </div>
        <span class="text-base font-head font-extrabold uppercase text-foreground tracking-tight">
          Compromisso com a Comunidade Discente
        </span>
        <span class="inline-flex items-center px-2.5 py-0.5 rounded-lg text-xs font-mono font-bold bg-secondary text-white border-3 border-border shadow-sm">
          Mandato Vigente
        </span>
      </div>
      <a
        href="https://www.instagram.com/cagp.ufmg"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs font-head font-bold uppercase text-secondary hover:underline flex items-center gap-1.5"
      >
        <i class="bi bi-instagram text-sm" aria-hidden="true"></i> @cagp.ufmg
      </a>
    </div>

    <p class="text-xs text-foreground leading-relaxed font-medium m-0">
      A gestão do Centro Acadêmico orienta-se pela <strong>escuta discente, impessoalidade e descentralização</strong>. Os membros da diretoria exercem seus mandatos de forma voluntária e democrática, dedicando suas horas extracurriculares à melhoria das condições de ensino, ampliação de oportunidades de estágio e pesquisa, e mediação de demandas com o Colegiado e os departamentos parceiros.
    </p>

    <div class="flex flex-wrap gap-2.5 pt-2 border-t-2 border-border">
      <a
        href="mailto:chapa.semente.gp@gmail.com"
        class="min-h-[44px] px-3.5 py-2 bg-secondary hover:bg-secondary text-white font-head font-bold uppercase text-xs tracking-wider border-3 border-border rounded-xl shadow hover:shadow-md active:translate-x-[2px] active:translate-y-[2px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
      >
        <i class="bi bi-envelope" aria-hidden="true"></i> Falar com a Chapa Semente (chapa.semente.gp@gmail.com)
      </a>
      <a
        href="https://www.instagram.com/cagp.ufmg"
        target="_blank"
        rel="noopener noreferrer"
        class="min-h-[44px] px-3.5 py-2 bg-white hover:bg-muted text-foreground font-head font-bold uppercase text-xs tracking-wider border-3 border-border rounded-xl shadow-sm hover:shadow active:translate-x-[1px] active:translate-y-[1px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
      >
        <i class="bi bi-camera-reels" aria-hidden="true"></i> Vídeos &amp; Comunicados
      </a>
      <a
        href={asset('/documentos/regimento-interno-cagp-ufmg.pdf')}
        download
        class="min-h-[44px] px-3.5 py-2 bg-white hover:bg-muted text-foreground font-head font-bold uppercase text-xs tracking-wider border-3 border-border rounded-xl shadow-sm hover:shadow active:translate-x-[1px] active:translate-y-[1px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
      >
        <i class="bi bi-file-earmark-pdf text-secondary" aria-hidden="true"></i> Regimento CAGP (PDF)
      </a>
      <a
        href={asset('/documentos/regimento-geral-ufmg.pdf')}
        download
        class="min-h-[44px] px-3.5 py-2 bg-primary text-white hover:bg-primary-hover text-white font-head font-bold uppercase text-xs tracking-wider border-3 border-border rounded-xl shadow hover:shadow-md active:translate-x-[2px] active:translate-y-[2px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
      >
        <i class="bi bi-building" aria-hidden="true"></i> Regimento Geral UFMG (PDF)
      </a>
    </div>
  </div>

  <!-- Organograma Estrutural Interativo -->
  <div class="bg-white border-[3px] border-border rounded-xl p-5 sm:p-6 shadow-md space-y-5">
    <div class="border-b-2 border-border pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-foreground text-background text-white flex items-center justify-center border-3 border-border shadow-sm">
            <i class="bi bi-diagram-2-fill text-base" aria-hidden="true"></i>
          </div>
          <h3 class="font-head text-base sm:text-lg font-extrabold text-foreground m-0">
            Organograma Funcional (Regimento de 14/10/2024)
          </h3>
        </div>
        <p class="text-xs text-foreground mt-1 m-0 font-medium">
          Sistema de freios e contrapesos fixado nos Arts. 20 a 40 do Regimento Interno:
        </p>
      </div>
      <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-foreground text-background text-white border-3 border-border shadow-sm">
        Arts. 20 a 40
      </span>
    </div>

    <!-- Nível 1: Soberana Assembleia Geral -->
    <div class="flex flex-col items-center">
      <div class="w-full max-w-md p-4 rounded-xl bg-secondary text-white text-center shadow border-2 border-border">
        <div class="flex items-center justify-center gap-1.5 mb-1.5">
          <i class="bi bi-people-fill text-sm" aria-hidden="true"></i>
          <span class="text-xs font-mono uppercase bg-white/20 px-2 py-0.5 rounded border border-white/30 font-bold inline-block">
            Instância Máxima Soberana
          </span>
        </div>
        <h4 class="font-head text-sm sm:text-base font-extrabold m-0">
          Soberana Assembleia Geral
        </h4>
        <p class="text-xs text-white mt-1 font-medium m-0">
          Totalidade dos estudantes matriculados em Gestão Pública (Arts. 35 a 40)
        </p>
      </div>

      <!-- Conector vertical -->
      <div class="w-1 h-6 bg-foreground text-background"></div>

      <!-- Nível 2: Junta Eleitoral e Presidência -->
      <div class="w-full grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-xl">
        <div class="p-4 bg-white border-2 border-border rounded-xl text-center shadow-sm">
          <div class="flex items-center justify-center gap-1.5 mb-1.5">
            <i class="bi bi-shield-check text-foreground" aria-hidden="true"></i>
            <span class="text-xs font-mono uppercase bg-muted text-foreground px-2 py-0.5 rounded border border-border font-bold inline-block">
              Fiscalização Plebiscitária
            </span>
          </div>
          <h5 class="font-head text-xs sm:text-sm font-extrabold uppercase text-foreground m-0">
            Junta Eleitoral Permanente
          </h5>
          <p class="text-xs text-foreground mt-1 font-medium m-0">
            Controle de lisura eleitoral independente da gestão (Arts. 20 a 23)
          </p>
        </div>

        <div class="p-4 rounded-xl bg-foreground text-background text-white text-center shadow border-2 border-border">
          <div class="flex items-center justify-center gap-1.5 mb-1.5">
            <i class="bi bi-bank text-accent" aria-hidden="true"></i>
            <span class="text-xs font-mono uppercase bg-accent text-foreground px-2 py-0.5 rounded font-bold inline-block">
              Poder Executivo
            </span>
          </div>
          <h5 class="font-head text-xs sm:text-sm font-extrabold uppercase text-white m-0">
            Diretoria da Presidência (DIPRE)
          </h5>
          <p class="text-xs text-gray-200 mt-1 font-medium m-0">
            Presidente • Vice-Presidente • Assessoria Geral (Art. 28)
          </p>
        </div>
      </div>

      <!-- Conector vertical -->
      <div class="w-1 h-6 bg-foreground text-background"></div>

      <!-- Nível 3: As 6 Diretorias Executivas Subordinadas -->
      <div class="w-full">
        <div class="text-center mb-3">
          <span class="text-xs font-mono uppercase text-foreground font-extrabold bg-white px-3 py-1 rounded-lg border-3 border-border shadow-sm inline-block">
            6 Diretorias Executivas Setoriais (Arts. 24 a 34)
          </span>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 text-xs">
          <div class="p-3.5 bg-white border-2 border-border rounded-xl text-center shadow-sm">
            <i class="bi bi-shield-check text-secondary text-lg block mb-1" aria-hidden="true"></i>
            <span class="font-mono font-bold text-secondary block text-xs">DIJUR</span>
            <span class="text-xs font-head font-extrabold uppercase text-foreground block mt-0.5">Assuntos Jurídicos</span>
            <span class="text-xs text-foreground font-medium block mt-0.5">Atas, Legalidade &amp; LAI</span>
          </div>
          <div class="p-3.5 bg-white border-2 border-border rounded-xl text-center shadow-sm">
            <i class="bi bi-cash-coin text-success text-lg block mb-1" aria-hidden="true"></i>
            <span class="font-mono font-bold text-success block text-xs">DIFI</span>
            <span class="text-xs font-head font-extrabold uppercase text-foreground block mt-0.5">Finanças &amp; RREO</span>
            <span class="text-xs text-foreground font-medium block mt-0.5">CNPJ, Caixa &amp; Produtos</span>
          </div>
          <div class="p-3.5 bg-white border-2 border-border rounded-xl text-center shadow-sm">
            <i class="bi bi-mortarboard text-primary text-lg block mb-1" aria-hidden="true"></i>
            <span class="font-mono font-bold text-primary block text-xs">DIAC</span>
            <span class="text-xs font-head font-extrabold uppercase text-foreground block mt-0.5">Ensino &amp; Pesquisa</span>
            <span class="text-xs text-foreground font-medium block mt-0.5">ACG, PPC &amp; Colegiado</span>
          </div>
          <div class="p-3.5 bg-white border-2 border-border rounded-xl text-center shadow-sm">
            <i class="bi bi-diagram-3 text-secondary text-lg block mb-1" aria-hidden="true"></i>
            <span class="font-mono font-bold text-secondary block text-xs">DIAP</span>
            <span class="text-xs font-head font-extrabold uppercase text-foreground block mt-0.5">Articulação Política</span>
            <span class="text-xs text-foreground font-medium block mt-0.5">DA FAFICH, DCE &amp; Fóruns</span>
          </div>
          <div class="p-3.5 bg-white border-2 border-border rounded-xl text-center shadow-sm">
            <i class="bi bi-palette text-accent text-lg block mb-1" aria-hidden="true"></i>
            <span class="font-mono font-bold text-accent block text-xs">DICULT</span>
            <span class="text-xs font-head font-extrabold uppercase text-foreground block mt-0.5">Cultura &amp; Lazer</span>
            <span class="text-xs text-foreground font-medium block mt-0.5">Calouradas &amp; Cineclube</span>
          </div>
          <div class="p-3.5 bg-white border-2 border-border rounded-xl text-center shadow-sm">
            <i class="bi bi-broadcast-pin text-secondary text-lg block mb-1" aria-hidden="true"></i>
            <span class="font-mono font-bold text-secondary block text-xs">DIMAC</span>
            <span class="text-xs font-head font-extrabold uppercase text-foreground block mt-0.5">Marketing &amp; Mídias</span>
            <span class="text-xs text-foreground font-medium block mt-0.5">Portal, Murais &amp; Redes</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
