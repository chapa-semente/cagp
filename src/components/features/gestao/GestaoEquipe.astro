---
// GestaoEquipe.astro - Sub-view 2: Equipe por diretoria e chamada de assessoria
import { CHAPA_SEMENTE_LEADERS } from '@/lib/chapaSementeData';
import { LeaderAvatar } from '@/components/features/semente/LeaderAvatar';
import { route } from '@/lib/paths';

const diretorias = [
  {
    sigla: 'DIPRE',
    nome: 'Diretoria da Presidência',
    icon: 'bi-bank',
    cargo: 'Presidência Executiva & Vice-Presidência',
    membros: 'Composição do Mandato Vigente',
    curso: 'Gestão Pública • Noturno • FAFICH/UFMG',
    bio: 'Representação institucional, coordenação executiva perante a Reitoria e Colegiado, assinatura de convênios e protocolo de ofícios regimentais.',
    artigo: 'Art. 28 do Regimento Interno',
    email: 'cagp@fafich.ufmg.br',
  },
  {
    sigla: 'DIJUR',
    nome: 'Diretoria de Assuntos Jurídicos',
    icon: 'bi-shield-check',
    cargo: 'Diretor(a) Jurídico(a) & Assessoria Normativa',
    membros: 'Composição Aberta / Mandato',
    curso: 'Gestão Pública • Noturno • FAFICH/UFMG',
    bio: 'Consultoria jurídica interna, emissão de pareceres de conformidade, guarda física e digital do Livro de Atas e garantia de transparência passiva discente.',
    artigo: 'Art. 29 do Regimento Interno',
    email: 'cagp@fafich.ufmg.br',
  },
  {
    sigla: 'DIFI',
    nome: 'Diretoria Financeira',
    icon: 'bi-cash-coin',
    cargo: 'Diretor(a) Financeiro(a) & Tesouraria',
    membros: 'Composição Aberta / Mandato',
    curso: 'Gestão Pública • Noturno • FAFICH/UFMG',
    bio: 'Gestão da conta bancária institucional e CNPJ, emissão compulsória mensal do RREO, controle do livro-caixa e confecção de produtos oficiais do curso.',
    artigo: 'Art. 30 do Regimento Interno',
    email: 'cagp@fafich.ufmg.br',
  },
  {
    sigla: 'DIAC',
    nome: 'Diretoria Acadêmica',
    icon: 'bi-mortarboard',
    cargo: 'Diretor(a) Acadêmico(a) & Suporte Discente',
    membros: 'Composição Aberta / Mandato',
    curso: 'Gestão Pública • Noturno • FAFICH/UFMG',
    bio: 'Orientação personalizada sobre percursos curriculares, cálculo de horas complementares (AAC/ACG), monitoramento de trancamentos e diálogo com o Colegiado.',
    artigo: 'Art. 31 do Regimento Interno',
    email: 'cagp@fafich.ufmg.br',
  },
  {
    sigla: 'DIAP',
    nome: 'Diretoria de Articulação e Assuntos Políticos',
    icon: 'bi-diagram-3',
    cargo: 'Diretor(a) Político(a) & Relações Estudantis',
    membros: 'Composição Aberta / Mandato',
    curso: 'Gestão Pública • Noturno • FAFICH/UFMG',
    bio: 'Representação do CAGP no Conselho de Centros Acadêmicos (CEB), relação com DA FAFICH e DCE UFMG, e integração com entidades do Campo de Públicas.',
    artigo: 'Art. 32 do Regimento Interno',
    email: 'cagp@fafich.ufmg.br',
  },
  {
    sigla: 'DICULT',
    nome: 'Diretoria de Cultura',
    icon: 'bi-palette',
    cargo: 'Diretor(a) de Cultura & Eventos',
    membros: 'Composição Aberta / Mandato',
    curso: 'Gestão Pública • Noturno • FAFICH/UFMG',
    bio: 'Planejamento e execução da recepção de calouros e Calouradas do curso, cineclubes temáticos, debates extracurriculares e articulação esportiva.',
    artigo: 'Art. 33 do Regimento Interno',
    email: 'cagp@fafich.ufmg.br',
  },
  {
    sigla: 'DIMAC',
    nome: 'Diretoria de Marketing e Comunicação',
    icon: 'bi-broadcast-pin',
    cargo: 'Diretor(a) de Comunicação & Redes',
    membros: 'Composição Aberta / Mandato',
    curso: 'Gestão Pública • Noturno • FAFICH/UFMG',
    bio: 'Gestão das mídias sociais (@cagp.ufmg), produção visual, manutenção e atualização contínua do Super App e informes de prazos de matrícula via painel.',
    artigo: 'Art. 34 do Regimento Interno',
    email: 'cagp@fafich.ufmg.br',
  },
];
---

<div class="space-y-6 text-foreground font-body">
  <!-- Apresentação dos Quadros -->
  <div class="bg-white border-[3px] border-border rounded-xl p-5 sm:p-6 shadow-md space-y-4">
    <div class="border-b-2 border-border pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <div class="flex items-center gap-2.5">
          <div class="w-8 h-8 rounded-lg bg-secondary text-white flex items-center justify-center border-3 border-border shadow-sm">
            <i class="bi bi-people-fill text-base" aria-hidden="true"></i>
          </div>
          <h3 class="font-head text-base sm:text-lg font-extrabold uppercase text-foreground m-0 tracking-tight">
            Quadro das 7 Diretorias Estatutárias
          </h3>
        </div>
        <p class="text-xs text-foreground mt-1 m-0 font-medium">
          Distribuição de competências e contatos para acolhimento de demandas discentes:
        </p>
      </div>
      <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-mono font-bold bg-secondary text-white border-3 border-border shadow-sm">
        Arts. 24 e 25
      </span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      {diretorias.map((d) => (
        <div class="p-4 bg-white border-3 border-[#16181d] rounded-xl shadow-[6px_6px_0_0_#16181d] hover:translate-x-[-2px] hover:translate-y-[-2px] hover:shadow-[8px_8px_0_0_#16181d] transition-all flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2 pb-2 border-b-2 border-[#16181d]">
              <div class="flex items-center gap-2">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono font-bold bg-secondary text-white border-2 border-[#16181d]">
                  {d.sigla}
                </span>
                <i class={`bi ${d.icon} text-secondary text-sm`} aria-hidden="true" />
              </div>
              <span class="text-[11px] font-mono text-foreground font-bold">{d.artigo}</span>
            </div>
            <h4 class="font-head font-extrabold text-xs sm:text-sm uppercase text-foreground mb-1">{d.nome}</h4>
            <span class="text-xs font-bold text-secondary block mb-1.5">{d.cargo}</span>
            <p class="text-xs text-foreground leading-relaxed mb-3 font-medium">{d.bio}</p>
          </div>
          <div class="pt-2.5 border-t-2 border-[#16181d] flex items-center justify-between text-xs">
            <span class="text-foreground font-mono text-[11px] font-bold italic">{d.membros}</span>
            <a
              href={`mailto:${d.email}`}
              class="text-secondary font-head font-extrabold uppercase hover:underline inline-flex items-center gap-1"
            >
              <i class="bi bi-envelope" aria-hidden="true"></i> Contatar
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Vitrine Fotográfica Ampliada: As 9 Pastas e Diretorias da Chapa Semente (2026/2027) -->
  <div class="bg-[#FFFDF9] border-3 border-[#16181d] rounded-xl p-5 sm:p-6 shadow-[8px_8px_0_0_#5B2A85] space-y-5">
    <div class="border-b-2 border-[#16181d] pb-3 flex items-center justify-between flex-wrap gap-2">
      <div>
        <span class="text-[11px] font-mono font-bold uppercase tracking-wider text-[#5B2A85] block">
          Eleições CAGP • 25 e 26 de Novembro de 2026 • Retratos Ampliados 4:5
        </span>
        <h3 class="font-head text-base sm:text-lg font-black uppercase text-[#16181d] m-0 tracking-tight">
          As 9 Pastas &amp; Diretorias da Chapa Semente <span class="font-accent font-normal normal-case tracking-normal text-primary text-xl sm:text-2xl whitespace-nowrap ml-1">Germinar o CAGP</span>
        </h3>
      </div>
      <a
        href={route('/chapa-semente')}
        class="min-h-[44px] px-4 py-2 rounded-xl bg-[#FE8812] text-[#16181d] font-head font-black uppercase text-xs border-3 border-[#16181d] shadow-[4px_4px_0_0_#16181d] hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all inline-flex items-center gap-1.5 no-underline"
      >
        <span>Ver Plataforma Completa</span>
        <i class="bi bi-arrow-right" aria-hidden="true" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {CHAPA_SEMENTE_LEADERS.map((leader, idx) => (
        <div class="p-4 bg-white border-3 border-[#16181d] rounded-2xl shadow-[8px_8px_0_0_#16181d] flex flex-col justify-between gap-4">
          <div class="space-y-3">
            <LeaderAvatar
              client:visible
              name={leader.name}
              photoFilename={leader.photoFilename}
              initials={leader.initials}
              deptColor={leader.deptColor}
              role={leader.role}
              tagline={leader.tagline}
              index={idx}
              variant="portrait"
            />
            <div class="space-y-1.5">
              <span class="inline-block px-2 py-0.5 rounded bg-[#5B2A85] text-white font-mono text-[10px] font-black uppercase">
                PASTA {idx + 1} • {leader.role}
              </span>
              <h4 class="font-head text-base font-black uppercase text-[#16181d] m-0">
                {leader.name}
              </h4>
              <p class="text-xs font-bold text-secondary m-0">
                {leader.tagline}
              </p>
              <p class="text-xs text-[#16181d]/90 leading-relaxed m-0 font-medium">
                {leader.solution}
              </p>
            </div>
          </div>

          <div class="pt-3 border-t-2 border-[#16181d] flex flex-wrap items-center justify-between gap-2">
            <a
              href={`mailto:cagp@fafich.ufmg.br?subject=${encodeURIComponent(`Contato Diretoria: ${leader.role} (${leader.name})`)}`}
              class="min-h-[44px] px-3 py-2 rounded-xl bg-[#16181d] text-white font-head font-black uppercase text-[11px] border-2 border-[#16181d] shadow-[3px_3px_0_0_#FE8812] hover:bg-[#5B2A85] transition-colors inline-flex items-center gap-1.5 no-underline"
            >
              <i class="bi bi-envelope-fill" aria-hidden="true"></i>
              <span>Contatar Pasta</span>
            </a>
            <a
              href={leader.toolHref}
              class="min-h-[44px] px-3 py-2 rounded-xl bg-[#f4f0ea] text-[#16181d] font-mono font-bold text-[11px] border-2 border-[#16181d] hover:bg-[#FE8812] transition-colors inline-flex items-center gap-1 no-underline"
            >
              <span>{leader.toolLabel}</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  <!-- Chamada para Novos Assessores Discentes -->
  <div class="p-5 sm:p-6 rounded-xl bg-foreground text-background text-white border-[3px] border-border shadow-md space-y-3">
    <div class="flex items-center gap-2">
      <span class="px-2.5 py-0.5 rounded-lg bg-accent text-foreground font-mono font-bold uppercase text-[11px] border border-border">
        Edital Permanente
      </span>
      <h3 class="font-head text-sm sm:text-base uppercase font-extrabold text-white tracking-wide m-0">
        Participe da Gestão: Chamada para Novos Assessores
      </h3>
    </div>
    <p class="text-xs text-white/90 leading-relaxed font-medium m-0">
      Todas as diretorias executivas possuem previsão regimental expressa para inclusão contínua de <strong>Assessores Discentes Voluntários</strong> (Arts. 24 a 34). A atuação discente proporciona vivência prática em gestão pública e contabilidade social, concessão de horas complementares (AAC/Extensão) e atuação direta nas decisões da faculdade.
    </p>
    <div class="pt-2">
      <a
        href="mailto:cagp@fafich.ufmg.br?subject=Interesse%20em%20Assessoria%20CAGP"
        class="min-h-[44px] px-4 py-2 bg-secondary hover:bg-secondary text-white font-head font-bold uppercase text-xs tracking-wider border-2 border-white rounded-xl shadow-[3px_3px_0_0_#FFFFFF] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none inline-flex items-center gap-2 transition-all no-underline"
      >
        <i class="bi bi-envelope-plus" aria-hidden="true"></i> Enviar Mensagem de Interesse para Assessoria &rarr;
      </a>
    </div>
  </div>
</div>
