---
// src/components/features/documentos/DocumentosCentralOverview.astro — Visão Geral do Acervo de Documentos
import { asset } from '@/lib/paths';
---

<div class="cagp-documentos-central-overview space-y-6 select-none text-foreground">
  {/* Apresentação do Acervo */}
  <div class="p-5 sm:p-6 bg-white border-2 border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">
    <div class="flex items-start gap-3.5">
      <span class="w-12 h-12 rounded-xl bg-secondary text-white flex items-center justify-center text-xl shrink-0 mt-0.5 border-2 border-border shadow-sm">
        <i class="bi bi-folder2-open" aria-hidden="true" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-head uppercase font-bold tracking-wider text-secondary">
            Acervo Documental & Normativo
          </span>
          <span class="text-foreground">•</span>
          <span class="text-xs text-foreground font-mono font-bold">100% Autêntico</span>
        </div>
        <h2 class="font-head text-lg sm:text-xl font-black text-foreground leading-tight m-0">
          Normas, formulários e processos do DRCA
        </h2>
        <p class="text-xs text-gray-700 mt-1 max-w-3xl leading-relaxed m-0 font-body font-medium">
          Repositório integral de regulamentos, minutas editáveis, requerimentos do Colegiado e resoluções do CEPE/UFMG disponíveis para consulta offline e download.
        </p>
      </div>
    </div>
  </div>

  {/* Bento Grid das 3 Seções */}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {/* Card 1: Atos Normativos */}
    <div class="cagp-card p-5 bg-white border-2 border-border rounded-xl flex flex-col justify-between h-full shadow hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-md transition-all">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-lg bg-secondary text-white flex items-center justify-center text-lg border-3 border-border shadow-sm">
              <i class="bi bi-file-earmark-ruled-fill text-white" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-head font-bold text-sm text-foreground leading-tight m-0">
                Atos Normativos
              </h3>
              <span class="text-xs text-gray-700 font-mono font-medium">PPC, Regulamento & Estatuto</span>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-md font-head text-xs font-bold bg-secondary text-white border border-border shadow-xs">
            Leis
          </span>
        </div>
        <p class="text-xs text-gray-700 leading-relaxed mb-3 font-body font-medium">
          PPC 2020 de 3.000h, Regulamento N-20229, Regimento Interno do CAGP de 14/10/2024 e matrizes dos 3 percursos.
        </p>
      </div>

      <a
        href="#atos"
        class="min-h-[44px] px-3.5 py-2 bg-primary text-white hover:bg-primary-hover active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline border-3 border-border shadow"
      >
        <span>Consultar Atos</span>
        <i class="bi bi-arrow-right" aria-hidden="true" />
      </a>
    </div>

    {/* Card 2: Formulários Oficiais */}
    <div class="cagp-card p-5 bg-white border-2 border-border rounded-xl flex flex-col justify-between h-full shadow hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-md transition-all">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-lg bg-success text-white flex items-center justify-center text-lg border-3 border-border shadow-sm">
              <i class="bi bi-journal-check text-white" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-head font-bold text-sm text-foreground leading-tight m-0">
                Formulários & Modelos
              </h3>
              <span class="text-xs text-gray-700 font-mono font-medium">AAC, Estágio & TCC</span>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-md font-head text-xs font-bold bg-success text-white border border-border shadow-xs">
            Modelos
          </span>
        </div>
        <p class="text-xs text-gray-700 leading-relaxed mb-3 font-body font-medium">
          Requerimento oficial de AAC N-20229, Termos de Compromisso de Estágio, Termo de Aceite de TCC e dispensa Art. 41.
        </p>
      </div>

      <a
        href="#formularios"
        class="min-h-[44px] px-3.5 py-2 bg-primary text-white hover:bg-success active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline border-3 border-border shadow"
      >
        <span>Ver Formulários</span>
        <i class="bi bi-arrow-right" aria-hidden="true" />
      </a>
    </div>

    {/* Card 3: Processos DRCA */}
    <div class="cagp-card p-5 bg-white border-2 border-border rounded-xl flex flex-col justify-between h-full shadow hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-md transition-all">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-lg bg-foreground text-background text-white flex items-center justify-center text-lg border-3 border-border shadow-sm">
              <i class="bi bi-archive-fill text-white" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-head font-bold text-sm text-foreground leading-tight m-0">
                DRCA & Prazos
              </h3>
              <span class="text-xs text-gray-700 font-mono font-medium">Trancamento & Res. 06/2019</span>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-md font-head text-xs font-bold bg-foreground text-background text-white border border-border shadow-xs">
            UFMG
          </span>
        </div>
        <p class="text-xs text-gray-700 leading-relaxed mb-3 font-body font-medium">
          Requerimentos de trancamento parcial e total, regime especial de graduação (RAEP) e aproveitamento de estudos.
        </p>
      </div>

      <a
        href="#drca"
        class="min-h-[44px] px-3.5 py-2 bg-primary text-white hover:bg-primary-hover active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline border-3 border-border shadow"
      >
        <span>Processos DRCA</span>
        <i class="bi bi-arrow-right" aria-hidden="true" />
      </a>
    </div>
  </div>
</div>
