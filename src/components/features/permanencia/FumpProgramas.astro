---
// FumpProgramas.astro — Os quatro programas da FUMP e o que muda com o nível (decisão de 11/11/2026).
// Tudo aqui resume o site da FUMP (src/data/fumpProgramas.json, com o link de cada página e a data da
// consulta). Antes a página prometia benefício por nível e simulava valores sem fonte: a FUMP só define
// por nível o preço do RU; moradia e suportes financeiros saem por chamada.
import dados from '@/data/fumpProgramas.json';

const brl = (n: number) => n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
const dataBr = dados.consultadoEm.split('-').reverse().join('/');
// As quatro cores do ciclo, uma por programa (como nas listas de hub).
const CORES = ['var(--color-accent)', '#6DB33F', '#FFC83D', 'var(--color-primary-tint)'];
---

<div class="fp">
  <p class="fp-lede">
    A FUMP tem quatro programas. O seu nível (de I a IV) define quanto você paga no RU e se pode concorrer à moradia e
    aos suportes financeiros.
  </p>

  <ul class="fp-programas" role="list">
    {dados.programas.map((p, i) => (
      <li class="fp-programa" id={`fump-${p.id}`}>
        <div class="fp-programa-topo">
          <span class="fp-icone" style={`background:${CORES[i % CORES.length]}`} aria-hidden="true"><i class={`bi ${p.icone}`}></i></span>
          <h3 class="fp-h3">{p.nome}</h3>
        </div>
        <p class="fp-texto">{p.oQueE}</p>
        <dl class="fp-dl">
          <div><dt>Quem pode</dt><dd>{p.quemPode}</dd></div>
          <div><dt>Como acessar</dt><dd>{p.comoAcessar}</dd></div>
        </dl>
        <a href={p.link} target="_blank" rel="noopener noreferrer" class="fp-link">
          Ver no site da FUMP<span class="sr-only"> (abre em nova aba)</span>
          <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
        </a>
      </li>
    ))}
  </ul>

  <section aria-labelledby="fump-suportes-titulo" class="fp-bloco">
    <h3 id="fump-suportes-titulo" class="fp-h3">Os suportes financeiros, um por um</h3>
    <p class="fp-texto">
      A FUMP só publica valor fixo onde ele aparece abaixo. Nos outros, o valor e as vagas vêm em cada chamada.
    </p>
    <ul class="fp-suportes" role="list">
      {dados.suportes.map((s) => (
        <li>
          <a href={s.link} target="_blank" rel="noopener noreferrer">
            <span class="fp-suporte-corpo">
              <span class="fp-suporte-nome">{s.nome}<span class="fp-acesso">{s.acesso}</span></span>
              <span class="fp-suporte-resumo">{s.resumo}</span>
            </span>
            <i class="bi bi-box-arrow-up-right shrink-0" aria-hidden="true"></i>
            <span class="sr-only">(abre o site da FUMP em nova aba)</span>
          </a>
        </li>
      ))}
    </ul>
    <a href={dados.fonte} target="_blank" rel="noopener noreferrer" class="fp-link">
      Ver todos os suportes no site da FUMP
      <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
    </a>
  </section>

  <section aria-labelledby="fump-niveis-titulo" class="fp-bloco" id="niveis">
    <h3 id="fump-niveis-titulo" class="fp-h3">O que muda com o nível</h3>
    <p class="fp-texto">{dados.precosRu.nota} Valores conforme a {dados.precosRu.norma}.</p>
    <div class="fp-niveis" role="table" aria-label="O que cada nível paga no RU e a que pode concorrer">
      <div class="fp-nivel fp-nivel-cabeca" role="row">
        <span role="columnheader">Nível</span>
        <span role="columnheader">Almoço e jantar</span>
        <span role="columnheader">Café da manhã</span>
        <span role="columnheader">Moradia e suportes</span>
      </div>
      {dados.precosRu.niveis.map((n) => (
        <div class="fp-nivel" role="row">
          <span role="cell" class="fp-nivel-nome">{n.nivel}</span>
          <span role="cell" data-rotulo="Almoço e jantar"><strong>{n.preco === 0 ? 'Gratuito' : brl(n.preco)}</strong></span>
          <span role="cell" data-rotulo="Café da manhã">{n.cafe ? 'Gratuito' : 'Não tem'}</span>
          <span role="cell" data-rotulo="Moradia e suportes">{n.concorre ? 'Pode concorrer, por chamada' : 'Só níveis I, II e III'}</span>
        </div>
      ))}
    </div>
    <p class="fp-texto">
      Quem define o nível é a FUMP, depois do estudo socioeconômico (Portaria PRAE nº 1.286/2026).{' '}
      <a href="#pedir" class="fp-inline">Veja como pedir o seu</a>.
    </p>
  </section>

  <p class="fp-fonte">
    Fonte: <a href={dados.fonte} target="_blank" rel="noopener noreferrer" class="fp-inline">site da FUMP</a>, consultado em {dataBr}.
    Regras e valores mudam por portaria e por chamada: confirme sempre na FUMP. {dados.contato}.
  </p>
</div>

<style>
  .fp {
    display: grid;
    gap: 2rem;
  }
  .fp-lede {
    margin: 0;
    max-width: 68ch;
    font-size: 1rem;
    line-height: 1.6;
  }
  .fp-programas {
    display: grid;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .fp-programa {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: 1.25rem;
    background: var(--color-card, #fff);
    border: 3px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 4px 4px 0 0 var(--shadow-color, var(--color-border));
    scroll-margin-top: 7rem;
  }
  .fp-programa-topo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .fp-icone {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 3px solid var(--color-border);
    border-radius: 16px 5px 16px 5px;
    color: var(--color-foreground);
    font-size: 1.25rem;
  }
  .fp-h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
  }
  .fp-texto {
    margin: 0;
    max-width: 68ch;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-content-secondary, #4a4740);
    text-wrap: pretty;
  }
  .fp-dl {
    display: grid;
    gap: 0.625rem;
    margin: 0;
    padding: 0.875rem 1rem;
    background: var(--color-muted);
    border-radius: 8px;
  }
  .fp-dl div {
    display: grid;
    gap: 0.125rem;
  }
  .fp-dl dt,
  .fp-nivel-cabeca,
  .fp-acesso {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .fp-dl dt { color: var(--color-content-secondary, #4a4740); }
  .fp-dl dd {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .fp-link {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 44px;
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .fp-inline {
    font-weight: 700;
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 0.22em;
  }
  .fp-bloco {
    display: grid;
    gap: 0.75rem;
    scroll-margin-top: 7rem;
  }
  .fp-suportes,
  .fp-niveis {
    margin: 0;
    padding: 0;
    list-style: none;
    background: var(--color-card, #fff);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    overflow: hidden;
  }
  .fp-suportes li + li,
  .fp-nivel + .fp-nivel {
    border-top: 2px solid var(--color-border);
  }
  .fp-suportes a {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-height: 48px;
    padding: 0.875rem 1rem;
    color: var(--color-foreground);
    text-decoration: none;
  }
  .fp-suportes a:hover { background: var(--color-muted); }
  .fp-suporte-corpo {
    flex: 1;
    display: grid;
    gap: 0.25rem;
    min-width: 0;
  }
  .fp-suporte-nome {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.625rem;
    font-family: var(--font-heading);
    font-weight: 700;
    line-height: 1.3;
  }
  .fp-acesso {
    padding: 0.125rem 0.5rem;
    background: var(--color-secondary-tint, #e3f0ef);
    border: 2px solid var(--color-border);
    border-radius: 8px;
    line-height: 1.4;
  }
  .fp-suporte-resumo {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-content-secondary, #4a4740);
  }
  /* Níveis: no celular, cada nível é uma ficha com os rótulos; no desktop, uma tabela de 4 colunas. */
  .fp-nivel {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    font-size: 0.875rem;
    line-height: 1.45;
    font-variant-numeric: tabular-nums;
  }
  .fp-nivel-cabeca { display: none; }
  .fp-nivel-nome {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
  }
  .fp-nivel [data-rotulo]::before {
    content: attr(data-rotulo) ': ';
    color: var(--color-content-secondary, #4a4740);
  }
  .fp-fonte {
    margin: 0;
    max-width: 68ch;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-content-secondary, #4a4740);
  }
  .fp a:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }
  @media (min-width: 768px) {
    .fp-programas { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .fp-nivel {
      grid-template-columns: 1.1fr 1fr 1fr 1.6fr;
      align-items: center;
      gap: 1rem;
    }
    .fp-nivel-cabeca {
      display: grid;
      background: var(--color-foreground);
      color: #fff;
    }
    .fp-nivel [data-rotulo]::before { content: none; }
  }
</style>
