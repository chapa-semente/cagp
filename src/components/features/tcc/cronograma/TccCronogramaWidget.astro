---
// src/components/features/tcc/cronograma/TccCronogramaWidget.astro — Widget de Resumo do Ciclo de TCC
import { route } from '@/lib/paths';
---

<div class="cagp-card p-5 bg-white border-2 border-border rounded-xl flex flex-col justify-between h-full shadow hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-md transition-all select-none">
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-lg bg-foreground text-background text-white flex items-center justify-center text-lg border-3 border-border shadow-sm">
          <i class="bi bi-mortarboard-fill text-white" aria-hidden="true" />
        </span>
        <div>
          <h3 class="font-head font-bold text-sm text-foreground leading-tight m-0">
            Ciclo de TCC (180h)
          </h3>
          <span class="text-xs text-gray-700 font-mono font-medium">DCP 089 (60h) + DCP 137 (120h)</span>
        </div>
      </div>
      <span class="px-2 py-0.5 rounded-md font-head text-xs font-bold bg-foreground text-background text-white border border-border shadow-xs">
        9º e 10ºP
      </span>
    </div>

    <p class="font-body text-xs text-gray-700 leading-relaxed mb-3 font-medium">
      Projeto de pesquisa e redação monográfica com orientação docente individualizada e banca examinadora pública.
    </p>

    <div class="grid grid-cols-2 gap-2 mb-3 text-xs">
      <div class="p-2.5 bg-white border-3 border-border rounded-lg text-center shadow-xs">
        <div class="font-mono font-bold text-secondary text-sm tabular-nums">60h (4 cr)</div>
        <div class="text-xs text-foreground uppercase font-head font-bold tracking-wider mt-0.5">DCP 089 • Projeto</div>
      </div>
      <div class="p-2.5 bg-white border-3 border-border rounded-lg text-center shadow-xs">
        <div class="font-mono font-bold text-secondary text-sm tabular-nums">120h (8 cr)</div>
        <div class="text-xs text-foreground uppercase font-head font-bold tracking-wider mt-0.5">DCP 137 • Defesa</div>
      </div>
    </div>
  </div>

  <a
    href={route('/tcc') + '#cronograma'}
    class="min-h-[44px] px-3.5 py-2 bg-secondary hover:bg-secondary-hover active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline shadow border-3 border-border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2"
  >
    <span>Ver Cronograma Completo</span>
    <i class="bi bi-arrow-right" aria-hidden="true" />
  </a>
</div>
