---
// src/components/features/tcc/termo/TccTermoAceiteWidget.astro — Widget de Resumo do Termo de Aceite
import { asset } from '../../../../lib/paths';
---

<div class="cagp-card p-5 bg-white border-3 border-border rounded-xl flex flex-col justify-between h-full shadow hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-md transition-all select-none">
  <div>
    <div class="flex items-center justify-between gap-2 mb-3">
      <div class="flex items-center gap-2.5">
        <span class="w-9 h-9 rounded-lg bg-secondary text-white flex items-center justify-center text-lg border-3 border-border shadow-sm">
          <i class="bi bi-file-earmark-check-fill" aria-hidden="true" />
        </span>
        <div>
          <h3 class="font-head font-bold text-sm uppercase text-foreground leading-tight m-0 tracking-wide">
            Termo de Aceite
          </h3>
          <span class="text-xs text-gray-700 font-mono font-medium">Pré-requisito DCP 089</span>
        </div>
      </div>
      <span class="px-2 py-0.5 rounded-md font-head text-xs font-bold bg-secondary text-white border border-border shadow-xs">
        Obrigatório
      </span>
    </div>

    <p class="font-body text-xs text-gray-700 leading-relaxed mb-3 font-medium">
      Documento firmado com seu(sua) professor(a) orientador(a) antes de solicitar matrícula em Projeto de TCC no SIGA.
    </p>

    <div class="p-2.5 bg-white border-3 border-border rounded-lg mb-3 flex items-center justify-between text-xs shadow-xs">
      <span class="text-gray-700 font-body font-medium">Formato Disponível:</span>
      <span class="font-mono font-bold text-foreground">PDF e DOCX</span>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-3 border-t-2 border-border">
    <a
      href="#termo-aceite"
      class="flex-1 min-h-[44px] px-3.5 py-2 bg-secondary hover:bg-[#6e1723] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-1.5 transition-all no-underline shadow border-3 border-border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2"
    >
      <span>Orientações & Regras</span>
      <i class="bi bi-arrow-right" aria-hidden="true" />
    </a>
    <a
      href={asset('/documentos/termo-aceite-orientador-tcc.pdf')}
      download
      class="min-h-[44px] min-w-[44px] px-3 py-2 bg-white hover:bg-[#EAE6DE] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-foreground border-3 border-border shadow rounded-xl flex items-center justify-center transition-all no-underline shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
      title="Baixar Termo de Aceite em PDF"
      aria-label="Baixar Termo de Aceite em PDF"
    >
      <i class="bi bi-file-earmark-pdf-fill text-secondary text-lg" aria-hidden="true" />
    </a>
  </div>
</div>
