---
// src/components/features/tcc/TccCentralOverview.astro — Visão Geral do Trabalho de Conclusão de Curso (180h) (Padrão Dossiê Tátil)
import TccModalidadesWidget from './modalidades/TccModalidadesWidget.astro';
import TccCronogramaWidget from './cronograma/TccCronogramaWidget.astro';
import TccTermoAceiteWidget from './termo/TccTermoAceiteWidget.astro';
import CagpIcon from '../../ui/CagpIcon.astro';
import { asset } from '../../../lib/paths';
---

<div class="cagp-tcc-central-overview space-y-6 select-none text-[#0A0A0A]">
  {/* Apresentação da Central de TCC */}
  <div class="p-5 sm:p-6 bg-white border border-[#DFDBD2] rounded-3xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-start gap-3.5">
      <span class="w-11 h-11 rounded-2xl bg-[#8B1E2D] text-white flex items-center justify-center shrink-0 mt-0.5 shadow-xs">
        <CagpIcon name="thesis" class="w-6 h-6" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-[11px] font-['Oswald'] uppercase font-bold tracking-wider text-[#8B1E2D]">
            Trabalho de Conclusão de Curso
          </span>
          <span class="text-[#A8A29E]">•</span>
          <span class="text-xs text-[#57534E] font-mono">180 horas regimentais</span>
        </div>
        <h2 class="font-['Oswald'] text-lg sm:text-xl font-bold uppercase text-[#0A0A0A] leading-tight m-0">
          As 4 Modalidades do Art. 19, Cronograma 9º/10ºP e Termo de Aceite
        </h2>
        <p class="text-xs text-[#57534E] mt-1 max-w-3xl leading-relaxed m-0">
          Planeje sua formatura no curso noturno: escolha sua modalidade de TCC, formalize a orientação com o docente do DCP e confira o rito de banca examinadora.
        </p>
      </div>
    </div>
  </div>

  {/* Bento Grid dos Widgets de TCC */}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <TccModalidadesWidget />
    <TccCronogramaWidget />
    <TccTermoAceiteWidget />
  </div>

  {/* Banner Informativo sobre o Termo de Aceite */}
  <div class="p-5 bg-white border border-[#DFDBD2] rounded-3xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-xs">
    <div class="flex items-center gap-3.5">
      <span class="w-10 h-10 rounded-2xl bg-[#0A0A0A] text-white flex items-center justify-center shrink-0 shadow-xs">
        <CagpIcon name="file-text" class="w-5 h-5" />
      </span>
      <div>
        <h3 class="font-['Oswald'] text-sm uppercase font-bold text-[#0A0A0A] leading-tight m-0">
          Termo de Aceite de Orientação (PDF Oficial)
        </h3>
        <p class="text-xs text-[#57534E] mt-0.5 m-0">
          Exigência regimental para efetivar a matrícula em DCP 089 (Projeto de TCC).
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2.5 w-full sm:w-auto">
      <a
        href={asset('/documentos/termo-aceite-orientador-tcc.pdf')}
        download
        class="min-h-[44px] flex-1 sm:flex-none px-4 py-2 bg-[#8B1E2D] hover:bg-[#6D1723] active:scale-95 text-white rounded-xl text-xs font-['Oswald'] uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline shadow-xs"
      >
        <CagpIcon name="download" class="w-4 h-4" />
        <span>Baixar Termo (PDF)</span>
      </a>
      <a
        href="#termo-aceite"
        class="min-h-[44px] px-3.5 py-2 bg-[#FBF8F3] hover:bg-[#F4F1EA] text-[#0A0A0A] border border-[#DFDBD2] rounded-xl text-xs font-['Oswald'] uppercase font-bold flex items-center justify-center transition-all no-underline"
      >
        <span>Ver Regras</span>
      </a>
    </div>
  </div>
</div>
