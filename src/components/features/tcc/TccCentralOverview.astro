---
// src/components/features/tcc/TccCentralOverview.astro — Visão Geral do Trabalho de Conclusão de Curso (180h) (Padrão Dossiê Tátil)
import TccModalidadesWidget from './modalidades/TccModalidadesWidget.astro';
import TccCronogramaWidget from './cronograma/TccCronogramaWidget.astro';
import TccTermoAceiteWidget from './termo/TccTermoAceiteWidget.astro';
import CagpIcon from '../../ui/CagpIcon.astro';
import { asset } from '../../../lib/paths';
---

<div class="cagp-tcc-central-overview space-y-6 select-none text-[#0A0A0A]">
  {/* Apresentação da Central de TCC */}
  <div class="p-5 sm:p-6 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-[4px_4px_0_0_#0A0A0A]">
    <div class="flex items-start gap-3.5">
      <span class="w-12 h-12 rounded-xl bg-[#8B1E2D] text-white flex items-center justify-center shrink-0 mt-0.5 border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
        <CagpIcon name="thesis" class="w-6 h-6" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-head uppercase font-bold tracking-wider text-[#8B1E2D]">
            Trabalho de Conclusão de Curso
          </span>
          <span class="text-[#0A0A0A]">•</span>
          <span class="text-xs text-[#0A0A0A] font-mono font-bold">180 horas regimentais</span>
        </div>
        <h2 class="font-head text-lg sm:text-xl font-black uppercase text-[#0A0A0A] leading-tight m-0 tracking-wide">
          As 4 Modalidades do Art. 19, Cronograma 9º/10ºP e Termo de Aceite
        </h2>
        <p class="font-body text-xs text-gray-700 mt-1 max-w-3xl leading-relaxed m-0 font-medium">
          Planeje sua formatura no curso noturno: escolha sua modalidade de TCC, formalize a orientação com o docente do DCP e confira o rito de banca examinadora.
        </p>
      </div>
    </div>
  </div>

  {/* Bento Grid dos Widgets de TCC */}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <TccModalidadesWidget />
    <TccCronogramaWidget />
    <TccTermoAceiteWidget />
  </div>

  {/* Banner Informativo sobre o Termo de Aceite */}
  <div class="p-5 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-[3px_3px_0_0_#0A0A0A]">
    <div class="flex items-center gap-3.5">
      <span class="w-11 h-11 rounded-xl bg-[#0A0A0A] text-white flex items-center justify-center shrink-0 border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
        <CagpIcon name="file-text" class="w-5 h-5 text-white" />
      </span>
      <div>
        <h3 class="font-head text-sm uppercase font-bold text-[#0A0A0A] leading-tight m-0 tracking-wide">
          Termo de Aceite de Orientação (PDF Oficial)
        </h3>
        <p class="font-body text-xs text-gray-700 mt-0.5 m-0 font-medium">
          Exigência regimental para efetivar a matrícula em DCP 089 (Projeto de TCC).
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2.5 w-full sm:w-auto">
      <a
        href={asset('/documentos/termo-aceite-orientador-tcc.pdf')}
        download
        class="min-h-[44px] flex-1 sm:flex-none px-4 py-2 bg-[#8B1E2D] hover:bg-[#6D1723] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl text-xs font-head uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline border-2 border-[#0A0A0A] shadow-[3px_3px_0_0_#0A0A0A]"
      >
        <CagpIcon name="download" class="w-4 h-4" />
        <span>Baixar Termo (PDF)</span>
      </a>
      <a
        href="#termo-aceite"
        class="min-h-[44px] px-3.5 py-2 bg-white hover:bg-[#F4F1EA] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-[#0A0A0A] border-2 border-[#0A0A0A] shadow-[3px_3px_0_0_#0A0A0A] rounded-xl text-xs font-head uppercase font-bold flex items-center justify-center transition-all no-underline"
      >
        <span>Ver Regras</span>
      </a>
    </div>
  </div>
</div>
