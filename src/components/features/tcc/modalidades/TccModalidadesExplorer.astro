---
// src/components/features/tcc/modalidades/TccModalidadesExplorer.astro — Matriz das 4 Modalidades Oficiais de TCC
const modalidades = [
  {
    num: 1,
    nome: 'Monografia Científica Tradicional',
    icon: 'bi-journal-richtext',
    badge: 'Perfil Acadêmico',
    badgeColor: 'bg-[#0A0A0A]',
    foco: 'Domínio teórico-analítico e revisão exaustiva da literatura especializada.',
    estrutura: 'Texto monográfico completo com problema de pesquisa, metodologia e análise empírica/documental detalhada.',
    sinergia: 'Indicada para discentes que visam ingresso em programas de Pós-Graduação (PPGCP/UFMG) e carreira docente.',
  },
  {
    num: 2,
    nome: 'Projeto de Intervenção Governamental',
    icon: 'bi-kanban-fill',
    badge: 'Perfil Aplicado',
    badgeColor: 'bg-[#8B1E2D]',
    foco: 'Resolução aplicada de problema real em órgão público, política pública ou OSC.',
    estrutura: 'Diagnóstico situacional estruturado + Plano executivo de melhoria, modernização institucional ou intervenção.',
    sinergia: 'Aproveitamento direto de diagnósticos e vivências do Estágio Obrigatório (DCP 135/136) ou atuação no setor público.',
  },
  {
    num: 3,
    nome: 'Artigo Científico para Publicação',
    icon: 'bi-file-earmark-text-fill',
    badge: 'Perfil Periódico',
    badgeColor: 'bg-[#15803D]',
    foco: 'Teste objetivo de hipóteses no formato de periódicos científicos indexados (Qualis/CAPES).',
    estrutura: 'Artigo autoral inédito formatado segundo normas de periódicos acadêmicos da área de Gestão Pública/Ciência Política.',
    sinergia: 'Excelente para bolsistas e pesquisadores dos 11 Núcleos de Pesquisa do DCP que visam publicação científica.',
  },
  {
    num: 4,
    nome: 'Projeto de Iniciação Científica Avançado',
    icon: 'bi-search',
    badge: 'Perfil Pesquisa',
    badgeColor: 'bg-[#B45309]',
    foco: 'Desenho metodológico avançado para investigação futura de fôlego.',
    estrutura: 'Projeto completo contendo justificativa, estado da arte, hipóteses e matriz operacional de coleta de dados.',
    sinergia: 'Recomendado para discentes com planos de editais de fomento científico ou anteprojeto de seleção de mestrado.',
  },
];
---

<div class="cagp-tcc-modalidades space-y-6 select-none text-[#0A0A0A]">
  {/* Cabeçalho */}
  <div class="p-5 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-[4px_4px_0_0_#0A0A0A]">
    <div>
      <span class="text-xs font-head uppercase font-bold tracking-wider text-[#8B1E2D]">
        Regulamento do Curso • Artigo 19
      </span>
      <h3 class="font-head text-lg font-black uppercase text-[#0A0A0A] m-0 tracking-wide">
        As 4 Modalidades Oficiais de TCC no CAGP
      </h3>
      <p class="font-body text-xs text-gray-700 mt-0.5 m-0 font-medium">
        Escolha o formato que melhor se alinha à sua trajetória acadêmica ou profissional.
      </p>
    </div>
    <span class="px-3 py-1.5 rounded-lg bg-[#0A0A0A] text-white font-mono text-xs font-bold shrink-0 border border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
      4 Opções Regimentais
    </span>
  </div>

  {/* Grid das 4 Modalidades */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    {modalidades.map((m) => (
      <div class="cagp-card p-5 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col justify-between shadow-[3px_3px_0_0_#0A0A0A] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[5px_5px_0_0_#0A0A0A] transition-all">
        <div>
          <div class="flex items-center justify-between gap-2 mb-3">
            <div class="flex items-center gap-2.5">
              <span class="w-9 h-9 rounded-lg bg-[#8B1E2D] text-white flex items-center justify-center text-sm border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
                <i class={`bi ${m.icon}`} aria-hidden="true" />
              </span>
              <span class="font-mono text-xs font-bold text-[#0A0A0A]">Opção {m.num}</span>
            </div>
            <span class={`px-2.5 py-0.5 rounded-md text-[11px] font-head uppercase font-bold text-white border border-[#0A0A0A] shadow-[1px_1px_0_0_#0A0A0A] ${m.badgeColor}`}>
              {m.badge}
            </span>
          </div>

          <h4 class="font-head text-base font-bold uppercase text-[#0A0A0A] leading-snug mb-3 m-0 tracking-wide">
            {m.nome}
          </h4>

          <div class="space-y-2.5 text-xs text-gray-700 font-body">
            <div>
              <strong class="text-[#0A0A0A] font-head uppercase tracking-wider text-[11px] block">Foco Analítico:</strong>
              <span class="text-gray-700 font-medium">{m.foco}</span>
            </div>
            <div>
              <strong class="text-[#0A0A0A] font-head uppercase tracking-wider text-[11px] block">Estrutura Esperada:</strong>
              <span class="text-gray-700 font-medium">{m.estrutura}</span>
            </div>
          </div>
        </div>

        <div class="pt-3 mt-4 border-t-2 border-[#0A0A0A] text-xs bg-[#FBF8F3] p-3 rounded-lg border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
          <strong class="text-[#8B1E2D] font-head uppercase tracking-wider text-[11px] block mb-1">Sinergia Recomendada:</strong>
          <span class="text-gray-700 font-medium font-body">{m.sinergia}</span>
        </div>
      </div>
    ))}
  </div>
</div>
