---
// src/components/features/curriculum/timeline/MandatoryTimelineExplorer.astro — Linha do Tempo das 27 Obrigatórias
import { getCollection } from 'astro:content';
import { asset } from '../../../../lib/paths';

const allDisciplinas = await getCollection('disciplinas');
const mandatoryList = allDisciplinas
  .filter((d) => d.data.natureza === 'obrigatoria')
  .sort((a, b) => (a.data.periodo || 0) - (b.data.periodo || 0));

// Agrupar por período (1 a 10)
const periodsMap = new Map<number, typeof mandatoryList>();
for (let p = 1; p <= 10; p++) {
  periodsMap.set(p, []);
}
mandatoryList.forEach((d) => {
  const p = d.data.periodo || 1;
  const list = periodsMap.get(p) || [];
  list.push(d);
  periodsMap.set(p, list);
});
---

<div class="cagp-mandatory-timeline space-y-6 select-none text-foreground">
  <div class="p-5 bg-white border-[3px] border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">
    <div>
      <h3 class="font-head text-base sm:text-lg font-black text-foreground m-0">
        As 27 Disciplinas Obrigatórias (1.860h)
      </h3>
      <p class="font-body text-xs text-muted-foreground mt-0.5 m-0">
        Estrutura curricular sequencial dos 10 períodos letivos do turno noturno da FAFICH/UFMG.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={asset('/documentos/ementario-gestao-publica-ufmg.pdf')}
        download
        class="px-3.5 py-2 rounded-xl bg-secondary hover:bg-secondary-hover active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white font-mono text-xs font-bold transition-all inline-flex items-center gap-2 no-underline border-3 border-border shadow-sm"
      >
        <i class="bi bi-file-earmark-pdf" aria-hidden="true" />
        <span>Baixar Ementário Oficial (PDF)</span>
      </a>
      <span class="px-3 py-2 rounded-xl bg-foreground text-background text-white font-mono text-xs font-bold border-3 border-border shadow-sm shrink-0">
        27 Matérias • 124 Créditos
      </span>
    </div>
  </div>

  <div class="space-y-6">
    {Array.from(periodsMap.entries()).map(([period, courses]) => (
      <div class="p-5 bg-white border-[3px] border-border rounded-xl space-y-4 shadow-md">
        <div class="flex items-center justify-between border-b-2 border-border pb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-secondary text-white flex items-center justify-center font-head text-sm font-black border-3 border-border shadow-sm">
              {period}º
            </span>
            <h4 class="font-head text-base font-bold text-foreground m-0">
              {period}º Período Letivo
            </h4>
          </div>
          <span class="text-xs font-mono font-bold text-muted-foreground px-2.5 py-1 bg-white border border-border rounded-md shadow-xs">
            {courses.reduce((acc, c) => acc + c.data.ch, 0)}h ({courses.length} disciplinas)
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5 items-start" data-masonry>
          {courses.map((c) => (
            <div class="cagp-card p-4 bg-white border-2 border-border rounded-xl flex flex-col justify-between shadow hover:shadow-xs hover:translate-x-[1px] hover:translate-y-[1px] transition-all">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-mono text-xs font-bold text-secondary px-2 py-0.5 rounded-md bg-white border border-border shadow-xs">
                    {c.data.codigo}
                  </span>
                  <span class="text-xs font-mono text-muted-foreground font-bold">
                    {c.data.ch}h ({Math.round(c.data.ch / 15)} cr)
                  </span>
                </div>

                <h5 class="font-head text-sm font-bold uppercase text-foreground leading-snug m-0 mb-1.5">
                  {c.data.nome}
                </h5>

                {c.data.preRequisitos && c.data.preRequisitos.length > 0 && (
                  <div class="mb-2.5 p-2 bg-red-50 border border-secondary rounded-lg">
                    <span class="text-xs font-head uppercase font-bold text-secondary block">
                      Trava SIGA (Pré-requisito):
                    </span>
                    <span class="text-xs font-mono font-semibold text-foreground">
                      {c.data.preRequisitos.join(', ')}
                    </span>
                  </div>
                )}

                <!-- Ementa Oficial Completa e Expansível -->
                <div class="mt-2.5 pt-2 border-t-2 border-border">
                  <details class="cagp-ementa-details group">
                    <summary class="text-xs font-head uppercase font-bold text-secondary hover:text-foreground cursor-pointer flex items-center justify-between select-none min-h-[44px] py-1 px-1 list-none [&::-webkit-details-marker]:hidden">
                      <span>Ementa Oficial (PPC / DCP)</span>
                      <span class="inline-flex items-center gap-1 text-xs font-mono text-muted-foreground">
                        Ler completa
                        <i class="bi bi-chevron-down text-xs cagp-expand-chevron" aria-hidden="true"></i>
                      </span>
                    </summary>
                    <p class="font-body text-xs text-muted-foreground leading-relaxed mt-2 mb-0 select-text bg-white p-2.5 border border-border rounded-lg">
                      {c.data.ementa}
                    </p>
                  </details>
                </div>
              </div>

              <div class="pt-2.5 mt-3 border-t-2 border-border flex items-center justify-between text-xs font-mono text-muted-foreground">
                <span class="font-bold">{c.data.modulo || 'DCP'}</span>
                <span class="font-bold text-secondary uppercase px-1.5 py-0.5 bg-teal-700/10 border border-secondary rounded">Obrigatória</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
