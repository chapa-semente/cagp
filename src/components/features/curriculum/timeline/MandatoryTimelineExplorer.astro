---
// src/components/features/curriculum/timeline/MandatoryTimelineExplorer.astro — Linha do Tempo das 27 Obrigatórias
import { getCollection } from 'astro:content';
import { asset } from '../../../../lib/paths';

const allDisciplinas = await getCollection('disciplinas');
const mandatoryList = allDisciplinas
  .filter((d) => d.data.natureza === 'obrigatoria')
  .sort((a, b) => (a.data.periodo || 0) - (b.data.periodo || 0));

// Agrupar por período (1 a 10)
const periodsMap = new Map<number, typeof mandatoryList>();
for (let p = 1; p <= 10; p++) {
  periodsMap.set(p, []);
}
mandatoryList.forEach((d) => {
  const p = d.data.periodo || 1;
  const list = periodsMap.get(p) || [];
  list.push(d);
  periodsMap.set(p, list);
});
---

<div class="cagp-mandatory-timeline space-y-6 select-none text-[#0A0A0A]">
  <div class="p-5 bg-white border-[3px] border-[#0A0A0A] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-[4px_4px_0_0_#0A0A0A]">
    <div>
      <span class="text-[11px] font-head uppercase font-bold tracking-wider text-[#9E2424]">
        Núcleo Específico Obrigatório
      </span>
      <h3 class="font-head text-base sm:text-lg font-black uppercase text-[#0A0A0A] m-0">
        As 27 Disciplinas Obrigatórias (1.860h)
      </h3>
      <p class="font-body text-xs text-[#57534E] mt-0.5 m-0">
        Estrutura curricular sequencial dos 10 períodos letivos do turno noturno da FAFICH/UFMG.
      </p>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <a
        href={asset('/documentos/ementario-gestao-publica-ufmg.pdf')}
        download
        class="px-3.5 py-2 rounded-xl bg-[#9E2424] hover:bg-[#851E1E] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white font-mono text-xs font-bold transition-all inline-flex items-center gap-2 no-underline border-2 border-[#0A0A0A] shadow-[2.5px_2.5px_0_0_#0A0A0A]"
      >
        <i class="bi bi-file-earmark-pdf" aria-hidden="true" />
        <span>Baixar Ementário Oficial (PDF)</span>
      </a>
      <span class="px-3 py-2 rounded-xl bg-[#0A0A0A] text-white font-mono text-xs font-bold border-2 border-[#0A0A0A] shadow-[2.5px_2.5px_0_0_#0A0A0A] shrink-0">
        27 Matérias • 124 Créditos
      </span>
    </div>
  </div>

  <div class="space-y-6">
    {Array.from(periodsMap.entries()).map(([period, courses]) => (
      <div class="p-5 bg-[#FBF8F3] border-[3px] border-[#0A0A0A] rounded-xl space-y-4 shadow-[4px_4px_0_0_#0A0A0A]">
        <div class="flex items-center justify-between border-b-2 border-[#0A0A0A] pb-3">
          <div class="flex items-center gap-2.5">
            <span class="w-8 h-8 rounded-lg bg-[#9E2424] text-white flex items-center justify-center font-head text-sm font-black border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A]">
              {period}º
            </span>
            <h4 class="font-head text-base font-bold uppercase text-[#0A0A0A] m-0">
              {period}º Período Letivo
            </h4>
          </div>
          <span class="text-xs font-mono font-bold text-[#57534E] px-2.5 py-1 bg-white border border-[#0A0A0A] rounded-md shadow-[1px_1px_0_0_#0A0A0A]">
            {courses.reduce((acc, c) => acc + c.data.ch, 0)}h ({courses.length} disciplinas)
          </span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3.5">
          {courses.map((c) => (
            <div class="cagp-card p-4 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col justify-between shadow-[3px_3px_0_0_#0A0A0A] hover:shadow-[1.5px_1.5px_0_0_#0A0A0A] hover:translate-x-[1px] hover:translate-y-[1px] transition-all">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="font-mono text-xs font-bold text-[#9E2424] px-2 py-0.5 rounded-md bg-[#FBF8F3] border border-[#0A0A0A] shadow-[1px_1px_0_0_#0A0A0A]">
                    {c.data.codigo}
                  </span>
                  <span class="text-[11px] font-mono text-[#57534E] font-bold">
                    {c.data.ch}h ({Math.round(c.data.ch / 15)} cr)
                  </span>
                </div>

                <h5 class="font-head text-sm font-bold uppercase text-[#0A0A0A] leading-snug m-0 mb-1.5">
                  {c.data.nome}
                </h5>

                {c.data.preRequisitos && c.data.preRequisitos.length > 0 && (
                  <div class="mb-2.5 p-2 bg-red-50 border border-[#9E2424] rounded-lg">
                    <span class="text-[10px] font-head uppercase font-bold text-[#9E2424] block">
                      Trava SIGA (Pré-requisito):
                    </span>
                    <span class="text-[11px] font-mono font-semibold text-[#0A0A0A]">
                      {c.data.preRequisitos.join(', ')}
                    </span>
                  </div>
                )}

                <!-- Ementa Oficial Completa e Expansível -->
                <div class="mt-2.5 pt-2 border-t-2 border-[#0A0A0A]/20">
                  <details class="cagp-ementa-details group">
                    <summary class="text-[11px] font-head uppercase font-bold text-[#9E2424] hover:text-[#0A0A0A] cursor-pointer flex items-center justify-between select-none min-h-[36px] py-1 px-1">
                      <span>Ementa Oficial (PPC / DCP)</span>
                      <span class="text-[10px] font-mono text-[#57534E] group-open:hidden">Ler completa ▼</span>
                      <span class="text-[10px] font-mono text-[#57534E] hidden group-open:inline">Recolher ▲</span>
                    </summary>
                    <p class="font-body text-xs text-[#292524] leading-relaxed mt-2 mb-0 select-text bg-[#FBF8F3] p-2.5 border border-[#0A0A0A] rounded-lg">
                      {c.data.ementa}
                    </p>
                  </details>
                </div>
              </div>

              <div class="pt-2.5 mt-3 border-t-2 border-[#0A0A0A]/20 flex items-center justify-between text-[11px] font-mono text-[#57534E]">
                <span class="font-bold">{c.data.modulo || 'DCP'}</span>
                <span class="font-bold text-[#266264] uppercase px-1.5 py-0.5 bg-[#266264]/10 border border-[#266264] rounded">Obrigatória</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>
