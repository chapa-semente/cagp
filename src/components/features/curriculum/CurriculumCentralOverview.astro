---
// src/components/features/curriculum/CurriculumCentralOverview.astro — Visão Geral da Central Curricular & Grafo 10P (Padrão Dossiê Tátil)
import { CurriculumGraphWidget } from './graph/CurriculumGraphWidget';
import { CurriculumDossierWidget } from './dossie/CurriculumDossierWidget';
import { AcgCalculatorWidget } from '../acg/calculator/AcgCalculatorWidget';
import CagpIcon from '@/components/ui/CagpIcon.astro';
import { route, asset } from '@/lib/paths';

const percursos = [
  {
    codigo: '01-01',
    nome: 'Bacharelado com Núcleo Geral',
    slug: 'percurso-bacharelado-nucleo-geral',
    badge: 'Vínculo Automático no 1ºP',
    badgeVariant: 'green' as const,
    desc: 'Percurso canônico da FAFICH/UFMG. Proporciona formação sólida e generalista em gestão pública, finanças e ciência política, com máxima autonomia na escolha de matérias optativas.',
    obrig: '1.560h (25 disciplinas) + 300h Estágio (A + B)',
    opt: '1.020h optativas (DCP/Extensão/AAC) + 120h Livre',
    pdf: '/documentos/percurso-bacharelado-nucleo-geral.pdf',
    size: '166 KB',
  },
  {
    codigo: '01-02',
    nome: 'Núcleo Complementar (Transversal / Aberta)',
    slug: 'percurso-bacharelado-nucleo-complementar',
    badge: 'Opção no 4ºP para o 5ºP+',
    badgeVariant: 'red' as const,
    desc: 'Permite cursar 300 horas em Formação Transversal (Direitos Humanos, Relações Étnico-Raciais, Meio Ambiente) ou Formação Complementar Aberta (FCA) em outro departamento da UFMG.',
    obrig: '300h dedicadas à área interdisciplinar certificada',
    opt: 'Optativas DCP reduzidas de 1.020h para 720h (-300h)',
    pdf: '/documentos/percurso-bacharelado-nucleo-complementar.pdf',
    size: '167 KB',
  },
  {
    codigo: '01-03',
    nome: 'Núcleo Avançado (Articulação com Pós-Graduação)',
    slug: 'percurso-bacharelado-nucleo-avancado',
    badge: 'Opção no 4ºP para o 7ºP+',
    badgeVariant: 'blue' as const,
    desc: 'Destinado a discentes com vocação para pesquisa e carreira acadêmica. Permite cursar entre 45h e 120h em disciplinas de Mestrado/Doutorado no PPGCP/FAFICH ainda na graduação.',
    obrig: '45h a 120h com aproveitamento formal no mestrado',
    opt: 'Optativas DCP de 900h a 975h + 120h Livre',
    pdf: '/documentos/percurso-bacharelado-nucleo-avancado.pdf',
    size: '167 KB',
  },
];
---

<div class="cagp-curriculum-central-overview space-y-6 select-none text-foreground">
  <!-- Apresentação da Central Curricular -->
  <div class="p-6 bg-white border-[3px] border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">
    <div class="flex items-start gap-3.5">
      <span class="w-12 h-12 rounded-xl bg-teal-700 text-white flex items-center justify-center shrink-0 mt-0.5 border-2 border-border shadow-sm">
        <CagpIcon name="curriculo" class="w-6 h-6" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-head uppercase font-bold tracking-wider text-secondary">
            A grade em 10 períodos
          </span>
          <span class="text-foreground font-bold">•</span>
          <span class="text-xs text-muted-foreground font-mono">3.000 horas de integralização</span>
        </div>
        <h2 class="font-head text-lg sm:text-xl font-black text-foreground leading-tight m-0">
          27 Obrigatórias, 68 Optativas, 120h Livres, Estágio e TCC
        </h2>
        <p class="font-body text-xs text-muted-foreground mt-1 max-w-3xl leading-relaxed m-0">
          Navegue pela matriz de 10 semestres, adicione disciplinas optativas diretamente nas colunas do Grafo e monitore o seu progresso rumo à colação de grau.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <a
        href={asset('/documentos/ementario-gestao-publica-ufmg.pdf')}
        download
        class="min-h-[44px] px-4 py-2 bg-white hover:bg-secondary hover:text-white border-3 border-border rounded-xl text-xs font-head uppercase font-bold text-foreground inline-flex items-center gap-2 transition-all no-underline shadow-sm active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
      >
        <CagpIcon name="file-text" class="w-4 h-4 text-secondary" />
        <span>Ementário Geral (PDF)</span>
      </a>
    </div>
  </div>

  <!-- Bento Grid de Widgets do Currículo -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <CurriculumGraphWidget client:load />
    <CurriculumDossierWidget client:load />
    <AcgCalculatorWidget client:load />
  </div>

  <!-- Os 3 Percursos Curriculares Oficiais -->
  <div class="p-6 bg-white border-[3px] border-border rounded-xl space-y-5 shadow-md">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b-2 border-border pb-3">
      <div>
        <h3 class="font-head text-base sm:text-lg font-black text-foreground m-0">
          Os 3 Percursos Formativos Oficiais
        </h3>
        <p class="m-0 mt-1 text-sm text-muted-foreground">Base: Regulamento do Curso, art. 3º, e PPC 2020.</p>
        <p class="font-body text-xs text-muted-foreground mt-0.5 m-0">
          Todo discente ingressa no Percurso 01-01 e pode optar no 4º período por direcionar sua carga optativa em Formação Complementar ou Pós-Graduação.
        </p>
      </div>
      <span class="px-3 py-1 rounded-lg bg-foreground text-background text-white font-mono text-xs font-bold border border-border self-start sm:self-auto shrink-0 shadow-xs">
        Versão N-20229
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      {percursos.map((p) => (
        <div class="p-5 bg-white border-2 border-border rounded-xl flex flex-col justify-between space-y-4 shadow">
          <div class="space-y-3">
            <div class="flex items-center justify-between gap-2 flex-wrap">
              <span class="font-mono text-xs font-bold px-2 py-0.5 rounded bg-foreground text-background text-white">
                {p.codigo}
              </span>
              <span class={`text-xs font-mono font-bold px-2.5 py-1 rounded-md border border-border shadow-xs ${
                p.badgeVariant === 'green' ? 'bg-teal-700 text-white' :
                p.badgeVariant === 'red' ? 'bg-secondary text-white' :
                'bg-primary text-white'
              }`}>
                {p.badge}
              </span>
            </div>

            <h4 class="font-head text-base font-bold text-foreground m-0 leading-snug">
              {p.nome}
            </h4>

            <p class="font-body text-xs text-muted-foreground leading-relaxed m-0">
              {p.desc}
            </p>

            <div class="pt-3 border-t-2 border-border space-y-1.5 text-xs">
              <div>
                <span class="font-bold text-foreground">Carga Obrigatória:</span>
                <span class="text-muted-foreground block font-mono">{p.obrig}</span>
              </div>
              <div>
                <span class="font-bold text-foreground">Flexibilidade:</span>
                <span class="text-muted-foreground block font-mono">{p.opt}</span>
              </div>
            </div>
          </div>

          <div class="pt-3 border-t-2 border-border flex flex-wrap gap-2">
            <a
              href={route(`/documentos/${p.slug}`)}
              class="flex-1 min-h-[40px] px-3 py-2 bg-white hover:bg-foreground text-background hover:text-white border-3 border-border rounded-xl text-xs font-head uppercase font-bold text-foreground inline-flex items-center justify-center gap-1.5 transition-all no-underline text-center shadow-sm active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
            >
              <CagpIcon name="thesis" class="w-3.5 h-3.5" />
              <span>Matriz Web</span>
            </a>
            <a
              href={asset(p.pdf)}
              download
              class="flex-1 min-h-[40px] px-3 py-2 bg-secondary hover:bg-secondary-hover active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl text-xs font-mono font-bold inline-flex items-center justify-center gap-1.5 transition-all no-underline text-center border-3 border-border shadow-sm"
            >
              <CagpIcon name="download" class="w-3.5 h-3.5" />
              <span>PDF ({p.size})</span>
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Requerimentos de Mudança de Percurso no DRCA -->
    <div class="p-4 bg-white border-2 border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-sm">
      <div class="flex items-center gap-3">
        <span class="w-10 h-10 rounded-xl bg-foreground text-background text-white flex items-center justify-center shrink-0 border border-border shadow-xs">
          <CagpIcon name="sliders" class="w-4 h-4" />
        </span>
        <div>
          <h4 class="font-head text-xs font-bold text-foreground m-0">
            Formulários Oficiais do DRCA para Mudança de Percurso
          </h4>
          <p class="font-body text-xs text-muted-foreground m-0">
            Protocolo semestral junto ao DRCA e ao Colegiado de Gestão Pública para alteração formal de percurso curricular.
          </p>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 shrink-0">
        <a
          href={asset('/documentos/requerimento-mudanca-percurso-curricular-drca.pdf')}
          download
          class="min-h-[40px] px-3.5 py-2 bg-white hover:bg-foreground text-background hover:text-white border-3 border-border rounded-xl text-xs font-mono font-bold text-foreground inline-flex items-center gap-2 transition-all no-underline shadow-sm active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
        >
          <CagpIcon name="download" class="w-3.5 h-3.5 text-secondary" />
          <span>Mudança de Percurso DRCA (PDF)</span>
        </a>
        <a
          href={asset('/documentos/requerimento-mudanca-percurso-modalidade-habilitacao-enfase.pdf')}
          download
          class="min-h-[40px] px-3.5 py-2 bg-white hover:bg-foreground text-background hover:text-white border-3 border-border rounded-xl text-xs font-mono font-bold text-foreground inline-flex items-center gap-2 transition-all no-underline shadow-sm active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
        >
          <CagpIcon name="download" class="w-3.5 h-3.5 text-secondary" />
          <span>Modalidade / Habilitação (PDF)</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Formação Complementar Aberta (FCA) e Formação Transversal -->
  <div class="p-6 bg-white border-[3px] border-border rounded-xl space-y-5 shadow-md">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b-2 border-border pb-3">
      <div>
        <h3 class="font-head text-base sm:text-lg font-black text-foreground m-0">
          Formação Complementar Aberta (FCA) &amp; Formações Transversais (300h)
        </h3>
        <p class="font-body text-xs text-muted-foreground mt-0.5 m-0">
          O Percurso 01-02 permite integralizar 300h em pacotes curriculares certificados em outros departamentos da UFMG ou em grandes áreas temáticas institucionais.
        </p>
      </div>
      <span class="px-3 py-1 rounded-lg bg-primary text-white font-mono text-xs font-bold border border-border self-start sm:self-auto shrink-0 shadow-xs">
        300 Horas / 20 Créditos
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Card FCA -->
      <div class="p-5 bg-white border-2 border-border rounded-xl space-y-3.5 shadow">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-xl bg-primary text-white flex items-center justify-center border border-border shadow-xs">
              <CagpIcon name="curso" class="w-4 h-4" />
            </span>
            <h4 class="font-head text-sm font-bold text-foreground m-0">
              Formação Complementar Aberta (FCA)
            </h4>
          </div>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-primary-tint text-primary border border-primary">
            Res. 01/2016 e 01/2018
          </span>
        </div>
        <p class="font-body text-xs text-muted-foreground leading-relaxed m-0">
          Permite ao estudante de Gestão Pública montar um percurso personalizado de 300 horas cursando disciplinas em faculdades parceiras da UFMG (Direito, FACE/Economia/Administração, ECI/Ciência da Informação, ICEx, Belas Artes, etc.), mediante aprovação prévia de plano de estudos pelo Colegiado.
        </p>
        <div class="pt-3 border-t-2 border-border flex flex-wrap gap-2">
          <a
            href={asset('/documentos/fca-formacao-complementar-aberta.pdf')}
            download
            class="min-h-[38px] px-3.5 py-1.5 bg-white hover:bg-primary hover:text-white border-3 border-border rounded-xl text-xs font-mono font-bold text-foreground inline-flex items-center gap-1.5 transition-all no-underline shadow-sm active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
          >
            <CagpIcon name="file-text" class="w-3.5 h-3.5 text-primary" />
            <span>Guia FCA (PDF - 62 KB)</span>
          </a>
          <a
            href={asset('/documentos/requerimento-formacao-complementar-aberta-fca.pdf')}
            download
            class="min-h-[38px] px-3.5 py-1.5 bg-primary hover:bg-primary-hover text-white rounded-xl text-xs font-mono font-bold inline-flex items-center gap-1.5 transition-all no-underline border-3 border-border shadow-sm active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
          >
            <CagpIcon name="download" class="w-3.5 h-3.5" />
            <span>Requerimento FCA (PDF - 90 KB)</span>
          </a>
        </div>
      </div>

      <!-- Card Formação Transversal -->
      <div class="p-5 bg-white border-2 border-border rounded-xl space-y-3.5 shadow">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-xl bg-teal-700 text-white flex items-center justify-center border border-border shadow-xs">
              <CagpIcon name="curriculo" class="w-4 h-4" />
            </span>
            <h4 class="font-head text-sm font-bold text-foreground m-0">
              Formações Transversais da UFMG
            </h4>
          </div>
          <span class="text-xs font-mono font-bold px-2 py-0.5 rounded-md bg-teal-700/10 text-secondary border border-secondary">
            Res. CEPE 19/2014
          </span>
        </div>
        <p class="font-body text-xs text-muted-foreground leading-relaxed m-0">
          Formações interdisciplinares temáticas estruturadas pela Pró-Reitoria de Graduação (PROGRAD): <em>Direitos Humanos</em>, <em>Relações Étnico-Raciais e Gênero</em>, <em>Meio Ambiente e Sustentabilidade</em>, <em>Divulgação Científica</em>, entre outras.
        </p>
        <div class="pt-3 border-t-2 border-border flex flex-wrap gap-2">
          <a
            href={asset('/documentos/resolucao-cepe-19-2014-formacao-transversal.pdf')}
            download
            class="min-h-[38px] px-3.5 py-1.5 bg-white hover:bg-teal-700 hover:text-white border-3 border-border rounded-xl text-xs font-mono font-bold text-foreground inline-flex items-center gap-1.5 transition-all no-underline shadow-sm active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
          >
            <CagpIcon name="file-text" class="w-3.5 h-3.5 text-secondary" />
            <span>Resolução CEPE 19/2014 (PDF)</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Formação Livre (120h) & Pós-Graduação (PPGCP) -->
  <div class="p-6 bg-white border-[3px] border-border rounded-xl space-y-5 shadow-md">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b-2 border-border pb-3">
      <div>
        <h3 class="font-head text-base sm:text-lg font-black text-foreground m-0">
          Formação Livre (120h) &amp; Matrícula na Pós-Graduação (PPGCP)
        </h3>
        <p class="m-0 mt-1 text-sm text-muted-foreground">Base: PPC, art. 13, e Regulamento, art. 3º.</p>
        <p class="font-body text-xs text-muted-foreground mt-0.5 m-0">
          Documentos e requerimentos para cursar disciplinas fora da FAFICH ou disciplinas adiantadas de mestrado/doutorado.
        </p>
      </div>
      <span class="px-3 py-1 rounded-lg bg-accent text-foreground font-mono text-xs font-bold border border-border self-start sm:self-auto shrink-0 shadow-xs">
        120h Livre • Até 120h Pós
      </span>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div class="p-5 bg-white border-2 border-border rounded-xl space-y-3.5 shadow">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-accent-tint text-accent flex items-center justify-center shrink-0 border border-accent">
            <CagpIcon name="bolt" class="w-4 h-4" />
          </span>
          <div>
            <h4 class="font-head text-xs font-bold text-foreground m-0">
              Formação Livre (120h • 8 Créditos)
            </h4>
            <p class="font-body text-xs text-muted-foreground m-0">
              Direito regulamentar garantido a todo discente no PPC Art. 13.
            </p>
          </div>
        </div>
        <p class="font-body text-xs text-muted-foreground leading-relaxed m-0">
          Você tem direito a cursar até 120 horas em qualquer departamento da UFMG (Direito, Economia, Ciência da Informação, Engenharia, Belas Artes, etc.). Matrícula realizada na 3ª Fase do SIGA ou por acerto com o formulário oficial.
        </p>
        <div class="pt-3 border-t-2 border-border flex flex-wrap gap-2">
          <a
            href={asset('/documentos/requerimento-matricula-formacao-livre.pdf')}
            download
            class="min-h-[38px] px-3.5 py-1.5 bg-accent hover:bg-accent-hover active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-foreground rounded-xl text-xs font-mono font-bold inline-flex items-center gap-1.5 transition-all no-underline border-3 border-border shadow-sm"
          >
            <CagpIcon name="download" class="w-3.5 h-3.5" />
            <span>Requerimento Formação Livre (PDF)</span>
          </a>
          <a
            href="#grafo"
            class="min-h-[38px] px-3.5 py-1.5 bg-white hover:bg-foreground text-background hover:text-white border-3 border-border rounded-xl text-xs font-head uppercase font-bold text-foreground inline-flex items-center gap-1.5 transition-all no-underline shadow-sm active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
          >
            <CagpIcon name="curriculo" class="w-3.5 h-3.5 text-accent" />
            <span>Inserir no Grafo 10P</span>
          </a>
        </div>
      </div>

      <div class="p-5 bg-white border-2 border-border rounded-xl space-y-3.5 shadow">
        <div class="flex items-center gap-3">
          <span class="w-9 h-9 rounded-xl bg-primary-tint text-primary flex items-center justify-center shrink-0 border border-primary">
            <CagpIcon name="curso" class="w-4 h-4" />
          </span>
          <div>
            <h4 class="font-head text-xs font-bold text-foreground m-0">
              Matrícula na Pós-Graduação (PPGCP)
            </h4>
            <p class="font-body text-xs text-muted-foreground m-0">
              Percurso 01-03 (Núcleo Avançado) ou disciplinas isoladas de mestrado.
            </p>
          </div>
        </div>
        <p class="font-body text-xs text-muted-foreground leading-relaxed m-0">
          Discentes de alto rendimento a partir do 7º período podem requerer autorização do Colegiado e da Coordenação do PPGCP para cursar disciplinas do mestrado, com aproveitamento integral para futura pós-graduação.
        </p>
        <div class="pt-3 border-t-2 border-border flex flex-wrap gap-2">
          <a
            href={asset('/documentos/requerimento-matricula-pos-graduacao.pdf')}
            download
            class="min-h-[38px] px-3.5 py-1.5 bg-primary hover:bg-primary-hover active:translate-x-[2px] active:translate-y-[2px] active:shadow-none text-white rounded-xl text-xs font-mono font-bold inline-flex items-center gap-1.5 transition-all no-underline border-3 border-border shadow-sm"
          >
            <CagpIcon name="download" class="w-3.5 h-3.5" />
            <span>Requerimento Matrícula Pós (PDF)</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
