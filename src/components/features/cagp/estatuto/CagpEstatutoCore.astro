---
// src/components/features/cagp/estatuto/CagpEstatutoCore.astro — Regimento Interno de 14/10/2024 e Instâncias Deliberativas
import SobreGovernanca from '@/components/features/cagp/SobreGovernanca.astro';
import SobreEsferas from '@/components/features/cagp/SobreEsferas.astro';
---

<div class="cagp-estatuto-core space-y-6 select-none text-foreground">
  <div class="p-5 bg-white border-[3px] border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-md">
    <div>
      <h3 class="font-head text-base font-extrabold text-foreground m-0">
        Governança, Instâncias Deliberativas e Estatuto
      </h3>
      <p class="m-0 mt-1 text-sm text-muted-foreground">Regimento Interno aprovado em 14/10/2024.</p>
      <p class="text-xs font-body text-foreground font-medium mt-1 m-0">
        Estrutura de poder baseada na soberania da Assembleia Geral e participação democrática discente.
      </p>
    </div>
    <span class="px-3 py-1 rounded-lg bg-primary text-white font-mono text-xs font-bold border-3 border-border shadow-sm shrink-0">
      Estatuto Vigente
    </span>
  </div>

  <SobreGovernanca />
  <SobreEsferas />
</div>
