---
// src/components/features/cagp/CagpCentralOverview.astro — Visão Geral do Eixo 5 (O CAGP)
import { asset, route } from '@/lib/paths';
---

<div class="cagp-central-overview space-y-6 select-none text-foreground">
  {/* Apresentação do CAGP */}
  <div class="p-5 bg-white border-[3px] border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">
    <div class="flex items-start gap-4">
      <span class="w-12 h-12 rounded-xl bg-secondary text-white flex items-center justify-center text-2xl shrink-0 border-3 border-border shadow-sm">
        <i class="bi bi-people-fill" aria-hidden="true" />
      </span>
      <div>
        <div class="flex items-center gap-2 mb-1">
          <span class="text-xs font-head uppercase font-extrabold tracking-wider text-secondary">
            Entidade Oficial de Representação Discente
          </span>
          <span class="text-foreground">•</span>
          <span class="text-xs text-foreground font-mono font-bold">FAFICH / UFMG</span>
        </div>
        <h2 class="font-head text-lg sm:text-xl font-extrabold text-foreground leading-tight m-0">
          Centro Acadêmico de Gestão Pública (CAGP)
        </h2>
        <p class="text-xs font-body text-foreground font-medium mt-1.5 max-w-3xl leading-relaxed m-0">
          Entidade autônoma fundada nos princípios da legalidade, moralidade e eficiência pública. Defesa intransigente do ensino noturno e da valorização do gestor público.
        </p>
      </div>
    </div>
  </div>

  {/* Bento Grid das 3 Dimensões */}
  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {/* Card 1: Princípios & História */}
    <div class="p-5 bg-white border-[3px] border-border rounded-xl flex flex-col justify-between h-full shadow-md hover:translate-x-[-1px] hover:translate-y-[-1px] transition-transform">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3 pb-3 border-b-2 border-border">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-lg bg-secondary text-white flex items-center justify-center text-lg border-3 border-border shadow-sm">
              <i class="bi bi-bank" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-head font-extrabold text-sm text-foreground leading-tight m-0">
                Princípios & História
              </h3>
              <span class="text-xs text-foreground font-mono font-bold">Os Candangos FAFICH</span>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-lg font-head text-xs font-extrabold uppercase bg-secondary text-white border-3 border-border shadow-sm">
            Origem
          </span>
        </div>
        <p class="text-xs font-body text-foreground leading-relaxed mb-4">
          A história da criação do curso, o espírito candango de construção coletiva e a aplicação prática do Art. 37 da Constituição Federal.
        </p>
      </div>

      <a
        href="#principios"
        class="min-h-[44px] px-3.5 py-2.5 bg-foreground text-background hover:bg-secondary text-white rounded-xl font-head text-xs uppercase font-extrabold tracking-wider flex items-center justify-center gap-2 border-3 border-border shadow hover:shadow-md active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all no-underline"
      >
        <span>Conhecer Princípios</span>
        <i class="bi bi-arrow-right" aria-hidden="true" />
      </a>
    </div>

    {/* Card 2: Governança & Estatuto */}
    <div class="p-5 bg-white border-[3px] border-border rounded-xl flex flex-col justify-between h-full shadow-md hover:translate-x-[-1px] hover:translate-y-[-1px] transition-transform">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3 pb-3 border-b-2 border-border">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-lg bg-primary text-white flex items-center justify-center text-lg border-3 border-border shadow-sm">
              <i class="bi bi-diagram-3-fill" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-head font-extrabold text-sm text-foreground leading-tight m-0">
                Governança & Estatuto
              </h3>
              <span class="text-xs text-foreground font-mono font-bold">Regimento 14/10/2024</span>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-lg font-head text-xs font-extrabold uppercase bg-primary text-white border-3 border-border shadow-sm">
            Estatuto
          </span>
        </div>
        <p class="text-xs font-body text-foreground leading-relaxed mb-4">
          Assembleia Geral soberana, Conselho de Representantes de Turma e rito democrático de eleições diretas.
        </p>
      </div>

      <a
        href="#governanca"
        class="min-h-[44px] px-3.5 py-2.5 bg-foreground text-background hover:bg-secondary text-white rounded-xl font-head text-xs uppercase font-extrabold tracking-wider flex items-center justify-center gap-2 border-3 border-border shadow hover:shadow-md active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all no-underline"
      >
        <span>Ver Governança</span>
        <i class="bi bi-arrow-right" aria-hidden="true" />
      </a>
    </div>

    {/* Card 3: Gestão & Transparência */}
    <div class="p-5 bg-white border-[3px] border-border rounded-xl flex flex-col justify-between h-full shadow-md hover:translate-x-[-1px] hover:translate-y-[-1px] transition-transform">
      <div>
        <div class="flex items-center justify-between gap-2 mb-3 pb-3 border-b-2 border-border">
          <div class="flex items-center gap-2.5">
            <span class="w-9 h-9 rounded-lg bg-teal-700 text-white flex items-center justify-center text-lg border-3 border-border shadow-sm">
              <i class="bi bi-people" aria-hidden="true" />
            </span>
            <div>
              <h3 class="font-head font-extrabold text-sm text-foreground leading-tight m-0">
                Eleições & Diretorias
              </h3>
              <span class="text-xs text-foreground font-mono font-bold">7 Diretorias Estatutárias</span>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded-lg font-head text-xs font-extrabold uppercase bg-secondary text-white border-3 border-border shadow-sm">
            Eleições
          </span>
        </div>
        <p class="text-xs font-body text-foreground leading-relaxed mb-4">
          Organograma regimental das 7 diretorias executivas, atribuições estatutárias e acompanhamento do processo eleitoral.
        </p>
      </div>

      <div class="flex items-center gap-2 pt-2 border-t-2 border-border">
        <a
          href={route('/transparencia')}
          class="flex-1 min-h-[44px] px-3 py-2 bg-secondary hover:bg-secondary text-white rounded-xl font-head text-xs uppercase font-extrabold tracking-wider flex items-center justify-center gap-1.5 border-3 border-border shadow hover:shadow-md active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all no-underline"
        >
          <span>Transparência</span>
        </a>
        <a
          href={route('/gestao')}
          class="min-h-[44px] px-3.5 py-2 bg-white hover:bg-muted text-foreground border-3 border-border rounded-xl text-xs font-head uppercase font-extrabold flex items-center justify-center shadow-sm hover:shadow active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all no-underline"
          title="Ver página de Diretorias & Gestão Discente"
        >
          <span>Diretorias</span>
        </a>
      </div>
    </div>
  </div>

  {/* Banner para Download dos Regimentos Interno e Geral */}
  <div class="p-5 bg-white border-[3px] border-border rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-md">
    <div class="flex items-center gap-3.5">
      <span class="w-11 h-11 rounded-xl bg-foreground text-background text-white flex items-center justify-center text-xl shrink-0 border-3 border-border shadow-sm">
        <i class="bi bi-file-earmark-pdf-fill" aria-hidden="true" />
      </span>
      <div>
        <h3 class="font-head text-sm font-extrabold text-foreground leading-tight m-0">
          Regimento Interno do CAGP & Regimento Geral da UFMG
        </h3>
        <p class="text-xs font-body text-foreground mt-1 m-0 font-medium">
          Estatuto formal aprovado pela Assembleia Geral dos Estudantes de Gestão Pública e normas institucionais da UFMG.
        </p>
      </div>
    </div>

    <div class="flex flex-wrap items-center gap-2.5 shrink-0">
      <a
        href={asset('/documentos/regimento-interno-cagp-ufmg.pdf')}
        download
        class="min-h-[44px] px-4 py-2.5 bg-secondary hover:bg-secondary text-white rounded-xl text-xs font-head uppercase font-extrabold tracking-wider flex items-center justify-center gap-2 border-3 border-border shadow hover:shadow-md active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all no-underline"
      >
        <i class="bi bi-download" aria-hidden="true" />
        <span>Regimento CAGP (PDF)</span>
      </a>
      <a
        href={asset('/documentos/regimento-geral-ufmg.pdf')}
        download
        class="min-h-[44px] px-4 py-2.5 bg-foreground text-background hover:bg-secondary text-white rounded-xl text-xs font-head uppercase font-extrabold tracking-wider flex items-center justify-center gap-2 border-3 border-border shadow hover:shadow-md active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all no-underline"
      >
        <i class="bi bi-building" aria-hidden="true" />
        <span>Regimento Geral UFMG</span>
      </a>
    </div>
  </div>
</div>
