---
// src/components/features/cagp/historia/CagpHistoriaCore.astro — Princípios Republicano e História dos Candangos
import SobrePrincipios from '../../../sobre/SobrePrincipios.astro';
---

<div class="cagp-historia-core space-y-6 select-none text-[#0A0A0A]">
  <div class="p-5 bg-white border-[3px] border-[#0A0A0A] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-[4px_4px_0_0_#0A0A0A]">
    <div>
      <span class="text-xs font-head uppercase font-extrabold tracking-wider text-[#8B1E2D]">
        História & Identidade Discente
      </span>
      <h3 class="font-head text-base font-extrabold uppercase text-[#0A0A0A] m-0 tracking-tight">
        Os Candangos e a Luta por Gestão Pública
      </h3>
      <p class="text-xs font-body text-[#0A0A0A] font-medium mt-1 m-0">
        Princípios constitucionais da administração pública aplicados à representação estudantil na FAFICH.
      </p>
    </div>
    <span class="px-3 py-1 rounded-lg bg-[#0A0A0A] text-white font-mono text-xs font-bold border-2 border-[#0A0A0A] shadow-[2px_2px_0_0_#0A0A0A] shrink-0">
      Desde 2009 na UFMG
    </span>
  </div>

  <SobrePrincipios />
</div>
