---
// src/components/features/cagp/historia/CagpHistoriaCore.astro — Princípios Republicano e História dos Candangos
import SobrePrincipios from '@/components/features/cagp/SobrePrincipios.astro';
---

<div class="cagp-historia-core space-y-6 select-none text-foreground">
  <div class="p-5 bg-white border-2 border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-3 shadow-xl">
    <div>
      <span class="text-xs font-head uppercase font-extrabold tracking-wider text-secondary">
        História &amp; Identidade Discente
      </span>
      <h3 class="font-head text-base font-extrabold text-foreground m-0">
        Os Candangos e a Luta por Gestão Pública
      </h3>
      <p class="text-xs font-body text-foreground font-medium mt-1 m-0">
        Princípios constitucionais da administração pública aplicados à representação estudantil na FAFICH.
      </p>
    </div>
    <span class="px-3 py-1.5 rounded-lg bg-foreground text-white font-mono text-xs font-bold border-3 border-border shadow-[3px_3px_0_0_#FE8812] shrink-0">
      Desde 2009 na UFMG
    </span>
  </div>

  <SobrePrincipios />
</div>
