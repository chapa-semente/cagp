---
// src/components/features/estagio/tce/EstagioTceWidget.astro — Widget de Resumo do TCE
import { asset } from '../../../../lib/paths';
---

<div class="cagp-card p-5 bg-white border-2 border-border rounded-xl flex flex-col justify-between h-full shadow hover:shadow-xs hover:translate-x-[1px] hover:translate-y-[1px] transition-all select-none">
  <div>
    <div class="flex items-center justify-between gap-2 mb-3.5">
      <div class="flex items-center gap-2.5">
        <span class="w-10 h-10 rounded-xl bg-primary-tint text-primary flex items-center justify-center text-lg border border-primary shadow-xs">
          <i class="bi bi-journal-text" aria-hidden="true" />
        </span>
        <div>
          <h3 class="font-head font-bold text-sm text-foreground leading-tight m-0">
            Termo de Estágio (TCE)
          </h3>
          <span class="text-xs text-muted-foreground font-mono">Lei nº 11.788/2008</span>
        </div>
      </div>
      <span class="px-2.5 py-1 rounded-md font-head text-xs font-bold bg-primary text-white border border-border shadow-xs">
        Modelos
      </span>
    </div>

    <p class="font-body text-xs text-muted-foreground leading-relaxed mb-3.5">
      Tutorial visual passo a passo para preenchimento do modelo oficial com interveniência da FAFICH/UFMG.
    </p>

    <div class="p-3 bg-white border border-border rounded-lg mb-4 flex items-center justify-between text-xs shadow-xs">
      <span class="text-muted-foreground font-medium">Modelos Oficiais:</span>
      <span class="font-mono font-bold text-foreground">PDF & DOCX</span>
    </div>
  </div>

  <div class="flex items-center gap-2 pt-3 border-t-2 border-border">
    <a
      href="#tutorial"
      class="flex-1 min-h-[44px] px-4 py-2.5 bg-primary hover:bg-primary-hover text-white rounded-xl font-head text-xs uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline border-3 border-border shadow-sm active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
    >
      <span>Ver Tutorial TCE</span>
      <i class="bi bi-arrow-right" aria-hidden="true" />
    </a>
    <a
      href={asset('/documentos/estagio-modelo-termo-de-compromisso-com-convenio.pdf')}
      download
      class="min-h-[44px] min-w-[44px] px-3 py-2 bg-white hover:bg-surface-hover text-foreground border-3 border-border rounded-xl flex items-center justify-center transition-all no-underline shrink-0 shadow-sm active:translate-x-[1px] active:translate-y-[1px] active:shadow-none"
      title="Baixar Modelo de TCE em PDF"
      aria-label="Baixar Modelo de TCE em PDF"
    >
      <i class="bi bi-file-earmark-pdf-fill text-primary text-lg" aria-hidden="true" />
    </a>
  </div>
</div>
