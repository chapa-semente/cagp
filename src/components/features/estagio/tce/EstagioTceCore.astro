---
// src/components/features/estagio/tce/EstagioTceCore.astro — Tutorial Visual do Termo de Compromisso de Estágio (TCE) & Matriz Oficial de Modelos
import { asset } from '../../../../lib/paths';
import { EstagioTceWizard } from './EstagioTceWizard';

const etapasTCE = [
  {
    num: 1,
    titulo: '1. Dados da Entidade Concedente',
    icon: 'bi-building',
    desc: 'Preencha a Razão Social completa, CNPJ, endereço oficial do órgão concedente (ministério, secretaria, fundação, ONG ou empresa conveniada) e os dados do representante legal signatário.',
  },
  {
    num: 2,
    titulo: '2. Identificação Acadêmica do Discente',
    icon: 'bi-person-vcard',
    desc: 'Insira seus dados cadastrais (CPF, RG, endereço) e declare expressamente o curso como Bacharelado em Gestão Pública, o turno Noturno e o número de matrícula no SIGA.',
  },
  {
    num: 3,
    titulo: '3. Interveniência Institucional FAFICH/UFMG',
    icon: 'bi-bank',
    desc: 'Identifique a Faculdade de Filosofia e Ciências Humanas e o Colegiado de Gestão Pública. A assinatura é firmada pela Coordenação do Curso em conjunto com o docente orientador do DCP.',
  },
  {
    num: 4,
    titulo: '4. Plano de Atividades & Seguro Obrigatório',
    icon: 'bi-shield-shaded',
    desc: 'Anexe o Plano de Atividades com tarefas compatíveis com o perfil de Gestão Pública e informe a apólice do Seguro contra Acidentes Pessoais contratada pela concedente (Lei nº 11.788/2008).',
  },
];

const formulariosGoogle = [
  {
    titulo: 'Solicitação Inicial de Estágio',
    desc: 'Envio do Termo de Compromisso (TCE) e Plano de Atividades para homologação da Coordenação.',
    link: 'https://docs.google.com/forms/d/e/1FAIpQLScnRdWYJDa4yERPesbL4IZ-Atk2uPBE4ihR2ht9ho0mIeumMQ/viewform',
    badge: 'Início de Estágio',
  },
  {
    titulo: 'Protocolo de Aproveitamento Servidor (Art. 41)',
    desc: 'Submissão de processo para dispensa das 300h com base em exercício profissional na administração pública ou OSC.',
    link: 'https://docs.google.com/forms/d/e/1FAIpQLSdIGMGFzJMsnyLTvkDTDVPQddU37S_OO1ABuQbMv5F3wElKLA/viewform',
    badge: 'Aproveitamento Servidor',
  },
];

const modelosEstagio = [
  {
    titulo: 'Plano de Atividades de Estágio (PAE)',
    desc: 'Cronograma e plano assinado para deferimento prévio no Colegiado.',
    pdf: 'estagio-modelo-plano-de-atividades.pdf',
    docx: 'estagio-modelo-plano-de-atividades.docx',
    gdoc: 'https://docs.google.com/document/d/100ECMbDcwXjIUojwU6WwcN0eWN72NIjI/edit',
  },
  {
    titulo: 'Termo de Compromisso com Convênio',
    desc: 'Modelo padrão para concedentes com convênio ativo formal com a UFMG.',
    pdf: 'estagio-modelo-termo-de-compromisso-com-convenio.pdf',
    docx: 'estagio-modelo-termo-de-compromisso-com-convenio.docx',
    gdoc: 'https://docs.google.com/document/d/1bzFYhmoGkgcEnBwMqSDBlENP-r2ke1X_/edit',
  },
  {
    titulo: 'Termo de Compromisso sem Vínculo Prévio',
    desc: 'Minuta para celebração com empresas via agentes integradores de estágio.',
    pdf: 'estagio-modelo-termo-de-compromisso-sem-vinculo.pdf',
    docx: 'estagio-modelo-termo-de-compromisso-sem-vinculo.docx',
    gdoc: 'https://docs.google.com/document/d/19-Elm9v0ztx3sWgwPsRGB-NuaxoaByI4/edit',
  },
  {
    titulo: 'Relatório Semestral de Estágio',
    desc: 'Acompanhamento periódico exigido a cada 6 meses de vigência do estágio.',
    pdf: 'estagio-modelo-relatorio-semestral.pdf',
    docx: 'estagio-modelo-relatorio-semestral.docx',
    gdoc: 'https://docs.google.com/document/d/1SNyHiDvFQocVO5W6FiJIBtomJasQis_d/edit',
  },
  {
    titulo: 'Relatório Final de Estágio Supervisionado',
    desc: 'Entrega final para integralização de créditos de DCP 135 ou DCP 136.',
    pdf: 'estagio-modelo-relatorio-final.pdf',
    docx: 'estagio-modelo-relatorio-final.docx',
    gdoc: 'https://docs.google.com/document/d/1fB4afw-U3ODnZrkOjk9R5q3-a8qYNtVV/edit',
  },
  {
    titulo: 'Requerimento de Aproveitamento Servidor (Art. 41)',
    desc: 'Protocolo de integralização de 300h com base em cargo público efetivo, comissionado ou celetista.',
    pdf: 'estagio-requerimento-integralizacao-experiencia-profissional.pdf',
    docx: 'estagio-requerimento-integralizacao-experiencia-profissional.docx',
    gdoc: 'https://docs.google.com/document/d/1QJJ8wLISxpztQFH--V2aYm8-509D6_418o14zSfxbe4/edit',
  },
  {
    titulo: 'Relatório de Atividades — Aproveitamento Servidor (Art. 41)',
    desc: 'Memorial descritivo das atribuições laborais para instrução da comissão avaliadora.',
    pdf: 'estagio-relatorio-atividades-experiencia-profissional.pdf',
    docx: 'estagio-relatorio-atividades-experiencia-profissional.docx',
    gdoc: 'https://docs.google.com/document/d/1Uc3oHwEBM9zbf9tJ2q5N80YPQme3niFh/edit',
  },
];

const normasEstagio = [
  { titulo: 'Manual de Orientações de Estágio FAFICH', desc: 'Diretrizes do Setor de Estágios e fluxos de assinatura.', file: 'estagio-manual-orientacoes-fafich.pdf' },
  { titulo: 'Resolução GP nº 01/2019 (Colegiado)', desc: 'Regulamentação do estágio supervisionado de Gestão Pública.', file: 'resolucao-01-2019-estagio-curricular.pdf' },
  { titulo: 'Resolução CEPE nº 02/2009 (UFMG)', desc: 'Normas gerais de estágio da Universidade Federal de Minas Gerais.', file: 'resolucao-cepe-02-2009-estagio-ufmg.pdf' },
];
---

<div class="cagp-estagio-tce space-y-6 select-none text-foreground">
  {/* Cabeçalho */}
  <div class="p-6 bg-white border-3 border-[#16181d] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-[4px_4px_0_0_#16181d]">
    <div>
      <span class="text-[11px] font-head uppercase font-bold tracking-wider text-secondary">
        Guia Visual Passo a Passo
      </span>
      <h3 class="font-head text-base sm:text-lg font-black uppercase text-foreground m-0">
        Preenchimento do Termo de Compromisso de Estágio (TCE)
      </h3>
      <p class="font-body text-xs text-muted-foreground mt-0.5 m-0">
        Documento jurídico obrigatório pela Lei nº 11.788/2008 para formalizar Estágio Obrigatório ou Não-Obrigatório.
      </p>
    </div>

    <a
      href={asset('/documentos/estagio-modelo-termo-de-compromisso-com-convenio.pdf')}
      download
      class="min-h-[44px] px-4 py-2.5 bg-secondary hover:bg-[#851E1E] text-white rounded-xl text-xs font-head uppercase font-bold tracking-wider flex items-center justify-center gap-2 transition-all no-underline shrink-0 border-3 border-[#16181d] shadow-[3px_3px_0_0_#16181d] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none"
    >
      <i class="bi bi-file-earmark-arrow-down-fill" aria-hidden="true" />
      <span>Termo de Estágio (PDF)</span>
    </a>
  </div>

  {/* Protocolos Online: Google Forms Oficiais */}
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    {formulariosGoogle.map((f) => (
      <div class="p-5 bg-white border-3 border-[#16181d] rounded-xl flex flex-col justify-between shadow-[4px_4px_0_0_#16181d]">
        <div>
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="px-2.5 py-0.5 rounded-md bg-[#134E4A] text-white text-[10px] font-mono font-bold border border-[#16181d]">{f.badge}</span>
            <span class="text-[11px] text-muted-foreground font-mono font-bold">Google Forms Oficial</span>
          </div>
          <h4 class="font-head font-bold text-sm uppercase text-foreground m-0 mb-1">{f.titulo}</h4>
          <p class="font-body text-xs text-muted-foreground leading-snug m-0">{f.desc}</p>
        </div>
        <div class="mt-4 pt-3 border-t-2 border-border/20">
          <a
            href={f.link}
            target="_blank"
            rel="noopener noreferrer"
            class="min-h-[44px] cagp-btn-primary text-xs py-2.5 px-3 no-underline inline-flex items-center justify-center gap-2 w-full rounded-xl font-head font-bold uppercase border-3 border-[#16181d] shadow-[3px_3px_0_0_#16181d] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
          >
            <span>Preencher no Formulário Oficial</span>
            <i class="bi bi-box-arrow-up-right text-[10px]" aria-hidden="true" />
          </a>
        </div>
      </div>
    ))}
  </div>

  {/* Tutorial com Imagem Anotada e Pins */}
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 items-start">
    <div class="cagp-doc-preview-wrapper border-3 border-[#16181d] rounded-xl overflow-hidden shadow-[4px_4px_0_0_#16181d]" role="region" aria-label="Visualização anotada do modelo de TCE">
      <img
        src={asset('/imagens/tutoriais/print-termo-estagio-1.png')}
        alt="Primeira folha do modelo oficial de Termo de Compromisso de Estágio da UFMG com demarcações dos campos de preenchimento"
        class="cagp-doc-preview-img"
        loading="lazy"
      />

      <div class="cagp-doc-box" style="top: 36%; left: 5%; width: 90%; height: 30.69%;" aria-hidden="true"></div>
      <button type="button" class="cagp-doc-pin" style="top: 36%; left: 5%;" aria-label="Ponto 1: Instituição Concedente">1</button>

      <div class="cagp-doc-box" style="top: 67%; left: 5%; width: 90%; height: 26.7%;" aria-hidden="true"></div>
      <button type="button" class="cagp-doc-pin" style="top: 67%; left: 5%;" aria-label="Ponto 2: Dados do Estudante">2</button>
    </div>

    <div class="space-y-3.5">
      {etapasTCE.map((et) => (
        <div class="cagp-card p-4 bg-white border-3 border-[#16181d] rounded-xl flex items-start gap-3.5 shadow-[4px_4px_0_0_#16181d]">
          <span class="w-8 h-8 rounded-lg bg-secondary text-white flex items-center justify-center font-head text-sm font-black shrink-0 border-2 border-[#16181d] shadow-xs">
            {et.num}
          </span>
          <div class="min-w-0">
            <h4 class="font-head text-xs font-bold uppercase text-foreground leading-tight m-0 mb-1">
              {et.titulo}
            </h4>
            <p class="font-body text-xs text-muted-foreground leading-relaxed m-0">
              {et.desc}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>

  {/* Assistente Interativo de Homologação de TCE com Stepper Multi-Passos */}
  <EstagioTceWizard client:load />

  {/* Acervo Completo de Modelos Oficiais de Estágio (PDF + DOCX + Google Docs) */}
  <div class="p-6 bg-white border-3 border-[#16181d] rounded-xl space-y-4 shadow-[4px_4px_0_0_#16181d]">
    <div class="flex items-center justify-between border-b-2 border-[#16181d] pb-3 flex-wrap gap-2">
      <div>
        <h4 class="font-head text-base uppercase font-bold text-foreground m-0 flex items-center gap-2">
          <i class="bi bi-folder-symlink text-secondary" aria-hidden="true" />
          <span>Matriz de Modelos Oficiais de Estágio (PDF, DOCX e Google Docs)</span>
        </h4>
        <p class="font-body text-xs text-muted-foreground mt-0.5 m-0">Preenchimento direto em computador ou edição na nuvem pelo Google Drive:</p>
      </div>
      <span class="text-xs text-foreground font-mono font-bold px-2.5 py-1 bg-white border-2 border-[#16181d] rounded-md shadow-xs">7 Modelos Homologados</span>
    </div>

    <div class="space-y-3">
      {modelosEstagio.map((m) => (
        <div class="p-4 bg-white border-3 border-[#16181d] rounded-xl flex flex-col md:flex-row md:items-center justify-between gap-3 shadow-[3px_3px_0_0_#16181d]">
          <div class="min-w-0">
            <h5 class="font-head text-sm font-bold uppercase text-foreground m-0 mb-0.5">
              {m.titulo}
            </h5>
            <p class="font-body text-xs text-muted-foreground m-0">
              {m.desc}
            </p>
          </div>

          <div class="flex items-center gap-2 shrink-0 flex-wrap">
            <a
              href={m.gdoc}
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] px-3.5 py-2 bg-white hover:bg-muted border-2 border-[#16181d] rounded-xl text-xs font-head font-bold uppercase text-foreground no-underline inline-flex items-center gap-1.5 shadow-[2px_2px_0_0_#16181d] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all"
              title="Abrir modelo no Google Docs"
            >
              <i class="bi bi-google" aria-hidden="true" />
              <span>Google Docs</span>
            </a>
            <a
              href={asset(`/documentos/${m.docx}`)}
              download
              class="min-h-[44px] px-3.5 py-2 bg-primary hover:bg-[#49216C] text-white rounded-xl text-xs font-mono font-bold no-underline inline-flex items-center gap-1.5 border-2 border-[#16181d] shadow-[2px_2px_0_0_#16181d] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all"
              title="Baixar versão Word DOCX"
            >
              <i class="bi bi-file-earmark-word" aria-hidden="true" />
              <span>DOCX</span>
            </a>
            <a
              href={asset(`/documentos/${m.pdf}`)}
              download
              class="min-h-[44px] px-3.5 py-2 bg-secondary hover:bg-[#851E1E] text-white rounded-xl text-xs font-mono font-bold no-underline inline-flex items-center gap-1.5 border-2 border-[#16181d] shadow-[2px_2px_0_0_#16181d] active:translate-x-[1px] active:translate-y-[1px] active:shadow-none transition-all"
              title="Baixar versão PDF"
            >
              <i class="bi bi-file-earmark-pdf" aria-hidden="true" />
              <span>PDF</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>

  {/* Resoluções Normativas e Manual da FAFICH */}
  <div class="p-6 bg-white border-3 border-[#16181d] rounded-xl space-y-4 shadow-[4px_4px_0_0_#16181d]">
    <div class="flex items-center justify-between border-b-2 border-[#16181d] pb-3">
      <h4 class="font-head text-base font-bold uppercase text-foreground m-0 flex items-center gap-2">
        <i class="bi bi-shield-check text-[#134E4A]" aria-hidden="true" />
        <span>Atos Normativos e Manual de Estágio FAFICH</span>
      </h4>
      <span class="text-xs text-muted-foreground font-mono font-bold">Downloads</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      {normasEstagio.map((n) => (
        <div class="p-4 bg-white border-3 border-[#16181d] rounded-xl flex flex-col justify-between shadow-[3px_3px_0_0_#16181d]">
          <div>
            <h5 class="font-head font-bold text-xs uppercase text-foreground m-0 mb-1">{n.titulo}</h5>
            <p class="font-body text-xs text-muted-foreground leading-snug m-0">{n.desc}</p>
          </div>
          <div class="mt-4 pt-3 border-t-2 border-border/20">
            <a
              href={asset(`/documentos/${n.file}`)}
              download
              class="min-h-[44px] cagp-btn-primary text-xs py-2.5 px-3 no-underline flex items-center justify-center gap-2 w-full rounded-xl font-head font-bold uppercase border-3 border-[#16181d] shadow-[3px_3px_0_0_#16181d] active:translate-x-[2px] active:translate-y-[2px] active:shadow-none transition-all"
            >
              <i class="bi bi-download" aria-hidden="true" />
              <span>Baixar PDF</span>
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
