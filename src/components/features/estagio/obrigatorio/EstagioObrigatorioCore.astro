---
// src/components/features/estagio/obrigatorio/EstagioObrigatorioCore.astro — Regras do Estágio Supervisionado (300h)
import { asset } from '../../../../lib/paths';

const stats = [
  { label: 'Estágio Curricular A', ch: '180 h', desc: 'DCP 135 • 7º Período (12 créditos)', icon: 'bi-briefcase-fill' },
  { label: 'Estágio Curricular B', ch: '120 h', desc: 'DCP 136 • 8º Período (8 créditos)', icon: 'bi-clock-history' },
  { label: 'Estágio Não-Obrigatório', ch: 'Até 60 h', desc: 'Modalidade IX • AAC (4 créditos)', icon: 'bi-shield-check' },
];
---

<div class="cagp-estagio-obrigatorio space-y-6 select-none text-[#0A0A0A]">
  {/* Cabeçalho */}
  <div class="p-6 bg-white border-[3px] border-[#0A0A0A] rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-[4px_4px_0_0_#0A0A0A]">
    <div>
      <span class="text-[11px] font-head uppercase font-bold tracking-wider text-[#9E2424]">
        Componente Curricular Obrigatório
      </span>
      <h3 class="font-head text-base sm:text-lg font-black uppercase text-[#0A0A0A] m-0">
        Estágio Supervisionado A e B (300h)
      </h3>
      <p class="font-body text-xs text-[#57534E] mt-0.5 m-0">
        Regulamento do Curso — Capítulo VII (Art. 29 a 41) e Lei Federal nº 11.788/2008.
      </p>
    </div>
    <span class="px-3 py-1.5 rounded-lg bg-[#0A0A0A] text-white font-mono text-xs font-bold border border-[#0A0A0A] shadow-[1.5px_1.5px_0_0_#0A0A0A] shrink-0">
      300h • 20 Créditos
    </span>
  </div>

  {/* Cards de Carga Horária */}
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    {stats.map((s) => (
      <div class="cagp-card p-5 bg-white border-2 border-[#0A0A0A] rounded-xl flex flex-col justify-between shadow-[3px_3px_0_0_#0A0A0A] hover:shadow-[1.5px_1.5px_0_0_#0A0A0A] hover:translate-x-[1px] hover:translate-y-[1px] transition-all">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="w-8 h-8 rounded-lg bg-[#9E2424]/10 text-[#9E2424] flex items-center justify-center text-sm border border-[#9E2424] shadow-[1px_1px_0_0_#0A0A0A]">
              <i class={`bi ${s.icon}`} aria-hidden="true" />
            </span>
            <span class="font-head text-xs font-bold uppercase text-[#0A0A0A]">{s.label}</span>
          </div>
          <div class="text-2xl font-mono font-bold text-[#9E2424] mb-1">{s.ch}</div>
        </div>
        <span class="font-body text-[11px] text-[#57534E] font-medium">{s.desc}</span>
      </div>
    ))}
  </div>

  {/* Duas Colunas: Estágio Obrigatório vs Não-Obrigatório */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div class="cagp-tool-box p-6 bg-white border-2 border-[#0A0A0A] rounded-xl space-y-4 shadow-[3px_3px_0_0_#0A0A0A]">
      <div class="flex items-center justify-between border-b-2 border-[#0A0A0A] pb-3">
        <h4 class="font-head font-bold text-sm uppercase text-[#0A0A0A] m-0 flex items-center gap-2">
          <i class="bi bi-mortarboard-fill text-[#9E2424]" aria-hidden="true" />
          <span>Estágio Obrigatório (300h)</span>
        </h4>
        <span class="px-2.5 py-1 rounded-md bg-[#9E2424] text-white font-mono text-[10px] font-bold border border-[#0A0A0A]">7º e 8º Períodos</span>
      </div>
      <ul class="font-body text-xs text-[#292524] space-y-2 list-disc pl-4 m-0 leading-relaxed">
        <li>
          <strong>DCP 135 — Estágio Curricular A (7º período):</strong> 180 horas (12 créditos), com elaboração de plano de trabalho e supervisão docente.
        </li>
        <li>
          <strong>DCP 136 — Estágio Curricular B (8º período):</strong> 120 horas (8 créditos), com relatório final de estágio e avaliação do supervisor de campo.
        </li>
        <li>
          <strong>Teto Legal:</strong> Máximo de 6 horas diárias e 30 horas semanais conforme a Lei Federal nº 11.788/2008.
        </li>
        <li>
          <strong>Estágio nas Férias (Art. 31):</strong> É permitido cumprir horas durante o recesso escolar para viabilizar a jornada dos discentes trabalhadores do noturno.
        </li>
      </ul>
    </div>

    <div class="cagp-tool-box p-6 bg-white border-2 border-[#0A0A0A] rounded-xl space-y-4 shadow-[3px_3px_0_0_#0A0A0A]">
      <div class="flex items-center justify-between border-b-2 border-[#0A0A0A] pb-3">
        <h4 class="font-head font-bold text-sm uppercase text-[#0A0A0A] m-0 flex items-center gap-2">
          <i class="bi bi-briefcase text-[#266264]" aria-hidden="true" />
          <span>Estágio Não-Obrigatório (AAC)</span>
        </h4>
        <span class="px-2.5 py-1 rounded-md bg-[#266264] text-white font-mono text-[10px] font-bold border border-[#0A0A0A]">Até 60h AAC</span>
      </div>
      <ul class="font-body text-xs text-[#292524] space-y-2 list-disc pl-4 m-0 leading-relaxed">
        <li>
          Atividade extracurricular remunerada (bolsa estágio + auxílio-transporte).
        </li>
        <li>
          Pode ser iniciado desde os primeiros períodos letivos para aquisição de experiência prática em órgãos públicos e ONGs.
        </li>
        <li>
          <strong>Aproveitamento em AAC (Modalidade IX):</strong> As horas comprovadas em estágio não-obrigatório na área pública podem ser aproveitadas em até 60 horas (4 créditos) de optativas.
        </li>
        <li>
          Exige Termo de Compromisso firmado com interveniência obrigatória da FAFICH/UFMG.
        </li>
      </ul>
    </div>
  </div>
</div>
