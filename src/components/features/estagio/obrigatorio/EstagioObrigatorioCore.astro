---
// src/components/features/estagio/obrigatorio/EstagioObrigatorioCore.astro — Regras do Estágio Supervisionado (300h)
import { asset } from '../../../../lib/paths';

const stats = [
  { label: 'Estágio Curricular A', ch: '180 h', desc: 'DCP 135 • 7º Período (12 créditos)', icon: 'bi-briefcase-fill' },
  { label: 'Estágio Curricular B', ch: '120 h', desc: 'DCP 136 • 8º Período (8 créditos)', icon: 'bi-clock-history' },
  { label: 'Estágio Não-Obrigatório', ch: 'Até 60 h', desc: 'Modalidade IX • AAC (4 créditos)', icon: 'bi-shield-check' },
];
---

<div class="cagp-estagio-obrigatorio space-y-6 select-none text-foreground">
  <div id="obrigatorio" class="cagp-anchor-target scroll-mt-24"></div>

  {/* Cabeçalho */}
  <div class="p-6 bg-white border-3 border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">
    <div>
      <h3 class="font-heading text-base sm:text-xl font-black uppercase text-foreground m-0">
        Estágio Supervisionado A e B (300h)
      </h3>
      <p class="font-sans text-xs text-muted-foreground mt-1 max-w-3xl leading-relaxed m-0 font-medium">
        Regulamento do Curso — Capítulo VII (Art. 29 a 41) e Lei Federal nº 11.788/2008.
      </p>
    </div>
    <span class="px-3 py-1.5 rounded-lg bg-foreground text-background text-white font-mono text-xs font-bold border border-border shadow-xs shrink-0">
      300h • 20 Créditos
    </span>
  </div>

  {/* Cards de Carga Horária */}
  <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
    {stats.map((s) => (
      <div class="cagp-card p-5 bg-white border-2 border-border/80 rounded-xl flex flex-col justify-between shadow-xs hover:shadow-sm hover:translate-x-[-1px] hover:translate-y-[-1px] transition-all">
        <div>
          <div class="flex items-center gap-2 mb-2">
            <span class="w-8 h-8 rounded-lg bg-secondary/10 text-secondary flex items-center justify-center text-sm border border-secondary/40 shadow-2xs">
              <i class={`bi ${s.icon}`} aria-hidden="true" />
            </span>
            <span class="font-heading text-xs font-bold uppercase text-foreground">{s.label}</span>
          </div>
          <div class="text-2xl font-mono font-bold text-secondary mb-1 tabular-nums">{s.ch}</div>
        </div>
        <span class="font-sans text-xs text-muted-foreground font-medium">{s.desc}</span>
      </div>
    ))}
  </div>

  {/* Duas Colunas: Estágio Obrigatório vs Não-Obrigatório */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
    <div class="cagp-tool-box p-6 bg-white border-3 border-border rounded-xl space-y-4 shadow-md">
      <div class="flex items-center justify-between border-b-2 border-border/80 pb-3">
        <h4 class="font-heading font-bold text-sm uppercase text-foreground m-0 flex items-center gap-2">
          <i class="bi bi-mortarboard-fill text-secondary" aria-hidden="true" />
          <span>Estágio Obrigatório (300h)</span>
        </h4>
        <span class="px-2.5 py-1 rounded-md bg-secondary text-white font-mono text-xs font-bold border border-border">7º e 8º Períodos</span>
      </div>
      <ul class="font-sans text-xs text-muted-foreground space-y-2 list-disc pl-4 m-0 leading-relaxed">
        <li>
          <strong>DCP 135 — Estágio Curricular A (7º período):</strong> 180 horas (12 créditos), com elaboração de plano de trabalho e supervisão docente.
        </li>
        <li>
          <strong>DCP 136 — Estágio Curricular B (8º período):</strong> 120 horas (8 créditos), com relatório final de estágio e avaliação do supervisor de campo.
        </li>
        <li>
          <strong>Teto Legal:</strong> Máximo de 6 horas diárias e 30 horas semanais conforme a Lei Federal nº 11.788/2008.
        </li>
        <li>
          <strong>Estágio nas Férias (Art. 31):</strong> É permitido cumprir horas durante o recesso escolar para viabilizar a jornada dos discentes trabalhadores do noturno.
        </li>
      </ul>
    </div>

    <div class="cagp-tool-box p-6 bg-white border-3 border-border rounded-xl space-y-4 shadow-md">
      <div class="flex items-center justify-between border-b-2 border-border/80 pb-3">
        <h4 class="font-heading font-bold text-sm uppercase text-foreground m-0 flex items-center gap-2">
          <i class="bi bi-briefcase text-[#134E4A]" aria-hidden="true" />
          <span>Estágio Não-Obrigatório (AAC)</span>
        </h4>
        <span class="px-2.5 py-1 rounded-md bg-[#134E4A] text-white font-mono text-xs font-bold border border-border">Até 60h AAC</span>
      </div>
      <ul class="font-sans text-xs text-muted-foreground space-y-2 list-disc pl-4 m-0 leading-relaxed">
        <li>
          Atividade extracurricular remunerada (bolsa estágio + auxílio-transporte).
        </li>
        <li>
          Pode ser iniciado desde os primeiros períodos letivos para aquisição de experiência prática em órgãos públicos e ONGs.
        </li>
        <li>
          <strong>Aproveitamento em AAC (Modalidade IX):</strong> As horas comprovadas em estágio não-obrigatório na área pública podem ser aproveitadas em até 60 horas (4 créditos) de optativas.
        </li>
        <li>
          Exige Termo de Compromisso firmado com interveniência obrigatória da FAFICH/UFMG.
        </li>
      </ul>
    </div>
  </div>
</div>
