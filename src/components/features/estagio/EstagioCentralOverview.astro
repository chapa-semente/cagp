---
// src/components/features/estagio/EstagioCentralOverview.astro — Visão Geral do Estágio Supervisionado
import { Art41Widget } from './art41/Art41Widget';
import EstagioObrigatorioWidget from './obrigatorio/EstagioObrigatorioWidget.astro';
import EstagioTceWidget from './tce/EstagioTceWidget.astro';
import { asset } from '@/lib/paths';
import CagpIcon from '@/components/ui/CagpIcon.astro';
---

<div class="cagp-estagio-central-overview space-y-6 select-none text-foreground font-sans">
  {/* Apresentação da Central de Estágio */}
  <div class="p-5 sm:p-6 bg-white border-3 border-border rounded-xl flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-md">
    <div class="flex items-start gap-3.5">
      <span class="w-12 h-12 rounded-xl bg-secondary text-white flex items-center justify-center shrink-0 mt-0.5 border-3 border-border shadow-xs">
        <CagpIcon name="briefcase" class="w-6 h-6" />
      </span>
      <div>
        <div class="flex items-center gap-2">
          <span class="text-xs font-heading uppercase font-bold tracking-wider text-secondary">
            Estágio Supervisionado
          </span>
          <span class="text-foreground font-bold">•</span>
          <span class="text-xs text-muted-foreground font-mono font-bold">300 horas obrigatórias</span>
        </div>
        <h2 class="font-heading text-lg sm:text-xl font-black text-foreground leading-tight m-0">
          Estágio Curricular A &amp; B, Aproveitamento Servidor (Art. 41) e Termo de Compromisso (TCE)
        </h2>
        <p class="font-sans text-xs text-muted-foreground mt-1 max-w-3xl leading-relaxed m-0 font-medium">
          Consulte as regras de integralização profissional, simule elegibilidade de <strong>Aproveitamento Servidor</strong> pelo Art. 41 e baixe modelos oficiais de convênio.
        </p>
      </div>
    </div>
  </div>

  {/* Bento Grid dos Widgets de Estágio */}
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
    <Art41Widget client:load />
    <EstagioObrigatorioWidget />
    <EstagioTceWidget />
  </div>

  {/* Banner Informativo sobre Convênios */}
  <div class="p-5 sm:p-6 bg-white border-3 border-border rounded-xl flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-md">
    <div class="flex items-center gap-3.5">
      <span class="w-12 h-12 rounded-xl bg-foreground text-white flex items-center justify-center shrink-0 border-2 border-border shadow-xs">
        <CagpIcon name="thesis" class="w-6 h-6 text-accent" />
      </span>
      <div>
        <h3 class="font-heading text-sm font-black text-foreground leading-tight m-0">
          Termo de Compromisso Oficial (TCE) com a UFMG
        </h3>
        <p class="font-sans text-xs text-muted-foreground mt-0.5 m-0 font-medium">
          Minuta homologada pela Pró-Reitoria de Graduação com seguro contra acidentes pessoais.
        </p>
      </div>
    </div>

    <div class="flex items-center gap-2.5 w-full sm:w-auto">
      <a
        href={asset('/documentos/estagio-modelo-termo-de-compromisso-com-convenio.pdf')}
        download
        class="min-h-[44px] flex-1 sm:flex-none px-4 py-2.5 bg-secondary hover:bg-[#851E1E] text-white rounded-xl text-xs font-heading uppercase font-black tracking-wider flex items-center justify-center gap-2 transition-all no-underline border-3 border-border shadow-xs active:translate-x-[2px] active:translate-y-[2px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-secondary focus-visible:ring-offset-2"
      >
        <CagpIcon name="download" class="w-4 h-4 text-white" />
        <span>Termo de Estágio (PDF)</span>
      </a>
      <a
        href="#tutorial"
        class="min-h-[44px] px-4 py-2.5 bg-white hover:bg-muted text-foreground border-3 border-border rounded-xl text-xs font-heading uppercase font-black flex items-center justify-center transition-all no-underline shadow-xs active:translate-x-[2px] active:translate-y-[2px] active:shadow-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2"
      >
        <span>Ver Tutorial</span>
      </a>
    </div>
  </div>
</div>
