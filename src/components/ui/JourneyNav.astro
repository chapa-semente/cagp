---
// JourneyNav.astro - Trilha de continuidade discente no rodapé de páginas
import { route } from '../../lib/paths';

interface Step {
  title: string;
  href: string;
  desc: string;
}

interface Props {
  prev?: Step;
  next?: Step;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav class="mt-10 pt-6 border-t border-[#DFDBD2] select-none" aria-label="Continuidade da jornada acadêmica">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      {prev ? (
        <a
          href={route(prev.href)}
          class="p-5 rounded-3xl bg-white border border-[#DFDBD2] shadow-2xs hover:border-[#8B1E2D] hover:shadow-xs transition-all no-underline text-[#0A0A0A] flex flex-col justify-between group"
        >
          <div>
            <span class="font-['Oswald'] font-bold text-xs uppercase tracking-wider text-[#8B1E2D] block mb-1">
              &larr; Passo Anterior
            </span>
            <h4 class="font-['Oswald'] font-bold text-base uppercase text-[#0A0A0A] group-hover:text-[#8B1E2D] transition-colors leading-tight">
              {prev.title}
            </h4>
          </div>
          <p class="text-xs text-[#57534E] mt-2 leading-relaxed">{prev.desc}</p>
        </a>
      ) : <div class="hidden md:block" />}

      {next ? (
        <a
          href={route(next.href)}
          class="p-5 rounded-3xl bg-white border border-[#DFDBD2] shadow-2xs hover:border-[#8B1E2D] hover:shadow-xs transition-all no-underline text-[#0A0A0A] flex flex-col justify-between group text-left md:text-right"
        >
          <div>
            <span class="font-['Oswald'] font-bold text-xs uppercase tracking-wider text-[#8B1E2D] block mb-1">
              Próximo Passo &rarr;
            </span>
            <h4 class="font-['Oswald'] font-bold text-base uppercase text-[#0A0A0A] group-hover:text-[#8B1E2D] transition-colors leading-tight">
              {next.title}
            </h4>
          </div>
          <p class="text-xs text-[#57534E] mt-2 leading-relaxed">{next.desc}</p>
        </a>
      ) : <div class="hidden md:block" />}
    </div>
  </nav>
)}
