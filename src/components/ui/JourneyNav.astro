---
// JourneyNav.astro — Trilha de continuidade no fim do guia (anterior / próximo).
// DESIGN.md › Navigation › JourneyNav: duas fichas, título em caixa de frase, uma linha.
// A ordem vem do registro (páginas da mesma aba). `prev`/`next` só valem para rotas fora dele.
import { route } from '@/lib/paths';
import { getItemByPath, getSiblingPages } from '@/lib/navigationRegistry';

interface Step {
  title: string;
  href: string;
  desc: string;
}

interface Props {
  prev?: Step;
  next?: Step;
}

const owner = getItemByPath(Astro.url.pathname);
const siblings = owner ? getSiblingPages(Astro.url.pathname) : undefined;
// Os hrefs do registro já trazem o base path; route() abaixo não deve aplicá-lo de novo.
const toStep = (item?: { label: string; href: string; description: string }): Step | undefined =>
  item ? { title: item.label, href: item.href, desc: item.description } : undefined;

const prev = owner ? toStep(siblings?.prev) : Astro.props.prev;
const next = owner ? toStep(siblings?.next) : Astro.props.next;
const resolveHref = (href: string) => (owner ? href : route(href));
---

{(prev || next) && (
  <nav class="cagp-journey" aria-label="Continue a jornada">
    {prev ? (
      <a href={resolveHref(prev.href)} class="cagp-journey-card">
        <span class="cagp-journey-dir">
          <i class="bi bi-arrow-left" aria-hidden="true"></i>
          Anterior
        </span>
        <span class="cagp-journey-title">{prev.title}</span>
        <span class="cagp-journey-desc">{prev.desc}</span>
      </a>
    ) : <span class="cagp-journey-gap" aria-hidden="true"></span>}

    {next ? (
      <a href={resolveHref(next.href)} class="cagp-journey-card is-next">
        <span class="cagp-journey-dir">
          Próximo
          <i class="bi bi-arrow-right" aria-hidden="true"></i>
        </span>
        <span class="cagp-journey-title">{next.title}</span>
        <span class="cagp-journey-desc">{next.desc}</span>
      </a>
    ) : <span class="cagp-journey-gap" aria-hidden="true"></span>}
  </nav>
)}

<style>
  .cagp-journey {
    display: grid;
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .cagp-journey-gap {
    display: none;
  }
  .cagp-journey-card {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1.25rem;
    background: var(--color-card);
    color: var(--color-foreground);
    border: 2px solid var(--color-border);
    border-radius: 12px;
    box-shadow: 3px 3px 0 0 var(--color-border);
    text-decoration: none;
    transition: transform var(--duration-press, 150ms) var(--ease-snap, cubic-bezier(0.16, 1, 0.3, 1)), box-shadow var(--duration-press, 150ms) var(--ease-snap, cubic-bezier(0.16, 1, 0.3, 1));
  }
  .cagp-journey-card:hover {
    transform: translate(-1px, -1px);
    box-shadow: 5px 5px 0 0 var(--color-border);
  }
  .cagp-journey-card:active {
    transform: translate(3px, 3px);
    box-shadow: none;
  }
  .cagp-journey-dir {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font: 700 0.75rem/1.2 var(--font-heading, 'Poppins', sans-serif);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-content-secondary, #4A4740);
  }
  .cagp-journey-title {
    font: 700 1.125rem/1.3 var(--font-heading, "Poppins", sans-serif);
    text-wrap: balance;
  }
  .cagp-journey-card:hover .cagp-journey-title {
    color: var(--color-primary);
  }
  .cagp-journey-desc {
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--color-content-secondary, #4A4740);
  }
  @media (min-width: 768px) {
    .cagp-journey {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }
    .cagp-journey-gap {
      display: block;
    }
    .cagp-journey-card.is-next {
      text-align: right;
      align-items: flex-end;
    }
  }
</style>
