---
// PageHeader.astro - Cabeçalho Canônico Neobrutalista (rL9Ap + Tri-Layer CAGP/Semente/UFMG)
import AxisNavBar from '../shell/AxisNavBar.astro';
import type { AxisId } from '@/lib/navigationRegistry';
import CagpIcon from './CagpIcon.astro';
import { resolveCagpIconName } from '@/lib/cagpIcons';
import { badgeVariants } from './badge';
import { cn } from '@/lib/utils';
import {
  Breadcrumb,
  BreadcrumbList,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbPage,
  BreadcrumbSeparator,
} from './breadcrumb';

interface Badge {
  label: string;
  variant?: 'red' | 'dark' | 'blue' | 'green' | 'gold' | 'purple' | 'orange' | 'secondary' | 'accent' | 'default';
  icon?: string;
}

interface Breadcrumb {
  label: string;
  href?: string;
}

interface AxisPill {
  axisName: string;
  axisIcon: string;
  parentLabel: string;
  parentHref: string;
  currentLabel: string;
}

interface Props {
  title: string;
  subtitle?: string;
  eyebrow?: string;
  badges?: Badge[];
  breadcrumbs?: Breadcrumb[];
  axisPill?: AxisPill;
  axisId?: AxisId;
  activeId?: string;
  showAxisNav?: boolean;
  mode?: 'persuade' | 'operate' | 'read' | 'experience';
  condensed?: boolean;
}

const {
  title,
  subtitle,
  eyebrow,
  badges = [],
  breadcrumbs,
  axisId,
  activeId,
  showAxisNav = true,
  mode,
  condensed = false,
} = Astro.props;

const isPersuadeMode = mode === 'persuade' || mode === 'experience';
const isOperateOrCondensed = mode === 'operate' || condensed;

const mapToBadgeVariant = (v?: string): any => {
  switch (v) {
    case 'red': return 'destructive';
    case 'purple': return 'default';
    case 'orange': return 'accent';
    case 'dark': return 'dark';
    case 'blue': return 'info';
    case 'green': return 'success';
    case 'gold': return 'warning';
    case 'secondary': return 'secondary';
    case 'accent': return 'accent';
    default: return 'dark';
  }
};

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '/index.html';
const shouldRenderAxisNav = showAxisNav && !isHome;
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const computedBreadcrumbs = breadcrumbs && breadcrumbs.length > 0
  ? breadcrumbs
  : (!isHome && currentPath !== '/'
    ? [
        { label: 'Início', href: '/' },
        { label: title },
      ]
    : []);
---

<header class={cn(isPersuadeMode ? 'mb-2 sm:mb-3' : isOperateOrCondensed ? 'mb-3 sm:mb-4' : 'mb-4 sm:mb-6', 'select-none')}>
  {shouldRenderAxisNav && (
    <AxisNavBar axisId={axisId} activeId={activeId} />
  )}

  {!isPersuadeMode && (
    <div class={cn(
      'relative overflow-hidden rounded-xl border-3 border-[#16181d] bg-card shadow-[6px_6px_0_0_#16181d]',
      isOperateOrCondensed ? 'p-3.5 sm:p-4' : 'p-5 sm:p-6'
    )}>
      <!-- Barra Tri-Camada Institucional Superior (Rubro CAGP + Roxo Semente + Laranja Germinar) -->
      <div class="absolute top-0 left-0 right-0 h-2 flex border-b-2 border-[#16181d]" aria-hidden="true">
        <div class="flex-1 bg-secondary"></div>
        <div class="flex-1 bg-primary"></div>
        <div class="w-1/4 bg-accent"></div>
      </div>

      <!-- Decoração Geométrica Neobrutalista no Canto Direito -->
      <div
        class="pointer-events-none absolute -right-6 -bottom-6 w-28 h-28 rounded-full border-3 border-border/15 bg-accent/15 hidden sm:block"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute right-10 -top-4 w-12 h-12 rotate-12 border-3 border-border/15 bg-primary/10 hidden md:block"
        aria-hidden="true"
      ></div>

      <div class="relative z-10 pt-1">
        {computedBreadcrumbs.length > 0 && !isOperateOrCondensed && (
          <div class="mb-2">
            <Breadcrumb>
              <BreadcrumbList>
                {computedBreadcrumbs.map((crumb, idx) => {
                  const isLast = idx === computedBreadcrumbs.length - 1;
                  return (
                    <BreadcrumbItem>
                      {isLast || !crumb.href ? (
                        <BreadcrumbPage>{crumb.label}</BreadcrumbPage>
                      ) : (
                        <BreadcrumbLink href={crumb.href}>{crumb.label}</BreadcrumbLink>
                      )}
                      {!isLast && <BreadcrumbSeparator />}
                    </BreadcrumbItem>
                  );
                })}
              </BreadcrumbList>
            </Breadcrumb>
          </div>
        )}

        <!-- Eyebrow & Badges Row -->
        {(eyebrow || badges.length > 0) && (
          <div class={cn('flex flex-wrap items-center gap-2', isOperateOrCondensed ? 'mb-2' : 'mb-3')}>
            {eyebrow && (
              <span class="inline-flex items-center gap-1.5 rounded-lg border-3 border-border bg-primary text-white px-2.5 py-0.5 font-heading text-xs font-extrabold uppercase tracking-wider shadow-xs">
                <span>✦</span>
                <span>{eyebrow}</span>
              </span>
            )}
            {badges.map((b, idx) => (
              <span class={cn(
                badgeVariants({ variant: mapToBadgeVariant(b.variant) }),
                isOperateOrCondensed
                  ? (idx >= 1 ? 'hidden sm:inline-flex' : 'inline-flex')
                  : (idx >= 3 ? 'hidden sm:inline-flex' : 'inline-flex'),
                'items-center gap-1.5'
              )}>
                {b.icon && <CagpIcon name={resolveCagpIconName(b.icon)} class="w-3.5 h-3.5 shrink-0" />}
                <span>{b.label}</span>
              </span>
            ))}
          </div>
        )}

        <!-- Page Title & Subtitle -->
        <h1 class={cn(
          'font-heading font-extrabold uppercase tracking-tight text-foreground leading-tight m-0',
          isOperateOrCondensed ? 'text-xl sm:text-3xl' : 'text-2xl sm:text-4xl'
        )}>
          {title}
        </h1>
        {subtitle && (
          <p class={cn(
            'text-xs sm:text-sm font-sans text-muted-foreground font-medium max-w-4xl leading-relaxed m-0',
            isOperateOrCondensed ? 'mt-1.5 line-clamp-2 sm:line-clamp-none' : 'mt-2'
          )}>
            {subtitle}
          </p>
        )}

        <!-- Slot contextual/destilado para ações, links de campanha ou extensões -->
        <slot />
      </div>
    </div>
  )}
</header>
