---
// FactCheckBanner.astro - Tarja Editorial Neobrutalista de Homologação e Checagem de Fatos
import CagpIcon from './CagpIcon.astro';
import type { CagpIconName } from '@/lib/cagpIcons';

interface Props {
  claim: string;
  verdict: 'homologado' | 'obrigatorio' | 'atencao' | 'desmistificado';
  stampText?: string;
  normativeSource: string;
  explanation: string;
  officialRuleExcerpt?: string;
}

const {
  claim,
  verdict,
  stampText,
  normativeSource,
  explanation,
  officialRuleExcerpt,
} = Astro.props;

const verdictConfig: Record<string, {
  badge: string;
  stamp: string;
  stampClass: string;
  iconName: CagpIconName;
  iconColor: string;
}> = {
  homologado: {
    badge: 'VERIFICADO • NORMA REGIMENTAL',
    stamp: stampText || 'HOMOLOGADO',
    stampClass: 'text-success bg-[#D0E5D8]',
    iconName: 'check',
    iconColor: 'text-success',
  },
  obrigatorio: {
    badge: 'TRAVA OFICIAL • PPC 2020',
    stamp: stampText || 'OBRIGATÓRIO',
    stampClass: 'text-secondary bg-destructive-tint',
    iconName: 'shield',
    iconColor: 'text-secondary',
  },
  atencao: {
    badge: 'PRAZO PEREMPTÓRIO • ATENÇÃO',
    stamp: stampText || '120 DIAS',
    stampClass: 'text-warning bg-warning-tint',
    iconName: 'alert-triangle',
    iconColor: 'text-warning',
  },
  desmistificado: {
    badge: 'CHECAGEM ANTI-BOATO • FATO',
    stamp: stampText || 'FATO REAL',
    stampClass: 'text-info bg-info-tint',
    iconName: 'stamp',
    iconColor: 'text-info',
  },
};

const current = verdictConfig[verdict];
---

<div class="bg-card border-2 border-border rounded-xl p-5 sm:p-6 shadow-md mb-5 relative overflow-hidden font-sans">
  <!-- Top Editorial Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b-3 border-border pb-3 mb-4">
    <div class="flex items-center gap-2.5">
      <div class={`p-2 rounded-xl bg-white border-2 border-border shadow-xs ${current.iconColor} shrink-0`}>
        <CagpIcon name={current.iconName} class="w-5 h-5" />
      </div>
      <div>
        <span class="font-heading font-extrabold text-xs uppercase tracking-tight text-foreground block">
          {current.badge}
        </span>
        <span class="text-xs font-mono font-bold text-muted-foreground">
          Fonte: {normativeSource}
        </span>
      </div>
    </div>

    <!-- Authentic Rubber Stamp com Animação BoldKit -->
    <div class={`border-3 border-border rounded-lg ${current.stampClass} font-heading font-extrabold text-xs px-3 py-1 uppercase tracking-wider shadow-xs -rotate-1 animate-[bk-stamp-in_0.35s_cubic-bezier(0.16,1,0.3,1)_both]`}>
      {current.stamp}
    </div>
  </div>

  <!-- Central Question / Claim -->
  <div class="mb-3">
    <span class="text-xs uppercase font-mono font-bold text-muted-foreground tracking-wider block mb-1">
      O que circula / O que você precisa checar:
    </span>
    <p class="font-heading font-extrabold text-base sm:text-lg text-foreground leading-snug m-0">
      "{claim}"
    </p>
  </div>

  <!-- Editorial Explanation -->
  <div class="bg-white border-2 border-border rounded-xl p-4 text-xs sm:text-sm text-foreground leading-relaxed mb-3 shadow-xs">
    <span class="font-extrabold text-secondary block mb-1 font-heading uppercase text-xs">
      Checagem do Colegiado &amp; CAGP:
    </span>
    {explanation}
  </div>

  <!-- Optional Official Excerpt Drawer -->
  {officialRuleExcerpt && (
    <details class="cagp-normative-details group bg-white border-2 border-border rounded-xl text-xs overflow-hidden shadow-xs">
      <summary class="px-3.5 py-2.5 min-h-[44px] cursor-pointer font-heading font-extrabold uppercase text-foreground bg-white hover:bg-muted flex items-center justify-between select-none transition-colors border-b group-open:border-border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-inset">
        <span class="flex items-center gap-2">
          <CagpIcon name="file-text" class="w-4 h-4 text-muted-foreground" />
          <span>Ver texto legal literal da UFMG</span>
        </span>
        <CagpIcon name="chevron-right" class="w-3.5 h-3.5 text-foreground transition-transform duration-200 group-open:rotate-90" />
      </summary>
      <div class="px-4 py-3 font-mono text-xs text-foreground bg-white whitespace-pre-line leading-relaxed">
        {officialRuleExcerpt}
      </div>
    </details>
  )}
</div>
