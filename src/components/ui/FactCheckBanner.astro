---
// FactCheckBanner.astro - Tarja Editorial Neobrutalista de Homologação e Checagem de Fatos
import CagpIcon from './CagpIcon.astro';
import type { CagpIconName } from '../../lib/cagpIcons';

interface Props {
  claim: string;
  verdict: 'homologado' | 'obrigatorio' | 'atencao' | 'desmistificado';
  stampText?: string;
  normativeSource: string;
  explanation: string;
  officialRuleExcerpt?: string;
}

const {
  claim,
  verdict,
  stampText,
  normativeSource,
  explanation,
  officialRuleExcerpt,
} = Astro.props;

const verdictConfig: Record<string, {
  badge: string;
  stamp: string;
  stampClass: string;
  iconName: CagpIconName;
  iconColor: string;
}> = {
  homologado: {
    badge: 'VERIFICADO • NORMA REGIMENTAL',
    stamp: stampText || 'HOMOLOGADO',
    stampClass: 'text-[#15803D] bg-[#DCFCE7]',
    iconName: 'check',
    iconColor: 'text-[#15803D]',
  },
  obrigatorio: {
    badge: 'TRAVA OFICIAL • PPC 2020',
    stamp: stampText || 'OBRIGATÓRIO',
    stampClass: 'text-[#9E2424] bg-[#FEE2E2]',
    iconName: 'shield',
    iconColor: 'text-[#9E2424]',
  },
  atencao: {
    badge: 'PRAZO PEREMPTÓRIO • ATENÇÃO',
    stamp: stampText || '120 DIAS',
    stampClass: 'text-[#854D0E] bg-[#FEF08A]',
    iconName: 'alert-triangle',
    iconColor: 'text-[#854D0E]',
  },
  desmistificado: {
    badge: 'CHECAGEM ANTI-BOATO • FATO',
    stamp: stampText || 'FATO REAL',
    stampClass: 'text-[#0369A1] bg-[#E0F2FE]',
    iconName: 'stamp',
    iconColor: 'text-[#0369A1]',
  },
};

const current = verdictConfig[verdict];
---

<div class="bg-white border-[3px] border-[#0A0A0A] rounded-xl p-5 sm:p-6 shadow-[4px_4px_0_0_#0A0A0A] mb-5 relative overflow-hidden font-sans">
  <!-- Top Editorial Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b-[3px] border-[#0A0A0A] pb-3 mb-4">
    <div class="flex items-center gap-2.5">
      <div class={`p-2 rounded-xl bg-[#FBF8F3] border-2 border-black shadow-[1.5px_1.5px_0_0_#0A0A0A] ${current.iconColor} shrink-0`}>
        <CagpIcon name={current.iconName} class="w-5 h-5" />
      </div>
      <div>
        <span class="font-heading font-extrabold text-xs uppercase tracking-tight text-[#0A0A0A] block">
          {current.badge}
        </span>
        <span class="text-xs font-mono font-bold text-[#57534E]">
          Fonte: {normativeSource}
        </span>
      </div>
    </div>

    <!-- Authentic Rubber Stamp -->
    <div class={`border-2 border-black rounded-lg ${current.stampClass} font-heading font-extrabold text-xs px-3 py-1 uppercase tracking-wider shadow-[2px_2px_0_0_#0A0A0A] -rotate-1`}>
      {current.stamp}
    </div>
  </div>

  <!-- Central Question / Claim -->
  <div class="mb-3">
    <span class="text-[11px] uppercase font-mono font-bold text-[#57534E] tracking-wider block mb-1">
      O que circula / O que você precisa checar:
    </span>
    <p class="font-heading font-extrabold text-base sm:text-lg text-[#0A0A0A] leading-snug m-0">
      "{claim}"
    </p>
  </div>

  <!-- Editorial Explanation -->
  <div class="bg-[#FBF8F3] border-2 border-[#0A0A0A] rounded-xl p-4 text-xs sm:text-sm text-[#0A0A0A] leading-relaxed mb-3 shadow-[1.5px_1.5px_0_0_#0A0A0A]">
    <span class="font-extrabold text-[#9E2424] block mb-1 font-heading uppercase text-xs">
      Checagem do Colegiado &amp; CAGP:
    </span>
    {explanation}
  </div>

  <!-- Optional Official Excerpt Drawer -->
  {officialRuleExcerpt && (
    <details class="cagp-normative-details group bg-white border-2 border-[#0A0A0A] rounded-xl text-xs overflow-hidden shadow-[1.5px_1.5px_0_0_#0A0A0A]">
      <summary class="px-3.5 py-2.5 min-h-[44px] cursor-pointer font-heading font-extrabold uppercase text-[#0A0A0A] bg-[#FBF8F3] hover:bg-[#F4F1EA] flex items-center justify-between select-none transition-colors border-b group-open:border-[#0A0A0A]">
        <span class="flex items-center gap-2">
          <CagpIcon name="file-text" class="w-4 h-4 text-[#57534E]" />
          <span>Ver texto legal literal da UFMG</span>
        </span>
        <CagpIcon name="chevron-right" class="w-3.5 h-3.5 text-[#0A0A0A] transition-transform duration-200 group-open:rotate-90" />
      </summary>
      <div class="px-4 py-3 font-mono text-xs text-[#0A0A0A] bg-white whitespace-pre-line leading-relaxed">
        {officialRuleExcerpt}
      </div>
    </details>
  )}
</div>
