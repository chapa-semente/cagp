---
// FactCheckBanner.astro - Tarja Editorial de Homologação e Checagem de Fatos (Padrão Dossiê Tátil)
import CagpIcon from './CagpIcon.astro';
import type { CagpIconName } from '../../lib/cagpIcons';

interface Props {
  claim: string;
  verdict: 'homologado' | 'obrigatorio' | 'atencao' | 'desmistificado';
  stampText?: string;
  normativeSource: string;
  explanation: string;
  officialRuleExcerpt?: string;
}

const {
  claim,
  verdict,
  stampText,
  normativeSource,
  explanation,
  officialRuleExcerpt,
} = Astro.props;

const verdictConfig: Record<string, {
  badge: string;
  stamp: string;
  stampClass: string;
  iconName: CagpIconName;
  iconColor: string;
}> = {
  homologado: {
    badge: 'VERIFICADO • NORMA REGIMENTAL',
    stamp: stampText || 'HOMOLOGADO',
    stampClass: 'is-deferido text-[#15803D] border-[#15803D] bg-[#DCFCE7]/40',
    iconName: 'check',
    iconColor: 'text-[#15803D]',
  },
  obrigatorio: {
    badge: 'TRAVA OFICIAL • PPC 2020',
    stamp: stampText || 'OBRIGATÓRIO',
    stampClass: 'is-indeferido text-[#9E2424] border-[#9E2424] bg-[#FEE2E2]/50',
    iconName: 'shield',
    iconColor: 'text-[#9E2424]',
  },
  atencao: {
    badge: 'PRAZO PEREMPTÓRIO • ATENÇÃO',
    stamp: stampText || '120 DIAS',
    stampClass: 'is-homologado text-[#B45309] border-[#B45309] bg-[#FEF3C7]',
    iconName: 'alert-triangle',
    iconColor: 'text-[#B45309]',
  },
  desmistificado: {
    badge: 'CHECAGEM ANTI-BOATO • FATO',
    stamp: stampText || 'FATO REAL',
    stampClass: 'is-deferido text-[#005A9C] border-[#005A9C] bg-[#E0F2FE]',
    iconName: 'stamp',
    iconColor: 'text-[#005A9C]',
  },
};

const current = verdictConfig[verdict];
---

<div class="cagp-fact-check-box bg-white border border-[#DFDBD2] rounded-3xl p-5 sm:p-6 shadow-xs mb-5 relative overflow-hidden">
  <!-- Top Editorial Bar -->
  <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#DFDBD2] pb-3 mb-4">
    <div class="flex items-center gap-2.5">
      <div class={`p-1.5 rounded-xl bg-[#FBF8F3] border border-[#DFDBD2] ${current.iconColor} shrink-0`}>
        <CagpIcon name={current.iconName} class="w-5 h-5" />
      </div>
      <div>
        <span class="font-['Oswald'] font-bold text-xs uppercase tracking-wider text-[#0A0A0A] block">
          {current.badge}
        </span>
        <span class="text-xs font-mono text-[#57534E]">
          Fonte: {normativeSource}
        </span>
      </div>
    </div>

    <!-- Authentic Rubber Stamp -->
    <div class={`cagp-stamp-badge ${current.stampClass} font-mono font-black text-xs px-3 py-1 uppercase tracking-wider shadow-xs`}>
      {current.stamp}
    </div>
  </div>

  <!-- Central Question / Claim -->
  <div class="mb-3">
    <span class="text-[11px] uppercase font-['Oswald'] font-bold text-[#57534E] tracking-wider block mb-0.5">
      O que circula / O que você precisa checar:
    </span>
    <p class="font-['Oswald'] font-bold text-base sm:text-lg text-[#0A0A0A] leading-snug m-0">
      "{claim}"
    </p>
  </div>

  <!-- Editorial Explanation -->
  <div class="bg-[#FBF8F3] border border-[#DFDBD2] rounded-2xl p-4 text-xs sm:text-sm text-[#292524] leading-relaxed mb-3">
    <span class="font-bold text-[#8B1E2D] block mb-1 font-['Oswald'] uppercase text-xs">
      Checagem do Colegiado &amp; CAGP:
    </span>
    {explanation}
  </div>

  <!-- Optional Official Excerpt Drawer -->
  {officialRuleExcerpt && (
    <details class="cagp-normative-details group bg-white border border-[#DFDBD2] rounded-2xl text-xs overflow-hidden">
      <summary class="px-3.5 py-2.5 min-h-[44px] cursor-pointer font-['Oswald'] font-bold uppercase text-[#292524] bg-[#FBF8F3] hover:bg-[#F4F1EA] flex items-center justify-between select-none transition-colors">
        <span class="flex items-center gap-2">
          <CagpIcon name="file-text" class="w-4 h-4 text-[#57534E]" />
          <span>Ver texto legal literal da UFMG</span>
        </span>
        <CagpIcon name="chevron-right" class="w-3.5 h-3.5 text-[#57534E] transition-transform duration-200 group-open:rotate-90" />
      </summary>
      <div class="px-4 py-3 font-mono text-xs text-[#292524] bg-white border-t border-[#DFDBD2] whitespace-pre-line leading-relaxed">
        {officialRuleExcerpt}
      </div>
    </details>
  )}
</div>
