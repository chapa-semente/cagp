---
// TramitePassos.astro — O passo a passo numerado (DESIGN.md › Passo a passo de trâmite).
// Cada passo é uma ficha: número roxo, título-verbo, uma ou duas frases e, na própria ficha,
// o formulário, o modelo ou o link de que ele precisa. Uma régua grafite liga os números.
import TramiteAcoes from './TramiteAcoes.astro';
import type { TramitePasso } from './types';

interface Props {
  passos: TramitePasso[];
  titulo?: string;
  id?: string;
}

const { passos, titulo = 'Passo a passo', id } = Astro.props;
const headingId = id ? `${id}-titulo` : undefined;
---

<section class="space-y-4" aria-labelledby={headingId} id={id}>
  <h2 id={headingId} class="font-heading font-bold text-xl text-foreground m-0">{titulo}</h2>
  <ol class="cagp-tramite-passos cagp-reveal-stagger">
    {passos.map((p, i) => (
      <li>
        <span class="cagp-tramite-num" aria-hidden="true">{i + 1}</span>
        <div class="cagp-tramite-ficha">
          <h3>
            <span class="sr-only">Passo {i + 1}: </span>{p.titulo}
          </h3>
          <p set:html={p.texto} />
          {p.prazo && <span class="cagp-tramite-prazo"><i class="bi bi-clock" aria-hidden="true"></i>{p.prazo}</span>}
          {p.acoes && p.acoes.length > 0 && <TramiteAcoes acoes={p.acoes} />}
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .cagp-tramite-passos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  .cagp-tramite-passos > li {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 0.75rem;
  }
  /* Régua que liga um número ao próximo. */
  .cagp-tramite-passos > li:not(:last-child)::before {
    content: '';
    position: absolute;
    left: calc(1.375rem - 1px);
    top: 2.75rem;
    bottom: -1rem;
    width: 2px;
    background: var(--color-border);
  }
  .cagp-tramite-num {
    position: relative;
    z-index: 1;
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 2px solid var(--color-border);
    border-radius: 12px;
    background: var(--color-primary);
    color: #fff;
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    box-shadow: var(--shadow-chip);
  }
  .cagp-tramite-ficha {
    padding: 1rem 1.125rem;
    background: #fff;
    border: 2px solid var(--color-border);
    border-radius: 12px;
    box-shadow: var(--shadow-ficha);
    display: grid;
    gap: 0.625rem;
  }
  .cagp-tramite-ficha h3 {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--color-foreground);
  }
  .cagp-tramite-ficha p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--color-content-secondary);
    text-wrap: pretty;
  }
  .cagp-tramite-ficha p :global(strong) {
    color: var(--color-foreground);
  }
  .cagp-tramite-ficha p :global(a) {
    color: var(--color-primary);
    font-weight: 700;
  }
  .cagp-tramite-prazo {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.625rem;
    border-radius: 8px;
    background: var(--color-warning-tint);
    color: var(--color-warning);
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
