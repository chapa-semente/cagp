---
// EstagioArt.astro — O desenho do estágio da planta (semente → raiz → broto → planta → fruto).
// Geometria chapada, sem traço "de ilustração": gota, arcos de folha e círculos, como o símbolo da chapa.
// Cada parte entra em ordem ao carregar (.ea-draw desenha o traço, .ea-pop faz brotar).
import type { Estagio } from '@/lib/estagios';

interface Props {
  estagio: Estagio;
  class?: string;
}
const { estagio: e, class: className = '' } = Astro.props;
const n = e.nivel;
---

<svg class={`cagp-estagio-art ${className}`} viewBox="0 0 160 160" aria-hidden="true" fill="none">
  {n >= 5 && (
    <>
      <circle class="ea-pop" style="--d:1.25s" cx="122" cy="50" r="11" fill={e.fruto} />
      <circle class="ea-pop" style="--d:1.35s" cx="40" cy="36" r="10" fill={e.fruto} />
      <circle class="ea-pop" style="--d:1.45s" cx="100" cy="14" r="8" fill={e.fruto} />
    </>
  )}
  {n >= 3 && <path class="ea-draw" style="--d:0.55s" pathLength="1" d={n >= 4 ? 'M80 100V26' : 'M80 100V56'} stroke={e.folha} stroke-width="6" stroke-linecap="round" />}
  {n >= 3 && <path class="ea-pop" style="--d:0.85s" d="M80 82c0-22 12-35 34-36 0 22-12 35-34 36z" fill={e.folha} />}
  {n >= 4 && (
    <>
      <path class="ea-pop" style="--d:0.98s" d="M80 64c0-22-12-35-34-36 0 22 12 35 34 36z" fill={e.folha} />
      <path class="ea-pop" style="--d:1.1s" d="M80 40c0-14 8-22 22-23 0 14-8 22-22 23z" fill={e.folha} />
    </>
  )}
  {n >= 2 && (
    <>
      <path class="ea-draw" style="--d:0.25s" pathLength="1" d="M80 114v36" stroke={e.raiz} stroke-width="6" stroke-linecap="round" />
      <path class="ea-draw" style="--d:0.35s" pathLength="1" d="M80 122c-9 8-22 9-34 20" stroke={e.raiz} stroke-width="6" stroke-linecap="round" />
      <path class="ea-draw" style="--d:0.45s" pathLength="1" d="M80 128c9 6 20 6 31 18" stroke={e.raiz} stroke-width="6" stroke-linecap="round" />
    </>
  )}
  <path d="M10 104h140" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
  <path class="ea-pop" style="--d:0.05s" d="M80 84c10 7 13 15 13 20a13 13 0 0 1-26 0c0-5 3-13 13-20z" fill={e.semente} />
</svg>
