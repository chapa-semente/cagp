---
// SegmentedControl.astro — Controle Segmentado Unificado por N (Impeccable Layout & Polish)
import CagpIcon from './CagpIcon.astro';

export interface TabItem {
  id: string;
  shortLabel: string;
  fullLabel: string;
  hash: string;
}

export interface Props {
  tabs: TabItem[];
  defaultTab?: string;
  class?: string;
  showViewAll?: boolean;
}

const {
  tabs,
  defaultTab = tabs[0]?.id,
  class: className = '',
  showViewAll = true,
} = Astro.props;
---

<nav
  class={`cagp-workspace-bar border-3 border-border shadow-md select-none ${className}`.trim()}
  aria-label="Abas operacionais da página"
>
  <div
    class="cagp-workspace-tabs scroll-mask-x flex-1 min-w-0 overflow-x-auto scrollbar-none snap-x snap-proximity"
    role="tablist"
    aria-orientation="horizontal"
    data-tab-count={tabs.length}
  >
    {tabs.map((tab) => {
      const isSelected = tab.id === defaultTab;
      return (
        <button
          type="button"
          class={`cagp-workspace-tab min-h-[44px] snap-start focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 active:translate-x-0.5 active:translate-y-0.5 ${isSelected ? 'is-active' : ''}`}
          role="tab"
          id={`ws-tab-${tab.id}`}
          aria-controls={`ws-panel-${tab.id}`}
          aria-selected={isSelected ? 'true' : 'false'}
          tabindex={isSelected ? 0 : -1}
          data-ws-tab={tab.id}
          data-ws-hash={tab.hash}
        >
          <span class="cagp-tab-label-full truncate">{tab.fullLabel}</span>
          <span class="cagp-tab-label-short truncate" aria-hidden="true">{tab.shortLabel}</span>
        </button>
      );
    })}
  </div>
  {showViewAll && (
    <button
      type="button"
      class="cagp-workspace-viewall min-h-[44px] min-w-[44px] shrink-0 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary focus-visible:ring-offset-2 active:translate-x-0.5 active:translate-y-0.5"
      aria-pressed="false"
      aria-label="Ver todas as abas (visão contínua)"
      title="Exibir todas as abas (visão contínua)"
      data-ws-tab="__all__"
      data-ws-hash="#visao-completa"
    >
      <CagpIcon name="sidebar" class="w-4 h-4" />
    </button>
  )}
</nav>

<script>
  let activeCleanup: (() => void) | null = null;

  function setupWorkspaceTabs() {
    if (activeCleanup) {
      activeCleanup();
      activeCleanup = null;
    }

    const bars = document.querySelectorAll<HTMLElement>('.cagp-workspace-bar');
    if (bars.length === 0) return;

    const unbindCallbacks: Array<() => void> = [];

    bars.forEach((bar) => {
      const tabs = bar.querySelectorAll<HTMLButtonElement>('.cagp-workspace-tab');
      const viewAllBtn = bar.querySelector<HTMLButtonElement>('.cagp-workspace-viewall');
      const panels = document.querySelectorAll<HTMLElement>('.cagp-workspace-view');

      // Ensure all panels have WAI-ARIA tabpanel attributes
      panels.forEach((p) => {
        const panelId = p.getAttribute('data-ws-panel') || p.id.replace('ws-panel-', '');
        p.setAttribute('role', 'tabpanel');
        p.setAttribute('aria-labelledby', `ws-tab-${panelId}`);
        if (!p.hasAttribute('tabindex')) {
          p.setAttribute('tabindex', '0');
        }
      });

      function activate(tabId: string, updateHash = true) {
        if (typeof navigator !== 'undefined' && 'vibrate' in navigator) {
          try {
            navigator.vibrate(12);
          } catch {}
        }

        if (tabId === '__all__') {
          tabs.forEach((t) => {
            t.classList.remove('is-active');
            t.setAttribute('aria-selected', 'false');
            t.tabIndex = -1;
          });
          viewAllBtn?.setAttribute('aria-pressed', 'true');
          viewAllBtn?.classList.add('is-active');
          panels.forEach((p) => p.removeAttribute('hidden'));
          if (updateHash) history.replaceState(null, '', '#visao-completa');
          return;
        }

        viewAllBtn?.setAttribute('aria-pressed', 'false');
        viewAllBtn?.classList.remove('is-active');

        tabs.forEach((t) => {
          const isMatch = t.getAttribute('data-ws-tab') === tabId;
          t.classList.toggle('is-active', isMatch);
          t.setAttribute('aria-selected', isMatch ? 'true' : 'false');
          t.tabIndex = isMatch ? 0 : -1;
          if (isMatch) {
            t.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
            if (updateHash) {
              const h = t.getAttribute('data-ws-hash');
              if (h) history.replaceState(null, '', h);
            }
          }
        });

        panels.forEach((p) => {
          const panelId = p.getAttribute('data-ws-panel') || p.id.replace('ws-panel-', '');
          if (panelId === tabId) {
            p.removeAttribute('hidden');
            p.classList.remove('cagp-animate-ws-enter');
            void p.offsetWidth;
            p.classList.add('cagp-animate-ws-enter');
          } else {
            p.setAttribute('hidden', '');
            p.classList.remove('cagp-animate-ws-enter');
          }
        });
      }

      tabs.forEach((tab, index) => {
        const handleTabClick = () => {
          const id = tab.getAttribute('data-ws-tab');
          if (id) activate(id);
        };
        tab.addEventListener('click', handleTabClick);

        // Keyboard navigation with roving tabindex (ArrowLeft, ArrowRight, Home, End)
        const handleKeydown = (e: KeyboardEvent) => {
          let nextIndex = index;
          if (e.key === 'ArrowRight') {
            nextIndex = (index + 1) % tabs.length;
          } else if (e.key === 'ArrowLeft') {
            nextIndex = (index - 1 + tabs.length) % tabs.length;
          } else if (e.key === 'Home') {
            nextIndex = 0;
          } else if (e.key === 'End') {
            nextIndex = tabs.length - 1;
          } else {
            return;
          }
          e.preventDefault();
          tabs[nextIndex].focus();
          const nextId = tabs[nextIndex].getAttribute('data-ws-tab');
          if (nextId) activate(nextId);
        };
        tab.addEventListener('keydown', handleKeydown);
      });

      if (viewAllBtn) {
        const handleViewAllClick = () => {
          const isPressed = viewAllBtn.getAttribute('aria-pressed') === 'true';
          if (isPressed) {
            const firstTab = tabs[0]?.getAttribute('data-ws-tab');
            if (firstTab) activate(firstTab);
          } else {
            activate('__all__');
          }
        };
        viewAllBtn.addEventListener('click', handleViewAllClick);
      }

      // Delegated click listener to catch in-page anchor links referencing tabs or tab panels
      const handleGlobalAnchorClick = (e: MouseEvent) => {
        const anchor = (e.target as HTMLElement).closest('a');
        if (!anchor) return;
        const href = anchor.getAttribute('href');
        if (!href) return;

        let hash = '';
        if (href.startsWith('#')) {
          hash = href;
        } else if (href.includes('#')) {
          try {
            const url = new URL(anchor.href, window.location.href);
            if (
              url.origin === window.location.origin &&
              url.pathname.replace(/\/$/, '') === window.location.pathname.replace(/\/$/, '')
            ) {
              hash = url.hash;
            }
          } catch {}
        }

        if (!hash) return;

        // Check if hash matches one of the tabs
        const matchingTab = Array.from(tabs).find((t) => t.getAttribute('data-ws-hash') === hash);
        if (matchingTab) {
          e.preventDefault();
          const id = matchingTab.getAttribute('data-ws-tab');
          if (id) {
            activate(id, true);
            setTimeout(() => {
              const targetEl = document.querySelector(hash) || document.getElementById('ws-panel-' + id);
              if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
              }
            }, 60);
          }
          return;
        }

        // Check if hash matches an element inside one of the panels
        try {
          const targetEl = document.querySelector(hash);
          if (targetEl) {
            const parentPanel = targetEl.closest('.cagp-workspace-view');
            if (parentPanel) {
              const panelId = parentPanel.getAttribute('data-ws-panel') || parentPanel.id.replace('ws-panel-', '');
              const tabForPanel = Array.from(tabs).find((t) => t.getAttribute('data-ws-tab') === panelId);
              if (tabForPanel) {
                e.preventDefault();
                activate(panelId, true);
                setTimeout(() => {
                  targetEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                  if (targetEl.tagName === 'DETAILS') {
                    (targetEl as HTMLDetailsElement).open = true;
                  }
                }, 60);
              }
            }
          }
        } catch {}
      };

      document.addEventListener('click', handleGlobalAnchorClick);
      unbindCallbacks.push(() => {
        document.removeEventListener('click', handleGlobalAnchorClick);
      });

      // Match current window location hash on load
      const applyHash = () => {
        const hash = window.location.hash;
        if (hash === '#visao-completa') {
          activate('__all__', false);
        } else if (hash) {
          let matchingTab = Array.from(tabs).find((t) => t.getAttribute('data-ws-hash') === hash);
          let targetEl: HTMLElement | null = null;

          if (!matchingTab && hash.length > 1) {
            try {
              targetEl = document.querySelector(hash);
              if (targetEl) {
                const parentPanel = targetEl.closest('.cagp-workspace-view');
                if (parentPanel) {
                  const panelId = parentPanel.getAttribute('data-ws-panel') || parentPanel.id.replace('ws-panel-', '');
                  matchingTab = Array.from(tabs).find((t) => t.getAttribute('data-ws-tab') === panelId);
                }
              }
            } catch (e) {}
          }

          if (matchingTab) {
            const id = matchingTab.getAttribute('data-ws-tab');
            if (id) {
              activate(id, false);
              setTimeout(() => {
                const el = targetEl || document.querySelector(hash) || document.getElementById('ws-panel-' + id);
                if (el) {
                  el.scrollIntoView({ behavior: 'smooth', block: 'start' });
                  if (el.tagName === 'DETAILS') {
                    (el as HTMLDetailsElement).open = true;
                  }
                }
              }, 120);
            }
          }
        }
      };

      applyHash();
      window.addEventListener('hashchange', applyHash);
      unbindCallbacks.push(() => {
        window.removeEventListener('hashchange', applyHash);
      });
    });

    activeCleanup = () => {
      unbindCallbacks.forEach((fn) => fn());
    };
  }

  document.addEventListener('astro:page-load', setupWorkspaceTabs);
  document.addEventListener('astro:before-swap', () => {
    if (activeCleanup) {
      activeCleanup();
      activeCleanup = null;
    }
  });
</script>
