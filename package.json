{
  "name": "cagp-ufmg-superapp",
  "type": "module",
  "version": "3.0.0",
  "description": "Portal Institucional & Super App Discente — Centro Acadêmico de Gestão Pública (CAGP FAFICH/UFMG)",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/generate-sw-manifest.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "generate:icons": "node scripts/generate-pwa-icons.mjs",
    "audit:sync": "node --experimental-strip-types scripts/audit-holistic-sync.ts",
    "verify:holistic": "node --experimental-strip-types scripts/verify-holistic-integration.ts",
    "verify:design-system": "node scripts/verify-quadripartite-compliance.mjs",
    "lint:styles": "node scripts/check-hardcoded-styles.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/react": "^4.2.1",
    "@base-ui/react": "^1.9.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@headlessui/react": "^2.2.10",
    "@hookform/resolvers": "^7.0.3",
    "@phosphor-icons/core": "2.1.1",
    "@phosphor-icons/react": "2.1.10",
    "@phosphor-icons/web": "2.1.2",
    "@tailwindcss/vite": "^4.0.9",
    "@tanstack/react-table": "^8.21.3",
    "astro": "^7.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.70.0",
    "mdast-util-toc": "^7.1.0",
    "motion": "^14.10.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.91.0",
    "react-resizable-panels": "^2.1.9",
    "recharts": "^3.10.1",
    "remark": "^15.0.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.0.9",
    "unist-util-visit": "^5.2.0",
    "vaul": "^1.1.2",
    "vfile": "^6.0.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@testing-library/react": "^16.2.0",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
